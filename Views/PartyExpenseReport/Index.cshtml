@using Nskg.Models
@{
    ViewData["Title"] = "Party Expense Report (Detailed Ledger)";
    var fromDateValue = ViewBag.FromDate as string ?? "";
    var toDateValue = ViewBag.ToDate as string ?? "";
    var biltyNoValue = ViewBag.BiltyNo as string ?? "";
    var vehicleNoValue = ViewBag.VehicleNo as string ?? "";
    var accodeValue = ViewBag.Accode as string ?? "";
    var selectedCompanyId = ViewBag.SelectedCompanyId != null ? (int)ViewBag.SelectedCompanyId : 0;
    var companyList = ViewBag.CompanyList as IEnumerable<dynamic>;

    if (string.IsNullOrEmpty(fromDateValue))
    {
        fromDateValue = DateTime.Now.AddDays(-30).ToString("yyyy-MM-dd");
    }

    if (string.IsNullOrEmpty(toDateValue))
    {
        toDateValue = DateTime.Now.ToString("yyyy-MM-dd");
    }
}

<style>
    .custom-card { border-radius: 10px; }
    .heading-glow { font-weight: 600; }
    .custom-btn { border-radius: 6px; }
    iframe { border-radius: 8px; }
</style>

<div class="container-fluid mt-4">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="fw-bold"><i class="fa fa-book me-2 text-danger"></i> Party Expense Report (Detailed Ledger)</h3>
    </div>

    <!-- Filter Card -->
    <div class="card custom-card mb-4 shadow-sm border-0">
        <div class="card-header bg-danger text-white py-3">
            <h5 class="mb-0 fw-semibold">
                <i class="fa fa-filter me-2"></i> Filter Parameters
            </h5>
        </div>
        <div class="card-body p-4 bg-light">
            <form method="get" id="partyExpenseForm">
                <div class="row g-3">
                    
                    <!-- Company Filter -->
                    <div class="col-md-3">
                        <label class="form-label fw-bold">Company</label>
                        <select class="form-select select2" id="companySelect" name="companyId">
                            <option value="0" selected="@(selectedCompanyId == 0 ? "selected" : null)">-- All Companies --</option>
                            @if (companyList != null)
                            {
                                foreach (var comp in companyList)
                                {
                                    <option value="@comp.Id" selected="@(comp.Id == selectedCompanyId ? "selected" : null)">
                                        @comp.Code - @comp.Name
                                    </option>
                                }
                            }
                        </select>
                    </div>

                    <!-- Account / Party Filter -->
                    <div class="col-md-3">
                        <label class="form-label fw-bold">Select Party / Account</label>
                        <select class="form-control select2" id="accodeSelect" name="accode">
                            <option value="">-- Select Party / Account --</option>
                            @if (ViewBag.AccountList != null)
                            {
                                foreach (var item in ViewBag.AccountList)
                                {
                                    <option value="@item.Code" 
                                            selected="@(item.Code == accodeValue ? "selected" : null)">
                                        @item.Code - @item.Name
                                    </option>
                                }
                            }
                        </select>
                    </div>

                    <!-- Vehicle No Filter -->
                    <div class="col-md-2">
                        <label class="form-label fw-bold">Vehicle No</label>
                        <select class="form-select select2" id="vehicleNoSelect" name="vehicleNo">
                            <option value="">-- All Vehicles --</option>
                            @if (!string.IsNullOrEmpty(vehicleNoValue))
                            {
                                <option value="@vehicleNoValue" selected="selected">@vehicleNoValue</option>
                            }
                        </select>
                    </div>

                    <!-- Commission No -->
                    <div class="col-md-2">
                        <label class="form-label fw-bold">Commission No</label>
                        <input type="text" class="form-control" name="biltyNo" value="@biltyNoValue" placeholder="e.g. 5432" />
                    </div>

                    <!-- From Date -->
                    <div class="col-md-2">
                        <label class="form-label fw-bold">From Date</label>
                        <input type="date" class="form-control" name="fromDate" value="@fromDateValue" />
                    </div>

                    <!-- To Date -->
                    <div class="col-md-2">
                        <label class="form-label fw-bold">To Date</label>
                        <input type="date" class="form-control" name="toDate" value="@toDateValue" />
                    </div>

                    <!-- Actions -->
                    <div class="col-md-12 d-flex justify-content-end gap-2 mt-3 pt-2 border-top">
                        <!-- VIEW ON SCREEN -->
                        <button type="button"
                                class="btn btn-primary btn-sm px-3 shadow-sm fw-semibold"
                                onclick="loadOnScreenReport()">
                            <i class="fa fa-desktop me-1"></i> View Report
                        </button>

                        <!-- EXCEL EXPORT -->
                        <button type="submit"
                                class="btn btn-success btn-sm px-3 shadow-sm fw-semibold"
                                asp-action="ExportExcel">
                            <i class="fa fa-file-excel-o me-1"></i> Export Excel (CSV)
                        </button>

                        <!-- PDF DOWNLOAD -->
                        <button type="submit"
                                class="btn btn-danger btn-sm px-3 shadow-sm fw-semibold"
                                asp-action="GeneratePDF"
                                formtarget="_blank">
                            <i class="fa fa-file-pdf-o me-1"></i> Open / Print PDF
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- ON SCREEN REPORT PREVIEW -->
    <div id="reportCard" class="card shadow border-0" style="display:none;">
        <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center py-2">
            <h5 class="mb-0 fs-6"><i class="fa fa-file-text-o me-2"></i> Report Preview</h5>
            <button type="button" class="btn btn-sm btn-outline-light" onclick="$('#reportCard').hide()">
                <i class="fa fa-times"></i> Close
            </button>
        </div>

        <!-- LOADER -->
        <div id="reportLoader" style="display:none; padding:40px; text-align:center;">
            <div class="spinner-border text-danger" role="status" style="width: 3rem; height: 3rem;">
                <span class="visually-hidden">Loading...</span>
            </div>
            <div class="mt-3 fw-bold text-muted">Generating party expense ledger, please wait...</div>
        </div>

        <!-- REPORT IFRAME -->
        <div class="card-body p-0">
            <iframe id="reportFrame"
                    style="width:100%; height:750px; border:none;"></iframe>
        </div>
    </div>

</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            if ($.fn.select2) {
                $('#companySelect').select2({ theme: 'bootstrap-5', width: '100%' });

                $('#accodeSelect').select2({
                    theme: 'bootstrap-5',
                    placeholder: "-- Select Party / Account --",
                    allowClear: true,
                    width: '100%'
                });

                $('#vehicleNoSelect').select2({
                    theme: 'bootstrap-5',
                    placeholder: "-- All Vehicles --",
                    allowClear: true,
                    tags: true,
                    width: '100%'
                });
            }

            $('#companySelect').on('change', function () {
                var compId = $(this).val();
                if (compId === null || compId === undefined || compId === "") compId = "0";

                $.getJSON('@Url.Action("GetAccountsByCompany", "PartyExpenseReport")', { companyId: compId }, function (data) {
                    var $acc = $('#accodeSelect');
                    $acc.empty().append('<option value="">-- Select Party / Account --</option>');
                    $.each(data, function (i, item) {
                        var codeVal = item.code || item.Code || '';
                        var nameVal = item.name || item.Name || '';
                        $acc.append('<option value="' + codeVal + '">' + codeVal + ' - ' + nameVal + '</option>');
                    });
                    $acc.trigger('change');
                });
            });
        });

        function loadOnScreenReport() {
            var companyId = $('#companySelect').val();
            if (companyId === null || companyId === undefined || companyId === "") companyId = "0";
            var accode = $('#accodeSelect').val() || '';
            var vehicleNo = $('#vehicleNoSelect').val() || '';
            var biltyNo = $('input[name="biltyNo"]').val() || '';
            var fromDate = $('input[name="fromDate"]').val() || '2010-01-01';
            var toDate = $('input[name="toDate"]').val() || '';

            if (!accode && !vehicleNo && !biltyNo) {
                alert("Please select a Party / Account, Vehicle No, or enter a Commission No.");
                return;
            }

            if (fromDate && toDate && fromDate > toDate && !vehicleNo && !biltyNo) {
                alert("From Date cannot be greater than To Date.");
                return;
            }

            $('#reportCard').show();
            $('#reportLoader').show();
            $('#reportFrame').show();

            // Smooth scroll down to preview
            $('html, body').animate({
                scrollTop: $("#reportCard").offset().top - 20
            }, 300);

            var url = '@Url.Action("OnScreenReport", "PartyExpenseReport")'
                + '?companyId=' + encodeURIComponent(companyId)
                + '&accode=' + encodeURIComponent(accode)
                + '&fromDate=' + encodeURIComponent(fromDate)
                + '&toDate=' + encodeURIComponent(toDate)
                + '&vehicleNo=' + encodeURIComponent(vehicleNo)
                + '&biltyNo=' + encodeURIComponent(biltyNo);

            var frame = document.getElementById('reportFrame');
            if (frame) {
                frame.onload = function () {
                    $('#reportLoader').hide();
                };
                frame.src = url;
            }

            setTimeout(function () {
                $('#reportLoader').hide();
            }, 2500);
        }
    </script>
}
