
@using Nskg.Models.ViewModels
@model CompanySelectionViewModel

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">Select Company & Financial Year</h4>
        </div>
        <div class="card-body">
            <form asp-action="SelectCompany" method="post">
                
                <div class="form-group row">
                    <label for="companyDropdown" class="col-sm-3 col-form-label">Company</label>
                    <div class="col-sm-9">
                        <select asp-for="SelectedCompanyId" asp-items="Model.Companies"
                                id="companyDropdown" class="form-control">
                            <option value="">--select--</option>
                        </select>
                    </div>
                </div>

                <div class="form-group row mt-3">
                    <label for="yearDropdown" class="col-sm-3 col-form-label">Financial Year</label>
                    <div class="col-sm-9">
                        <select asp-for="SelectedFinancialYearId"
                                id="yearDropdown" class="form-control">
                            <option value="">--select--</option>
                        </select>
                    </div>
                </div>

                <div class="text-right mt-4">
                    <button type="submit" class="btn btn-primary">
                        Continue
                    </button>
                </div>

            </form>
        </div>
    </div>
</div>

<script>
    document.getElementById("companyDropdown").addEventListener("change", function () {
        var companyId = this.value;
        fetch('/AccountSetup/GetFinancialYears?companyId=' + companyId)
            .then(res => res.json())
            .then(data => {
                var yearDropdown = document.getElementById("yearDropdown");
                yearDropdown.innerHTML = '<option value="">--select--</option>';
                data.forEach(item => {
                    var option = document.createElement("option");
                    option.value = item.value;
                    option.text = item.text;
                    yearDropdown.appendChild(option);
                });
            });
    });
</script>