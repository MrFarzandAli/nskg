@using Nskg.Models.ViewModels
@model CommBookViewModel

@section Styles {
    <style>
        .form-inline-label {
            min-width: 130px;
            margin-bottom: 0;
            font-weight: 600;
            white-space: nowrap;
        }

        .card {
            border-radius: 10px;
        }

        label i {
            margin-right: 6px;
            color: #0d6efd;
        }

        .table-responsive {
            max-height: 400px;
            overflow-y: auto;
        }

        .bg-light {
            background-color: #e9ecef !important;
        }

        .total-row {
            background-color: #f8f9fa;
            font-weight: bold;
        }
        /* Highlight style for form controls (for Enter-navigation focus) */
        .active-field {
            border: 2px solid #0d6efd !important;
            box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.25) !important;
            background-color: #f0f7ff !important;
            transition: all 0.2s ease;
        }

        .btn.active-field {
            border: 2px solid #0d6efd !important;
            box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.3) !important;
            transform: scale(1.02);
            transition: all 0.2s ease;
        }

        /* Match Select2 dropdowns exactly with form-control-sm in height, width, and font */
        .select2-container .select2-selection--single,
        .select2-container--bootstrap-5 .select2-selection--single {
            height: 31px !important;
            min-height: 31px !important;
            padding: 0.2rem 0.5rem !important;
            font-size: 0.875rem !important;
            line-height: 1.5 !important;
            border-radius: 0.25rem !important;
            display: flex !important;
            align-items: center !important;
            border-color: #ced4da !important;
        }

        .select2-container--bootstrap-5 .select2-selection--single .select2-selection__rendered {
            font-size: 0.875rem !important;
            line-height: 1.5 !important;
            padding-left: 0 !important;
            padding-right: 1.25rem !important;
            color: #212529 !important;
        }

        .select2-container--bootstrap-5 .select2-selection--single .select2-selection__arrow {
            top: 50% !important;
            transform: translateY(-50%) !important;
            right: 6px !important;
            width: 16px !important;
            height: 16px !important;
        }

        .select2-container {
            width: 100% !important;
        }

        .select2-dropdown {
            font-size: 12px !important;
        }
        .select2-results__option {
            padding: 4px 8px !important;
            font-size: 12px !important;
            line-height: 1.4 !important;
        }
        .select2-container--bootstrap-5 .select2-dropdown .select2-search .select2-search__field {
            font-size: 12px !important;
            padding: 4px 6px !important;
            height: 28px !important;
        }

        /* Ensure checkbox checkmark is always clearly visible when checked */
        .bilty-check,
        input[type="checkbox"].bilty-check,
        .form-check-input.bilty-check {
            -webkit-appearance: checkbox !important;
            -moz-appearance: checkbox !important;
            appearance: checkbox !important;
            accent-color: #0d6efd !important;
            width: 17px !important;
            height: 17px !important;
            cursor: pointer !important;
            margin: 0 !important;
            display: inline-block !important;
            vertical-align: middle !important;
        }
    </style>
}

<form method="post" id="CommBookForm" class="form-dense">
    @Html.AntiForgeryToken()

    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-2">
        <div class="d-flex align-items-center gap-2">
            <div>
                <h4 class="mb-0 fw-bold text-navy" style="font-size: 1.15rem;">
                    <i class="fa fa-pencil-square-o text-primary me-2"></i>Edit Commission Book
                </h4>
                <small class="text-muted" style="font-size: 0.75rem;"><i class="fa fa-info-circle me-1"></i>Trip Settlements</small>
            </div>
            <span class="badge bg-primary px-2 py-1 shadow-sm" style="font-size: 0.78rem;"><i class="fa fa-file-text me-1"></i>Doc No: @Model.Head.DocNo</span>
        </div>

        <div class="d-flex flex-wrap align-items-center gap-1">
            @if (ViewBag.PrevId != null)
            {
                <a href="@Url.Action("Edit", new { id = ViewBag.PrevId })" class="btn btn-outline-secondary btn-sm custom-btn" title="Previous Entry">
                    <i class="fa fa-arrow-left me-1"></i> Prev
                </a>
            }
            else
            {
                <button type="button" class="btn btn-outline-secondary btn-sm custom-btn disabled" disabled>
                    <i class="fa fa-arrow-left me-1"></i> Prev
                </button>
            }

            @if (ViewBag.NextId != null)
            {
                <a href="@Url.Action("Edit", new { id = ViewBag.NextId })" class="btn btn-outline-secondary btn-sm custom-btn" title="Next Entry">
                    Next <i class="fa fa-arrow-right ms-1"></i>
                </a>
            }
            else
            {
                <button type="button" class="btn btn-outline-secondary btn-sm custom-btn disabled" disabled>
                    Next <i class="fa fa-arrow-right ms-1"></i>
                </button>
            }

            <a asp-action="Create" class="btn btn-outline-primary btn-sm custom-btn me-2" title="New Entry">
                <i class="fa fa-plus-circle me-1"></i> New
            </a>

            <button type="button"
                    id="btnAddChallan"
                    class="btn btn-outline-primary btn-sm custom-btn me-1"
                    data-bs-toggle="modal"
                    data-bs-target="#biltyModal">
                <i class="fa fa-plus me-1"></i> Add Challan
            </button>
            <button type="button" class="btn btn-outline-secondary btn-sm custom-btn me-1" onclick="addEmptyRow()">
                <i class="fa fa-plus me-1"></i> Add Empty Row
            </button>

            <button type="submit" id="btnSaveComm" class="btn btn-primary btn-sm custom-btn shadow-sm">
                <i class="fa fa-save me-1"></i> Update Commission Book
            </button>
        </div>
    </div>

    <!-- MASTER -->
    <div class="card custom-card shadow-sm border-0 mb-2">
        <div class="card-header bg-white border-bottom py-1 px-3 d-flex justify-content-between align-items-center">
            <h6 class="mb-0 fw-semibold text-navy" style="font-size: 13px;">
                <i class="fa fa-sliders text-primary me-1"></i> General Details
            </h6>
        </div>
        <div class="card-body py-2 px-3">
            <div class="row g-2">
                <input asp-for="Head.Id" hidden id="Head_Id"/>
                <input asp-for="Head.DocNo" type="hidden" />

                <!-- Row 1: Comm No (2), Date (2), Vehicle No (2), Station (3), Station Amt (3) = 12 -->
                <div class="col-12 col-sm-6 col-md-2">
                    <label class="form-label small text-muted fw-semibold mb-0"><i class="fa fa-hashtag text-primary me-1"></i> Comm No</label>
                    <input asp-for="Head.ChalNo" class="form-control form-control-sm" />
                </div>

                <div class="col-12 col-sm-6 col-md-2">
                    <label class="form-label small text-muted fw-semibold mb-0"><i class="fa fa-calendar text-primary me-1"></i> Date</label>
                    <input asp-for="Head.DocDate" type="date" value="@(Model != null && Model.Head != null ? Model.Head.DocDate.ToString("yyyy-MM-dd") : DateTime.Today.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" />
                </div>

                <div class="col-12 col-sm-6 col-md-2">
                    <label class="form-label small text-muted fw-semibold mb-0"><i class="fa fa-car text-primary me-1"></i> Vehicle No</label>
                    <input asp-for="Head.VehicleNo" class="form-control form-control-sm" />
                </div>

                <div class="col-12 col-sm-6 col-md-3">
                    <label class="form-label small text-muted fw-semibold mb-0"><i class="fa fa-map-marker text-primary me-1"></i> Station</label>
                    <select asp-for="Head.StationId" id="Head_StationId" class="form-select form-select-sm select2"
                            asp-items="@(new SelectList(ViewBag.Stations, "Value", "Text", Model?.Head?.StationId?.ToString() ?? ""))"></select>
                </div>

                <div class="col-12 col-sm-6 col-md-3">
                    <label class="form-label small text-muted fw-semibold mb-0"><i class="fa fa-money text-primary me-1"></i> Station Amt</label>
                    <input asp-for="Head.StationAmt" class="form-control form-control-sm text-end" />
                </div>

                <!-- Row 2: Transporter (3), Transporter Amt (3), Advance (3), Advance Amt (3) = 12 -->
                <div class="col-12 col-sm-6 col-md-3">
                    <label class="form-label small text-muted fw-semibold mb-0"><i class="fa fa-truck text-primary me-1"></i> Transporter</label>
                    <select asp-for="Head.TransId" id="Head_TransId" class="form-select form-select-sm select2"
                            asp-items="@(new SelectList(ViewBag.Transporters, "Value", "Text", Model?.Head?.TransId?.ToString() ?? ""))"></select>
                </div>

                <div class="col-12 col-sm-6 col-md-3">
                    <label class="form-label small text-muted fw-semibold mb-0"><i class="fa fa-money text-primary me-1"></i> Transporter Amt</label>
                    <input asp-for="Head.TransporterAmt" class="form-control form-control-sm text-end" />
                </div>

                <div class="col-12 col-sm-6 col-md-3">
                    <label class="form-label small text-muted fw-semibold mb-0"><i class="fa fa-hand-holding-usd text-primary me-1"></i> Advance</label>
                    <select asp-for="Head.AdvanceId" id="Head_AdvanceId" class="form-select form-select-sm select2"
                            asp-items="@(new SelectList(ViewBag.Advances, "Value", "Text", Model?.Head?.AdvanceId?.ToString() ?? ""))"></select>
                </div>

                <div class="col-12 col-sm-6 col-md-3">
                    <label class="form-label small text-muted fw-semibold mb-0"><i class="fa fa-money text-primary me-1"></i> Advance Amt</label>
                    <input asp-for="Head.AdvanceAmt" class="form-control form-control-sm text-end" />
                </div>

                <!-- Row 3: Remarks (12) -->
                <div class="col-12">
                    <label class="form-label small text-muted fw-semibold mb-0"><i class="fa fa-comment text-primary me-1"></i> Remarks</label>
                    <input asp-for="Head.Narration" id="Head_Narration" class="form-control form-control-sm" />
                </div>
            </div>
        </div>
    </div>

    <!-- DETAIL -->
    <div class="card custom-card shadow-sm border-0 mb-2">
        <div class="card-header bg-white border-bottom py-1 px-3 d-flex justify-content-between align-items-center">
            <h6 class="mb-0 fw-semibold text-navy" style="font-size: 13px;">
                <i class="fa fa-list text-primary me-1"></i> Challan Details
            </h6>
        </div>

        <div class="card-body p-0">
            <div class="table-responsive" style="max-height: 200px; overflow-y: auto; overflow-x: auto;">
                <table class="table table-bordered table-sm table-hover mb-0" id="tblItems">
                    <thead class="table-light text-center" style="position: sticky; top: 0; z-index: 2; background-color: #f8f9fa;">
                        <tr>
                            <th width="100"><i class="fa fa-hashtag text-primary me-1"></i> Challan No</th>
                            <th width="100"><i class="fa fa-map-marker text-primary me-1"></i> Station</th>
                            <th width="150"><i class="fa fa-truck text-primary me-1"></i> Transporter</th>
                            <th width="150"><i class="fa fa-user text-primary me-1"></i> Party Name</th>
                            <th width="100"><i class="fa fa-money text-primary me-1"></i> Bilty Amt</th>
                            <th width="100"><i class="fa fa-credit-card text-primary me-1"></i> Paid Amt</th>
                            <th width="100"><i class="fa fa-money text-primary me-1"></i> To Paid Amt</th>
                            <th width="100"><i class="fa fa-truck text-primary me-1"></i> Delivery Amt</th>
                            <th width="100"><i class="fa fa-map-marker text-primary me-1"></i> Local Amt</th>
                            <th width="100"><i class="fa fa-calculator text-primary me-1"></i> Net Amt</th>
                            <th width="90"><i class="fa fa-cog text-primary me-1"></i> Action</th>
                        </tr>
                        <tr class="total-row">
                            <td colspan="4" class="text-end fw-bold">Total:</td>
                            <td><input type="text" id="totalBillTiAmt" class="form-control form-control-sm text-end bg-light" readonly style="font-weight:bold;"></td>
                            <td><input type="text" id="totalPaidAmt" class="form-control form-control-sm text-end bg-light" readonly style="font-weight:bold;"></td>
                            <td><input type="text" id="totalToPaidAmt" class="form-control form-control-sm text-end bg-light" readonly style="font-weight:bold;"></td>
                            <td><input type="text" id="totalDeliveryAmt" class="form-control form-control-sm text-end bg-light" readonly style="font-weight:bold;"></td>
                            <td><input type="text" id="totalLocalAmt" class="form-control form-control-sm text-end bg-light" readonly style="font-weight:bold;"></td>
                            <td><input type="text" id="totalNetAmt" class="form-control form-control-sm text-end bg-light" readonly style="font-weight:bold;"></td>
                            <td></td>
                        </tr>
                    </thead>
                    <tbody id="tbodyItems">
                        @if (Model?.Details != null && Model.Details.Any())
                        {
                            for (int i = 0; i < Model.Details.Count; i++)
                            {
                                var d = Model.Details[i];
                                <tr data-row-index="@i">
                                    <td>
                                        <input type="text" name="Details[@i].BillTiNo" value="@d.BillTiNo" class="form-control form-control-sm billti-no" readonly />
                                    </td>
                                    <td>
                                        <input type="text" name="Details[@i].Fooder" value="@d.Fooder" class="form-control form-control-sm fooder" readonly />
                                    </td>
                                    <td>
                                        <input type="text" name="Details[@i].CusName" value="@d.CusName" class="form-control form-control-sm cus-name" />
                                    </td>
                                    <td>
                                        <input type="text" name="Details[@i].SendTo" value="@d.SendTo" class="form-control form-control-sm send-to" readonly />
                                    </td>
                                    <td>
                                        <input type="number" name="Details[@i].BillTiAmt" value="@(d.BillTiAmt ?? 0)" class="form-control form-control-sm biltyamt text-end" step="any" readonly />
                                    </td>
                                    <td>
                                        <input type="number" name="Details[@i].PaidAmt" value="@(d.PaidAmt ?? 0)" class="form-control form-control-sm paidamt text-end" step="any" readonly />
                                    </td>
                                    <td>
                                        <input type="number" name="Details[@i].ToPaidAmt" value="@(d.ToPaidAmt ?? 0)" class="form-control form-control-sm topaidamt text-end" step="any" readonly />
                                    </td>
                                    <td>
                                        <input type="number" name="Details[@i].DeliveryAmt" value="@(d.DeliveryAmt ?? 0)" class="form-control form-control-sm deliveryamt text-end" step="any" readonly />
                                    </td>
                                    <td>
                                        <input type="number" name="Details[@i].LocalAmt" value="@(d.LocalAmt ?? 0)" class="form-control form-control-sm localamt text-end" step="any" readonly />
                                    </td>
                                    <td>
                                        <input type="number" name="Details[@i].NetAmt" value="@(d.NetAmt ?? 0)" class="form-control form-control-sm netamt text-end" step="any" readonly />
                                    </td>
                                    <td class="text-center">
                                        <input type="hidden" name="Details[@i].DCNo" class="dc-no" value="@d.DCNo" />
                                        <input type="hidden" name="Details[@i].ChallanId" class="challan-id" value="@d.ChallanId" />
                                        <input type="hidden" name="Details[@i].FooderCode" value="@d.FooderCode" />
                                        <input type="hidden" name="Details[@i].PartyEx" value="@(d.PartyEx ?? 0)" />
                                        <input type="hidden" name="Details[@i].Lifter2" value="@(d.Lifter2 ?? 0)" />
                                        <input type="hidden" name="Details[@i].OtherEx" value="@(d.OtherEx ?? 0)" />
                                        <div class="d-flex justify-content-center gap-1">
                                            <button type="button" class="btn btn-info btn-sm text-white" title="View Challan in Edit mode" onclick="viewChallan(this)">
                                                <i class="fa fa-eye"></i>
                                            </button>
                                            <button type="button" class="btn btn-danger btn-sm" onclick="removeRow(this)">
                                                <i class="fa fa-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr id="noDataRow">
                                <td colspan="11" class="text-center text-muted py-3">No Records Added</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- LOWER SECTION: EXPENSES (LEFT ~70%) & PARTY (RIGHT ~30%) -->
    <div class="row g-2 mb-2">
        <!-- LEFT COLUMN: FREIGHT, EXPENSES & NET (~70%) -->
        <div class="col-12 col-lg-8">
            <div class="card shadow-sm border-0 h-100 mb-0">
                <div class="card-header bg-white py-1 px-3">
                    <h6 class="mb-0 fw-semibold text-navy" style="font-size: 13px;">
                        <i class="fa fa-calculator me-1 text-primary"></i> Expenses & Calculations
                    </h6>
                </div>
                <div class="card-body py-2 px-3">
                    <div class="row g-2">
                        <div class="col-6 col-md-3">
                            <label class="form-label small fw-semibold mb-0">Freight (Delivery)</label>
                            <input asp-for="Head.DeliveryAmt" id="Head_DeliveryAmt" class="form-control form-control-sm text-end" />
                        </div>

                        <div class="col-6 col-md-3">
                            <label class="form-label small fw-semibold mb-0">Munshiana (Local)</label>                    
                            <input asp-for="Head.LocalAmt" id="Head_LocalAmt" class="form-control form-control-sm text-end" />
                        </div>

                        <div class="col-6 col-md-3">
                            <label class="form-label small fw-semibold mb-0">Labour</label>
                            <input asp-for="Head.Labour" id="Head_Labour" class="form-control form-control-sm text-end" />
                        </div>

                        <div class="col-6 col-md-3">
                            <label class="form-label small fw-semibold mb-0">Other Expense</label>
                            <input asp-for="Head.OtherExAmt" id="Head_OtherExAmt" class="form-control form-control-sm text-end" />
                        </div>

                        <div class="col-6 col-md-3">
                            <label class="form-label small fw-semibold mb-0">Lifter Amount</label>
                            <input asp-for="Head.Lifter2Amt" id="Head_Lifter2Amt" class="form-control form-control-sm text-end" />
                        </div>

                        <div class="col-6 col-md-3">
                            <label class="form-label small fw-semibold mb-0">Tax</label>
                            <input asp-for="Head.Tax" id="Head_Tax" class="form-control form-control-sm text-end" />
                        </div>

                        <div class="col-6 col-md-3">
                            <label class="form-label small fw-bold mb-0">Total Amt</label>
                            <input asp-for="Head.TotAmt" id="Head_TotAmt" class="form-control form-control-sm bg-light fw-bold text-end" readonly />
                        </div>

                        <div class="col-6 col-md-3">
                            <label class="form-label small fw-bold text-primary mb-0">Net Amt</label>
                            <input asp-for="Head.NetAmt" id="Head_NetAmt" class="form-control form-control-sm bg-light text-primary border-primary fw-bold text-end" readonly />
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- RIGHT COLUMN: PARTY EXPENSE (~30%) -->
        <div class="col-12 col-lg-4">
            <div class="card shadow-sm border-0 h-100 mb-0">
                <div class="card-header bg-white py-1 px-3">
                    <h6 class="mb-0 fw-semibold text-navy" style="font-size: 13px;">
                        <i class="fa fa-users me-1 text-primary"></i> Party Details
                    </h6>
                </div>
                <div class="card-body py-2 px-3">
                    <div class="p-1 border rounded bg-light">
                        <div class="d-flex justify-content-between align-items-center mb-0">
                            <span class="text-primary fw-bold" style="font-size:0.75rem;">Party Expense</span>
                        </div>
                        <input asp-for="Head.PartyExAmt" id="Head_PartyExAmt" class="form-control form-control-sm text-end" placeholder="Amount" style="font-size:0.8rem;" />
                    </div>
                </div>
            </div>
        </div>
    </div>

</form>

<!-- Bilty Modal (same as create) -->
<div class="modal fade" id="biltyModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 96vw; width: 96vw; margin: 15px auto;">
        <div class="modal-content shadow-lg border-0">
            <div class="modal-header bg-light py-2 px-3 border-bottom d-flex justify-content-between align-items-center">
                <h5 class="modal-title fw-bold text-navy mb-0" style="font-size: 1.1rem;">
                    <i class="fa fa-truck-loading text-primary me-2"></i>Select Challan
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-2" style="max-height: 75vh; overflow-y: auto; overflow-x: hidden;">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2 p-2 bg-light rounded border">
                    <div class="d-flex align-items-center gap-2">
                        <button type="button" class="btn btn-sm btn-primary px-3 shadow-sm" onclick="selectAllBilties()">
                            <i class="fa fa-check-square me-1"></i>Select All
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-secondary px-3" onclick="deselectAllBilties()">
                            <i class="fa fa-square me-1"></i>Deselect All
                        </button>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <span class="text-muted small fw-semibold" id="biltyMatchCount"></span>
                        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="clearChallanFilters()" title="Reset all search filters">
                            <i class="fa fa-refresh me-1"></i>Reset / Clear Filters
                        </button>
                    </div>
                </div>

                <div class="table-responsive" style="overflow-x: hidden;">
                    <table class="table table-bordered table-sm table-hover align-middle mb-0" id="biltyModalTable" style="font-size: 0.78rem; width: 100%;">
                        <thead class="table-light">
                            <tr class="text-center align-middle" style="background-color: #f1f4f9;">
                                <th style="width: 38px;">Select</th>
                                <th style="width: 95px;">Challan No</th>
                                <th style="width: 85px;">Date</th>
                                <th style="width: 85px;">Vehicle</th>
                                <th style="min-width: 130px;">Transporter</th>
                                <th style="min-width: 130px;">Driver</th>
                                <th style="min-width: 110px;">Station</th>
                                <th style="width: 70px;" class="text-end">Paid</th>
                                <th style="width: 70px;" class="text-end">To Paid</th>
                                <th style="width: 70px;" class="text-end">Billti</th>
                                <th style="width: 70px;" class="text-end">Delivery</th>
                                <th style="width: 70px;" class="text-end">Local</th>
                                <th style="width: 75px;" class="text-end">Net Amt</th>
                            </tr>
                            <tr class="bg-white filter-row align-middle">
                                <th class="text-center text-muted p-1"><i class="fa fa-search small"></i></th>
                                <th class="p-1"><input type="text" class="form-control form-control-sm col-search" data-col="1" placeholder="Challan #" style="font-size: 0.72rem; padding: 2px 4px; height: 26px;" /></th>
                                <th class="p-1"><input type="date" class="form-control form-control-sm col-search" data-col="2" placeholder="Date" style="font-size: 0.72rem; padding: 2px 4px; height: 26px;" /></th>
                                <th class="p-1"><input type="text" class="form-control form-control-sm col-search" data-col="3" placeholder="Vehicle" style="font-size: 0.72rem; padding: 2px 4px; height: 26px;" /></th>
                                <th class="p-1"><input type="text" class="form-control form-control-sm col-search" data-col="4" placeholder="Transporter" style="font-size: 0.72rem; padding: 2px 4px; height: 26px;" /></th>
                                <th class="p-1"><input type="text" class="form-control form-control-sm col-search" data-col="5" placeholder="Driver / Party" style="font-size: 0.72rem; padding: 2px 4px; height: 26px;" /></th>
                                <th class="p-1"><input type="text" class="form-control form-control-sm col-search" data-col="6" placeholder="Station" style="font-size: 0.72rem; padding: 2px 4px; height: 26px;" /></th>
                                <th class="p-1"><input type="text" class="form-control form-control-sm col-search text-end" data-col="7" placeholder="Paid" style="font-size: 0.72rem; padding: 2px 4px; height: 26px;" /></th>
                                <th class="p-1"><input type="text" class="form-control form-control-sm col-search text-end" data-col="8" placeholder="To Paid" style="font-size: 0.72rem; padding: 2px 4px; height: 26px;" /></th>
                                <th class="p-1"><input type="text" class="form-control form-control-sm col-search text-end" data-col="9" placeholder="Billti" style="font-size: 0.72rem; padding: 2px 4px; height: 26px;" /></th>
                                <th class="p-1"><input type="text" class="form-control form-control-sm col-search text-end" data-col="10" placeholder="Delivery" style="font-size: 0.72rem; padding: 2px 4px; height: 26px;" /></th>
                                <th class="p-1"><input type="text" class="form-control form-control-sm col-search text-end" data-col="11" placeholder="Local" style="font-size: 0.72rem; padding: 2px 4px; height: 26px;" /></th>
                                <th class="p-1"><input type="text" class="form-control form-control-sm col-search text-end" data-col="12" placeholder="Net" style="font-size: 0.72rem; padding: 2px 4px; height: 26px;" /></th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (ViewBag.ChallanList != null)
                            {
                                foreach (var chalno in ViewBag.ChallanList)
                                {
                                    var displayChalNo = chalno.ChalNo != null ? chalno.ChalNo.ToString() : "";
                                    var dateStr = chalno.DocDate != null ? ((DateTime)chalno.DocDate).ToString("dd/MM/yyyy") : "";
                                    var isAssigned = (chalno.commBookId != null && chalno.commBookId > 0) || chalno.DescYn == "Y";
                                    <tr data-id="@chalno.Id" data-docno="@chalno.DocNo" data-chalno="@displayChalNo" data-isassigned="@(isAssigned ? "true" : "false")">
                                        <td class="text-center p-1">
                                            <input type="checkbox"
                                                   class="bilty-check form-check-input mt-0"
                                                   data-id="@chalno.Id"
                                                   data-docno="@chalno.DocNo"
                                                   data-chalno="@displayChalNo"
                                                   data-vehicleno="@chalno.VehicleNo"
                                                   data-transporter="@chalno.Transporter"
                                                   data-driver="@chalno.Driver"
                                                   data-stationcode="@chalno.StationCode"
                                                   data-station="@chalno.Station"
                                                   data-totpaid="@(chalno.TotPaid ?? 0)"
                                                   data-tottopaid="@(chalno.TotToPaid ?? 0)"
                                                   data-totbillti="@(chalno.TotBillTi ?? 0)"
                                                   data-deliveryamt="@(chalno.DeliveryAmt ?? 0)"
                                                   data-localamt="@(chalno.LocalAmt ?? 0)"
                                                   data-netamt="@(chalno.NetAmt ?? 0)"
                                                   data-totpartyex="@(chalno.TotPartyEx ?? 0)"
                                                   data-totlifter2="@(chalno.TotLifter2 ?? 0)"
                                                   data-tototherex="@(chalno.TotOtherEx ?? 0)"
                                                   data-isassigned="@(isAssigned ? "true" : "false")" />
                                        </td>
                                        <td class="p-1 fw-semibold text-primary">
                                            @displayChalNo
                                        </td>
                                        <td class="p-1 text-nowrap">@dateStr</td>
                                        <td class="p-1 text-nowrap">@chalno.VehicleNo</td>
                                        <td class="p-1 text-truncate" style="max-width: 150px;" title="@chalno.Transporter">@chalno.Transporter</td>
                                        <td class="p-1 text-truncate" style="max-width: 150px;" title="@chalno.Driver">@chalno.Driver</td>
                                        <td class="p-1 text-truncate" style="max-width: 120px;" title="@chalno.Station">@chalno.Station</td>
                                        <td class="p-1 text-end">@(((decimal)(chalno.TotPaid ?? 0)).ToString("0.00"))</td>
                                        <td class="p-1 text-end">@(((decimal)(chalno.TotToPaid ?? 0)).ToString("0.00"))</td>
                                        <td class="p-1 text-end">@(((decimal)(chalno.TotBillTi ?? 0)).ToString("0.00"))</td>
                                        <td class="p-1 text-end">@(((decimal)(chalno.DeliveryAmt ?? 0)).ToString("0.00"))</td>
                                        <td class="p-1 text-end">@(((decimal)(chalno.LocalAmt ?? 0)).ToString("0.00"))</td>
                                        <td class="p-1 text-end fw-semibold">@(((decimal)(chalno.NetAmt ?? 0)).ToString("0.00"))</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer py-2 px-3 bg-light border-top d-flex justify-content-between align-items-center">
                <span class="text-muted small"><i class="fa fa-info-circle me-1"></i>Search across any column to find specific challans.</span>
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Close</button>
                    <button type="button" id="btnAddSelected" class="btn btn-primary btn-sm px-3 shadow-sm" onclick="addSelectedBilties()">
                        <i class="fa fa-plus-circle me-1"></i>Add Selected
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Initialize rowCounter from existing model details
        let rowCounter = @((Model?.Details != null) ? Model.Details.Count : 0);

        // Summary variables
        let sumBillTiAmt = 0;
        let sumPaidAmt = 0;
        let sumToPaidAmt = 0;
        let sumDeliveryAmt = 0;
        let sumLocalAmt = 0;
        let sumNetAmt = 0;

        function updateSummaryDisplay() {
            $("#totalBillTiAmt").val(sumBillTiAmt.toFixed(2));
            $("#totalPaidAmt").val(sumPaidAmt.toFixed(2));
            $("#totalToPaidAmt").val(sumToPaidAmt.toFixed(2));
            $("#totalDeliveryAmt").val(sumDeliveryAmt.toFixed(2));
            $("#totalLocalAmt").val(sumLocalAmt.toFixed(2));
            $("#totalNetAmt").val(sumNetAmt.toFixed(2));
        }

        function recalculateTotalsFromRows() {
            sumBillTiAmt = 0;
            sumPaidAmt = 0;
            sumToPaidAmt = 0;
            sumDeliveryAmt = 0;
            sumLocalAmt = 0;
            sumNetAmt = 0;

            $("#tbodyItems tr").each(function() {
                sumBillTiAmt += parseFloat($(this).find(".biltyamt").val()) || 0;
                sumPaidAmt += parseFloat($(this).find(".paidamt").val()) || 0;
                sumToPaidAmt += parseFloat($(this).find(".topaidamt").val()) || 0;
                sumDeliveryAmt += parseFloat($(this).find(".deliveryamt").val()) || 0;
                sumLocalAmt += parseFloat($(this).find(".localamt").val()) || 0;
                sumNetAmt += parseFloat($(this).find(".netamt").val()) || 0;
            });

            updateSummaryDisplay();
        }

        function calculateTotals() {
            recalculateTotalsFromRows();

            let deliveryAmt = parseFloat($("#Head_DeliveryAmt").val()) || 0;
            let localAmt = parseFloat($("#Head_LocalAmt").val()) || 0;
            let tax = parseFloat($("#Head_Tax").val()) || 0;
            let labour = parseFloat($("#Head_Labour").val()) || 0;
            let partyExAmt = parseFloat($("#Head_PartyExAmt").val()) || 0;
            let lifter2Amt = parseFloat($("#Head_Lifter2Amt").val()) || 0;
            let otherExAmt = parseFloat($("#Head_OtherExAmt").val()) || 0;

            let totAmt = (sumNetAmt - (deliveryAmt - localAmt)) - tax;
            let net = (totAmt + sumPaidAmt) - sumBillTiAmt;
            let finalNetAmt = ((((net - labour) - localAmt) - partyExAmt) - lifter2Amt) - otherExAmt;

            $("#Head_TotAmt").val(totAmt.toFixed(2));
            $("#Head_NetAmt").val(finalNetAmt.toFixed(2));

            let advanceAmt = parseFloat($("#Head_AdvanceAmt").val()) || 0;
            let balance = finalNetAmt - advanceAmt;
            $("#BalanceAmt").val(balance.toFixed(2));
        }

        function getNextRowIndex() {
            return rowCounter++;
        }

        function reindexRows() {
            $("#tbodyItems tr").each(function(index) {
                $(this).find("input, select").each(function() {
                    const name = $(this).attr("name");
                    if (name) {
                        const newName = name.replace(/Details\[\d+\]/, `Details[${index}]`);
                        $(this).attr("name", newName);
                    }
                });
                $(this).attr("data-row-index", index);
            });
            rowCounter = $("#tbodyItems tr").length;
        }

        function addEmptyRow() {
            const tbody = $("#tbodyItems");
            const noDataRow = document.getElementById("noDataRow");
            if (noDataRow) noDataRow.remove();
            const currentIndex = getNextRowIndex();
            const row = `
                <tr data-row-index="${currentIndex}">
                    <td>
                        <input type="text"
                               name="Details[${currentIndex}].BillTiNo"
                               class="form-control form-control-sm billti-no" />
                    </td>
                    <td>
                        <input type="text"
                               name="Details[${currentIndex}].Fooder"
                               class="form-control form-control-sm fooder" />
                    </td>
                    <td>
                        <input type="text"
                               name="Details[${currentIndex}].CusName"
                               class="form-control form-control-sm cus-name" />
                    </td>
                    <td>
                        <input type="text"
                               name="Details[${currentIndex}].SendTo"
                               class="form-control form-control-sm send-to" />
                    </td>
                    <td>
                        <input type="number"
                               name="Details[${currentIndex}].BillTiAmt"
                               class="form-control form-control-sm biltyamt text-end"
                               step="any" value="0" />
                    </td>
                    <td>
                        <input type="number"
                               name="Details[${currentIndex}].PaidAmt"
                               class="form-control form-control-sm paidamt text-end"
                               step="any" value="0" />
                    </td>
                    <td>
                        <input type="number"
                               name="Details[${currentIndex}].ToPaidAmt"
                               class="form-control form-control-sm topaidamt text-end"
                               step="any" value="0" />
                    </td>
                    <td>
                        <input type="number"
                               name="Details[${currentIndex}].DeliveryAmt"
                               class="form-control form-control-sm deliveryamt text-end"
                               step="any" value="0" />
                    </td>
                    <td>
                        <input type="number"
                               name="Details[${currentIndex}].LocalAmt"
                               class="form-control form-control-sm localamt text-end"
                               step="any" value="0" />
                    </td>
                    <td>
                        <input type="number"
                               name="Details[${currentIndex}].NetAmt"
                               class="form-control form-control-sm netamt text-end"
                               step="any" value="0" />
                    </td>
                    <td class="text-center">
                        <input type="hidden" name="Details[${currentIndex}].DCNo" class="dc-no" value="" />
                        <input type="hidden" name="Details[${currentIndex}].ChallanId" class="challan-id" value="" />
                        <input type="hidden" name="Details[${currentIndex}].FooderCode" value="" />
                        <input type="hidden" name="Details[${currentIndex}].PartyEx" value="0" />
                        <input type="hidden" name="Details[${currentIndex}].Lifter2" value="0" />
                        <input type="hidden" name="Details[${currentIndex}].OtherEx" value="0" />
                        <div class="d-flex justify-content-center gap-1">
                            <button type="button" class="btn btn-info btn-sm text-white" title="View Challan in Edit mode" onclick="viewChallan(this)">
                                <i class="fa fa-eye"></i>
                            </button>
                            <button type="button" class="btn btn-danger btn-sm" onclick="removeRow(this)">
                                <i class="fa fa-trash"></i>
                            </button>
                        </div>
                    </td>
                </tr>
            `;

            tbody.append(row);
            calculateTotals();
        }

        var initialModalTableHtml = '';
        var challanSearchTimer = null;

        function syncModalSelectedChallans() {
            var hasActiveSearch = false;
            $('.col-search').each(function () {
                if (($(this).val() || '').trim() !== '') {
                    hasActiveSearch = true;
                }
            });

            var selectedChallanIds = [];
            var selectedDocNos = [];
            var selectedChalNos = [];

            $("#tbodyItems tr").not("#noDataRow").each(function () {
                var cid = ($(this).find(".challan-id").val() || "").toString().trim();
                var dno = ($(this).find(".dc-no").val() || "").toString().trim().toLowerCase();
                var cno = ($(this).find(".billti-no").val() || "").toString().trim().toLowerCase();
                if (cid && cid !== "0") selectedChallanIds.push(cid);
                if (dno) selectedDocNos.push(dno);
                if (cno) selectedChalNos.push(cno);
            });

            $("#biltyModalTable tbody tr").each(function () {
                var $tr = $(this);
                if ($tr.attr('id') === 'noChallanMatchRow' || $tr.attr('id') === 'searchingRow') return;
                var $chk = $tr.find(".bilty-check");
                if (!$chk.length) return;

                var cid = ($chk.data("id") || "").toString().trim();
                var dno = ($chk.data("docno") || "").toString().trim().toLowerCase();
                var cno = ($chk.data("chalno") || "").toString().trim().toLowerCase();
                var isAssignedDb = ($chk.data("isassigned") === true || $chk.data("isassigned") === "true");

                var isAlreadyInCurrentGrid = 
                    (cid && cid !== "0" && selectedChallanIds.indexOf(cid) !== -1) ||
                    (dno && dno !== "" && selectedDocNos.indexOf(dno) !== -1) ||
                    (cno && cno !== "" && selectedChalNos.indexOf(cno) !== -1);

                if (hasActiveSearch) {
                    // Actively searching: Always show matching row, mark as Selected if already added
                    $tr.removeClass("already-in-grid").show();
                    if (isAlreadyInCurrentGrid || isAssignedDb) {
                        $chk.prop("disabled", true).prop("checked", true);
                        $tr.addClass("table-light text-muted");
                        if ($tr.find(".inchallan-badge").length === 0) {
                            var label = isAlreadyInCurrentGrid ? '(Current CommBook)' : '(Assigned)';
                            $tr.find("td:eq(1)").append(`<span class="badge bg-secondary ms-1 inchallan-badge" title="Already Selected"><i class="fa fa-check me-1"></i>Selected ${label}</span>`);
                        }
                    } else {
                        $chk.prop("disabled", false).prop("checked", false);
                        $tr.removeClass("table-light text-muted");
                        $tr.find(".inchallan-badge").remove();
                    }
                } else {
                    // Default state (no search text): Hide challans already added to current grid
                    if (isAlreadyInCurrentGrid) {
                        $chk.prop("checked", false).prop("disabled", false);
                        $tr.addClass("already-in-grid").hide();
                        $tr.find(".inchallan-badge").remove();
                    } else {
                        $chk.prop("checked", false).prop("disabled", false);
                        $tr.removeClass("already-in-grid table-light text-muted").show();
                        $tr.find(".inchallan-badge").remove();
                    }
                }
            });
        }

        // Apply filters: per-column client-side search
        function applyChallanFilters() {
            var searches = {};
            $('.col-search').each(function () {
                var col = $(this).data('col');
                var val = ($(this).val() || '').toLowerCase().trim();
                if (val) searches[col] = val;
            });

            var hasActiveSearch = Object.keys(searches).length > 0;
            var visibleCount = 0;

            $("#biltyModalTable tbody tr").each(function () {
                var $tr = $(this);
                if ($tr.attr('id') === 'noChallanMatchRow' || $tr.attr('id') === 'searchingRow') return;

                // When no active search, hide challans already in current grid
                if (!hasActiveSearch && $tr.hasClass("already-in-grid")) {
                    $tr.hide();
                    return;
                }

                var searchMatches = true;
                for (var col in searches) {
                    var sVal = searches[col];
                    if (!sVal) continue;

                    var $td = $tr.find('td').eq(col);
                    var cellText = $td.text().replace(/\s+/g, ' ').toLowerCase().trim();

                    var colIdx = parseInt(col);

                    if (colIdx === 2) {
                        var dMatch = cellText.indexOf(sVal) !== -1;
                        if (!dMatch && sVal.indexOf('-') !== -1) {
                            var dParts = sVal.split('-');
                            if (dParts.length === 3) {
                                var formattedD = dParts[2] + '/' + dParts[1] + '/' + dParts[0];
                                if (cellText.indexOf(formattedD) !== -1) dMatch = true;
                            }
                        }
                        if (!dMatch) {
                            searchMatches = false;
                            break;
                        }
                        continue;
                    }

                    // Col 1: Chal No - EXACT NUMERIC MATCH
                    if (colIdx === 1) {
                        var cleanCell = cellText.split(' ')[0].trim();
                        var sNum = parseFloat(sVal);
                        var cNum = parseFloat(cleanCell);
                        var matchChal = false;
                        if (!isNaN(sNum) && !isNaN(cNum)) {
                            matchChal = (cNum === sNum);
                        } else {
                            matchChal = (cleanCell === sVal);
                        }
                        if (!matchChal) {
                            searchMatches = false;
                            break;
                        }
                        continue;
                    }

                    // Col 7 to 12 (Amounts) - EXACT NUMERIC MATCH
                    if (colIdx >= 7 && colIdx <= 12) {
                        var sNum = parseFloat(sVal);
                        var cNum = parseFloat(cellText.replace(/,/g, ''));
                        var matchAmt = false;
                        if (!isNaN(sNum) && !isNaN(cNum)) {
                            matchAmt = (cNum === sNum);
                        } else {
                            matchAmt = (cellText === sVal);
                        }
                        if (!matchAmt) {
                            searchMatches = false;
                            break;
                        }
                        continue;
                    }

                    // Col 3 (Vehicle), Col 4 (Transporter), Col 5 (Driver), Col 6 (Station): exact or starts with (from first letter or word start)
                    var matchText = (cellText === sVal) || (cellText.indexOf(sVal) === 0) || cellText.split(' ').some(function(w) { return w.indexOf(sVal) === 0; });
                    if (!matchText) {
                        searchMatches = false;
                        break;
                    }
                }

                if (searchMatches) {
                    $tr.show();
                    visibleCount++;
                } else {
                    $tr.hide();
                }
            });

            $('#noChallanMatchRow').remove();
            if (visibleCount === 0) {
                $("#biltyModalTable tbody").append(`
                    <tr id="noChallanMatchRow">
                        <td colspan="13" class="text-center text-muted py-3">
                            <i class="fa fa-info-circle me-1 text-warning"></i> No challans found matching the search criteria.
                        </td>
                    </tr>
                `);
            }

            if (hasActiveSearch) {
                $('#biltyMatchCount').text(visibleCount + ' matching challans');
            } else {
                $('#biltyMatchCount').text('');
            }
        }

        function handleChallanSearch() {
            clearTimeout(challanSearchTimer);
            challanSearchTimer = setTimeout(function () {
                var chalNo = $('.col-search[data-col="1"]').val() || '';
                var docDate = $('.col-search[data-col="2"]').val() || '';
                var vehicleNo = $('.col-search[data-col="3"]').val() || '';
                var transporter = $('.col-search[data-col="4"]').val() || '';
                var driver = $('.col-search[data-col="5"]').val() || '';
                var station = $('.col-search[data-col="6"]').val() || '';
                var paid = $('.col-search[data-col="7"]').val() || '';
                var toPaid = $('.col-search[data-col="8"]').val() || '';
                var billti = $('.col-search[data-col="9"]').val() || '';
                var delivery = $('.col-search[data-col="10"]').val() || '';
                var localAmt = $('.col-search[data-col="11"]').val() || '';
                var netAmt = $('.col-search[data-col="12"]').val() || '';

                var hasSearch = (chalNo.trim() !== '') || (docDate.trim() !== '') || (vehicleNo.trim() !== '') ||
                                (transporter.trim() !== '') || (driver.trim() !== '') || (station.trim() !== '') ||
                                (paid.trim() !== '') || (toPaid.trim() !== '') || (billti.trim() !== '') ||
                                (delivery.trim() !== '') || (localAmt.trim() !== '') || (netAmt.trim() !== '');

                if (hasSearch) {
                    performServerChallanSearch({
                        chalNo: chalNo,
                        docDate: docDate,
                        vehicleNo: vehicleNo,
                        transporter: transporter,
                        driver: driver,
                        station: station,
                        paid: paid,
                        toPaid: toPaid,
                        billti: billti,
                        delivery: delivery,
                        localAmt: localAmt,
                        netAmt: netAmt
                    });
                } else {
                    if (initialModalTableHtml) {
                        $("#biltyModalTable tbody").html(initialModalTableHtml);
                    }
                    syncModalSelectedChallans();
                    applyChallanFilters();
                }
            }, 350);
        }

        function performServerChallanSearch(params) {
            $("#noChallanMatchRow").remove();
            $("#biltyModalTable tbody").html(`
                <tr id="searchingRow">
                    <td colspan="13" class="text-center text-primary py-3">
                        <i class="fa fa-spinner fa-spin me-2"></i> Searching challans in database...
                    </td>
                </tr>
            `);

            $.get('/CommBook/SearchChallans', params, function (res) {
                $("#searchingRow").remove();
                if (res && res.success && res.data && res.data.length > 0) {
                    var selectedChallanIds = [];
                    var selectedDocNos = [];
                    var selectedChalNos = [];

                    $("#tbodyItems tr").not("#noDataRow").each(function () {
                        var cid = ($(this).find(".challan-id").val() || "").toString().trim();
                        var dno = ($(this).find(".dc-no").val() || "").toString().trim().toLowerCase();
                        var cno = ($(this).find(".billti-no").val() || "").toString().trim().toLowerCase();
                        if (cid && cid !== "0") selectedChallanIds.push(cid);
                        if (dno) selectedDocNos.push(dno);
                        if (cno) selectedChalNos.push(cno);
                    });

                    var rowsHtml = '';
                    res.data.forEach(function (c) {
                        var cid = (c.id || "").toString().trim();
                        var dno = (c.docNo || "").toString().trim().toLowerCase();
                        var cno = (c.chalNo || "").toString().trim().toLowerCase();
                        var isAlreadyInGrid = (cid && cid !== "0" && selectedChallanIds.indexOf(cid) !== -1) ||
                                              (dno && dno !== "" && selectedDocNos.indexOf(dno) !== -1) ||
                                              (cno && cno !== "" && selectedChalNos.indexOf(cno) !== -1);
                        var isAssigned = c.isInCommBook || isAlreadyInGrid;
                        var displayNo = (c.chalNo !== null && c.chalNo !== undefined && c.chalNo !== '') ? c.chalNo : '';
                        var isMuted = isAssigned;

                        rowsHtml += `
                            <tr data-id="${c.id}" data-docno="${escapeHtml(c.docNo)}" data-chalno="${escapeHtml(displayNo)}" class="${isMuted ? 'table-light text-muted' : ''}">
                                <td class="text-center p-1">
                                    <input type="checkbox"
                                           class="bilty-check form-check-input mt-0"
                                           ${isMuted ? 'checked disabled' : ''}
                                           data-id="${c.id}"
                                           data-docno="${escapeHtml(c.docNo)}"
                                           data-chalno="${escapeHtml(displayNo)}"
                                           data-vehicleno="${escapeHtml(c.vehicleNo)}"
                                           data-transporter="${escapeHtml(c.transporter)}"
                                           data-driver="${escapeHtml(c.driver)}"
                                           data-stationcode="${escapeHtml(c.stationCode)}"
                                           data-station="${escapeHtml(c.station)}"
                                           data-totpaid="${c.totPaid || 0}"
                                           data-tottopaid="${c.totToPaid || 0}"
                                           data-totbillti="${c.totBillTi || 0}"
                                           data-deliveryamt="${c.deliveryAmt || 0}"
                                           data-localamt="${c.localAmt || 0}"
                                           data-netamt="${c.netAmt || 0}"
                                           data-totpartyex="${c.totPartyEx || 0}"
                                           data-totlifter2="${c.totLifter2 || 0}"
                                           data-tototherex="${c.totOtherEx || 0}"
                                           data-isassigned="${isAssigned ? 'true' : 'false'}" />
                                </td>
                                <td class="p-1 fw-semibold text-primary">
                                    ${escapeHtml(displayNo)}
                                    ${isAssigned ? `<span class="badge bg-secondary ms-1 inchallan-badge" title="Already Selected"><i class="fa fa-check me-1"></i>Selected</span>` : ''}
                                </td>
                                <td class="p-1 text-nowrap">${escapeHtml(c.docDate)}</td>
                                <td class="p-1 text-nowrap">${escapeHtml(c.vehicleNo)}</td>
                                <td class="p-1 text-truncate" style="max-width: 150px;" title="${escapeHtml(c.transporter)}">${escapeHtml(c.transporter)}</td>
                                <td class="p-1 text-truncate" style="max-width: 150px;" title="${escapeHtml(c.driver)}">${escapeHtml(c.driver)}</td>
                                <td class="p-1 text-truncate" style="max-width: 120px;" title="${escapeHtml(c.station)}">${escapeHtml(c.station)}</td>
                                <td class="p-1 text-end">${parseFloat(c.totPaid || 0).toFixed(2)}</td>
                                <td class="p-1 text-end">${parseFloat(c.totToPaid || 0).toFixed(2)}</td>
                                <td class="p-1 text-end">${parseFloat(c.totBillTi || 0).toFixed(2)}</td>
                                <td class="p-1 text-end">${parseFloat(c.deliveryAmt || 0).toFixed(2)}</td>
                                <td class="p-1 text-end">${parseFloat(c.localAmt || 0).toFixed(2)}</td>
                                <td class="p-1 text-end fw-semibold">${parseFloat(c.netAmt || 0).toFixed(2)}</td>
                            </tr>
                        `;
                    });

                    $("#biltyModalTable tbody").html(rowsHtml);
                    syncModalSelectedChallans();
                    applyChallanFilters();
                    $('#biltyMatchCount').text(res.data.length + ' matching challans');
                } else {
                    $("#biltyModalTable tbody").html(`
                        <tr id="noChallanMatchRow">
                            <td colspan="13" class="text-center text-muted py-3">
                                <i class="fa fa-info-circle me-1 text-warning"></i> No challans found matching the search criteria.
                            </td>
                        </tr>
                    `);
                    $('#biltyMatchCount').text('0 matching challans');
                }
            }).fail(function () {
                $("#searchingRow").remove();
                if (initialModalTableHtml) {
                    $("#biltyModalTable tbody").html(initialModalTableHtml);
                }
                syncModalSelectedChallans();
                applyChallanFilters();
            });
        }

        function clearChallanFilters() {
            $('.col-search').val('');
            if (initialModalTableHtml) {
                $("#biltyModalTable tbody").html(initialModalTableHtml);
            }
            syncModalSelectedChallans();
            applyChallanFilters();
        }

        function removeRow(btn) {
            $(btn).closest("tr").remove();
            reindexRows();
            calculateTotals();
            syncModalSelectedChallans();
            applyChallanFilters();

            if ($("#tbodyItems tr").length === 0) {
                showNoDataMessage();
                rowCounter = 0;
                sumBillTiAmt = sumPaidAmt = sumToPaidAmt = sumDeliveryAmt = sumLocalAmt = sumNetAmt = 0;
                updateSummaryDisplay();
            }
        }

        function showNoDataMessage() {
            const tbody = $("#tbodyItems");
            tbody.html(`
                <tr id="noDataRow">
                    <td colspan="11" class="text-center text-muted py-3">
                        No Records Added
                    </td>
                </tr>
            `);
        }

        function selectAllBilties() {
            $(".bilty-check:visible:not(:disabled)").prop("checked", true);
        }

        function deselectAllBilties() {
            $(".bilty-check:visible:not(:disabled)").prop("checked", false);
        }

        function addSelectedBilties() {
            const noDataRow = document.getElementById("noDataRow");
            if (noDataRow) noDataRow.remove();

            const tbody = $("#tbodyItems");
            let hasSelected = false;
            let selectedCount = 0;

            $(".bilty-check:checked:not(:disabled)").each(function () {
                hasSelected = true;
                const currentIndex = getNextRowIndex();
                const $checkbox = $(this);

                const challanId = $checkbox.data("id") || "";
                const chalno = $checkbox.data("chalno") || "";
                const transporter = $checkbox.data("transporter") || "";
                const driver = $checkbox.data("driver") || "";
                const station = $checkbox.data("station") || "";
                const stationCode = $checkbox.data("stationcode") || "";
                const docNo = $checkbox.data("docno") || "";

                const totBillti = parseFloat($checkbox.data("totbillti")) || 0;
                const totPaid = parseFloat($checkbox.data("totpaid")) || 0;
                const netAmt = parseFloat($checkbox.data("netamt")) || 0;
                const deliveryAmt = parseFloat($checkbox.data("deliveryamt")) || 0;
                const localAmt = parseFloat($checkbox.data("localamt")) || 0;
                const totToPaid = parseFloat($checkbox.data("tottopaid")) || 0;
                const totPartyEx = parseFloat($checkbox.data("totpartyex")) || 0;
                const totLifter2 = parseFloat($checkbox.data("totlifter2")) || 0;
                const totOtherEx = parseFloat($checkbox.data("tototherex")) || 0;

                const row = `
                    <tr data-row-index="${currentIndex}">
                        <td>
                            <input type="text"
                                   name="Details[${currentIndex}].BillTiNo"
                                   value="${escapeHtml(chalno)}"
                                   class="form-control form-control-sm billti-no"
                                   readonly />
                        </td>
                        <td>
                            <input type="text"
                                   name="Details[${currentIndex}].Fooder"
                                   value="${escapeHtml(station)}"
                                   class="form-control form-control-sm fooder"
                                   readonly />
                        </td>
                        <td>
                            <input type="text"
                                   name="Details[${currentIndex}].CusName"
                                   value="${escapeHtml(transporter)}"
                                   class="form-control form-control-sm cus-name" />
                        </td>
                        <td>
                            <input type="text"
                                   name="Details[${currentIndex}].SendTo"
                                   value="${escapeHtml(driver)}"
                                   class="form-control form-control-sm send-to"
                                   readonly />
                        </td>
                        <td>
                            <input type="number"
                                   name="Details[${currentIndex}].BillTiAmt"
                                   value="${totBillti.toFixed(2)}"
                                   class="form-control form-control-sm biltyamt text-end"
                                   step="any" readonly />
                        </td>
                        <td>
                            <input type="number"
                                   name="Details[${currentIndex}].PaidAmt"
                                   value="${totPaid.toFixed(2)}"
                                   class="form-control form-control-sm paidamt text-end"
                                   step="any" readonly />
                        </td>
                        <td>
                            <input type="number"
                                   name="Details[${currentIndex}].ToPaidAmt"
                                   value="${totToPaid.toFixed(2)}"
                                   class="form-control form-control-sm topaidamt text-end"
                                   step="any" readonly />
                        </td>
                        <td>
                            <input type="number"
                                   name="Details[${currentIndex}].DeliveryAmt"
                                   value="${deliveryAmt.toFixed(2)}"
                                   class="form-control form-control-sm deliveryamt text-end"
                                   step="any" readonly />
                        </td>
                        <td>
                            <input type="number"
                                   name="Details[${currentIndex}].LocalAmt"
                                   value="${localAmt.toFixed(2)}"
                                   class="form-control form-control-sm localamt text-end"
                                   step="any" readonly />
                        </td>
                        <td>
                            <input type="number"
                                   name="Details[${currentIndex}].NetAmt"
                                   value="${netAmt.toFixed(2)}"
                                   class="form-control form-control-sm netamt text-end"
                                   step="any" readonly />
                        </td>
                        <td class="text-center">
                            <input type="hidden" name="Details[${currentIndex}].DCNo" class="dc-no" value="${escapeHtml(docNo)}" />
                            <input type="hidden" name="Details[${currentIndex}].ChallanId" class="challan-id" value="${challanId}" />
                            <input type="hidden" name="Details[${currentIndex}].FooderCode" value="${escapeHtml(stationCode)}" />
                            <input type="hidden" name="Details[${currentIndex}].PartyEx" value="${totPartyEx.toFixed(2)}" />
                            <input type="hidden" name="Details[${currentIndex}].Lifter2" value="${totLifter2.toFixed(2)}" />
                            <input type="hidden" name="Details[${currentIndex}].OtherEx" value="${totOtherEx.toFixed(2)}" />
                            <div class="d-flex justify-content-center gap-1">
                                <button type="button" class="btn btn-info btn-sm text-white" title="View Challan in Edit mode" onclick="viewChallan(this)">
                                    <i class="fa fa-eye"></i>
                                </button>
                                <button type="button" class="btn btn-danger btn-sm" onclick="removeRow(this)">
                                    <i class="fa fa-trash"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                `;

                tbody.append(row);
                selectedCount++;
            });

            if (!hasSelected) {
                alert("Please select at least one challan.");
                return;
            }

            $(".bilty-check").prop("checked", false);

            const modalEl = document.getElementById('biltyModal');
            if (modalEl) {
                const modal = bootstrap.Modal.getInstance(modalEl) || new bootstrap.Modal(modalEl);
                if (modal) modal.hide();
            }

            reindexRows();
            calculateTotals();
            syncModalSelectedChallans();
            applyChallanFilters();
        }

        function escapeHtml(str) {
            if (!str) return "";
            return str.toString()
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#39;');
        }

        // View Challan function - Opens Challan Edit in a new tab
        function viewChallan(btn) {
            var $tr = $(btn).closest('tr');
            var challanId = $tr.find('.challan-id').val();
            var docNo = $tr.find('.dc-no').val() || $tr.find('input[name*="DCNo"]').val();
            var chalNo = $tr.find('.billti-no').val() || $tr.find('input[name*="BillTiNo"]').val();
            var station = $tr.find('.fooder').val() || $tr.find('input[name*="Fooder"]').val();
            var stationCode = $tr.find('input[name*="FooderCode"]').val();
            var transporter = $tr.find('.cus-name').val() || $tr.find('input[name*="CusName"]').val();
            var driver = $tr.find('.send-to').val() || $tr.find('input[name*="SendTo"]').val();
            var netAmt = $tr.find('.netamt').val() || $tr.find('input[name*="NetAmt"]').val();
            var billTiAmt = $tr.find('.biltyamt').val() || $tr.find('input[name*="BillTiAmt"]').val();
            var paidAmt = $tr.find('.paidamt').val() || $tr.find('input[name*="PaidAmt"]').val();
            var toPaidAmt = $tr.find('.topaidamt').val() || $tr.find('input[name*="ToPaidAmt"]').val();
            var deliveryAmt = $tr.find('.deliveryamt').val() || $tr.find('input[name*="DeliveryAmt"]').val();
            var localAmt = $tr.find('.localamt').val() || $tr.find('input[name*="LocalAmt"]').val();
            var commBookId = $('#Head_Id').val() || $('input[name="Head.Id"]').val() || '';

            if (challanId && parseInt(challanId) > 0) {
                window.open('/Challan/Edit/' + challanId, '_blank');
                return;
            }

            if (docNo || chalNo) {
                var params = {
                    docNo: docNo,
                    chalNo: chalNo,
                    station: station,
                    stationCode: stationCode,
                    transporter: transporter,
                    driver: driver,
                    netAmt: netAmt,
                    billTiAmt: billTiAmt,
                    paidAmt: paidAmt,
                    toPaidAmt: toPaidAmt,
                    deliveryAmt: deliveryAmt,
                    localAmt: localAmt,
                    commBookId: commBookId
                };

                $.get('/Challan/GetChallanId', params, function (res) {
                    if (res && res.success && res.id) {
                        $tr.find('.challan-id').val(res.id);
                        window.open('/Challan/Edit/' + res.id, '_blank');
                    } else {
                        alert(res && res.message ? res.message : 'Challan record not found.');
                    }
                }).fail(function () {
                    $.get('/CommBook/GetChallanId', params, function (res2) {
                        if (res2 && res2.success && res2.id) {
                            $tr.find('.challan-id').val(res2.id);
                            window.open('/Challan/Edit/' + res2.id, '_blank');
                        } else {
                            alert(res2 && res2.message ? res2.message : 'Challan record not found.');
                        }
                    }).fail(function () {
                        alert('Error looking up challan record. Please make sure the app has been reloaded.');
                    });
                });
                return;
            }

            alert('Please enter or select a valid Challan No first.');
        }

        function validateBeforeSubmit() {
            if (($("#tbodyItems tr").length === 0) || ($("#noDataRow").length > 0)) {
                alert("Please add at least one bilty detail before saving.");
                return false;
            }

            let isValid = true;
            $("#tbodyItems tr").each(function() {
                const billtiNo = $(this).find(".billti-no").val();
                if (!billtiNo) {
                    isValid = false;
                    return false;
                }
            });

            if (!isValid) {
                alert("Please fill in Challan No for each row.");
                return false;
            }

            return true;
        }

        $(document).on("input change", ".biltyamt, .paidamt, .topaidamt, .deliveryamt, .localamt, .netamt", function() {
            calculateTotals();
        });

        $(document).on("input change", "#Head_DeliveryAmt, #Head_LocalAmt, #Head_Tax, #Head_Labour, #Head_PartyExAmt, #Head_Lifter2Amt, #Head_OtherExAmt, #Head_AdvanceAmt", function() {
            calculateTotals();
        });

        // ENTER KEY NAVIGATION
        // Highlight active field
        function highlightField(element) {
            $('.form-control, .form-select, .btn').removeClass('active-field');
            $(element).addClass('active-field');
        }

        // Handle Enter key navigation for inputs, selects, textareas and buttons
        $(document).on('keydown', '.form-control, .form-select, textarea, .btn', function(e) {
            if (e.key === 'Enter') {
                e.preventDefault();

                var $el = $(this);

                // Special case: if Tax field, focus Save button
                if ($el.is('#Head_Tax')) {
                    var $save = $('#btnSaveComm');
                    if ($save.length) {
                        $save.focus();
                        highlightField($save);
                    }
                    return;
                }

                // Special case: if Save button is focused and Enter pressed, submit the form
                if ($el.is('#btnSaveComm')) {
                    try {
                        // Trigger native submit so attached submit handlers run
                        $('#CommBookForm').submit();
                    } catch (err) {
                        console.error('Error submitting form via Enter on Save', err);
                    }
                    return;
                }

                // Special case: if Remarks, move focus to Add Challan button (do not auto-add)
                if ($el.is('#Head_Narration')) {
                    var $addBtn = $('#btnAddChallan');
                    if ($addBtn.length) {
                        $addBtn.focus();
                        highlightField($addBtn);
                    }
                    return;
                }

                // If focused element is Add Challan button and Enter pressed, open modal
                if ($el.is('#btnAddChallan')) {
                    var modalEl = document.getElementById('biltyModal');
                    if (modalEl) {
                        var modal = new bootstrap.Modal(modalEl);
                        // ensure we focus first checkbox when modal shows
                        $(modalEl).one('shown.bs.modal', function () {
                            var firstCheckbox = $('.bilty-check:first');
                            if (firstCheckbox.length) firstCheckbox.focus();
                        });
                        modal.show();
                        highlightField($el);
                    }
                    return;
                }

                // If focused element is Add Selected button inside modal and Enter pressed, add selected rows and focus Party Expense
                if ($el.is('#btnAddSelected')) {
                    try {
                        addSelectedBilties();
                    } catch (err) {
                        console.error('Error adding selected bilties via Enter', err);
                    }
                    return;
                }

                // If inside detail tbody, navigate within row first
                if ($el.closest('#tbodyItems').length) {
                    var $row = $el.closest('tr');
                    var $fields = $row.find('input, select, textarea').filter(':visible');
                    var idx = $fields.index(this);

                    if (idx >= 0 && idx < $fields.length - 1) {
                        var $next = $fields.eq(idx + 1);
                        $next.focus();
                        highlightField($next);
                        return;
                    }

                    // Move to first field of next row if exists
                    var $nextRow = $row.next('tr');
                    if ($nextRow.length) {
                        var $first = $nextRow.find('input, select, textarea').filter(':visible').first();
                        if ($first.length) {
                            $first.focus();
                            highlightField($first);
                            return;
                        }
                    }

                    // No next row - focus the Add Challan button (opens modal)
                    var $addBtn = $('[data-bs-target="#biltyModal"]').first();
                    if ($addBtn.length) {
                        $addBtn.focus();
                        highlightField($addBtn);
                    }
                    return;
                }

                // General form navigation via AppNav
                AppNav.moveToNext($el);
            }
        });

        // Also highlight on focus
        $(document).on('focus', '.form-control, .form-select, textarea, .btn', function() {
            highlightField(this);
        });

        // Initialize on document ready
        $(document).ready(function() {
            // Initialize select2 on all select elements
            $('.select2').select2({
                theme: 'bootstrap-5',
                width: '100%'
            });

            @if (Model?.Head?.StationId > 0) {
                <text>$('#Head_StationId').val('@Model.Head.StationId').trigger('change.select2');</text>
            }
            @if (Model?.Head?.TransId > 0) {
                <text>$('#Head_TransId').val('@Model.Head.TransId').trigger('change.select2');</text>
            }
            @if (Model?.Head?.AdvanceId > 0) {
                <text>$('#Head_AdvanceId').val('@Model.Head.AdvanceId').trigger('change.select2');</text>
            }

            // focus first visible input in form
            var $first = $('#CommBookForm').find('input, select, textarea').filter(':visible').not('[type="hidden"]').first();
            if ($first.length) {
                $first.focus();
                highlightField($first);
            }

            // If no existing rows, create one empty row for convenience
            if (rowCounter === 0) addEmptyRow();
            calculateTotals();

            initialModalTableHtml = $("#biltyModalTable tbody").html();

            $(document).on('input change', '.col-search', function () {
                syncModalSelectedChallans();
                applyChallanFilters();
                handleChallanSearch();
            });

            // sync modal on show to hide already added challans
            $('#biltyModal').on('show.bs.modal', function () {
                syncModalSelectedChallans();
                applyChallanFilters();
            });

            $('#biltyModal').on('shown.bs.modal', function () {
                var firstInput = $('.col-search:first');
                if (firstInput.length) firstInput.focus();
            });

            syncModalSelectedChallans();
            applyChallanFilters();

            // Clicking checkbox cell also toggles checkbox for better usability
            $(document).on('click', '#biltyModalTable tbody tr td:first-child', function(e) {
                if (!$(e.target).is('.bilty-check')) {
                    var $chk = $(this).find('.bilty-check');
                    if ($chk.length && !$chk.is(':disabled')) {
                        $chk.prop('checked', !$chk.prop('checked')).trigger('change');
                    }
                }
            });
        });

        $("#CommBookForm").on("submit", function(e) {
            if (!validateBeforeSubmit()) {
                e.preventDefault();
                return false;
            }
        });

        window.addEmptyRow = addEmptyRow;
        window.removeRow = removeRow;
        window.addSelectedBilties = addSelectedBilties;
        window.viewChallan = viewChallan;
        window.validateBeforeSubmit = validateBeforeSubmit;
        window.selectAllBilties = selectAllBilties;
        window.deselectAllBilties = deselectAllBilties;
        window.clearChallanFilters = clearChallanFilters;
        window.applyChallanFilters = applyChallanFilters;
        window.syncModalSelectedChallans = syncModalSelectedChallans;
    </script>
}
