@model IEnumerable<CommHead>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Commission Book";
}
@Html.AntiForgeryToken()
<div class="page-header">
    <div class="row align-items-center">
        <div class="col">
            <h3 class="page-title">@ViewBag.PageTitle</h3>
            <ul class="breadcrumb">
                <li class="breadcrumb-item">
                    <a asp-controller="Home" asp-action="Index">Dashboard</a>
                </li>
                <li class="breadcrumb-item active">Commission Book</li>
            </ul>
        </div>

        <div class="col-auto ms-auto d-flex align-items-center justify-content-end">
            <a id="addCommissionBtn" tabindex="0" asp-controller="CommBook"
                   asp-action="Create"
                   class="btn add-btn">
                <i class="fa fa-plus"></i> Add Commission
            </a>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-12">

        <!-- Card -->
        <div class="card">
            <div class="card-body">

                <div class="table-responsive">
                    <table id="voucherTable"
                           class="table table-striped table-hover table-nowrap" style="width:100%">
                        <thead>
                            <tr>
                                <th>Document No</th>
                                <th>Date</th>
                                <th>Station</th>
                                <th>Transporter</th>
                                <th class="text-end">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                        </tbody>
                    </table>
                </div>

            </div>
        </div>
        <!-- /Card -->

    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

            $('#voucherTable').DataTable({
                "processing": true,
                "serverSide": true,
                "ajax": {
                    "url": "@Url.Action("GetCommBookList", "CommBook")",
                    "type": "POST",
                    "data": function (d) {
                        d.__RequestVerificationToken = token;
                    }
                },
                "columns": [
                    {
                        "data": "docNo",
                        "render": function (data, type, row) {
                            return `<h2 class="table-avatar"><a href="#">${data || ''}</a></h2>`;
                        }
                    },
                    { "data": "docDate" },
                    { "data": "station" },
                    { "data": "transporter" },
                    {
                        "data": "id",
                        "orderable": false,
                        "className": "text-end",
                        "render": function (data, type, row) {
                            return `
                                <div class="d-flex justify-content-end gap-2">
                                    <a href="/CommBook/Edit/${data}" class="btn btn-sm btn-primary">
                                        <i class="fa fa-pencil"></i> Edit
                                    </a>
                                    <button type="button" class="btn btn-sm btn-danger" onclick="confirmDelete(${data})">
                                        <i class="fa fa-trash"></i> Delete
                                    </button>
                                </div>
                            `;
                        }
                    }
                ],
                "order": [[1, "desc"]],
                "paging": true,
                "lengthChange": true,
                "searching": true,
                "ordering": true,
                "info": true,
                "autoWidth": false,
                "responsive": true
            });

            // Focus and highlight Add Commission button on page load (match Bilty Index behavior)
            setTimeout(function() {
                $('#addCommissionBtn').focus();

                $('#addCommissionBtn').css({
                    'box-shadow': '0 0 0 0.2rem rgba(13, 110, 253, 0.5)',
                    'border-color': '#0d6efd',
                    'transition': 'all 0.3s ease'
                });

                setTimeout(function() {
                    $('#addCommissionBtn').css({
                        'box-shadow': '',
                        'border-color': ''
                    });
                }, 3000);
            }, 100);

        });

        function confirmDelete(id) {

            if (!confirm("Are you sure you want to delete Commission Book ?")) {
                return;
            }

            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

            $.ajax({
                url: '/CommBook/Delete',
                type: 'POST',
                data: {
                    id: id,
                    __RequestVerificationToken: token
                },
                success: function (res) {
                    alert(res.message);
                    if (res.success) {
                        $('#voucherTable').DataTable().ajax.reload(null, false);
                    }
                },
                error: function () {
                    alert("Delete failed!");
                }
            });
        }
    </script>
}

<style>
    /* Match Bilty Index: focused Add Commission button style */
    #addCommissionBtn:focus {
        box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.5) !important;
        border-color: #0d6efd !important;
        transform: scale(1.02);
        transition: all 0.3s ease;
    }
    #addCommissionBtn:hover {
        transform: scale(1.05);
        transition: all 0.3s ease;
    }
    #addCommissionBtn {
        transition: all 0.3s ease;
    }
</style>