@model IEnumerable<Company>

<h2>Companies</h2>

<a asp-action="Create" class="btn btn-primary">Add Company</a>

<table class="table">
    <tr>
        <th>Name</th>
        <th>mobile</th>
        <th>Email</th>
        <th>Action</th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Name</td>
            <td>@item.Mobile</td>
            <td>@item.Email</td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
    }
</table>