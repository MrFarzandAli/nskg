@{
    ViewData["Title"] = "Receivable & Payable Report";
    var companyList = ViewBag.CompanyList as IEnumerable<dynamic>;
    var accountList = ViewBag.AccountList as IEnumerable<dynamic>;

    var selectedRcocode = ViewBag.Rcocode as string ?? "01";
    var selectedPac1 = ViewBag.PAC1 as string ?? "";
}

<style>
    .custom-card { border-radius: 10px; }
    .heading-glow { font-weight: 600; }
    .custom-btn { border-radius: 6px; }
    iframe { border-radius: 8px; border: 1px solid #dee2e6; }
</style>

<div class="container-fluid mt-4">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="fw-bold">List of Debit & Credit Balances of Receivable and Payable Group</h3>
    </div>

    <!-- Filter Card / Report Parameters -->
    <div class="card custom-card mb-4 shadow-sm border-0">
        <div class="card-header bg-primary text-white py-3">
            <h5 class="mb-0 fw-semibold">
                <i class="fa fa-sliders me-2 text-primary"></i> Report Parameters
            </h5>
            <small class="text-muted">Enter values for the parameters</small>
        </div>
        <div class="card-body">
            <form id="reportForm" method="get">
                <div class="row g-3 align-items-end">

                    <!-- 1. Rcocode -->
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Rcocode</label>
                        <select class="form-select select2" id="rcocodeSelect" name="rcocode">
                            @if (companyList != null && companyList.Any())
                            {
                                foreach (var comp in companyList)
                                {
                                    if (selectedRcocode == comp.Code || selectedRcocode == comp.Id.ToString())
                                    {
                                        <option value="@comp.Code" selected="selected">@comp.Name</option>
                                    }
                                    else
                                    {
                                        <option value="@comp.Code">@comp.Name</option>
                                    }
                                }
                            }
                            else
                            {
                                <option value="01" selected="selected">01 - Karachi Head Office</option>
                            }
                        </select>
                    </div>

                    <!-- 2. Account (GLChart1 - PAC1) -->
                    <div class="col-md-5">
                        <label class="form-label fw-semibold">Account</label>
                        <select class="form-select select2" id="pac1Select" name="pac1">
                            <option value="">-- ALL ACCOUNTS --</option>
                            @if (accountList != null)
                            {
                                foreach (var acc in accountList)
                                {
                                    if (selectedPac1 == acc.Code)
                                    {
                                        <option value="@acc.Code" selected="selected">@acc.Name</option>
                                    }
                                    else
                                    {
                                        <option value="@acc.Code">@acc.Name</option>
                                    }
                                }
                            }
                        </select>
                    </div>

                    <!-- BUTTON ROW -->
                    <div class="col-md-3 d-flex justify-content-end gap-2">
                        <!-- EXCEL -->
                        <button type="submit"
                                class="btn btn-success btn-sm custom-btn px-3"
                                asp-action="ExportExcel">
                            <i class="fa fa-file-excel-o me-1"></i> Excel
                        </button>

                        <!-- PRINT -->
                        <button type="button"
                                class="btn btn-secondary btn-sm custom-btn px-3"
                                onclick="printReportFrame()">
                            <i class="fa fa-print me-1"></i> Print
                        </button>

                        <!-- ON SCREEN -->
                        <button type="button"
                                class="btn btn-primary btn-sm custom-btn px-3 fw-semibold"
                                onclick="loadOnScreenReport()">
                            <i class="fa fa-desktop me-1"></i> View
                        </button>
                    </div>

                </div>
            </form>
        </div>
    </div>

    <!-- 🔵 ON SCREEN REPORT -->
    <div id="reportCard" class="card shadow-sm mb-4" style="display:none;">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0"><i class="fa fa-file-text-o me-2"></i> Report Preview</h5>
            <button type="button" class="btn btn-light btn-sm fw-bold" onclick="printReportFrame()">
                <i class="fa fa-print me-1"></i> Print
            </button>
        </div>

        <!-- LOADER -->
        <div id="reportLoader" style="display:none; padding:40px; text-align:center;">
            <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;"></div>
            <div class="mt-3 fw-bold text-secondary">Loading Report Data...</div>
        </div>

        <!-- REPORT FRAME -->
        <div class="card-body p-0">
            <iframe id="reportFrame"
                    style="width:100%; height:750px; display:none;"></iframe>
        </div>
    </div>

</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            if ($.fn.select2) {
                $('.select2').select2({
                    width: '100%',
                    allowClear: true
                });
            }

            // On Rcocode change, dynamically reload Accounts from GLChart1
            $('#rcocodeSelect').on('change', function () {
                var rco = $(this).val();
                $.getJSON('/ReceivablePayableReport/GetAccountsByCompany', { rcocode: rco }, function (data) {
                    var $pac1 = $('#pac1Select');
                    $pac1.empty();
                    $pac1.append('<option value="">-- ALL ACCOUNTS --</option>');
                    if (data && data.length > 0) {
                        $.each(data, function (i, item) {
                            $pac1.append($('<option>', {
                                value: item.code,
                                text: item.name
                            }));
                        });
                    }
                    $pac1.trigger('change.select2');
                });
            });

            // Auto load report on first view
            loadOnScreenReport();
        });

        function loadOnScreenReport() {
            var rcocode = $('#rcocodeSelect').val() || '';
            var pac1 = $('#pac1Select').val() || '';

            $('#reportCard').show();
            $('#reportLoader').show();
            $('#reportFrame').hide();

            var url = '/ReceivablePayableReport/OnScreenReport'
                + '?rcocode=' + encodeURIComponent(rcocode)
                + '&pac1=' + encodeURIComponent(pac1);

            $('#reportFrame').off('load');
            $('#reportFrame').attr('src', url);

            $('#reportFrame').on('load', function () {
                $('#reportLoader').hide();
                $('#reportFrame').show();
            });
        }

        function printReportFrame() {
            var frame = document.getElementById('reportFrame');
            if (frame && frame.contentWindow) {
                frame.contentWindow.focus();
                frame.contentWindow.print();
            } else {
                alert("Please view the report first before printing.");
            }
        }
    </script>
}
