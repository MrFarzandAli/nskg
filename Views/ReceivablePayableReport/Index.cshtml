@{
    ViewData["Title"] = "Receivable & Payable Report";
    var companyList = ViewBag.CompanyList as IEnumerable<dynamic>;
    var accountList = ViewBag.AccountList as IEnumerable<dynamic>;
    var financialYears = ViewBag.FinancialYears as IEnumerable<Nskg.Models.FinancialYear>;

    var selectedRcocode = ViewBag.Rcocode as string ?? "";
    var selectedPac1 = ViewBag.PAC1 as string ?? "";
    var selectedFyId = ViewBag.SelectedFyId as int? ?? 4;
}

<style>
    .custom-card { border-radius: 10px; }
    .heading-glow { font-weight: 600; }
    .custom-btn { border-radius: 6px; }
    iframe { border-radius: 8px; border: 1px solid #dee2e6; }
</style>

<div class="container-fluid mt-4">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h3 class="fw-bold mb-0 text-navy">
                <i class="fa fa-users me-2 text-primary"></i> List of Debit & Credit Balances of Receivable & Payable Group
            </h3>
            <small class="text-muted">Generate consolidated customer/vendor balances report</small>
        </div>
    </div>

    <!-- Filter Card / Report Parameters -->
    <div class="card custom-card mb-4 shadow-sm border-0">
        <div class="card-header card-header-brand py-3">
            <h5 class="mb-0 fw-semibold">
                <i class="fa fa-sliders me-2"></i> Report Parameters
            </h5>
            <small class="text-white-50">Filter by Financial Year, Company / Branch, and Account</small>
        </div>
        <div class="card-body report-filter-body">
            <form id="reportForm" method="get">
                <div class="row g-3 align-items-end">

                    <!-- 1. Financial Year -->
                    <div class="col-md-3">
                        <label class="form-label fw-semibold small text-secondary">Financial Year</label>
                        <select class="form-select select2" id="fySelect" name="fyId">
                            @if (financialYears != null)
                            {
                                foreach (var fy in financialYears)
                                {
                                    if (selectedFyId == fy.Id)
                                    {
                                        <option value="@fy.Id" selected="selected">@fy.YearName (@fy.StartDate.ToString("yyyy") - @fy.EndDate.ToString("yyyy")) @(!fy.IsClosed ? "[Active]" : "")</option>
                                    }
                                    else
                                    {
                                        <option value="@fy.Id">@fy.YearName (@fy.StartDate.ToString("yyyy") - @fy.EndDate.ToString("yyyy")) @(!fy.IsClosed ? "[Active]" : "")</option>
                                    }
                                }
                            }
                        </select>
                    </div>

                    <!-- 2. Rcocode (Company) -->
                    <div class="col-md-3">
                        <label class="form-label fw-semibold small text-secondary">Company / Branch</label>
                        <select class="form-select select2" id="rcocodeSelect" name="rcocode">
                            <option value="">-- ALL COMPANIES / BRANCHES --</option>
                            @if (companyList != null && companyList.Any())
                            {
                                foreach (var comp in companyList)
                                {
                                    if (selectedRcocode == comp.Code || selectedRcocode == comp.Id.ToString())
                                    {
                                        <option value="@comp.Code" selected="selected">@comp.Name</option>
                                    }
                                    else
                                    {
                                        <option value="@comp.Code">@comp.Name</option>
                                    }
                                }
                            }
                        </select>
                    </div>

                    <!-- 3. Account (GLChart1 - PAC1) -->
                    <div class="col-md-3">
                        <label class="form-label fw-semibold small text-secondary">Account</label>
                        <select class="form-select select2" id="pac1Select" name="pac1">
                            <option value="">-- ALL ACCOUNTS --</option>
                            @if (accountList != null)
                            {
                                foreach (var acc in accountList)
                                {
                                    if (selectedPac1 == acc.Code)
                                    {
                                        <option value="@acc.Code" selected="selected">@acc.Name</option>
                                    }
                                    else
                                    {
                                        <option value="@acc.Code">@acc.Name</option>
                                    }
                                }
                            }
                        </select>
                    </div>

                    <!-- BUTTON ROW -->
                    <div class="col-md-3 d-flex justify-content-end gap-2">
                        <!-- VIEW REPORT -->
                        <button type="button"
                                class="btn btn-primary btn-sm custom-btn px-3 fw-semibold shadow-sm"
                                onclick="loadOnScreenReport()">
                            <i class="fa fa-desktop me-1"></i> View Report
                        </button>

                        <!-- EXCEL -->
                        <button type="submit"
                                class="btn btn-success btn-sm custom-btn px-3 shadow-sm"
                                asp-action="ExportExcel">
                            <i class="fa fa-file-excel-o me-1"></i> Excel
                        </button>

                        <!-- PRINT -->
                        <button type="button"
                                class="btn btn-secondary btn-sm custom-btn px-3 shadow-sm"
                                onclick="printReportFrame()">
                            <i class="fa fa-print me-1"></i> Print
                        </button>
                    </div>

                </div>
            </form>
        </div>
    </div>

    <!-- ON SCREEN REPORT PREVIEW -->
    <div id="reportCard" class="card shadow-sm mb-4 border-0" style="display:none;">
        <div class="card-header card-header-brand d-flex justify-content-between align-items-center py-2">
            <h5 class="mb-0 fs-6 fw-semibold"><i class="fa fa-file-text-o me-2"></i> Report Preview</h5>
            <div class="d-flex gap-2">
                <button type="button" class="btn btn-light btn-sm fw-semibold" onclick="printReportFrame()">
                    <i class="fa fa-print me-1"></i> Print
                </button>
                <button type="button" class="btn btn-outline-light btn-sm" onclick="$('#reportCard').slideUp(200)">
                    <i class="fa fa-times me-1"></i> Close
                </button>
            </div>
        </div>

        <!-- LOADER -->
        <div id="reportLoader" style="display:none; padding:40px; text-align:center;">
            <div class="spinner-border text-primary" role="status" style="width: 2.5rem; height: 2.5rem;"></div>
            <div class="mt-3 fw-semibold text-muted">Generating report data, please wait...</div>
        </div>

        <!-- REPORT FRAME -->
        <div class="card-body p-0">
            <iframe id="reportFrame"
                    style="width:100%; height:750px; border:none; display:none;"></iframe>
        </div>
    </div>

</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            if ($.fn.select2) {
                $('.select2').select2({
                    width: '100%',
                    allowClear: true
                });
            }

            // On Rcocode change, dynamically reload Accounts from GLChart1
            $('#rcocodeSelect').on('change', function () {
                var rco = $(this).val();
                $.getJSON('/ReceivablePayableReport/GetAccountsByCompany', { rcocode: rco }, function (data) {
                    var $pac1 = $('#pac1Select');
                    $pac1.empty();
                    $pac1.append('<option value="">-- ALL ACCOUNTS --</option>');
                    if (data && data.length > 0) {
                        $.each(data, function (i, item) {
                            $pac1.append($('<option>', {
                                value: item.code,
                                text: item.name
                            }));
                        });
                    }
                    $pac1.trigger('change.select2');
                });
            });
        });

        function loadOnScreenReport() {
            var rcocode = $('#rcocodeSelect').val() || '';
            var pac1 = $('#pac1Select').val() || '';
            var fyId = $('#fySelect').val() || '';

            $('#reportCard').show();
            $('#reportLoader').show();
            $('#reportFrame').hide();

            $('html, body').animate({
                scrollTop: $("#reportCard").offset().top - 20
            }, 300);

            var url = '/ReceivablePayableReport/OnScreenReport'
                + '?rcocode=' + encodeURIComponent(rcocode)
                + '&pac1=' + encodeURIComponent(pac1)
                + '&fyId=' + encodeURIComponent(fyId);

            $('#reportFrame').off('load');
            $('#reportFrame').attr('src', url);

            $('#reportFrame').on('load', function () {
                $('#reportLoader').hide();
                $('#reportFrame').show();
            });
        }

        function printReportFrame() {
            var frame = document.getElementById('reportFrame');
            if (frame && frame.contentWindow && frame.style.display !== 'none') {
                frame.contentWindow.focus();
                frame.contentWindow.print();
            } else {
                alert("Please click 'View Report' first before printing.");
            }
        }
    </script>
}
