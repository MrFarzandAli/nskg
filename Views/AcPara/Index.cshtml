@model List<AcPara>


<h3 class="mb-3">Accounts Parameters</h3>

<button class="btn btn-primary mb-3" onclick="openAdd()">+ Add Account</button>

<table id="tbl" class="table table-striped">
    <thead>
        <tr>
            <th>Code</th>
            <th>Name</th>
            <th>Type</th>
            <th>Parent/Child</th>
            <th>Opening</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Accode</td>
                <td>@item.Acname</td>
                <td>@item.Actype?.ACNAME</td>
                <td>@(item.Parent == "P" ? "Parent" : "Child")</td>
                <td>@item.Opening</td>
                <td>
                    <button class="btn btn-sm btn-warning" onclick="edit('@item.Id')">Edit</button>
                    <button class="btn btn-sm btn-danger"
                            onclick="deleteItem(event,'@item.Id','@item.Acname',this)">
                        Delete
                    </button>
                </td>
            </tr>
        }
    </tbody>
</table>

<!-- Modal -->
<div class="modal fade" id="formModal">
    <div class="modal-dialog">
        <div class="modal-content p-3">

            <input type="hidden" id="mode" />
            <input type="hidden" id="Id" />

            <label>Type</label>
            <select id="Parent" class="form-control mb-2">
                <option value="">Select Type</option>
                <option value="P">Parent</option>
                <option value="C">Child</option>
            </select>

            <label>Select Account</label>
            <select id="Accode" class="form-control mb-2">
                <option value="">Select Account</option>
            </select>

         

            <label>Select Account Type</label>
            <select id="Actype" class="form-control mb-2">
                <option value="">Select Account Type</option>
                @foreach (var item in ViewBag.AccountType)
                {
                    <option value="@item.ACTYPE">@item.ACNAME</option>
                }
            </select>


            <button class="btn btn-success" onclick="save()">Save</button>

        </div>
    </div>
</div>
@section Scripts {
    <script>
        $(document).ready(function () {
        $('#tbl').DataTable();

        $('#Parent').change(function () {
        if ($(this).val() === 'C') {
        $('#parentDiv').show();
        } else {
        $('#parentDiv').hide();
        }
        });
        });

                function openAdd() {
            $('#formModal').modal('show');
            $('#mode').val('add');

            $('#Id').val('');
            $('#Accode').empty().append('<option>Select Account</option>');
        }

               function edit(id) {
            fetch('/AcPara/Get?id=' + id)
                .then(res => res.json())
                .then(data => {

                    $('#mode').val('edit');
                    $('#Id').val(data.id);

                    // 🔥 load dropdown first
                    fetch('/AcPara/GetAccounts?type=' + data.parent)
                        .then(res => res.json())
                        .then(list => {

                            let dropdown = $('#Accode');
                            dropdown.empty();

                            list.forEach(item => {
                               dropdown.append(`<option value="${item.glId}">${item.accode} - ${item.acname}</option>`);
                            });

                            $('#Accode').val(data.glId);
                        });

                    $('#Acname').val(data.acname);
                    $('#Actype').val(data.actype);
                    $('#Parent').val(data.parent);
                    $('#Opening').val(data.opening);

                    $('#formModal').modal('show');
                });
        }
                 function save() {

            let data = {
                Id: parseInt($('#Id').val()) || 0,
                ActypeCode: $('#Actype').val(),
                Parent: $('#Parent').val(),
                Opening: parseFloat($('#Opening').val()) || 0,
                GLChart1Id: $('#Parent').val() === 'P' ? parseInt($('#Accode').val()) : null,
                GLChart3Id: $('#Parent').val() === 'C' ? parseInt($('#Accode').val()) : null
            };

            let url = $('#mode').val() === 'edit'
                ? '/AcPara/Edit'
                : '/AcPara/Create';

            fetch(url, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            })
            .then(res => res.json())
            .then(res => {

                if (res.success) {

                    // 🔥 message store karo
                    localStorage.setItem("successMessage", res.message);

                    // 🔥 direct reload
                    location.reload();

                } else {
                    toastr.error(res.message);
                }

            })
            .catch(() => {
                toastr.error("Server error!");
            });
        }
        
                function deleteItem(event, id, name, btn) {

            event.preventDefault();

            let row = $(btn).closest('tr');

            Swal.fire({
                title: 'Are you sure?',
                html: `You want to delete <b>"${name}"</b>?`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Yes, delete it!',
                cancelButtonText: 'Cancel',
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6',
                width: 360,
                showLoaderOnConfirm: true,

                preConfirm: async () => {
                    try {

                        const response = await fetch('/AcPara/Delete?id=' + id, {
                            method: 'POST'
                        });

                        const result = await response.json();

                        if (!response.ok)
                            throw new Error(result.message || "Delete failed");

                        return result;

                    } catch (error) {
                        Swal.showValidationMessage(`Error: ${error}`);
                    }
                },

                allowOutsideClick: () => !Swal.isLoading()

            }).then((result) => {

                if (result.isConfirmed && result.value) {

                    if (result.value.success === false) {

                        Swal.fire({
                            icon: 'error',
                            title: 'Error!',
                            text: result.value.message,
                            timer: 2000,
                            showConfirmButton: false,
                            width: 320
                        });

                    } else {

                        Swal.fire({
                            icon: 'success',
                            title: 'Deleted!',
                            text: 'Account deleted successfully!',
                            timer: 1500,
                            showConfirmButton: false,
                            width: 320
                        });

                        row.remove(); // no reload
                    }
                }
            });
        }

                   $('#Parent').change(function () {

            let type = $(this).val();

            fetch('/AcPara/GetAccounts?type=' + type)
                .then(res => res.json())
                .then(data => {

                    let dropdown = $('#Accode');
                    dropdown.empty();

                    dropdown.append('<option value="">Select Account</option>');

                    data.forEach(item => {
                        dropdown.append(
                            `<option value="${item.glId}">${item.accode} - ${item.acname}</option>`
                        );
                    });

                });
        });
                $('#Accode').change(function () {
            let text = $("#Accode option:selected").text();
            let name = text.split('-')[1];
            $('#Acname').val(name);
        });
    </script>
    <script>
                $(document).ready(function () {

            var msg = localStorage.getItem("successMessage");

            if (msg) {
                toastr.success(msg);

                // ek baar show ho jaye phir delete
                localStorage.removeItem("successMessage");
            }

        });
    </script>
}