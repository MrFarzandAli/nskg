@Html.AntiForgeryToken()
 @using Nskg.Models.ViewModels
@model ChartVM

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Chart of Accounts";
}

<style>

    .account-item {
        cursor: pointer;
        padding: 12px 15px;
        border-radius: 6px;
        transition: 0.2s;
        margin-bottom: 6px;
        background: #fff;
        border: 1px solid #f0f0f0;
    }

        .account-item:hover {
            background: #f8f9ff;
            transform: translateX(2px);
        }

        .account-item.active {
            background: #eef2ff;
            border-left: 5px solid #4f46e5;
            font-weight: 600;
        }

    .card-header {
        background: #fff;
        border-bottom: 1px solid #f0f0f0;
    }

    .section-title {
        font-size: 15px;
        font-weight: 600;
    }

    .toolbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 10px;
    }

</style>

<!-- HEADER -->
<div class="page-header">
    <div class="row align-items-center">
        <div class="col">
            <h3 class="page-title">Chart of Accounts</h3>
            <ul class="breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Dashboard</a></li>
                <li class="breadcrumb-item active">Accounts</li>
            </ul>
        </div>

        <div class="col-auto ms-auto">
            <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#accountModal">
                <i class="fa fa-plus"></i> Account
            </button>

            <button class="btn btn-success" onclick="openDetailModal()">
                <i class="fa fa-plus"></i> Detail
            </button>
                <button id="deleteAccountBtn" class="btn btn-danger ms-2" onclick="deleteAccount()">
                    <i class="fa fa-trash"></i> Delete Account
                </button>
        </div>
    </div>
</div>

<!-- MAIN -->
<div class="row g-3">

    <!-- LEFT -->
    <div class="col-md-4">

        <div class="card shadow-sm">

            <div class="card-header">
                <div class="toolbar">
                    <span class="section-title">Accounts</span>
                </div>

                <input type="text" id="search" class="form-control form-control-sm mt-2"
                       placeholder="Search account..." />
            </div>

            <div class="card-body" style="max-height: 70vh; overflow-y:auto;">

                @foreach (var item in Model.Accounts)
                {
                    <div class="account-item"
                         onclick="loadDetails(@item.Id,'@item.AC1', this)">
                        <div><b>@item.AC1</b></div>
                        <small class="text-muted">@item.Name</small>
                    </div>
                }

        
            </div>
        </div>

    </div>

    <!-- RIGHT -->
    <div class="col-md-8">

        <div class="card shadow-sm">

            <div class="card-header d-flex justify-content-between align-items-center">
                <span class="section-title">Account Details</span>
            </div>

            <div class="card-body">

                <div class="table-responsive">
                    <table class="table table-hover table-striped align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Code</th>
                                <th>Name</th>
                                <th class="text-end">Action</th>
                            </tr>
                        </thead>

                        <tbody id="detailList"></tbody>

                    </table>
                </div>

            </div>

        </div>

    </div>

</div>

<!-- ACCOUNT MODAL -->
<div class="modal fade" id="accountModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <form id="accountForm" class="modal-content shadow-lg border-0">

            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">Add Account</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body p-3">

                <div class="mb-2">
                    <label class="form-label">Account Name</label>
                    <input name="Name" class="form-control" placeholder="Enter account name" required />
                </div>

                <div class="mb-2">
                    <label class="form-label">Category</label>
                    <select name="CType" asp-items="Model.Categories" class="form-select">
                        <option value="">Select Category</option>
                    </select>
                </div>

                <div class="mb-2">
                    <label class="form-label">Account Type</label>
                    <select name="actype" class="form-select">
                        <option value="">Select Type</option>
                        <option value="A">ASSETS</option>
                        <option value="L">LIABILITY</option>
                        <option value="C">CAPITAL</option>
                        <option value="I">INCOME</option>
                        <option value="E">EXPENSE</option>
                    </select>
                </div>

                <div class="form-check mt-3 mb-1">
                    <input class="form-check-input" type="checkbox" name="createInAllCompanies" id="accCreateInAllCompanies" value="true">
                    <label class="form-check-label fw-bold text-primary" for="accCreateInAllCompanies">
                        <i class="fa fa-building me-1"></i> Create in All Companies / Branches
                    </label>
                </div>

            </div>

            <div class="modal-footer">
                <button class="btn btn-primary w-100">
                    Save Account
                </button>
            </div>

        </form>
    </div>
</div>
<!-- DETAIL MODAL -->

<div class="modal fade" id="detailModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <form id="detailForm" class="modal-content shadow-lg border-0">

            <div class="modal-header bg-success text-white">
                <h5 class="modal-title">Add Detail</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body p-3">

                <input type="hidden" name="Id" id="detailId" />
                <input type="hidden" name="GLChart1Id" id="selectedAccountId" />

                <div class="mb-2">
                    <label class="form-label">Detail Name</label>
                    <input id="detailName" name="Name" class="form-control" placeholder="Enter detail name" required />
                </div>

                <div class="form-check mt-3 mb-1" id="detAllCompaniesCheckDiv">
                    <input class="form-check-input" type="checkbox" name="createInAllCompanies" id="detCreateInAllCompanies" value="true">
                    <label class="form-check-label fw-bold text-success" for="detCreateInAllCompanies">
                        <i class="fa fa-building me-1"></i> Create in All Companies / Branches
                    </label>
                </div>

            </div>

            <div class="modal-footer">
                <button type="submit" class="btn btn-success w-100">
                    Save Detail
                </button>
            </div>

        </form>
    </div>
</div>

<!-- LINK MODAL -->
<div class="modal fade" id="linkModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content shadow-lg border-0">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title"><i class="fa fa-link me-2"></i> Link Account Across Companies</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <input type="hidden" id="linkSourceDetailId" />

                <!-- Current Account Info Banner -->
                <div class="alert alert-light border shadow-sm mb-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <span class="text-muted small text-uppercase fw-bold">Active Account:</span>
                            <h5 class="mb-0 fw-bold text-primary mt-1" id="linkSourceAccTitle">-</h5>
                        </div>
                        <div>
                            <span class="badge bg-primary px-3 py-2 fs-6" id="linkSourceCompanyBadge">-</span>
                        </div>
                    </div>
                </div>

                <div class="d-flex align-items-center justify-content-between mb-3">
                    <div>
                        <h6 class="fw-bold mb-0 text-dark"><i class="fa fa-building me-1 text-secondary"></i> Target Companies</h6>
                        <small class="text-muted">Choose 1, 2, or all companies to link. Check the box and select the corresponding account for each company.</small>
                    </div>
                </div>

                <!-- Loader -->
                <div id="linkModalLoader" class="text-center py-4">
                    <div class="spinner-border text-info" role="status"></div>
                    <p class="text-muted mt-2">Loading company accounts...</p>
                </div>

                <!-- Companies List Container -->
                <div id="linkCompaniesList" style="display:none; max-height: 55vh; overflow-y: auto;">
                </div>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-info text-white px-4 fw-bold" onclick="saveAccountLinks()">
                    <i class="fa fa-save me-1"></i> Save Links
                </button>
            </div>
        </div>
    </div>
</div>

<!-- SCRIPT -->
@section Scripts {

    <script>
        let currentAccountId = 0;

        // LOAD DETAILS
        function loadDetails(id, ac1, el) {
            currentAccountId = id;

            $('.account-item').removeClass('active');
            $(el).addClass('active');

            $('#selectedAccountId').val(id);
            $('#selectedAC1').val(ac1);

            $.get('/GLChart/GetDetails?accountId=' + id, function (data) {
                $('#detailList').html(data);
            });
        }

        // ADD ACCOUNT (FIXED)
        // $('#accountForm').submit(function (e) {
        //     e.preventDefault();

        //     $.post('/GLChart/AddAccount', $(this).serialize(), function () {
        //         location.reload();
        //     });
        // });
                $('#accountForm').submit(function (e) {
            e.preventDefault();

            $.post('/GLChart/AddAccount', $(this).serialize(), function (res) {

                if (res.success) {
                    setTimeout(() => location.reload(), 500);
                } else {
                    toastr.error(res.message);
                }

            });
        });

        // OPEN DETAIL MODAL
        function openDetailModal() {

            if (currentAccountId === 0) {
                alert("Select account first");
                return;
            }

            $('#detailForm')[0].reset();
            $('#detailId').val('');
            $('#detAllCompaniesCheckDiv').show();

            $('#detailModal').modal('show');
        }

        // ADD / UPDATE DETAIL (FIXED)
        $('#detailForm').submit(function (e) {
            e.preventDefault();

            let id = $('#detailId').val();
            let url = id ? '/GLChart/UpdateDetail' : '/GLChart/AddDetail';

            $.post(url, $(this).serialize(), function (res) {

                if (res.success) {
                    $('#detailModal').modal('hide');
                    toastr.success(res.message);
                    loadDetails(currentAccountId);
                } else {
                    toastr.error(res.message);
                }

            });
        });

        // EDIT DETAIL (FIXED)
        function editDetail(id) {
            $.get('/GLChart/GetDetail?id=' + id, function (data) {

                $('#detailId').val(data.id);
                $('#selectedAccountId').val(data.glChart1Id);
                $('#detailName').val(data.name);
                $('#detAllCompaniesCheckDiv').hide();

                $('#detailModal').modal('show');
            });
        }

        // DELETE DETAIL
        // function deleteDetail(id) {
        //     if (!confirm("Are you sure?")) return;

        //     $.post('/GLChart/DeleteDetail?id=' + id, function () {
        //         loadDetails(currentAccountId);
        //     });
        // }
        //                 function deleteDetail(id, name) {

        //     Swal.fire({
        //         title: 'Are you sure?',
        //         html: `Delete <b>${name}</b>?`,
        //         icon: 'warning',
        //         showCancelButton: true,
        //         confirmButtonText: 'Yes, delete it!',
        //         confirmButtonColor: '#d33'
        //     }).then((result) => {

        //         if (result.isConfirmed) {

        //             const token = $('input[name="__RequestVerificationToken"]').val();

        //             fetch('/GLChart/DeleteDetail?id=' + id, {
        //                 method: 'DELETE',
        //                 headers: {
        //                     'RequestVerificationToken': token
        //                 }
        //             })
        //             .then(res => res.json())
        //             .then(result => {

        //                 if (result.success) {

        //                     Swal.fire({
        //                         icon: 'success',
        //                         title: 'Deleted!',
        //                         text: result.message,
        //                         timer: 1500,
        //                         showConfirmButton: false
        //                     });

        //                     // reload nahi → live update
        //                     loadDetails(currentAccountId);

        //                 } else {
        //                     toastr.error(result.message);
        //                 }

        //             })
        //             .catch(() => toastr.error("Delete failed"));

        //         }
        //     });
        // }
                function deleteDetail(event, id, itemName, btn) {

            event.preventDefault();

            let deleteUrl = '/GLChart/DeleteDetail?id=' + id;

            // 🔥 current row
            let tableRow = $(btn).closest('tr');

            Swal.fire({
                title: 'Are you sure?',
                html: `You want to delete <b>"${itemName}"</b>?`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Yes, delete it!',
                cancelButtonText: 'Cancel',
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6',
                width: 360,
                showLoaderOnConfirm: true,

                preConfirm: async () => {
                    try {
                        const token = $('input[name="__RequestVerificationToken"]').val();

                        const response = await fetch(deleteUrl, {
                            method: 'DELETE',
                            headers: {
                                'Content-Type': 'application/json',
                                'RequestVerificationToken': token
                            }
                        });

                        const result = await response.json();

                        if (!response.ok)
                            throw new Error(result.message || 'Delete failed');

                        return result;

                    } catch (error) {
                        Swal.showValidationMessage(`Error: ${error.message}`);
                    }
                },

                allowOutsideClick: () => !Swal.isLoading()

            }).then((result) => {

                if (result.isConfirmed && result.value?.success) {

                    Swal.fire({
                        icon: 'success',
                        title: 'Deleted!',
                        text: result.value.message,
                        showConfirmButton: false,
                        timer: 1800,
                        width: 320
                    });

                    // ✅ NO reload → row remove
                    tableRow.remove();

                }
                else if (result.isConfirmed && !result.value?.success) {

                    Swal.fire({
                        icon: 'error',
                        title: 'Error!',
                        text: result.value?.message || 'Delete failed!',
                        showConfirmButton: false,
                        timer: 2000,
                        width: 320
                    });
                }
            });

            return false;
        }
        // SEARCH
                $('#search').on('keyup', function () {

            var value = $(this).val().toLowerCase();

            // ✅ ACCOUNT SEARCH (LEFT SIDE)
            $('.account-item').filter(function () {
                $(this).toggle($(this).text().toLowerCase().includes(value));
            });

            // ✅ DETAIL SEARCH (RIGHT SIDE TABLE)
            $('#detailList tr').filter(function () {
                $(this).toggle($(this).text().toLowerCase().includes(value));
            });

        });


        // DELETE ACCOUNT (Header)
        function deleteAccount() {
            if (currentAccountId === 0) {
                toastr.warning('Select account first');
                return;
            }

            const name = $('.account-item.active small').text() || $('.account-item.active b').text();
            const token = $('input[name="__RequestVerificationToken"]').val();
            const url = '/GLChart/DeleteAccount?id=' + currentAccountId;

            Swal.fire({
                title: 'Are you sure?',
                html: `You want to delete <b>"${name}"</b>?`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Yes, delete it!',
                cancelButtonText: 'Cancel',
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6',
                width: 360,
                showLoaderOnConfirm: true,
                preConfirm: async () => {
                    try {
                        const response = await fetch(url, {
                            method: 'DELETE',
                            headers: {
                                'Content-Type': 'application/json',
                                'RequestVerificationToken': token
                            }
                        });

                        const result = await response.json();
                        if (!response.ok) throw new Error(result.message || 'Delete failed');
                        return result;
                    } catch (err) {
                        Swal.showValidationMessage(`Error: ${err.message}`);
                    }
                },
                allowOutsideClick: () => !Swal.isLoading()
            }).then((result) => {
                if (result.isConfirmed && result.value?.success) {
                    Swal.fire({
                        icon: 'success',
                        title: 'Deleted!',
                        text: result.value.message || 'Account deleted',
                        showConfirmButton: false,
                        timer: 1500,
                        width: 320
                    });

                    // remove from left list and clear details
                    $('.account-item.active').remove();
                    $('#detailList').html('');
                    currentAccountId = 0;
                }
                else if (result.isConfirmed && !result.value?.success) {
                    Swal.fire({
                        icon: 'error',
                        title: 'Error!',
                        text: result.value?.message || 'Delete failed!'
                    });
                }
            });
        }

        // ================= LINK ACCOUNTS ACROSS COMPANIES =================
        let currentLinkingSourceId = 0;

        function openLinkModal(id, name, code) {
            currentLinkingSourceId = id;
            $('#linkSourceDetailId').val(id);
            $('#linkSourceAccTitle').text(code + ' - ' + name);
            $('#linkSourceCompanyBadge').text('Loading...');
            $('#linkModalLoader').show();
            $('#linkCompaniesList').hide().empty();
            $('#linkModal').modal('show');

            $.get('/GLChart/GetAccountLinkingData?detailId=' + id, function (res) {
                $('#linkModalLoader').hide();
                if (!res.success) {
                    toastr.error(res.message || 'Failed to load linking data');
                    return;
                }

                $('#linkSourceCompanyBadge').text(res.source.companyName);

                var html = '';
                if (!res.companies || res.companies.length === 0) {
                    html = '<div class="alert alert-warning py-3 text-center"><i class="fa fa-info-circle me-1"></i> No other active companies found.</div>';
                } else {
                    $.each(res.companies, function (idx, comp) {
                        var isChecked = comp.isLinked ? 'checked' : '';
                        var isLinkedBadge = comp.isLinked 
                            ? '<span class="badge bg-success ms-2"><i class="fa fa-check-circle me-1"></i> Currently Linked</span>' 
                            : '<span class="badge bg-light text-muted border ms-2">Not Linked</span>';

                        html += '<div class="card mb-3 border ' + (comp.isLinked ? 'border-success' : '') + ' shadow-sm">';
                        html += '  <div class="card-header bg-white py-2 d-flex justify-content-between align-items-center">';
                        html += '    <div class="form-check form-switch mb-0">';
                        html += '      <input class="form-check-input comp-link-toggle" type="checkbox" id="toggleComp_' + comp.companyId + '" data-comp-id="' + comp.companyId + '" ' + isChecked + ' onchange="toggleCompanySelect(' + comp.companyId + ')">';
                        html += '      <label class="form-check-label fw-bold ms-2" for="toggleComp_' + comp.companyId + '">';
                        html += '        <i class="fa fa-building text-primary me-1"></i> ' + comp.companyName;
                        html += '      </label>';
                        html += '    </div>';
                        html += '    <div>' + isLinkedBadge + '</div>';
                        html += '  </div>';
                        html += '  <div class="card-body py-2" id="compBody_' + comp.companyId + '" style="' + (comp.isLinked ? '' : 'opacity: 0.5;') + '">';
                        html += '    <label class="form-label small text-muted mb-1">Select Account in ' + comp.companyName + ':</label>';
                        html += '    <select class="form-select form-select-sm comp-acc-select" id="selectComp_' + comp.companyId + '" data-comp-id="' + comp.companyId + '" ' + (comp.isLinked ? '' : 'disabled') + '>';
                        html += '      <option value="">-- Select Matching Account --</option>';

                        $.each(comp.accounts, function (i, acc) {
                            var selected = (acc.id === comp.selectedAccountId || (!comp.selectedAccountId && acc.name.toLowerCase() === res.source.name.toLowerCase())) ? 'selected' : '';
                            html += '<option value="' + acc.id + '" ' + selected + '>' + acc.code + ' - ' + acc.name + '</option>';
                        });

                        html += '    </select>';
                        html += '  </div>';
                        html += '</div>';
                    });
                }

                $('#linkCompaniesList').html(html).show();
            }).fail(function () {
                $('#linkModalLoader').hide();
                toastr.error('Failed to contact server');
            });
        }

        function toggleCompanySelect(compId) {
            var isChecked = $('#toggleComp_' + compId).is(':checked');
            var $select = $('#selectComp_' + compId);
            var $body = $('#compBody_' + compId);

            if (isChecked) {
                $select.prop('disabled', false);
                $body.css('opacity', '1');
            } else {
                $select.prop('disabled', true);
                $body.css('opacity', '0.5');
            }
        }

        function saveAccountLinks() {
            var sourceId = parseInt($('#linkSourceDetailId').val());
            var targetIds = [];

            $('.comp-link-toggle:checked').each(function () {
                var compId = $(this).data('comp-id');
                var val = $('#selectComp_' + compId).val();
                if (val) {
                    targetIds.push(parseInt(val));
                }
            });

            var payload = {
                SourceDetailId: sourceId,
                TargetDetailIds: targetIds
            };

            var token = $('input[name="__RequestVerificationToken"]').val();

            $.ajax({
                url: '/GLChart/SaveAccountLinks',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(payload),
                headers: {
                    'RequestVerificationToken': token
                },
                success: function (res) {
                    if (res.success) {
                        toastr.success(res.message || 'Accounts linked successfully!');
                        $('#linkModal').modal('hide');
                        if (currentAccountId > 0) {
                            var ac1 = $('#selectedAC1').val();
                            loadDetails(currentAccountId, ac1, $('.account-item.active'));
                        }
                    } else {
                        toastr.error(res.message || 'Failed to link accounts');
                    }
                },
                error: function () {
                    toastr.error('Server error occurred while linking accounts.');
                }
            });
        }

    </script>
    <script>
        $(document).ready(function () {
            var msg = '@TempData["SuccessMessage"]';
            if (msg) {
                toastr.success(msg, 'Success');
            }
        });
    </script>

}