        //             .then(res => res.json())
        //             .then(result => {

        //                 if (result.success) {

        //                     Swal.fire({
        //                         icon: 'success',
        //                         title: 'Deleted!',
        //                         text: result.message,
        //                         timer: 1500,
        //                         showConfirmButton: false
        //                     });

        //                     // reload nahi → live update
        //                     loadDetails(currentAccountId);

        //                 } else {
        //                     toastr.error(result.message);
        //                 }

        //             })
        //             .catch(() => toastr.error("Delete failed"));

        //         }
