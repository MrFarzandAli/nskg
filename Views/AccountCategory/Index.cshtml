
@model IEnumerable<AccCat>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Account Categories";
}

<div class="page-header">
    <div class="row align-items-center">
        <div class="col">
            <h3 class="page-title">Account Categories</h3>
            <ul class="breadcrumb">
                <li class="breadcrumb-item">
                    <a asp-controller="Home" asp-action="Index">Dashboard</a>
                </li>
                <li class="breadcrumb-item active">Account Categories</li>
            </ul>
        </div>

        <div class="col-auto float-end ms-auto">
            <a asp-action="Create" class="btn add-btn">
                <i class="fa fa-plus"></i> Add Account Category
            </a>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-12">

        <!-- Card -->
        <div class="card">
            <div class="card-body">

                <div class="table-responsive">
                    <table id="accCatTable" class="table table-striped table-hover table-nowrap">
                        <thead>
                            <tr>
                                <th>Code</th>
                                <th>Category Name</th>
                                <th class="text-end">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.CatCode</td>

                                    <td>
                                        <h2 class="table-avatar">
                                            <a href="#">@item.Category</a>
                                        </h2>
                                    </td>

                                    <td class="text-end">
                                        <div class="d-flex justify-content-end gap-2">

                                            <!-- EDIT -->
                                            <a asp-action="Edit" asp-route-id="@item.Id"
                                                   class="btn btn-sm btn-primary">
                                                <i class="fa fa-pencil"></i> Edit
                                            </a>

                                            <!-- DELETE -->
                                            <button type="button"
                                                    class="btn btn-sm btn-danger"
                                                    onclick="return confirmDelete(event, '@item.Category', '/AccountCategory/Delete/@item.Id')">
                                                <i class="fa fa-trash"></i> Delete
                                            </button>

                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

            </div>
        </div>
        <!-- /Card -->

    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#accCatTable').DataTable({
                "paging": true,
                "lengthChange": true,
                "searching": true,
                "ordering": true,
                "info": true,
                "autoWidth": false,
                "responsive": true
            });
        });
    </script>
}