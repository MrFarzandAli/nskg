@using Nskg.Models.ViewModels
@model BiltyViewModel

<form id="myForm" asp-action="Create" method="post">

    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h3 class="mb-0">
                <i class="fa fa-truck text-primary me-2"></i>
                Bilty Entry
            </h3>
            <small class="text-muted">Create Transport Bilty / Goods Dispatch</small>
        </div>

        <div>
            <button type="button" class="btn btn-outline-primary btn-sm me-2" onclick="addRow()">
                <i class="fa fa-plus"></i> Add Item
            </button>

            <button type="submit" id="btnSave" class="btn btn-success btn-sm">
                <i class="fa fa-save"></i> Save Bilty
            </button>
        </div>
    </div>


    <!-- MASTER SECTION -->
    <div class="card shadow-sm border-0 mb-3">
        <div class="card-body">
            <div class="row g-3">

                <div class="col-md-2">
                    <label>Bilty No</label>
                    <input asp-for="Head.BillTiNo" id="BiltyNo" class="form-control form-control-sm" tabindex="1" />
                </div>

                <div class="col-md-2">
                    <label>Bilty Date</label>
                    <input asp-for="Head.DocDate" id="BiltyDate" type="date" class="form-control form-control-sm" tabindex="2" />
                </div>

                <div class="col-md-2">
                    <label>DC No</label>
                    <input asp-for="Head.DocNo" readonly class="form-control form-control-sm bg-light" />
                </div>

                <div class="col-md-3">
                    <label>Station</label>
                    <select asp-for="Head.StationId" id="Station" class="form-select form-select-sm" tabindex="3"
                            asp-items="@(new SelectList(ViewBag.Stations, "Value", "Text"))">
                    </select>
                </div>

                <div class="col-md-3">
                    <label>Party Name</label>

                    <div class="input-group input-group-sm">
                        <select asp-for="Head.CustomerId"
                                id="CustomerId"
                                class="form-select" tabindex="4"
                                asp-items="@(new SelectList(ViewBag.Customers, "Value", "Text"))">
                        </select>

                        <button type="button"
                                class="btn btn-outline-primary"
                                data-bs-toggle="modal"
                                data-bs-target="#customerModal">
                            <i class="fa fa-plus"></i>
                        </button>
                    </div>
                </div>

                <div class="col-md-3">
                    <label>Send To</label>
                    <input asp-for="Head.SendTo" id="SendTo" class="form-control form-control-sm" tabindex="5" />
                </div>

                <div class="col-md-3">
                    <label>Bill No</label>
                    <input asp-for="Head.BilNo" id="BillNo" class="form-control form-control-sm" tabindex="6" />
                </div>

                <div class="col-md-6">
                    <label>Remarks</label>
                    <input asp-for="Head.Narration" id="Remarks" class="form-control form-control-sm" tabindex="7" />
                </div>

            </div>
        </div>
    </div>


    <!-- DETAIL GRID -->
    <div class="card shadow-sm border-0 mb-3">
        <div class="card-header bg-white">
            <h6 class="mb-0">
                <i class="fa fa-list me-1 text-primary"></i>
                Bilty Items
            </h6>
        </div>

        <div class="card-body p-0">
            <div class="table-responsive">

                <table class="table table-bordered table-hover mb-0" id="tblItems">
                    <thead class="table-light text-center">
                        <tr>
                            <th>Item</th>
                            <th width="120">Qty</th>
                            <th width="120">Weight</th>
                            <th width="80">Action</th>
                        </tr>
                    </thead>

                    <tbody id="tbodyItems">
                        <tr id="noDataRow">
                            <td colspan="4" class="text-center text-muted py-3">
                                No Items Added
                            </td>
                        </tr>
                    </tbody>
                </table>

            </div>
        </div>
    </div>


    <!-- EXPENSE SECTION -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white">
            <h6 class="mb-0">
                <i class="fa fa-money me-1 text-success"></i>
                Expense Details
            </h6>
        </div>

        <div class="card-body">
            <div class="row g-3">

                <div class="col-md-2">
                    <label>Freight</label>
                    <input id="Cartage1" asp-for="Head.Cartage1" class="form-control form-control-sm calc-net" tabindex="100" />
                </div>

                <div class="col-md-2">
                    <label>Labour</label>
                    <input id="Labour" asp-for="Head.Labour" class="form-control form-control-sm calc-net" tabindex="101" />
                </div>

                <div class="col-md-2">
                    <label>T.T</label>
                    <input id="T_T" asp-for="Head.T_T" class="form-control form-control-sm calc-net" tabindex="102" />
                </div>

                <div class="col-md-2">
                    <label>Lifter</label>
                    <input id="Cartage3" asp-for="Head.Cartage3" class="form-control form-control-sm calc-net" tabindex="103" />
                </div>

                <div class="col-md-2">
                    <label>Local Freight</label>
                    <input id="Cartage2" asp-for="Head.Cartage2" class="form-control form-control-sm calc-net" tabindex="104" />
                </div>

                <div class="col-md-2">
                    <label>Party Expense</label>
                    <input id="PartyEx" asp-for="Head.PartyEx" class="form-control form-control-sm calc-net" tabindex="105" />
                </div>

                <div class="col-md-2">
                    <label>Lifter2</label>
                    <input id="Lifter2" asp-for="Head.Lifter2" class="form-control form-control-sm calc-net" tabindex="106" />
                </div>

                <div class="col-md-2">
                    <label>Other</label>
                    <input id="OtherEx" asp-for="Head.OtherEx" class="form-control form-control-sm calc-net" tabindex="107" />
                </div>

                <div class="col-md-3">
                    <label>Net Amount</label>
                    <input asp-for="Head.NetAmt" readonly class="form-control form-control-sm bg-light" />
                </div>

            </div>
        </div>
    </div>

</form>

<div class="modal fade" id="customerModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Add Customer</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">

                <label>Customer Name</label>
                <input type="text" id="CustomerName" class="form-control" />

            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>

                <button type="button" class="btn btn-success" onclick="saveCustomer()">
                    Save
                </button>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Highlight active field
        function highlightField(element) {
            // Remove highlight from all fields and buttons
            $('.form-control, .form-select, .btn').removeClass('active-field');
            // Add highlight to current element
            $(element).addClass('active-field');
        }

        // Focus on Bilty No when page loads
        $(document).ready(function() {
            $('#BiltyNo').focus();
            highlightField('#BiltyNo');
            addRow();
            calculateNetAmount();
        });

        // Handle Enter key navigation
        $(document).on('keydown', '.form-control, .form-select', function(e) {
            if (e.key === 'Enter') {
                e.preventDefault();

                var currentElement = $(this);
                var currentId = currentElement.attr('id');
                var currentTabIndex = parseInt(currentElement.attr('tabindex')) || 0;

                // Check if it's a Qty field
                if (currentElement.hasClass('qty')) {
                    var currentRow = currentElement.closest('tr');
                    var qtyValue = currentElement.val();
                    var weightField = currentRow.find('.qtyperpack');

                    // If Qty is empty or null, go to Freight
                    if (!qtyValue || qtyValue.trim() === '') {
                        $('#Cartage1').focus();
                        highlightField('#Cartage1');
                        return;
                    }

                    // If Qty has value, go to Weight field in same row
                    if (weightField.length) {
                        weightField.focus();
                        highlightField(weightField);
                    }
                    return;
                }

                // Check if it's a Weight field
                if (currentElement.hasClass('qtyperpack')) {
                    var currentRow = currentElement.closest('tr');
                    var qtyField = currentRow.find('.qty');
                    var weightValue = currentElement.val();

                    // If Weight is empty or null, go to Freight
                    if (!weightValue || weightValue.trim() === '') {
                        $('#Cartage1').focus();
                        highlightField('#Cartage1');
                        return;
                    }

                    // If Weight has value, add new row and focus on its Qty
                    addRow();
                    var newRow = $('#tbodyItems tr:last-child');
                    setTimeout(function() {
                        var newQty = newRow.find('.qty');
                        newQty.focus();
                        highlightField(newQty);
                    }, 50);
                    return;
                }

                // Check if it's an expense field (tabindex 100+)
                if (currentTabIndex >= 100) {
                    var nextExpense = $('[tabindex="' + (currentTabIndex + 1) + '"]');
                    if (nextExpense.length) {
                        nextExpense.focus();
                        highlightField(nextExpense);
                    } else {
                        // After last expense, go to Save button
                        $('#btnSave').focus();
                        highlightField('#btnSave');
                    }
                    return;
                }

                // Navigation for master fields (tabindex 1-7)
                var nextTabIndex = currentTabIndex + 1;
                var nextField = $('[tabindex="' + nextTabIndex + '"]');

                if (nextField.length) {
                    nextField.focus();
                    highlightField(nextField);
                } else {
                    // After remarks (tabindex 7), go to first item Qty
                    var firstQty = $('#tbodyItems .qty:first');
                    if (firstQty.length) {
                        firstQty.focus();
                        highlightField(firstQty);
                    }
                }
            }
        });

        // Also highlight on focus
        $(document).on('focus', '.form-control, .form-select', function() {
            highlightField(this);
        });

        function saveCustomer() {
            let name = $("#CustomerName").val();

            if (name.trim() === "") {
                alert("Customer name required");
                return;
            }

            $.ajax({
                url: '/GLChart/CreateAjax',
                type: 'POST',
                data: { name: name },
                success: function (res) {
                    if (res.success) {
                        let newOption = new Option(res.text, res.id, true, true);
                        $('#CustomerId').append(newOption).trigger('change');
                        $("#CustomerName").val("");
                        $("#customerModal").modal('hide');
                    } else {
                        alert(res.message);
                    }
                },
                error: function () {
                    alert("Error saving customer");
                }
            });
        }

        let i = 0;

        function addRow() {
            const noData = document.getElementById("noDataRow");
            if (noData) noData.remove();

            let row = `
            <tr>
                <td>
                    <input name="Details[${i}].IName" value="NOS"
                           class="form-control form-control-sm" readonly />
                </td>

                <td>
                    <input name="Details[${i}].Qty" type="number" step="0.01"
                           class="form-control form-control-sm qty" />
                </td>

                <td>
                    <input name="Details[${i}].QtyPerPack" type="number" step="0.01"
                           class="form-control form-control-sm qtyperpack" />
                </td>

                <td class="text-center">
                    <button type="button" class="btn btn-danger btn-sm"
                            onclick="removeRow(this)">
                        <i class="fa fa-trash"></i>
                    </button>
                </td>
            </tr>`;

            $("#tbodyItems").append(row);
            i++;
        }

        function removeRow(btn) {
            var row = $(btn).closest("tr");
            var isFirstRow = row.is(':first-child');

            row.remove();

            // If it was the first row, focus on the new first row's Qty
            if (isFirstRow) {
                var newFirstQty = $('#tbodyItems .qty:first');
                if (newFirstQty.length) {
                    newFirstQty.focus();
                    highlightField(newFirstQty);
                } else {
                    // No rows left, go to Freight
                    $('#Cartage1').focus();
                    highlightField('#Cartage1');
                }
            }

            if ($("#tbodyItems tr").length === 0) {
                $("#tbodyItems").html(`
                    <tr id="noDataRow">
                        <td colspan="4" class="text-center text-muted py-3">
                            No Items Added
                        </td>
                    </tr>
                `);
            }
        }

        // ✅ NEW NET AMOUNT LOGIC
        function calculateNetAmount() {

            let cartage1 = parseFloat($("#Cartage1").val()) || 0;
            let cartage2 = parseFloat($("#Cartage2").val()) || 0;
            let cartage3 = parseFloat($("#Cartage3").val()) || 0;
            let labour   = parseFloat($("#Labour").val()) || 0;
            let tt       = parseFloat($("#T_T").val()) || 0;

            let netAmt = cartage1 + cartage2 + cartage3 + labour + tt;

            $("#Head_NetAmt").val(netAmt.toFixed(2));
        }

        // realtime update for ALL cost fields
        $(document).on("input", "#Cartage1, #Cartage2, #Cartage3, #Labour, #T_T", function () {
            calculateNetAmount();
        });

        // Ctrl+S to save
        document.addEventListener('keydown', function (e) {
            if (e.ctrlKey && e.key.toLowerCase() === 's') {
                e.preventDefault();
                document.getElementById('btnSave').click();
            }
        });
    </script>
}

<style>
    /* Highlight style for form controls */
    .active-field {
        border: 2px solid #0d6efd !important;
        box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.25) !important;
        background-color: #f0f7ff !important;
        transition: all 0.2s ease;
    }

    /* Highlight style for buttons (Save button) */
    .btn.active-field {
        border: 2px solid #0d6efd !important;
        box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.3) !important;
        transform: scale(1.02);
        transition: all 0.2s ease;
    }

    /* Specific style for success buttons */
    .btn-success.active-field {
        border: 2px solid #0d6efd !important;
        box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.3) !important;
        background-color: #157347 !important;
        transform: scale(1.02);
    }

    .form-control:focus, .form-select:focus {
        border-color: #86b7fe;
        box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.25);
    }

    /* Smooth transitions */
    .form-control, .form-select, .btn {
        transition: all 0.2s ease;
    }
</style>