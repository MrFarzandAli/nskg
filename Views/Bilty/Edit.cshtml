@using Nskg.Models.ViewModels
@model BiltyViewModel

<form method="post" id="myForm">

    <input type="hidden" asp-for="Head.Id" />

    <input type="hidden" asp-for="Head.DocNo" />
    <!-- HEADER -->
    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-2">
        <div class="d-flex align-items-center gap-3">
            <div>
                <h4 class="mb-0 fw-bold text-navy">
                    <i class="fa fa-pencil-square-o text-primary me-2"></i>
                    Edit Paid Bilty
                </h4>
                <small class="text-muted" style="font-size: 11px;"><i class="fa fa-info-circle me-1"></i> Update Paid Bilty</small>
            </div>
            <span class="badge bg-primary fs-7 px-3 py-1 shadow-sm"><i class="fa fa-file-text me-1"></i>DC No: @Model.Head.DocNo</span>
        </div>

        <div class="d-flex flex-wrap align-items-center gap-1">
            @if (ViewBag.PrevId != null)
            {
                <a href="@Url.Action("Edit", new { id = ViewBag.PrevId })" class="btn btn-outline-secondary btn-sm custom-btn" title="Previous Entry">
                    <i class="fa fa-arrow-left me-1"></i> Prev
                </a>
            }
            else
            {
                <button type="button" class="btn btn-outline-secondary btn-sm custom-btn disabled" disabled>
                    <i class="fa fa-arrow-left me-1"></i> Prev
                </button>
            }

            @if (ViewBag.NextId != null)
            {
                <a href="@Url.Action("Edit", new { id = ViewBag.NextId })" class="btn btn-outline-secondary btn-sm custom-btn" title="Next Entry">
                    Next <i class="fa fa-arrow-right ms-1"></i>
                </a>
            }
            else
            {
                <button type="button" class="btn btn-outline-secondary btn-sm custom-btn disabled" disabled>
                    Next <i class="fa fa-arrow-right ms-1"></i>
                </button>
            }

            <a asp-action="Create" class="btn btn-outline-primary btn-sm custom-btn me-2" title="New Entry">
                <i class="fa fa-plus-circle me-1"></i> New
            </a>

            <button type="button" class="btn btn-outline-primary btn-sm custom-btn me-1" onclick="addRow()">
                <i class="fa fa-plus me-1"></i> Add Item
            </button>

            <button type="submit" id="btnUpdate" class="btn btn-primary btn-sm custom-btn shadow-sm">
                <i class="fa fa-save me-1"></i> Update Bilty
            </button>
        </div>
    </div>

    <!-- MASTER SECTION -->
    <div class="card custom-card shadow-sm border-0 mb-2">
        <div class="card-header bg-white border-bottom py-1 px-3 d-flex justify-content-between align-items-center">
            <h6 class="mb-0 fw-semibold text-navy" style="font-size: 13px;">
                <i class="fa fa-sliders text-primary me-1"></i> General Details
            </h6>
        </div>
        <div class="card-body py-2 px-3">
            <div class="row g-2">

                <div class="col-md-2">
                    <label class="form-label small text-muted fw-semibold mb-0"><i class="fa fa-hashtag text-primary me-1"></i> Bilty No</label>
                    <input asp-for="Head.BillTiNo" id="BiltyNo" class="form-control form-control-sm" tabindex="1" />
                </div>

                <div class="col-md-2">
                    <label class="form-label small text-muted fw-semibold mb-0"><i class="fa fa-calendar text-primary me-1"></i> Bilty Date</label>
                    <input asp-for="Head.DocDate" id="BiltyDate" type="date" class="form-control form-control-sm" tabindex="2" />
                </div>

                <div class="col-md-4">
                    <label class="form-label small text-muted fw-semibold mb-0"><i class="fa fa-map-marker text-primary me-1"></i> Station</label>
                    <select asp-for="Head.StationId" id="Station" class="form-select form-select-sm select2" tabindex="3"
                            asp-items="@(new SelectList(ViewBag.Stations, "Value", "Text"))">
                    </select>
                </div>

                <div class="col-md-4">
                    <label class="form-label small text-muted fw-semibold mb-0"><i class="fa fa-user text-primary me-1"></i> Party Name</label>

                    <div class="input-group input-group-sm">
                        <select asp-for="Head.CustomerId"
                                id="CustomerId"
                                class="form-select select2" tabindex="4"
                                asp-items="@(new SelectList(ViewBag.Customers, "Value", "Text"))">
                        </select>

                        <button type="button"
                                class="btn btn-outline-primary"
                                data-bs-toggle="modal"
                                data-bs-target="#customerModal">
                            <i class="fa fa-plus"></i>
                        </button>
                    </div>
                </div>

                <div class="col-md-3">
                    <label class="form-label small text-muted fw-semibold mb-0"><i class="fa fa-paper-plane text-primary me-1"></i> Send To</label>
                    <input asp-for="Head.SendTo" id="SendTo" class="form-control form-control-sm" tabindex="5" />
                </div>

                <div class="col-md-3">
                    <label class="form-label small text-muted fw-semibold mb-0"><i class="fa fa-file-text-o text-primary me-1"></i> Bill No</label>
                    <input asp-for="Head.BilNo" id="BillNo" class="form-control form-control-sm" tabindex="6" />
                </div>

                <div class="col-md-6">
                    <label class="form-label small text-muted fw-semibold mb-0"><i class="fa fa-comment text-primary me-1"></i> Remarks</label>
                    <input asp-for="Head.Narration" id="Remarks" class="form-control form-control-sm" tabindex="7" />
                </div>

            </div>
        </div>
    </div>

    <!-- ITEMS GRID & EXPENSES SPLIT (SINGLE SCREEN) -->
    <div class="row g-2 mb-1">
        <!-- LEFT: DETAIL GRID -->
        <div class="col-12 col-lg-7">
            <div class="card custom-card shadow-sm border-0 h-100 mb-0">
                <div class="card-header bg-white border-bottom py-1 px-3 d-flex justify-content-between align-items-center">
                    <h6 class="mb-0 fw-semibold text-navy" style="font-size: 13px;">
                        <i class="fa fa-list text-primary me-1"></i> Bilty Items
                    </h6>
                    <button type="button" class="btn btn-outline-primary btn-sm py-0 px-2" onclick="addRow()">
                        <i class="fa fa-plus me-1"></i> Add
                    </button>
                </div>

                <div class="card-body p-0">
                    <div class="table-responsive" style="max-height: 220px; overflow-y: auto;">
                        <table class="table table-bordered table-hover mb-0" id="tblItems">
                            <thead class="table-light text-center" style="position: sticky; top: 0; z-index: 2;">
                                <tr>
                                    <th><i class="fa fa-cube text-primary me-1"></i> Item</th>
                                    <th width="110"><i class="fa fa-cubes text-primary me-1"></i> Qty</th>
                                    <th width="110"><i class="fa fa-balance-scale text-primary me-1"></i> Weight</th>
                                    <th width="65"><i class="fa fa-cog text-primary me-1"></i></th>
                                </tr>
                            </thead>

                            <tbody id="tbodyItems">
                                <tr id="noDataRow">
                                    <td colspan="4" class="text-center text-muted py-2">
                                        No Items Added
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- RIGHT: EXPENSE SECTION -->
        <div class="col-12 col-lg-5">
            <div class="card custom-card shadow-sm border-0 h-100 mb-0">
                <div class="card-header bg-white border-bottom py-1 px-3 d-flex justify-content-between align-items-center">
                    <h6 class="mb-0 fw-semibold text-navy" style="font-size: 13px;">
                        <i class="fa fa-calculator text-primary me-1"></i> Expense Details
                    </h6>
                </div>

                <div class="card-body py-2 px-3">
                    <div class="row g-2">
                        <div class="col-6">
                            <label class="form-label small text-muted fw-semibold mb-0">Freight</label>
                            <input id="Cartage1" asp-for="Head.Cartage1" class="form-control form-control-sm text-end calc-net" tabindex="100" />
                        </div>

                        <div class="col-6">
                            <label class="form-label small text-muted fw-semibold mb-0">Labour</label>
                            <input id="Labour" asp-for="Head.Labour" class="form-control form-control-sm text-end calc-net" tabindex="101" />
                        </div>

                        <div class="col-6">
                            <label class="form-label small text-muted fw-semibold mb-0">T.T</label>
                            <input id="T_T" asp-for="Head.T_T" class="form-control form-control-sm text-end calc-net" tabindex="102" />
                        </div>

                        <div class="col-6">
                            <label class="form-label small text-muted fw-semibold mb-0">Lifter</label>
                            <input id="Cartage3" asp-for="Head.Cartage3" class="form-control form-control-sm text-end calc-net" tabindex="103" />
                        </div>

                        <div class="col-6">
                            <label class="form-label small text-muted fw-semibold mb-0">Local Freight</label>
                            <input id="Cartage2" asp-for="Head.Cartage2" class="form-control form-control-sm text-end calc-net" tabindex="104" />
                        </div>

                        <div class="col-6">
                            <label class="form-label small text-muted fw-semibold mb-0">Party Expense</label>
                            <input id="PartyEx" asp-for="Head.PartyEx" class="form-control form-control-sm text-end calc-net" tabindex="105" />
                        </div>

                        <div class="col-6">
                            <label class="form-label small text-muted fw-semibold mb-0">Lifter2</label>
                            <input id="Lifter2" asp-for="Head.Lifter2" class="form-control form-control-sm text-end calc-net" tabindex="106" />
                        </div>

                        <div class="col-6">
                            <label class="form-label small text-muted fw-semibold mb-0">Other</label>
                            <input id="OtherEx" asp-for="Head.OtherEx" class="form-control form-control-sm text-end calc-net" tabindex="107" />
                        </div>

                        <div class="col-12 mt-2 pt-1 border-top">
                            <div class="d-flex justify-content-between align-items-center">
                                <label class="form-label mb-0 fw-bold text-navy"><i class="fa fa-calculator text-primary me-1"></i> Net Amount</label>
                                <input asp-for="Head.NetAmt" readonly class="form-control form-control-sm bg-light fw-bold text-navy text-end border-primary" style="font-size: 1.05rem; max-width: 170px;" />
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>

</form>

<div class="modal fade" id="customerModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Add Customer</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">

                <label>Customer Name</label>
                <input type="text" id="CustomerName" class="form-control" />

            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>

                <button type="button" class="btn btn-success" onclick="saveCustomer()">
                    Save
                </button>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Highlight active field
        function highlightField(element) {
            // Remove highlight from all fields and buttons
            $('.form-control, .form-select, .btn').removeClass('active-field');
            // Add highlight to current element
            $(element).addClass('active-field');
        }

        function saveCustomer() {
            let name = $("#CustomerName").val();

            if (name.trim() === "") {
                alert("Customer name required");
                return;
            }

            $.ajax({
                url: '/GLChart/CreateAjax',
                type: 'POST',
                data: { name: name },
                success: function (res) {
                    if (res.success) {
                        let newOption = new Option(res.text, res.id, true, true);
                        $('#CustomerId').append(newOption).trigger('change');
                        $("#CustomerName").val("");
                        $("#customerModal").modal('hide');
                    } else {
                        alert(res.message);
                    }
                },
                error: function () {
                    alert("Error saving customer");
                }
            });
        }

        let i = 0;

        // =========================
        // LOAD EXISTING DATA
        // =========================
        $(document).ready(function () {
            let data = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Details, new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }));

            $("#tbodyItems").html("");

            if (!data || data.length === 0) {
                addRow();
            } else {
                data.forEach(x => {
                    let row = `
                    <tr>
                        <td>
                            <input name="Details[${i}].IName"
                                   value="${x.iName ?? ''}"
                                   class="form-control form-control-sm iname" readonly />
                        </td>

                        <td>
                            <input name="Details[${i}].Qty"
                                   value="${x.qty ?? 0}"
                                   class="form-control form-control-sm qty" />
                        </td>

                        <td>
                            <input name="Details[${i}].QtyPerPack"
                                   value="${x.qtyPerPack ?? 0}"
                                   class="form-control form-control-sm qtyperpack" />
                        </td>

                        <td class="text-center">
                            <button type="button" class="btn btn-danger btn-sm"
                                    onclick="removeRow(this)">
                                <i class="fa fa-trash"></i>
                            </button>
                        </td>
                    </tr>`;

                    $("#tbodyItems").append(row);
                    i++;
                });
            }

            calculateNetAmount();

            // Initialize select2 on all dropdowns
            $('.select2').select2({
                theme: 'bootstrap-5',
                width: '100%'
            });

            // Focus on Bilty No when page loads
            $('#BiltyNo').focus();
            highlightField('#BiltyNo');
        });

        // =========================
        // ADD ROW
        // =========================
        function addRow() {
            const noData = document.getElementById("noDataRow");
            if (noData) noData.remove();

            let row = `
            <tr>
                <td>
                    <input name="Details[${i}].IName" value="NOS"
                           class="form-control form-control-sm iname" readonly />
                </td>

                <td>
                    <input name="Details[${i}].Qty" type="number" step="0.01"
                           class="form-control form-control-sm qty" />
                </td>

                <td>
                    <input name="Details[${i}].QtyPerPack" type="number" step="0.01"
                           class="form-control form-control-sm qtyperpack" />
                </td>

                <td class="text-center">
                    <button type="button" class="btn btn-danger btn-sm"
                            onclick="removeRow(this)">
                        <i class="fa fa-trash"></i>
                    </button>
                </td>
            </tr>`;

            $("#tbodyItems").append(row);
            i++;
        }

        // =========================
        // REMOVE ROW
        // =========================
        function removeRow(btn) {
            var row = $(btn).closest("tr");
            var isFirstRow = row.is(':first-child');

            row.remove();

            // If it was the first row, focus on the new first row's Qty
            if (isFirstRow) {
                var newFirstQty = $('#tbodyItems .qty:first');
                if (newFirstQty.length) {
                    newFirstQty.focus();
                    highlightField(newFirstQty);
                } else {
                    // No rows left, go to Freight
                    $('#Cartage1').focus();
                    highlightField('#Cartage1');
                }
            }

            if ($("#tbodyItems tr").length === 0) {
                $("#tbodyItems").html(`
                    <tr id="noDataRow">
                        <td colspan="4" class="text-center text-muted py-3">
                            No Items Added
                        </td>
                    </tr>
                `);
            }
        }

        // =========================
        // NET AMOUNT CALCULATION
        // =========================
        // ✅ NEW NET AMOUNT LOGIC
         function calculateNetAmount() {

             let cartage1 = parseFloat($("#Cartage1").val()) || 0;
             let cartage2 = parseFloat($("#Cartage2").val()) || 0;
             let cartage3 = parseFloat($("#Cartage3").val()) || 0;
             let labour   = parseFloat($("#Labour").val()) || 0;
             let tt       = parseFloat($("#T_T").val()) || 0;

             let netAmt = cartage1 + cartage2 + cartage3 + labour + tt;

             $("#Head_NetAmt").val(netAmt.toFixed(2));
         }

         // realtime update for ALL cost fields
         $(document).on("input", "#Cartage1, #Cartage2, #Cartage3, #Labour, #T_T", function () {
             calculateNetAmount();
         });

        // Ctrl+S to update
        document.addEventListener('keydown', function (e) {
            if (e.ctrlKey && e.key.toLowerCase() === 's') {
                e.preventDefault();
                document.getElementById('btnUpdate').click();
            }
        });
    </script>
}

<style>
    /* Highlight style for form controls */
    .active-field {
        border: 2px solid #0d6efd !important;
        box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.25) !important;
        background-color: #f0f7ff !important;
        transition: all 0.2s ease;
    }

    /* Highlight style for buttons (Update button) */
    .btn.active-field {
        border: 2px solid #0d6efd !important;
        box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.3) !important;
        transform: scale(1.02);
        transition: all 0.2s ease;
    }

    /* Specific style for warning buttons */
    .btn-warning.active-field {
        border: 2px solid #0d6efd !important;
        box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.3) !important;
        background-color: #e0a800 !important;
        transform: scale(1.02);
    }

    .form-control:focus, .form-select:focus {
        border-color: #86b7fe;
        box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.25);
    }

    /* Smooth transitions */
    .form-control, .form-select, .btn {
        transition: all 0.2s ease;
    }
</style>