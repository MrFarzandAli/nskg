@model IEnumerable<IssHead>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Bilty";
}
@Html.AntiForgeryToken()
<div class="page-header">
    <div class="row align-items-center">
        <div class="col">
            @*             <h3 class="page-title">Vouchers</h3> *@
            <h3 class="page-title">@ViewBag.PageTitle</h3>
            <ul class="breadcrumb">
                <li class="breadcrumb-item">
                    <a asp-controller="Home" asp-action="Index">Dashboard</a>
                </li>
                <li class="breadcrumb-item active">Bilty</li>
            </ul>
        </div>

        <div class="col-auto float-end ms-auto">
            <a asp-controller="Bilty"
               asp-action="Create"
               class="btn add-btn"
               id="addBiltyBtn">
                <i class="fa fa-plus"></i> Add Bilty
            </a>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-12">

        <!-- Card -->
        <div class="card">
            <div class="card-body">

                <div class="table-responsive">
                    <table id="voucherTable"
                           class="table table-striped table-hover table-nowrap">
                        <thead>
                            <tr>
                                <th>Document No</th>
                                <th>Date</th>
                                <th>Customer</th>
                                <th class="text-end">Action</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var b in Model)
                            {
                                <tr>
                                    <td>
                                        <h2 class="table-avatar">
                                            <a href="#">@b.DocNo</a>
                                        </h2>
                                    </td>

                                    <td>@(b.DocDate?.ToString("dd-MMM-yyyy") ?? "")</td>
                                    <td>@b.CusName</td>

                                    <td class="text-end">
                                        <div class="d-flex justify-content-end gap-2">

                                            <a asp-action="Edit"
                                               asp-route-id="@b.Id"
                                               class="btn btn-sm btn-primary">
                                                <i class="fa fa-pencil"></i> Edit
                                            </a>

                                            <button type="button"
                                                    class="btn btn-sm btn-danger"
                                                    onclick="confirmDelete(@b.Id)">
                                                <i class="fa fa-trash"></i> Delete
                                            </button>

                                            
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>

                    </table>
                </div>

            </div>
        </div>
        <!-- /Card -->

    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {

            $('#voucherTable').DataTable({
                "paging": true,
                "lengthChange": true,
                "searching": true,
                "ordering": true,
                "info": true,
                "autoWidth": false,
                "responsive": true
            });

            // 🔥 Focus on Add Bilty button when page loads
            setTimeout(function() {
                $('#addBiltyBtn').focus();

                // Optional: Add highlight effect to the focused button
                $('#addBiltyBtn').css({
                    'box-shadow': '0 0 0 0.2rem rgba(13, 110, 253, 0.5)',
                    'border-color': '#0d6efd',
                    'transition': 'all 0.3s ease'
                });

                // Remove highlight after 3 seconds or when user clicks elsewhere
                setTimeout(function() {
                    $('#addBiltyBtn').css({
                        'box-shadow': '',
                        'border-color': ''
                    });
                }, 3000);
            }, 100); // Small delay to ensure DOM is fully rendered

        });

        function confirmDelete(id) {

            if (!confirm("Are you sure you want to delete Bilty ?")) {
                return;
            }

            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

            $.ajax({
                url: '/Bilty/Delete',
                type: 'POST',
                data: {
                    id: id,
                    __RequestVerificationToken: token
                },
                success: function (res) {
                    alert(res.message);
                    if (res.success) {
                        location.reload();
                    }
                },
                error: function () {
                    alert("Delete failed!");
                }
            });
        }
    </script>
}

<style>
    /* 🔥 Optional: Style for focused Add Bilty button */
    #addBiltyBtn:focus {
        box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.5) !important;
        border-color: #0d6efd !important;
        transform: scale(1.02);
        transition: all 0.3s ease;
    }

    /* Add some hover effect */
    #addBiltyBtn:hover {
        transform: scale(1.05);
        transition: all 0.3s ease;
    }

    /* Button transition */
    #addBiltyBtn {
        transition: all 0.3s ease;
    }
</style>