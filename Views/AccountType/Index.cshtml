@model IEnumerable<Actype>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Account Types";
}

<div class="page-header">
    <div class="row align-items-center">
        <div class="col">
            <h3 class="page-title">Account Types</h3>
            <ul class="breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Dashboard</a></li>
                <li class="breadcrumb-item active">Account Types</li>
            </ul>
        </div>

        <div class="col-auto float-end ms-auto">
            <a asp-action="Create" class="btn add-btn">
                <i class="fa fa-plus"></i> Add Account Type
            </a>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-12">

        <!-- Card -->
        <div class="card">
            <div class="card-body">

                <div class="table-responsive">
                    <table id="actypeTable" class="table table-striped table-hover table-nowrap">
                        <thead>
                            <tr>
                                <th>Acc Type</th>
                                <th>Account Name</th>
                                <th class="text-end">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.ACTYPE</td>
                                    <td>@item.ACNAME</td>
                                    <td class="text-end">
                                        <div class="d-flex justify-content-end gap-2">
                                            <a asp-action="Edit" asp-route-id="@item.ACTYPE" class="btn btn-sm btn-primary">
                                                <i class="fa fa-pencil"></i> Edit
                                            </a>
                                            <button type="button"
                                                    class="btn btn-sm btn-danger"
                                                    onclick="return confirmDelete(event, '@item.ACNAME', '/AccountType/Delete/@item.ACTYPE')">
                                                <i class="fa fa-trash"></i> Delete
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

            </div>
        </div>
        <!-- /Card -->

    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Initialize DataTable
            var table = $('#actypeTable').DataTable({
                "paging": true,
                "lengthChange": true,
                "searching": true,
                "ordering": true,
                "info": true,
                "autoWidth": false,
                "responsive": true
            });
        });

        function confirmDelete(e, name, url) {
            e.preventDefault();
            if (confirm('Are you sure you want to delete "' + name + '"?')) {
                window.location.href = url;
            }
        }
    </script>
}