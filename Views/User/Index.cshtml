@using Microsoft.AspNetCore.Identity
@model IEnumerable<IdentityUser>

<h2>Users</h2>

<table class="table">
    <tr>
        <th>Email</th>
        <th>Action</th>
    </tr>

    @foreach (var user in Model)
    {
        <tr>
            <td>@user.Email</td>
            <td>
                <a asp-action="AssignRole" asp-route-userId="@user.Id" class="btn btn-primary">
                    Assign Role
                </a>
            </td>
        </tr>
    }
</table>