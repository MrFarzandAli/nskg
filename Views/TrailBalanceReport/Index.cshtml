@{
    ViewData["Title"] = "Trial Balance Report";
    var companyList = ViewBag.CompanyList as IEnumerable<dynamic>;
    var selectedRcocode = ViewBag.Rcocode as string ?? "";
    var financialYears = ViewBag.FinancialYears as IEnumerable<dynamic>;
    var selectedFyId = ViewBag.SelectedFyId as string ?? "All";
}

<style>
    .custom-card { border-radius: 10px; }
    .heading-glow { font-weight: 600; }
    .custom-btn { border-radius: 6px; }
    iframe { border-radius: 8px; border: 1px solid #dee2e6; }
</style>

<div class="container-fluid mt-4">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="fw-bold"><i class="fa fa-balance-scale me-2 text-primary"></i> Trial Balance Report</h3>
    </div>

    <!-- Filter Card / Report Parameters -->
    <div class="card custom-card mb-4 shadow-sm border-0">
        <div class="card-header bg-primary text-white py-3">
            <h5 class="mb-0 fw-semibold">
                <i class="fa fa-sliders me-2"></i> Report Parameters
            </h5>
            <small class="text-white-50">Filter by Company / Branch and Financial Year</small>
        </div>
        <div class="card-body bg-light p-4">
            <form id="reportForm" method="get">
                <div class="row g-3 align-items-end">

                    <!-- Company / Rcocode -->
                    <div class="col-md-4">
                        <label class="form-label fw-bold">Company / Branch</label>
                        <select class="form-select select2" id="rcocodeSelect" name="rcocode">
                            <option value="" selected="@(string.IsNullOrEmpty(selectedRcocode) ? "selected" : null)">-- All Companies / Branches --</option>
                            @if (companyList != null && companyList.Any())
                            {
                                foreach (var comp in companyList)
                                {
                                    if (selectedRcocode == comp.Code || selectedRcocode == comp.Id.ToString())
                                    {
                                        <option value="@comp.Code" selected="selected">@comp.Name</option>
                                    }
                                    else
                                    {
                                        <option value="@comp.Code">@comp.Name</option>
                                    }
                                }
                            }
                        </select>
                    </div>

                    <!-- Financial Year Filter -->
                    <div class="col-md-4">
                        <label class="form-label fw-bold">Financial Year</label>
                        <select class="form-select select2" id="fyIdSelect" name="fyId" required>
                            @if (financialYears != null)
                            {
                                foreach (var fy in financialYears)
                                {
                                    string fyVal = fy.Id.ToString();
                                    string fyDisplay = $"{fy.YearName} ({((DateTime)fy.StartDate).ToString("dd-MMM-yyyy")} to {((DateTime)fy.EndDate).ToString("dd-MMM-yyyy")})";
                                    if (fy.IsClosed) { fyDisplay += " [Closed]"; }
                                    if (selectedFyId == fyVal)
                                    {
                                        <option value="@fyVal" selected="selected">@fyDisplay</option>
                                    }
                                    else
                                    {
                                        <option value="@fyVal">@fyDisplay</option>
                                    }
                                }
                            }
                        </select>
                    </div>

                    <!-- BUTTON ROW -->
                    <div class="col-md-4 d-flex justify-content-end gap-2">
                        <!-- EXCEL -->
                        <button type="submit"
                                class="btn btn-success btn-sm custom-btn px-3 shadow-sm fw-semibold"
                                asp-action="ExportExcel">
                            <i class="fa fa-file-excel-o me-1"></i> Export Excel
                        </button>

                        <!-- PRINT -->
                        <button type="button"
                                class="btn btn-secondary btn-sm custom-btn px-3 shadow-sm fw-semibold"
                                onclick="printReportFrame()">
                            <i class="fa fa-print me-1"></i> Print
                        </button>

                        <!-- ON SCREEN -->
                        <button type="button"
                                class="btn btn-primary btn-sm custom-btn px-3 shadow-sm fw-semibold"
                                onclick="loadOnScreenReport()">
                            <i class="fa fa-desktop me-1"></i> View Report
                        </button>
                    </div>

                </div>
            </form>
        </div>
    </div>

    <!-- 🔵 ON SCREEN REPORT -->
    <div id="reportCard" class="card shadow border-0 mb-4" style="display:none;">
        <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center py-2">
            <h5 class="mb-0 fs-6"><i class="fa fa-file-text-o me-2"></i> Trial Balance Preview</h5>
            <div>
                <button type="button" class="btn btn-sm btn-outline-light me-2" onclick="printReportFrame()">
                    <i class="fa fa-print me-1"></i> Print
                </button>
                <button type="button" class="btn btn-sm btn-outline-light" onclick="$('#reportCard').hide()">
                    <i class="fa fa-times"></i> Close
                </button>
            </div>
        </div>

        <!-- LOADER -->
        <div id="reportLoader" style="display:none; padding:40px; text-align:center;">
            <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;"></div>
            <div class="mt-3 fw-bold text-secondary">Loading Trial Balance Data...</div>
        </div>

        <!-- REPORT FRAME -->
        <div class="card-body p-0">
            <iframe id="reportFrame"
                    style="width:100%; height:780px; border:none;"></iframe>
        </div>
    </div>

</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            if ($.fn.select2) {
                $('#rcocodeSelect').select2({
                    theme: 'bootstrap-5',
                    width: '100%',
                    allowClear: false
                });

                $('#fyIdSelect').select2({
                    theme: 'bootstrap-5',
                    width: '100%',
                    allowClear: false
                });
            }

            // Auto load report on first view without needing manual search
            loadOnScreenReport();

            // Auto reload when company or financial year changes
            $('#rcocodeSelect, #fyIdSelect').on('change', function () {
                loadOnScreenReport();
            });
        });

        function loadOnScreenReport() {
            var rcocode = $('#rcocodeSelect').val() || '';
            var fyId = $('#fyIdSelect').val() || 'All';

            $('#reportCard').show();
            $('#reportLoader').show();
            $('#reportFrame').show();

            var url = '@Url.Action("OnScreenReport", "TrailBalanceReport")'
                + '?rcocode=' + encodeURIComponent(rcocode)
                + '&fyId=' + encodeURIComponent(fyId);

            var frame = document.getElementById('reportFrame');
            if (frame) {
                frame.onload = function () {
                    $('#reportLoader').hide();
                };
                frame.src = url;
            }

            setTimeout(function () {
                $('#reportLoader').hide();
            }, 3000);
        }

        function printReportFrame() {
            var frame = document.getElementById('reportFrame');
            if (frame && frame.contentWindow) {
                frame.contentWindow.focus();
                frame.contentWindow.print();
            } else {
                alert("Please view the report first before printing.");
            }
        }
    </script>
}
