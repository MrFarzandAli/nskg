@{
    ViewData["Title"] = "Trial Balance Report";
    var companyList = ViewBag.CompanyList as IEnumerable<dynamic>;
    var selectedRcocode = ViewBag.Rcocode as string ?? "";
    var financialYears = ViewBag.FinancialYears as IEnumerable<dynamic>;
    var selectedFyId = ViewBag.SelectedFyId as string ?? "All";
    var fromDate = ViewBag.FromDate as string ?? "";
    var toDate = ViewBag.ToDate as string ?? "";
}

<style>
    .custom-card { border-radius: 10px; }
    .heading-glow { font-weight: 600; }
    .custom-btn { border-radius: 6px; }
    iframe { border-radius: 8px; border: 1px solid #dee2e6; }
</style>

<div class="container-fluid mt-4">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="fw-bold"><i class="fa fa-balance-scale me-2 text-primary"></i> Trial Balance Report</h3>
    </div>

    <!-- Filter Card / Report Parameters -->
    <div class="card custom-card mb-4 shadow-sm border-0">
        <div class="card-header bg-primary text-white py-3">
            <h5 class="mb-0 fw-semibold">
                <i class="fa fa-sliders me-2"></i> Report Parameters / Account Process
            </h5>
            <small class="text-white-50">Filter by Company / Branch, Financial Year, and Date Range</small>
        </div>
        <div class="card-body bg-light p-4">
            <form id="reportForm" method="get">
                <div class="row g-3 align-items-end">

                    <!-- Company / Rcocode -->
                    <div class="col-12 col-sm-6 col-lg-3">
                        <label class="form-label fw-bold">Company / Branch</label>
                        <select class="form-select select2" id="rcocodeSelect" name="rcocode">
                            <option value="ALL" selected="@(selectedRcocode == "ALL" ? "selected" : null)">-- All Companies (Linked) --</option>
                            @if (companyList != null && companyList.Any())
                            {
                                foreach (var comp in companyList)
                                {
                                    if (selectedRcocode == comp.Code || selectedRcocode == comp.Id.ToString())
                                    {
                                        <option value="@comp.Code" selected="selected">@comp.Name</option>
                                    }
                                    else
                                    {
                                        <option value="@comp.Code">@comp.Name</option>
                                    }
                                }
                            }
                        </select>
                    </div>

                    <!-- Financial Year Filter -->
                    <div class="col-12 col-sm-6 col-lg-2">
                        <label class="form-label fw-bold">Financial Year</label>
                        <select class="form-select select2" id="fyIdSelect" name="fyId">
                            @if (financialYears != null)
                            {
                                foreach (var fy in financialYears)
                                {
                                    string fyVal = fy.Id.ToString();
                                    string fyDisplay = $"{fy.YearName}";
                                    if (fy.IsClosed) { fyDisplay += " [Closed]"; }
                                    if (selectedFyId == fyVal)
                                    {
                                        <option value="@fyVal" data-start="@fy.StartDate" data-end="@fy.EndDate" selected="selected">@fyDisplay</option>
                                    }
                                    else
                                    {
                                        <option value="@fyVal" data-start="@fy.StartDate" data-end="@fy.EndDate">@fyDisplay</option>
                                    }
                                }
                            }
                        </select>
                    </div>

                    <!-- From Date -->
                    <div class="col-12 col-sm-6 col-lg-2">
                        <label class="form-label fw-bold">From Date</label>
                        <input type="date" class="form-control" id="fromDateInput" name="fromDate" value="@fromDate" required />
                    </div>

                    <!-- To Date -->
                    <div class="col-12 col-sm-6 col-lg-2">
                        <label class="form-label fw-bold">To Date</label>
                        <input type="date" class="form-control" id="toDateInput" name="toDate" value="@toDate" required />
                    </div>

                    <!-- Report View Mode -->
                    <div class="col-12 col-sm-6 col-lg-3">
                        <label class="form-label fw-bold">Report View</label>
                        <select class="form-select select2" id="reportTypeSelect" name="reportType">
                            <option value="summary" selected="@((ViewBag.ReportType as string) == "summary" ? "selected" : null)">Summary (Control Head & Expense Level 2)</option>
                            <option value="detailed" selected="@((ViewBag.ReportType as string) == "detailed" ? "selected" : null)">Detailed (Account Wise)</option>
                        </select>
                    </div>

                </div>

                <!-- ACTION BUTTONS ROW -->
                <div class="row mt-3">
                    <div class="col-12 d-flex justify-content-end gap-2 flex-wrap">

                        <!-- WITH PROCESS -->
                        <button type="button"
                                class="btn btn-warning btn-sm custom-btn px-3 shadow-sm fw-semibold text-dark"
                                onclick="loadOnScreenReport(true)"
                                title="Run sp_ProcessTrialBalance to synchronize accounts and load report">
                            <i class="fa fa-cogs me-1"></i> With Process
                        </button>

                        <!-- WITHOUT PROCESS -->
                        <button type="button"
                                class="btn btn-primary btn-sm custom-btn px-3 shadow-sm fw-semibold"
                                onclick="loadOnScreenReport(false)"
                                title="Directly load report from current balances">
                            <i class="fa fa-desktop me-1"></i> Without Process
                        </button>

                        <!-- EXCEL -->
                        <button type="button"
                                class="btn btn-success btn-sm custom-btn px-3 shadow-sm fw-semibold"
                                onclick="exportToExcel()">
                            <i class="fa fa-file-excel-o me-1"></i> Excel
                        </button>

                        <!-- PRINT -->
                        <button type="button"
                                class="btn btn-secondary btn-sm custom-btn px-3 shadow-sm fw-semibold"
                                onclick="printReportFrame()">
                            <i class="fa fa-print me-1"></i> Print
                        </button>

                    </div>
                </div>

            </form>
        </div>
    </div>

    <!-- 🔵 ON SCREEN REPORT -->
    <div id="reportCard" class="card shadow border-0 mb-4" style="display:none;">
        <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center py-2">
            <h5 class="mb-0 fs-6"><i class="fa fa-file-text-o me-2"></i> Trial Balance Preview</h5>
            <div>
                <button type="button" class="btn btn-sm btn-outline-light me-2" onclick="printReportFrame()">
                    <i class="fa fa-print me-1"></i> Print
                </button>
                <button type="button" class="btn btn-sm btn-outline-light" onclick="$('#reportCard').hide()">
                    <i class="fa fa-times"></i> Close
                </button>
            </div>
        </div>

        <!-- LOADER -->
        <div id="reportLoader" style="display:none; padding:40px; text-align:center;">
            <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;"></div>
            <div id="loaderText" class="mt-3 fw-bold text-secondary">Loading Trial Balance Data...</div>
        </div>

        <!-- REPORT FRAME -->
        <div class="card-body p-0">
            <iframe id="reportFrame"
                    style="width:100%; height:780px; border:none;"></iframe>
        </div>
    </div>

</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            if ($.fn.select2) {
                $('#rcocodeSelect, #fyIdSelect, #reportTypeSelect').select2({
                    theme: 'bootstrap-5',
                    width: '100%',
                    allowClear: false
                });
            }

            // Sync date inputs when Financial Year changes
            $('#fyIdSelect').on('change', function () {
                var selectedOption = $(this).find(':selected');
                var start = selectedOption.data('start');
                var end = selectedOption.data('end');
                if (start) $('#fromDateInput').val(start);
                if (end) $('#toDateInput').val(end);
            });

            // Initial load without process
            loadOnScreenReport(false);
        });

        function loadOnScreenReport(withProcess) {
            var rcocode = $('#rcocodeSelect').val() || '';
            var fyId = $('#fyIdSelect').val() || 'All';
            var fromDate = $('#fromDateInput').val() || '';
            var toDate = $('#toDateInput').val() || '';
            var reportType = $('#reportTypeSelect').val() || 'summary';

            $('#reportCard').show();
            $('#reportLoader').show();
            $('#reportFrame').hide();

            if (withProcess) {
                $('#loaderText').html('<i class="fa fa-cogs me-1 text-warning"></i> Running Account Process & Calculating Balances... Please wait.');
            } else {
                $('#loaderText').html('Loading Trial Balance Report...');
            }

            var url = '@Url.Action("OnScreenReport", "TrailBalanceReport")'
                + '?rcocode=' + encodeURIComponent(rcocode)
                + '&fyId=' + encodeURIComponent(fyId)
                + '&fromDate=' + encodeURIComponent(fromDate)
                + '&toDate=' + encodeURIComponent(toDate)
                + '&reportType=' + encodeURIComponent(reportType)
                + '&withProcess=' + (withProcess ? 'true' : 'false');

            var frame = document.getElementById('reportFrame');
            if (frame) {
                frame.onload = function () {
                    $('#reportLoader').hide();
                    $('#reportFrame').show();
                };
                frame.src = url;
            }

            setTimeout(function () {
                $('#reportLoader').hide();
                $('#reportFrame').show();
            }, 5000);
        }

        function exportToExcel() {
            var rcocode = $('#rcocodeSelect').val() || '';
            var fyId = $('#fyIdSelect').val() || 'All';
            var fromDate = $('#fromDateInput').val() || '';
            var toDate = $('#toDateInput').val() || '';
            var reportType = $('#reportTypeSelect').val() || 'summary';

            var url = '@Url.Action("ExportExcel", "TrailBalanceReport")'
                + '?rcocode=' + encodeURIComponent(rcocode)
                + '&fyId=' + encodeURIComponent(fyId)
                + '&fromDate=' + encodeURIComponent(fromDate)
                + '&toDate=' + encodeURIComponent(toDate)
                + '&reportType=' + encodeURIComponent(reportType);

            window.location.href = url;
        }

        function printReportFrame() {
            var frame = document.getElementById('reportFrame');
            if (frame && frame.contentWindow) {
                frame.contentWindow.focus();
                frame.contentWindow.print();
            } else {
                alert("Please view the report first before printing.");
            }
        }
    </script>
}
