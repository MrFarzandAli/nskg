                                <i class="fa fa-check-circle text-success me-1"></i> All biltis are currently selected. Use search to view any specific bilty.
                                </td>
                            </tr>
                        `);
                    }
                }

                filterPartyBiltis();
                updateModalCounters();
            }

            // Helper: Exact Match comparator
            function isExactMatch(searchedVal, cellVal, isNumeric, isDate, rawDateVal) {
                if (!searchedVal || searchedVal.trim() === '') return true;
                var s = searchedVal.trim();
                if (cellVal === undefined || cellVal === null) cellVal = '';
                var c = cellVal.toString().trim();

                if (isNumeric) {
                    var sNum = parseFloat(s.replace(/,/g, ''));
                    var cNum = parseFloat(c.replace(/,/g, ''));
                    if (!isNaN(sNum) && !isNaN(cNum)) {
                        return sNum === cNum;
                    }
                    return s.toLowerCase() === c.toLowerCase();
                }

                if (isDate) {
                    var sLow = s.toLowerCase();
                    var cLow = c.toLowerCase();
                    var rawLow = (rawDateVal || '').toString().toLowerCase().trim();
                    if (sLow === cLow || (rawLow && sLow === rawLow)) return true;

                    // Match variations: dd-MM-yyyy, dd/MM/yyyy, yyyy-MM-dd
                    var sParts = s.split(/[-/.]/);
                    var cParts = c.split(/[-/.]/);
                    if (sParts.length === 3 && cParts.length === 3) {
                        var sD = new Date(s);
                        var cD = new Date(c);
                        if (!isNaN(sD.getTime()) && !isNaN(cD.getTime())) {
                            return sD.toDateString() === cD.toDateString();
                        }
                    }
                    return false;
                }

                // String exact match (case-insensitive, trimmed)
                return s.toLowerCase() === c.toLowerCase();
            }

            var biltyServerSearchTimer = null;

            // Live Filter function inside Modal (EXACT MATCH FOR EACH COLUMN, EVEN IF SELECTED OR NOT)
            function filterPartyBiltis() {
                var sDocDate = ($('.bilty-col-search[data-col="docdate"]').val() || '').trim();
                var sCusName = ($('.bilty-col-search[data-col="cusname"]').val() || '').trim();
                var sVehicle = ($('.bilty-col-search[data-col="vehicleno"]').val() || '').trim();
                var sBilNo   = ($('.bilty-col-search[data-col="bilno"]').val() || '').trim();
                var sBillTiNo= ($('.bilty-col-search[data-col="billtino"]').val() || '').trim();
                var sNetAmt  = ($('.bilty-col-search[data-col="netamt"]').val() || '').trim();
                var sGlobal  = ($('#modalBiltySearch').val() || '').trim();

                var hasActiveSearch = (sDocDate !== '' || sCusName !== '' || sVehicle !== '' || sBilNo !== '' || sBillTiNo !== '' || sNetAmt !== '' || sGlobal !== '');

                $('#allSelectedMsgRow').toggle(!hasActiveSearch && $('#tblPartyBiltisBody tr.bilty-row:not(.already-selected)').length === 0);
                $('#noExactMatchRow').remove();

                var visibleCount = 0;

                $('#tblPartyBiltisBody tr.bilty-row').each(function () {
                    var $tr = $(this);
                    var isSelected = $tr.hasClass('already-selected');

                    if (!hasActiveSearch) {
                        // When NO search active, only show unselected/pending rows
                        var shouldShow = !isSelected;
                        $tr.toggle(shouldShow);
                        if (shouldShow) visibleCount++;
                        return;
                    }

                    // WHEN ACTIVE SEARCH: EXACT MATCH ONLY, EVEN ITS SELECTED OR NOT!
                    var rDocDate    = $tr.data('docdate') || '';
                    var rDocDateRaw = $tr.data('docdateraw') || '';
                    var rCusName    = $tr.data('cusname') || '';
                    var rVehicle    = $tr.data('vehicleno') || '';
                    var rBilNo      = $tr.data('bilno') || '';
                    var rBillTiNo   = $tr.data('billtino') || '';
                    var rNetAmt     = $tr.data('netamt') || '';

                    var match = true;

                    if (sDocDate && !isExactMatch(sDocDate, rDocDate, false, true, rDocDateRaw)) match = false;
                    if (match && sCusName && !isExactMatch(sCusName, rCusName, false)) match = false;
                    if (match && sVehicle && !isExactMatch(sVehicle, rVehicle, false)) match = false;
                    if (match && sBilNo && !isExactMatch(sBilNo, rBilNo, true)) match = false;
                    if (match && sBillTiNo && !isExactMatch(sBillTiNo, rBillTiNo, true)) match = false;
                    if (match && sNetAmt && !isExactMatch(sNetAmt, rNetAmt, true)) match = false;

                    if (match && sGlobal) {
                        // Global exact match on any field
                        var rVono = $tr.data('vono') || '';
                        var gMatch = isExactMatch(sGlobal, rBillTiNo, true) ||
                                     isExactMatch(sGlobal, rBilNo, true) ||
                                     isExactMatch(sGlobal, rNetAmt, true) ||
                                     isExactMatch(sGlobal, rVehicle, false) ||
                                     isExactMatch(sGlobal, rCusName, false) ||
                                     isExactMatch(sGlobal, rDocDate, false, true, rDocDateRaw) ||
                                     isExactMatch(sGlobal, rVono, false);
                        if (!gMatch) match = false;
                    }

                    $tr.toggle(match);
                    if (match) visibleCount++;
                });

                if (hasActiveSearch && visibleCount === 0) {
                    $('#tblPartyBiltisBody').append(`
                        <tr id="noExactMatchRow">
                            <td colspan="7" class="text-center py-4 text-danger">
                                <i class="fa fa-search me-1"></i> No exact matching bilty found.
                            </td>
                        </tr>
                    `);

                    // Server-side fallback search across database if not found locally
                    clearTimeout(biltyServerSearchTimer);
                    biltyServerSearchTimer = setTimeout(function () {
                        var partyId = $('#modalPartySelect').val();
                        $.ajax({
                            url: '/Voucher/SearchPartyBiltis',
                            type: 'GET',
                            data: {
                                partyId: partyId,
                                docDate: sDocDate,
                                cusName: sCusName,
                                vehicleNo: sVehicle,
                                bilNo: sBilNo,
                                billTiNo: sBillTiNo,
                                netAmt: sNetAmt,
                                q: sGlobal
                            },
                            success: function (res) {
                                if (res && res.success && res.data && res.data.length > 0) {
                                    $('#noExactMatchRow').remove();
                                    res.data.forEach(function (b) {
                                        if ($(`#tblPartyBiltisBody tr.bilty-row[data-id="${b.id}"]`).length === 0) {
                                            var netAmtFormatted = (parseFloat(b.netAmt) || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                                            var badgeHtml = '';
                                            if (b.isUsed) {
                                                if (b.vono && b.voucherId) {
                                                    badgeHtml = `<a href="/Voucher/Edit/${b.voucherId}" target="_blank" class="badge bg-secondary ms-1 text-white text-decoration-none shadow-sm" style="font-size:0.75rem;" onclick="event.stopPropagation();" title="Open Voucher ${escapeHtml(b.vono)} in new tab">Selected: ${escapeHtml(b.vono)} <i class="fa fa-external-link" style="font-size:0.65rem;"></i></a>`;
                                                } else {
                                                    badgeHtml = `<span class="badge bg-secondary ms-1 shadow-sm" style="font-size:0.75rem;" title="Already Selected">Selected</span>`;
                                                }
                                            }
                                            var rowHtml = `
                                                <tr class="bilty-row ${b.isUsed ? 'already-selected' : ''}" 
                                                    data-id="${b.id}" 
                                                    data-docno="${escapeHtml(b.docNo)}"
                                                    data-vono="${escapeHtml(b.vono || '')}"
                                                    data-voucherid="${b.voucherId || ''}"
                                                    data-docdate="${escapeHtml(b.docDate)}" 
                                                    data-docdateraw="${escapeHtml(b.docDateRaw)}"
                                                    data-cusname="${escapeHtml(b.cusName)}" 
                                                    data-vehicleno="${escapeHtml(b.vehicleNo)}" 
                                                    data-bilno="${escapeHtml(b.bilNo)}" 
                                                    data-billtino="${escapeHtml(b.billTiNo)}" 
                                                    data-netamt="${b.netAmt}">
                                                    <td class="text-center">
                                                        <input type="checkbox" class="form-check-input bilty-chk" value="${b.id}" />
                                                    </td>
                                                    <td class="text-center fw-semibold text-secondary">${escapeHtml(b.docDate)}</td>
                                                    <td>${escapeHtml(b.cusName)} ${badgeHtml}</td>
                                                    <td class="text-center">${escapeHtml(b.vehicleNo)}</td>
                                                    <td class="text-center fw-bold text-dark">${escapeHtml(b.bilNo)}</td>
                                                    <td class="text-center fw-bold text-primary">${escapeHtml(b.billTiNo)}</td>
                                                    <td class="text-end fw-bold text-success">${netAmtFormatted}</td>
                                                </tr>
                                            `;
                                            $('#tblPartyBiltisBody').append(rowHtml);
                                        }
                                    });
                                    updateModalCounters();
                                }
                            }
                        });
                    }, 400);
                }

                $('#modalTotalBiltisCount').text(hasActiveSearch ? visibleCount : $('#tblPartyBiltisBody tr.bilty-row:visible').length);
                updateModalCounters();
            }

            // Live column search inputs & global search input
            $(document).on('input change', '.bilty-col-search', function () {
                filterPartyBiltis();
            });

            $('#modalBiltySearch').on('input', function () {
                filterPartyBiltis();
            });

            // Show All button -> clear search and show all rows
            $('#btnModalShowAll').on('click', function () {
                $('#modalBiltySearch').val('');
                $('.bilty-col-search').val('');
                filterPartyBiltis();
            });

            // Refresh button -> re-fetch biltis from server
            $('#btnModalRefresh').on('click', function () {
                $('.bilty-col-search').val('');
                $('#modalBiltySearch').val('');
                var partyId = $('#modalPartySelect').val();
                loadPartyBiltis(partyId);
            });

            // Toggle Select All checkboxes
            $('#chkSelectAllBiltis').on('change', function () {
                var checked = $(this).is(':checked');
                $('#tblPartyBiltisBody tr.bilty-row:visible .bilty-chk').prop('checked', checked);
                updateModalCounters();
            });

            // Individual checkbox change
            $(document).on('change', '.bilty-chk', function () {
                updateModalCounters();
            });

            // Clicking row toggles checkbox (except clicking checkbox itself)
            $(document).on('click', '#tblPartyBiltisBody tr.bilty-row', function (e) {
                if ($(e.target).is('input[type="checkbox"]')) return;
                var $chk = $(this).find('.bilty-chk');
                $chk.prop('checked', !$chk.is(':checked')).trigger('change');
            });

            // Update modal summary stats (selected count and selected amount)
            function updateModalCounters() {
                var selectedCount = 0;
                var selectedAmt = 0;

                $('#tblPartyBiltisBody tr.bilty-row').each(function () {
                    var $chk = $(this).find('.bilty-chk');
                    if ($chk.is(':checked')) {
                        selectedCount++;
                        selectedAmt += parseFloat($(this).data('netamt') || 0);
                    }
                });

                $('#modalSelectedCount').text(selectedCount);
                $('#modalSelectedAmount').text(selectedAmt.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }));
            }

            // Save selected biltis from Modal into Voucher Detail Grid
            $('#btnModalSaveBiltis').on('click', function () {
                var selectedBiltis = [];
                var partyId = $('#modalPartySelect').val() || $('#Head_Partycode').val();

                $('#tblPartyBiltisBody tr.bilty-row').each(function () {
                    var $chk = $(this).find('.bilty-chk');
                    if ($chk.is(':checked')) {
                        selectedBiltis.push({
                            id: $(this).data('id'),
                            docDate: $(this).data('docdate'),
                            cusName: $(this).data('cusname'),
                            vehicleNo: $(this).data('vehicleno'),
                            bilNo: $(this).data('bilno'),
                            billTiNo: $(this).data('billtino'),
                            netAmt: parseFloat($(this).data('netamt') || 0)
                        });
                    }
                });

                if (selectedBiltis.length === 0) {
                    alert('Please select at least one bilty to import.');
                    return;
                }

                // If the detail grid currently has only 1 blank row, remove that blank row
                var $existingRows = $('#tbl tbody tr:not(#noDataRow)');
                if ($existingRows.length === 1) {
                    var $firstRow = $existingRows.first();
                    var accVal = $firstRow.find('select[name*="gl3Id"]').val();
                    var bNoVal = $firstRow.find('input[name*="Billtino"]').val();
                    var drVal = $firstRow.find('input[name*="Dramt"]').val();
                    var crVal = $firstRow.find('input[name*="Cramt"]').val();

                    if (!accVal && !bNoVal && !drVal && !crVal) {
                        $firstRow.remove();
                    }
                }

                // Default narration
                var masterNarr = $('#Head_Narration').val() || '';

                // Add each checked bilty to the voucher grid
                selectedBiltis.forEach(function (b) {
                    var rowNarration = masterNarr;
                    var cramt = b.netAmt.toFixed(2);

                    addRow({
                        gl3Id: partyId,
                        billTiNo: b.billTiNo,
                        bilNo: b.bilNo,
                        vehicleNo: b.vehicleNo,
                        dramt: '',
                        cramt: cramt,
                        narration: rowNarration,
                        id: b.id,
                        cusName: b.cusName
                    });
                });

                reindexDetailRows();

                // Close the modal
                var modalEl = document.getElementById('partyBiltyModal');
                var modalInstance = bootstrap.Modal.getInstance(modalEl);
                if (modalInstance) {
                    modalInstance.hide();
                }

                // Recalculate totals
                calc();
            });
            </text>
        }
    </script>
}
