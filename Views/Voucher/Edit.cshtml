@section scripts {
    <script>
        let i = @(Model.Details?.Count ?? 0);
        let type = '@ViewBag.VoucherType';
        let isFull = (type === "JV" || type === "CP" || type === "BP");
        let isReceipt = (type === "CR" || type === "BR");
        let isCashReceipt = (type === "CR");
        let isBankReceipt = (type === "BR");
        let isCashPayment = (type === "CP");
        let isBankPayment = (type === "BP");

        // Determine which columns to show
        let showDebit = !(isCashReceipt || isBankReceipt);
        let showCredit = !(isCashPayment || isBankPayment);

        function addRow() {
            // Transport column
            let transportCol = (isReceipt || isFull) ? `
                <td>
                    <select name="Details[${i}].Transcode" class="form-control select2">
                        <option value="">Select Transport</option>
                        @foreach (var acc in ViewBag.transporterList)
                        {
                                <option value="@acc.Value">@acc.Text</option>
                        }
                    </select>
                </td>
            ` : "";

            // Vehicle column
            let vehicleCol = (isReceipt || isFull) ? `
                <td><input name="Details[${i}].Vehicleno" class="form-control"/></td>
            ` : "";

            // Debit column
            let debitCol = showDebit ? `
                <td><input name="Details[${i}].Dramt" onkeyup="calc()" class="form-control"/></td>
            ` : "";

            // Credit column
            let creditCol = showCredit ? `
                <td><input name="Details[${i}].Cramt" onkeyup="calc()" class="form-control"/></td>
            ` : "";

            // Tax column
            let taxCol = (isCashReceipt || isCashPayment || isFull) ? `
                <td><input name="Details[${i}].Ptax" class="form-control"/></td>
            ` : "";

            // Cheque columns
            let chequeCols = (isBankReceipt || isBankPayment || isFull) ? `
                <td><input name="Details[${i}].Chqno" class="form-control"/></td>
                <td><input name="Details[${i}].ChqDate" type="date" class="form-control"/></td>
            ` : "";

            let row = `
            <tr>
                <td>
                    <select name="Details[${i}].gl3Id" class="form-control select2">
                        <option>Select Account</option>
                        @foreach (var acc in ViewBag.Accounts)
                        {
                                <option value="@acc.Value">@acc.Text</option>
                        }
                    </select>
                    <input type="hidden" name="Details[${i}].Id" value="0" />
                </td>

                ${transportCol}

                <td><input name="Details[${i}].Billtino" class="form-control"/></td>
                <td><input name="Details[${i}].Bilno" class="form-control"/></td>

                ${vehicleCol}

                ${debitCol}
                ${creditCol}

                ${chequeCols}

                ${taxCol}

                <td><input name="Details[${i}].Narration" class="form-control"/></td>

                <td>
                    <button type="button" class="btn btn-danger btn-sm" onclick="removeRow(this)">
                        <i class="fa fa-trash"></i>
                    </button>
                </td>
            </tr>`;

            // Remove no data row if exists
            let noDataRow = document.getElementById("noDataRow");
            if (noDataRow) {
                noDataRow.remove();
            }

            document.querySelector("#tbl tbody").insertAdjacentHTML("beforeend", row);
            
            // Re-initialize select2 for new selects
            $('.select2').select2();
            
            i++;
            calc();
        }

        function calc() {
            let dr = 0, cr = 0;
            const rows = document.querySelectorAll("#tbl tbody tr:not(#noDataRow)");
            let entries = 0;

            rows.forEach(tr => {
                let d = +(tr.querySelector("[name*='Dramt']")?.value || 0);
                let c = +(tr.querySelector("[name*='Cramt']")?.value || 0);

                if (d > 0 || c > 0) entries++;

                dr += d;
                cr += c;
            });

            let diff = dr - cr;

            document.getElementById("dr").innerText = dr.toFixed(2);
            document.getElementById("cr").innerText = cr.toFixed(2);
            document.getElementById("df").innerText = diff.toFixed(2);
            document.getElementById("entries").innerText = entries;
        }

        function removeRow(btn) {
            btn.closest('tr').remove();

            let rows = document.querySelectorAll("#tbl tbody tr");

            if (rows.length === 0) {
                document.querySelector("#tbl tbody").innerHTML = `
                    <tr id="noDataRow">
                        <td colspan="20" class="text-center text-muted py-3">
                            <i class="fa fa-inbox me-1"></i> No Data Available
                        </td>
                    </tr>`;
            }

            calc();
        }

        $(document).ready(function () {
            $('.select2').select2();
            calc(); // Calculate totals on page load
        });
    </script>
} *@

