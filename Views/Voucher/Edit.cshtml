@using Nskg.Models.ViewModels
@model VoucherVM

<form method="post" class="form-dense">
    <input type="hidden" asp-for="Head.Id" />
    <input type="hidden" asp-for="Head.Votype" />

    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-2">
        <div class="d-flex align-items-center gap-2">
            <div>
                <h4 class="mb-0 fw-bold text-navy">
                    <i class="fa fa-edit text-primary me-2"></i>
                    Edit @(ViewBag.Votype ?? Model?.Head?.Votype ?? "Voucher")
                </h4>
                <small class="text-muted" style="font-size: 11px;">
                    <i class="fa fa-info-circle me-1"></i>
                    Update accounting voucher entries
                </small>
            </div>
            @if (!string.IsNullOrEmpty(Model?.Head?.Vono))
            {
                <span class="badge bg-primary fs-7 px-2 py-1 shadow-sm"><i class="fa fa-hashtag me-1"></i>@Model.Head.Vono</span>
            }
        </div>
        <div class="d-flex flex-wrap align-items-center gap-1">
            @if (ViewBag.PrevId != null)
            {
                <a href="@Url.Action("Edit", new { id = ViewBag.PrevId })" class="btn btn-outline-secondary btn-sm custom-btn" title="Previous Entry">
                    <i class="fa fa-arrow-left me-1"></i> Prev
                </a>
            }
            else
            {
                <button type="button" class="btn btn-outline-secondary btn-sm custom-btn disabled" disabled>
                    <i class="fa fa-arrow-left me-1"></i> Prev
                </button>
            }

            @if (ViewBag.NextId != null)
            {
                <a href="@Url.Action("Edit", new { id = ViewBag.NextId })" class="btn btn-outline-secondary btn-sm custom-btn" title="Next Entry">
                    Next <i class="fa fa-arrow-right ms-1"></i>
                </a>
            }
            else
            {
                <button type="button" class="btn btn-outline-secondary btn-sm custom-btn disabled" disabled>
                    Next <i class="fa fa-arrow-right ms-1"></i>
                </button>
            }

            <a asp-action="Create" asp-route-type="@(Model?.Head?.Votype ?? ViewBag.VoucherType)" class="btn btn-outline-primary btn-sm custom-btn me-2" title="New Entry">
                <i class="fa fa-plus-circle me-1"></i> New
            </a>

            @if (Model?.Head?.Votype == "CR" || ViewBag.VoucherType == "CR")
            {
                <button type="button" class="btn btn-outline-info btn-sm custom-btn me-2 btnOpenPartyModal" title="Show pending biltys for selected party">
                    <i class="fa fa-truck me-1"></i> Party
                </button>
            }

            <button type="button" id="btnAddRow" class="btn btn-outline-primary btn-sm custom-btn me-2" onclick="addRow()">
                <i class="fa fa-plus me-1"></i> Add Row
            </button>

            <button type="submit" id="btnUpdate" class="btn btn-success btn-sm custom-btn shadow-sm">
                <i class="fa fa-save me-1"></i> Update Voucher
            </button>
        </div>
    </div>

    <!-- MASTER -->
    <div class="card custom-card border-0 shadow-sm mb-2">
        <div class="card-header bg-white border-bottom py-1 px-3 d-flex justify-content-between align-items-center">
            <h6 class="mb-0 fw-semibold text-navy" style="font-size: 13px;">
                <i class="fa fa-sliders text-primary me-1"></i> General Details
            </h6>
        </div>
        <div class="card-body py-2 px-3">
            <div class="row g-2">
                <div class="col-md-2">
                    <label class="form-label small text-muted fw-semibold mb-0">
                        <i class="fa fa-hashtag text-primary me-1"></i> Voucher No
                    </label>
                    <input asp-for="Head.Vono" class="form-control form-control-sm" readonly />
                </div>
                <div class="col-md-2">
                    <label class="form-label small text-muted fw-semibold mb-0">
                        <i class="fa fa-calendar text-primary me-1"></i> Trans Date
                    </label>
                    <input asp-for="Head.Vodate" type="date" value="@(Model?.Head?.Vodate?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" />
                </div>
                <div class="col-md-2">
                    <label class="form-label small text-muted fw-semibold mb-0">
                        <i class="fa fa-clock-o text-primary me-1"></i> Entry Date
                    </label>
                    <input asp-for="Head.EntryDate" type="date" value="@(Model?.Head?.EntryDate?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" readonly />
                </div>
                <div class="col-md-3">
                    <label class="form-label small text-muted fw-semibold mb-0">
                        <i class="fa fa-university text-primary me-1"></i> Account
                    </label>
                    <select asp-for="Head.gl3Id" class="form-select form-select-sm select2">
                        <option value="">-- Select Account --</option>
                        @if (ViewBag.HeaderAccounts != null)
                        {
                            foreach (var acc in (IEnumerable<SelectListItem>)ViewBag.HeaderAccounts)
                            {
                                bool isSelected = acc.Value == Model?.Head?.gl3Id?.ToString() || (!string.IsNullOrEmpty(Model?.Head?.Haccode) && acc.Text.Contains("(" + Model?.Head?.Haccode + ")"));
                                <option value="@acc.Value" selected="@(isSelected ? "selected" : null)">@acc.Text</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <div class="d-flex justify-content-between align-items-center mb-0">
                        <label class="form-label small text-muted fw-semibold mb-0">
                            <i class="fa fa-exchange text-primary me-1"></i> Pay / Receive
                        </label>
                        @if (Model?.Head?.Votype == "CR" || ViewBag.VoucherType == "CR")
                        {
                            <button type="button" class="btn btn-primary btn-xs py-0 px-2 rounded btnOpenPartyModal" style="font-size: 11px;" title="Fetch pending biltis for selected party">
                                <i class="fa fa-truck me-1"></i> Party
                            </button>
                        }
                    </div>
                    <select asp-for="Head.Partycode" class="form-select form-select-sm select2">
                        <option value="">-- Select Party Account --</option>
                        @if (ViewBag.PartyAccounts != null)
                        {
                            foreach (var acc in (IEnumerable<SelectListItem>)ViewBag.PartyAccounts)
                            {
                                if (string.IsNullOrEmpty(acc.Value)) { continue; }
                                bool isSelected = acc.Value == Model?.Head?.Partycode || (!string.IsNullOrEmpty(Model?.Head?.Partycode) && acc.Text.Contains("(" + Model?.Head?.Partycode + ")"));
                                <option value="@acc.Value" selected="@(isSelected ? "selected" : null)">@acc.Text</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-5">
                    <label class="form-label small text-muted fw-semibold mb-0">
                        <i class="fa fa-user text-primary me-1"></i> Payee / Receiver
                    </label>
                    <input asp-for="Head.PersonName" class="form-control form-control-sm" />
                </div>
                <div class="col-md-3">
                    <label class="form-label small text-muted fw-semibold mb-0">
                        <i class="fa fa-list-ol text-primary me-1"></i> Reference No
                    </label>
                    <input asp-for="Head.Invno" class="form-control form-control-sm" />
                </div>
                <div class="col-md-4">
                    <label class="form-label small text-muted fw-semibold mb-0">
                        <i class="fa fa-comment text-primary me-1"></i> Narration
                    </label>
                    <input asp-for="Head.Narration" class="form-control form-control-sm" />
                </div>
            </div>
        </div>
    </div>

    <!-- DETAILS -->
    <div class="card custom-card border-0 shadow-sm voucher-grid-card">
        <div class="card-header d-flex justify-content-between align-items-center bg-white border-bottom py-1 px-3">
            <h6 class="mb-0 fw-semibold text-navy" style="font-size: 13px;">
                <i class="fa fa-list text-primary me-1"></i> Voucher Details
            </h6>
            <span class="badge bg-light text-dark fs-7 px-2 py-1">
                <i class="fa fa-pencil me-1"></i> Edit Mode
            </span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive voucher-table-container">
                <table class="table table-hover table-bordered align-middle mb-0" id="tbl">
                    <thead class="table-light text-center" style="position: sticky; top: 0; z-index: 2;">
                        <tr>
                            <th style="width: 22%; min-width: 200px;">
                                <i class="fa fa-university text-primary me-1"></i>
                                Account
                            </th>
                            <th style="width: 8%; min-width: 85px;">
                                <i class="fa fa-tag text-primary me-1"></i>
                                Bilti No
                            </th>
                            <th style="width: 8%; min-width: 85px;">
                                <i class="fa fa-file-text text-primary me-1"></i>
                                Bill No
                            </th>
                            <th class="text-success" style="width: 10%; min-width: 95px;">
                                <i class="fa fa-arrow-down me-1"></i>
                                Debit
                            </th>
                            <th class="text-danger" style="width: 10%; min-width: 95px;">
                                <i class="fa fa-arrow-up me-1"></i>
                                Credit
                            </th>
                            @if (Model.Head.Votype == "CP" || Model.Head.Votype == "CR" || Model.Head.Votype == "JV")
                            {
                                <th style="width: 7%; min-width: 75px;">
                                    <i class="fa fa-percent text-primary me-1"></i>
                                    Tax
                                </th>
                            }
                            <th style="width: 37%; min-width: 350px;">
                                <i class="fa fa-comment text-primary me-1"></i>
                                Narration
                            </th>
                            <th style="width: 5%; min-width: 50px;">
                                <i class="fa fa-cog text-primary me-1"></i>
                                Action
                            </th>
                        </tr>
                    </thead>
                    <tbody id="tbody">
                        @if (Model.Details != null && Model.Details.Any())
                        {
                            @for (int idx = 0; idx < Model.Details.Count; idx++)
                            {
                                var d = Model.Details[idx];
                                <tr>
                                    <td>
                                        <select name="Details[@idx].gl3Id" class="form-control select2">
                                            <option value="">Select Account</option>
                                            @if (ViewBag.Accounts != null)
                                            {
                                                foreach (var acc in ViewBag.Accounts)
                                                {
                                                    bool isSelected = acc.Value == d.gl3Id?.ToString() || (!string.IsNullOrEmpty(d.Acc) && acc.Text.Contains("(" + d.Acc + ")"));
                                                    <option value="@acc.Value" selected="@(isSelected ? "selected" : null)">@acc.Text</option>
                                                }
                                            }
                                        </select>
                                        <input type="hidden" name="Details.Index" value="@idx" />
                                        <input type="hidden" name="Details[@idx].Id" value="@d.Id" />
                                        <input type="hidden" name="Details[@idx].Vehicleno" value="@d.Vehicleno" />
                                    </td>
                                    <td><input name="Details[@idx].Billtino" value="@d.Billtino" class="form-control" /></td>
                                    <td><input name="Details[@idx].Bilno" value="@d.Bilno" class="form-control" /></td>
                                    <td><input name="Details[@idx].Dramt" value="@(d.Dramt.HasValue && d.Dramt.Value > 0 ? d.Dramt.Value.ToString("0.00") : "")" oninput="calc()" class="form-control" /></td>
                                    <td><input name="Details[@idx].Cramt" value="@(d.Cramt.HasValue && d.Cramt.Value > 0 ? d.Cramt.Value.ToString("0.00") : "")" oninput="calc()" class="form-control" /></td>
                                    @if (Model.Head.Votype == "CP" || Model.Head.Votype == "CR" || Model.Head.Votype == "JV")
                                    {
                                        <td><input name="Details[@idx].Ptax" value="@d.Ptax" class="form-control" /></td>
                                    }
                                    <td><input name="Details[@idx].Narration" value="@d.Narration" class="form-control" /></td>
                                    <td>
                                        <button type="button" class="btn btn-danger btn-sm" onclick="removeRow(this)">
                                            <i class="fa fa-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr id="noDataRow">
                                <td colspan="20" class="text-center text-muted py-2">
                                    <i class="fa fa-inbox me-1"></i> No Data Available
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- SUMMARY / TOTALS BAR -->
    <div class="card border-0 shadow-sm voucher-totals-bar">
        <div class="card-body py-2 px-3">
            <div class="row text-center align-items-center g-2">
                <div class="col-3 border-end">
                    <span class="text-muted small me-2"><i class="fa fa-list text-secondary me-1"></i> Entries:</span>
                    <strong id="entries" class="fw-bold fs-6 text-dark">0</strong>
                </div>
                <div class="col-3 border-end">
                    <span class="text-muted small me-2"><i class="fa fa-arrow-down text-success me-1"></i> Debit:</span>
                    <strong id="dr" class="text-success fw-bold fs-6">0.00</strong>
                </div>
                <div class="col-3 border-end">
                    <span class="text-muted small me-2"><i class="fa fa-arrow-up text-danger me-1"></i> Credit:</span>
                    <strong id="cr" class="text-danger fw-bold fs-6">0.00</strong>
                </div>
                <div class="col-3">
                    <span class="text-muted small me-2"><i class="fa fa-balance-scale text-primary me-1"></i> Difference:</span>
                    <strong id="df" class="text-primary fw-bold fs-6">0.00</strong>
                </div>
            </div>
        </div>
    </div>
</form>

@if (Model?.Head?.Votype == "CR" || ViewBag.VoucherType == "CR")
{
    <!-- ======================================================== -->
    <!-- 🔥 PARTYS PENDING BILTIS MODAL (MATCHING ORACLE FORMS) -->
    <!-- ======================================================== -->
    <div class="modal fade" id="partyBiltyModal" tabindex="-1" aria-labelledby="partyBiltyModalLabel" aria-hidden="true" data-bs-backdrop="static">
        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content shadow-lg border-0">
                <div class="modal-header bg-navy text-white py-2 px-3">
                    <div class="d-flex align-items-center">
                        <i class="fa fa-truck text-warning me-2 fs-5"></i>
                        <h5 class="modal-title mb-0 fw-bold fs-6" id="partyBiltyModalLabel">Partys Biltis</h5>
                        <span class="badge bg-warning text-dark ms-3 fs-7" id="modalPartyBadge">No Party Selected</span>
                    </div>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body py-2 px-3">
                    <!-- Toolbar: Party Selector, Search, Summary -->
                    <div class="row g-2 align-items-center mb-2 pb-2 border-bottom">
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold text-muted mb-0">Party Account:</label>
                            <select id="modalPartySelect" class="form-select form-select-sm select2">
                                @if (ViewBag.PartyAccounts != null)
                                {
                                    foreach (var p in (IEnumerable<SelectListItem>)ViewBag.PartyAccounts)
                                    {
                                        <option value="@p.Value">@p.Text</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold text-muted mb-0">Search in Biltis:</label>
                            <div class="input-group input-group-sm">
                                <span class="input-group-text bg-white"><i class="fa fa-search text-muted"></i></span>
                                <input type="text" id="modalBiltySearch" class="form-control" placeholder="Search by Bilty #, Bill #, Vehicle..." />
                            </div>
                        </div>
                        <div class="col-md-4 text-end pt-3">
                            <span class="text-muted small">Pending:</span> <strong id="modalTotalBiltisCount" class="text-primary fs-6">0</strong>
                            <span class="mx-2 text-muted">|</span>
                            <span class="text-muted small">Selected:</span> <strong id="modalSelectedCount" class="text-success fs-6">0</strong>
                            <span class="mx-2 text-muted">|</span>
                            <span class="text-muted small">Total:</span> <strong id="modalSelectedAmount" class="text-success fs-6">0.00</strong>
                        </div>
                    </div>

                    <!-- Biltis Table -->
                    <div class="table-responsive" style="max-height: 420px; min-height: 250px;">
                        <table class="table table-sm table-bordered table-hover align-middle mb-0" id="tblPartyBiltis">
                            <thead class="table-light sticky-top" style="top: 0; z-index: 2;">
                                <tr class="text-center align-middle">
                                    <th style="width: 45px;">
                                        <input type="checkbox" id="chkSelectAllBiltis" class="form-check-input" title="Select All" />
                                    </th>
                                    <th style="width: 125px;">Docdate</th>
                                    <th>Cusname</th>
                                    <th style="width: 120px;">Vehicleno</th>
                                    <th style="width: 100px;">Bilno</th>
                                    <th style="width: 100px;">Billtino</th>
                                    <th style="width: 130px;" class="text-end">Netamt</th>
                                </tr>
                                <tr class="bg-white filter-row align-middle">
                                    <th class="text-center text-muted small"><i class="fa fa-search text-warning"></i></th>
                                    <th><input type="text" class="form-control form-control-sm bilty-col-search" data-col="docdate" placeholder="Search Date" /></th>
                                    <th><input type="text" class="form-control form-control-sm bilty-col-search" data-col="cusname" placeholder="Search Party" /></th>
                                    <th><input type="text" class="form-control form-control-sm bilty-col-search" data-col="vehicleno" placeholder="Search Vehicle #" /></th>
                                    <th><input type="text" class="form-control form-control-sm bilty-col-search" data-col="bilno" placeholder="Search Bil #" /></th>
                                    <th><input type="text" class="form-control form-control-sm bilty-col-search" data-col="billtino" placeholder="Search Bilty #" /></th>
                                    <th><input type="text" class="form-control form-control-sm bilty-col-search text-end" data-col="netamt" placeholder="Search Net" /></th>
                                </tr>
                            </thead>
                            <tbody id="tblPartyBiltisBody">
                                <tr>
                                    <td colspan="7" class="text-center py-4 text-muted">
                                        <i class="fa fa-info-circle me-1"></i> Please select a party to load biltis.
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="modal-footer bg-light py-2 px-3 d-flex justify-content-between align-items-center">
                    <div>
                        <span class="badge bg-secondary me-2" id="modalStatusMsg"></span>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-success btn-sm px-3 shadow-sm" id="btnModalSaveBiltis">
                            <i class="fa fa-save me-1"></i> Save
                        </button>
                        <button type="button" class="btn btn-outline-secondary btn-sm px-3" id="btnModalShowAll">
                            <i class="fa fa-list me-1"></i> Show All
                        </button>
                        <button type="button" class="btn btn-outline-primary btn-sm px-3" id="btnModalRefresh">
                            <i class="fa fa-refresh me-1"></i> Refresh
                        </button>
                        <button type="button" class="btn btn-secondary btn-sm px-3" data-bs-dismiss="modal">
                            <i class="fa fa-times me-1"></i> Exit
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@section scripts {
    <script>
        let i = @(Model.Details?.Count ?? 0);
        const type = '@Model.Head.Votype';

        function escapeHtml(text) {
            if (!text) return "";
            return String(text).replace(/&/g, "&amp;").replace(/"/g, "&quot;").replace(/'/g, "&#039;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
        }

        const isFullType = ["CP", "CR", "JV"].includes(type);
        const showTax    = isFullType;

        // Voucher rule engine
        const VoucherRules = {
            CP: { debit: true, credit: false },
            CR: { debit: false, credit: true },
            BP: { debit: true, credit: false },
            BR: { debit: false, credit: true },
            JV: { debit: true, credit: true }
        };

        const rule = VoucherRules[type] || VoucherRules.JV;

        function applyRowRules(row) {
            const dr = row.querySelector("[name*='Dramt']");
            const cr = row.querySelector("[name*='Cramt']");

            if (dr) {
                dr.readOnly = !rule.debit;
                if (!rule.debit) {
                    dr.classList.add("bg-light");
                    dr.tabIndex = -1;
                    dr.value = "";
                } else {
                    dr.classList.remove("bg-light");
                    dr.tabIndex = 0;
                }
            }

            if (cr) {
                cr.readOnly = !rule.credit;
                if (!rule.credit) {
                    cr.classList.add("bg-light");
                    cr.tabIndex = -1;
                    cr.value = "";
                } else {
                    cr.classList.remove("bg-light");
                    cr.tabIndex = 0;
                }
            }
        }

        function reindexDetailRows() {
            var $rows = $('#tbl tbody tr:not(#noDataRow)');
            $rows.each(function (idx) {
                var $tr = $(this);
                var $indexInput = $tr.find('input[name="Details.Index"]');
                if (!$indexInput.length) {
                    $tr.append(`<input type="hidden" name="Details.Index" value="${idx}" />`);
                } else {
                    $indexInput.val(idx);
                }

                $tr.find('[name]').each(function () {
                    var name = $(this).attr('name');
                    if (name && name.startsWith('Details[')) {
                        var newName = name.replace(/^Details\[\d+\]/, 'Details[' + idx + ']');
                        $(this).attr('name', newName);
                    }
                });
            });
            i = $rows.length;
        }

        function addRow(prefillData) {
            const noDataRow = document.getElementById("noDataRow");
            if (noDataRow) noDataRow.remove();

            // Default Narration from previous row, or from Master Narration
            let defaultNarration = "";
            if (prefillData && prefillData.narration !== undefined) {
                defaultNarration = prefillData.narration;
            } else {
                const prevNarrationInput = document.querySelector("#tbl tbody tr:not(#noDataRow):last-child input[name*='Narration']");
                if (prevNarrationInput && prevNarrationInput.value) {
                    defaultNarration = prevNarrationInput.value;
                } else {
                    const headNarr = document.querySelector("input[name='Head.Narration'], #Head_Narration");
                    if (headNarr && headNarr.value) {
                        defaultNarration = headNarr.value;
                    }
                }
            }

            const gl3Val = (prefillData && prefillData.gl3Id) ? String(prefillData.gl3Id) : "";
            const biltiVal = (prefillData && prefillData.billTiNo) ? escapeHtml(String(prefillData.billTiNo)) : "";
            const bilnoVal = (prefillData && prefillData.bilNo) ? escapeHtml(String(prefillData.bilNo)) : "";
            const vehVal = (prefillData && prefillData.vehicleNo) ? escapeHtml(prefillData.vehicleNo) : "";
            const dramtVal = (prefillData && prefillData.dramt !== undefined && prefillData.dramt !== null) ? prefillData.dramt : "";
            const cramtVal = (prefillData && prefillData.cramt !== undefined && prefillData.cramt !== null) ? prefillData.cramt : "";
            const biltyIdHidden = (prefillData && prefillData.id) ? `<input type="hidden" name="SelectedBiltyIds" value="${prefillData.id}" class="imported-bilty-id" />` : "";

            const row = document.createElement("tr");
            if (prefillData && prefillData.id) {
                row.setAttribute("data-bilty-id", prefillData.id);
            }

            row.innerHTML = `
                <td>
                    <select name="Details[${i}].gl3Id" class="form-control select2">
                        <option value="">Select Account</option>
                        @if (ViewBag.Accounts != null)
                        {
                            foreach (var acc in ViewBag.Accounts)
                            {
                                <option value="@acc.Value">@acc.Text</option>
                            }
                        }
                    </select>
                    <input type="hidden" name="Details.Index" value="${i}" />
                    <input type="hidden" name="Details[${i}].Id" value="0" />
                    ${biltyIdHidden}
                    <input type="hidden" name="Details[${i}].Vehicleno" value="${vehVal}" />
                </td>

                <td><input name="Details[${i}].Billtino" value="${biltiVal}" class="form-control"/></td>
                <td><input name="Details[${i}].Bilno" value="${bilnoVal}" class="form-control"/></td>

                <td><input name="Details[${i}].Dramt" value="${dramtVal}" oninput="calc()" class="form-control"/></td>
                <td><input name="Details[${i}].Cramt" value="${cramtVal}" oninput="calc()" class="form-control"/></td>

                ${showTax ? `<td><input name="Details[${i}].Ptax" class="form-control"/></td>` : ""}

                <td><input name="Details[${i}].Narration" value="${escapeHtml(defaultNarration)}" class="form-control"/></td>

                <td>
                    <button type="button" class="btn btn-danger btn-sm" onclick="removeRow(this)">
                        <i class="fa fa-trash"></i>
                    </button>
                </td>
            `;

            document.querySelector("#tbl tbody").appendChild(row);

            var $select = $(row).find("select[name*='gl3Id']");
            if (gl3Val) {
                if (!$select.find('option[value="' + gl3Val + '"]').length && prefillData.cusName) {
                    $select.append(new Option(prefillData.cusName, gl3Val, true, true));
                }
                $select.val(gl3Val);
            }

            $select.select2();
            if (gl3Val) {
                $select.val(gl3Val).trigger('change');
            }

            applyRowRules(row);

            i++;
            calc();
        }

        function calc() {
            let dr = 0, cr = 0, entries = 0;

            document.querySelectorAll("#tbl tbody tr:not(#noDataRow)").forEach(row => {
                const drInput = row.querySelector("[name*='Dramt']");
                const crInput = row.querySelector("[name*='Cramt']");

                const d = parseFloat(drInput?.value || 0);
                const c = parseFloat(crInput?.value || 0);

                if (d > 0 && c > 0) {
                    alert("Row cannot have both Debit and Credit");
                    drInput.value = "";
                    crInput.value = "";
                    return;
                }

                if (d > 0 || c > 0) entries++;

                dr += d;
                cr += c;
            });

            const diff = dr - cr;

            document.getElementById("dr").innerText = dr.toFixed(2);
            document.getElementById("cr").innerText = cr.toFixed(2);
            document.getElementById("df").innerText = (type === "JV" ? diff : 0).toFixed(2);
            document.getElementById("entries").innerText = entries;

            const submitBtns = document.querySelectorAll("button[type='submit']");
            let isValid = false;
            if (type === "JV") {
                isValid = (entries > 0 && diff === 0 && (dr > 0 || cr > 0));
            } else if (type === "CP" || type === "BP") {
                isValid = (entries > 0 && dr > 0);
            } else if (type === "CR" || type === "BR") {
                isValid = (entries > 0 && cr > 0);
            } else {
                isValid = (entries > 0 && (dr > 0 || cr > 0));
            }

            submitBtns.forEach(btn => {
                btn.disabled = !isValid;
                if (type === "JV") {
                    btn.classList.toggle("btn-danger", !isValid && entries > 0 && diff !== 0);
                    btn.classList.toggle("btn-success", isValid);
                } else {
                    btn.classList.remove("btn-danger");
                    btn.classList.add("btn-success");
                }
            });
        }

        function removeRow(btn) {
            btn.closest("tr").remove();

            const rows = document.querySelectorAll("#tbl tbody tr");

            if (rows.length === 0) {
                document.querySelector("#tbl tbody").innerHTML = `
                    <tr id="noDataRow">
                        <td colspan="20" class="text-center text-muted py-2">
                            <i class="fa fa-inbox me-1"></i> No Data Available
                        </td>
                    </tr>`;
            }

            reindexDetailRows();
            calc();
        }

        // ========================================================
        // 🚀 ENTER KEY NAVIGATION FOR VOUCHER GRID (#tbl)
        // ========================================================

        // Prevent accidental form submission on Enter inside all form inputs
        $(document).on('keydown', 'form.form-dense input, form.form-dense select', function(e) {
            if (e.key === 'Enter') {
                if (!$(e.target).is('#btnUpdate, #btnSave, button[type="submit"]')) {
                    e.preventDefault();
                }
            }
        });

        // 1. Enter on Master/Header Narration -> jumps to first Detail Row Account (focus, do not open)
        $(document).on('keydown', 'input[name="Head.Narration"], #Head_Narration', function(e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                e.stopPropagation();

                var $rows = $('#tbl tbody tr:not(#noDataRow)');
                if ($rows.length === 0) {
                    if (typeof addRow === 'function') addRow();
                    $rows = $('#tbl tbody tr:not(#noDataRow)');
                }
                var $firstAcc = $rows.first().find('select[name*="gl3Id"]');
                if ($firstAcc.length) {
                    AppNav.focusElement($firstAcc);
                }
            }
        });

        // Helper: Check if account in this row is selected
        function isRowAccountSelected($tr) {
            var $acc = $tr.find('select[name*="gl3Id"]');
            var val = $acc.val();
            return (val && val !== '' && val !== '0' && val !== 'Select Account');
        }

        // Helper: Jump to Save / Update button
        function jumpToSaveButton() {
            var $saveBtn = $('#btnUpdate, #btnSave, button[type="submit"]').filter(':visible').first();
            if ($saveBtn.length) {
                $saveBtn.prop('disabled', false).removeClass('disabled');
                $saveBtn.focus();
                if (typeof highlightField === 'function') highlightField($saveBtn);
                return true;
            }
            return false;
        }

        // 2. Intercept Enter on ANY list/Select2 in CAPTURE phase so Select2 never receives Enter to open the dropdown!
        window.addEventListener('keydown', function(e) {
            if (e.key === 'Enter') {
                var $target = $(e.target);
                var $selection = $target.closest('.select2-selection');
                if ($selection.length) {
                    var $container = $selection.closest('.select2-container');
                    if ($container.hasClass('select2-container--open')) {
                        return; // Let select2 pick option if open
                    }

                    // Dropdown is closed -> Stop Select2 from opening!
                    e.preventDefault();
                    e.stopPropagation();
                    e.stopImmediatePropagation();

                    var $tr = $selection.closest('tr');
                    if ($tr.length && $tr.closest('#tbl').length) {
                        // In detail grid row -> advance to Bilti No (or next visible input)
                        var $bilti = $tr.find('input[name*="Billtino"]:visible');
                        if ($bilti.length) {
                            AppNav.focusElement($bilti);
                        } else {
                            var $nextInput = $tr.find('input:not([type=hidden]):not([disabled]):visible').first();
                            if ($nextInput.length) AppNav.focusElement($nextInput);
                        }
                        return;
                    }

                    // Header Select2 lists
                    var $select = AppNav.getSelectFromSelection($selection);
                    if ($select.is('#Head_gl3Id, select[name*="gl3Id"]')) {
                        var $party = $('#Head_Partycode');
                        if ($party.length) return AppNav.focusElement($party);
                    } else if ($select.is('#Head_Partycode, select[name*="Partycode"]')) {
                        var $person = $('#Head_PersonName, input[name*="PersonName"]');
                        if ($person.length) return AppNav.focusElement($person);
                    }

                    if (typeof AppNav !== 'undefined' && AppNav.moveToNext) {
                        AppNav.moveToNext($select.length ? $select : $selection);
                    }
                    return;
                }

                // Native select element
                if ($target.is('select:not(.select2-hidden-accessible)')) {
                    e.preventDefault();
                    e.stopPropagation();
                    e.stopImmediatePropagation();
                    if (typeof AppNav !== 'undefined' && AppNav.moveToNext) {
                        AppNav.moveToNext($target);
                    }
                }
            }
        }, true);

        // 3. When an account is selected in #tbl via Select2 dropdown
        $(document).on('select2:select', '#tbl select[name*="gl3Id"]', function(e) {
            var $tr = $(this).closest('tr');
            setTimeout(function() {
                var $bilti = $tr.find('input[name*="Billtino"]:visible');
                if ($bilti.length) {
                    AppNav.focusElement($bilti);
                } else {
                    var $nextInput = $tr.find('input:not([type=hidden]):not([disabled]):visible').first();
                    if ($nextInput.length) AppNav.focusElement($nextInput);
                }
            }, 60);
        });

        // 4. Enter on Select2 search field when empty (user didn't choose an account)
        $(document).on('keydown', '.select2-search__field', function(e) {
            if (e.key === 'Enter') {
                var $search = $(this);
                var $openSelect = $('select.select2-hidden-accessible').filter(function() {
                    return $(this).data('select2') && $(this).data('select2').$container.hasClass('select2-container--open');
                });

                if ($openSelect.length && $openSelect.closest('#tbl').length) {
                    var $tr = $openSelect.closest('tr');
                    if (!$search.val()) {
                        e.preventDefault();
                        e.stopPropagation();
                        try { $openSelect.select2('close'); } catch(err) {}
                        var $bilti = $tr.find('input[name*="Billtino"]:visible');
                        if ($bilti.length) {
                            AppNav.focusElement($bilti);
                        } else {
                            var $nextInput = $tr.find('input:not([type=hidden]):not([disabled]):visible').first();
                            if ($nextInput.length) AppNav.focusElement($nextInput);
                        }
                    }
                }
            }
        });

        // 5. Enter on detail grid inputs (Bilti No -> Bill No -> Amount -> Tax -> Narration -> New Row)
        $(document).on('keydown', '#tbl tbody tr input:not([type=hidden])', function(e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                e.stopPropagation();

                var $currentInput = $(this);
                var $tr = $currentInput.closest('tr');
                var isLastInputInRow = $currentInput.is($tr.find('input:not([type=hidden]):not([disabled]):visible').last());

                if (isLastInputInRow) {
                    // Enter on last cell (Narration) -> Jump to Next Row Account OR Add New Row OR Jump to Save
                    var isAccSelected = isRowAccountSelected($tr);
                    if (!isAccSelected) {
                        jumpToSaveButton();
                        return;
                    }

                    var $allRows = $('#tbl tbody tr:not(#noDataRow)');
                    var currentRowIdx = $allRows.index($tr);

                    if (currentRowIdx < $allRows.length - 1) {
                        var $nextRow = $allRows.eq(currentRowIdx + 1);
                        var $nextAcc = $nextRow.find('select[name*="gl3Id"]');
                        if ($nextAcc.length) AppNav.focusElement($nextAcc);
                    } else {
                        addRow();
                        var $newRow = $('#tbl tbody tr:not(#noDataRow)').last();
                        var $newAcc = $newRow.find('select[name*="gl3Id"]');
                        if ($newAcc.length) AppNav.focusElement($newAcc);
                    }
                } else {
                    AppNav.moveToNext($currentInput);
                }
            }
        });

        // 6. Arrow key cell-by-cell navigation within detail grid (#tbl)
        $(document).on('keydown', '#tbl tbody tr input, #tbl tbody tr .select2-selection', function(e) {
            if (!['ArrowUp', 'ArrowDown', 'ArrowLeft', 'ArrowRight'].includes(e.key)) return;

            var $current = $(this);
            var $tr = $current.closest('tr');
            if (!$tr.length || !$tr.closest('#tbl').length) return;

            function getRowCells($row) {
                return $row.find('input:not([type=hidden]):visible, .select2-selection:visible');
            }

            var $cells = getRowCells($tr);
            var colIdx = $cells.index($current);
            var $allRows = $('#tbl tbody tr:not(#noDataRow)');
            var rowIdx = $allRows.index($tr);

            if (e.key === 'ArrowDown') {
                e.preventDefault();
                if (rowIdx < $allRows.length - 1) {
                    var $nextRow = $allRows.eq(rowIdx + 1);
                    var $nextCells = getRowCells($nextRow);
                    var targetIdx = Math.min(colIdx, $nextCells.length - 1);
                    if (targetIdx >= 0) {
                        var $target = $nextCells.eq(targetIdx);
                        $target.focus();
                        if ($target.is('input')) try { $target.select(); } catch(err) {}
                    }
                }
                return;
            }

            if (e.key === 'ArrowUp') {
                e.preventDefault();
                if (rowIdx > 0) {
                    var $prevRow = $allRows.eq(rowIdx - 1);
                    var $prevCells = getRowCells($prevRow);
                    var targetIdx = Math.min(colIdx, $prevCells.length - 1);
                    if (targetIdx >= 0) {
                        var $target = $prevCells.eq(targetIdx);
                        $target.focus();
                        if ($target.is('input')) try { $target.select(); } catch(err) {}
                    }
                }
                return;
            }

            if (e.key === 'ArrowRight') {
                var canRight = false;
                if ($current.hasClass('select2-selection')) {
                    canRight = true;
                } else if ($current.is('input')) {
                    var el = $current[0];
                    if (el.selectionStart !== el.selectionEnd || el.selectionEnd === el.value.length) {
                        canRight = true;
                    }
                }
                if (canRight && colIdx < $cells.length - 1) {
                    e.preventDefault();
                    var $nextCell = $cells.eq(colIdx + 1);
                    $nextCell.focus();
                    if ($nextCell.is('input')) try { $nextCell.select(); } catch(err) {}
                }
                return;
            }

            if (e.key === 'ArrowLeft') {
                var canLeft = false;
                if ($current.is('input')) {
                    var el = $current[0];
                    if (el.selectionStart !== el.selectionEnd || el.selectionStart === 0) {
                        canLeft = true;
                    }
                }
                if (canLeft && colIdx > 0) {
                    e.preventDefault();
                    var $prevCell = $cells.eq(colIdx - 1);
                    $prevCell.focus();
                    if ($prevCell.is('input')) try { $prevCell.select(); } catch(err) {}
                }
                return;
            }
        });

        $(document).ready(function () {
            $(".select2").select2();

            // Apply rules to all existing rows
            $('#tbl tbody tr:not(#noDataRow)').each(function () {
                applyRowRules(this);
            });

            reindexDetailRows();
            calc();
        });

        // Ensure rows are strictly indexed 0, 1, 2... before submitting form
        $('form').on('submit', function () {
            reindexDetailRows();
        });

        @if (Model?.Head?.Votype == "CR" || ViewBag.VoucherType == "CR")
        {
            <text>
            // ========================================================
            // 🔥 PARTYS PENDING BILTIS MODAL WORKFLOW (CR ONLY)
            // ========================================================
            let currentLoadedBiltis = [];

            // Open Modal handler (from toolbar button or header Pay/Receive button)
            $(document).on('click', '.btnOpenPartyModal', function (e) {
                e.preventDefault();
