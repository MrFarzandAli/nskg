                    },
                    error: function () {
                        $('#tblPartyBiltisBody').html(`
                            <tr>
                                <td colspan="7" class="text-center py-4 text-danger">
                                    <i class="fa fa-exclamation-circle me-1"></i> Server error while loading biltis.
                                </td>
                            </tr>
                        `);
                    }
                });
            }

            // Render Table: displays biltis with column exact match capability
            function renderPartyBiltisTable(items) {
                currentLoadedBiltis = items || [];

                // Collect all bilty IDs already present in #tbl
                var existingBiltyIds = new Set();
                $('#tbl input[name="SelectedBiltyIds"]').each(function () {
                    var v = $(this).val();
                    if (v) existingBiltyIds.add(String(v));
                });
                $('#tbl input[name*="Billtino"]').each(function () {
                    var v = $(this).val();
                    if (v && v.trim() !== '') existingBiltyIds.add(String(v.trim()));
                });

                var pendingCount = 0;
                var html = '';

                items.forEach(function (b) {
                    var isAlreadyInGrid = existingBiltyIds.has(String(b.id)) || (b.billTiNo && existingBiltyIds.has(String(b.billTiNo)));
                    var isDbUsed = (b.isUsed === true);
                    var isSelectedState = isAlreadyInGrid || isDbUsed;

                    if (!isSelectedState) {
                        pendingCount++;
                    }

                    var netAmtFormatted = (parseFloat(b.netAmt) || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                    var badgeHtml = '';
                    if (isAlreadyInGrid) {
                        badgeHtml = '<span class="badge bg-warning text-dark ms-1" style="font-size:0.75rem;"><i class="fa fa-check me-1"></i>In Voucher</span>';
                    } else if (isDbUsed) {
                        if (b.vono && b.voucherId) {
                            badgeHtml = `<a href="/Voucher/Edit/${b.voucherId}" target="_blank" class="badge bg-secondary ms-1 text-white text-decoration-none shadow-sm" style="font-size:0.75rem;" onclick="event.stopPropagation();" title="Open Voucher ${escapeHtml(b.vono)} in new tab">Selected: ${escapeHtml(b.vono)} <i class="fa fa-external-link" style="font-size:0.65rem;"></i></a>`;
                        } else {
                            badgeHtml = `<span class="badge bg-secondary ms-1 shadow-sm" style="font-size:0.75rem;" title="Already Selected">Selected</span>`;
                        }
                    }

                    html += `
                        <tr class="bilty-row ${isSelectedState ? 'already-selected' : ''}" 
                            data-id="${b.id}" 
                            data-docno="${escapeHtml(b.docNo)}"
                            data-vono="${escapeHtml(b.vono || '')}"
                            data-voucherid="${b.voucherId || ''}"
                            data-docdate="${escapeHtml(b.docDate)}" 
                            data-docdateraw="${escapeHtml(b.docDateRaw)}"
                            data-cusname="${escapeHtml(b.cusName)}" 
                            data-vehicleno="${escapeHtml(b.vehicleNo)}" 
                            data-bilno="${escapeHtml(b.bilNo)}" 
                            data-billtino="${escapeHtml(b.billTiNo)}" 
                            data-netamt="${b.netAmt}"
                            data-is-selected="${isSelectedState ? 'true' : 'false'}"
                            style="${isSelectedState ? 'display: none;' : ''}">
                            <td class="text-center">
                                <input type="checkbox" class="form-check-input bilty-chk" value="${b.id}" ${isAlreadyInGrid ? 'checked' : ''} />
                            </td>
                            <td class="text-center fw-semibold text-secondary">${escapeHtml(b.docDate)}</td>
                            <td>${escapeHtml(b.cusName)} ${badgeHtml}</td>
                            <td class="text-center">${escapeHtml(b.vehicleNo)}</td>
                            <td class="text-center fw-bold text-dark">${escapeHtml(b.bilno || b.bilNo)}</td>
                            <td class="text-center fw-bold text-primary">${escapeHtml(b.billTiNo)}</td>
                            <td class="text-end fw-bold text-success">${netAmtFormatted}</td>
