
@model IEnumerable<VoHead>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Vouchers";
}
@Html.AntiForgeryToken()
<div class="page-header">
    <div class="row align-items-center">
        <div class="col">
            <h3 class="page-title">@ViewBag.PageTitle</h3>
                <ul class="breadcrumb">
                <li class="breadcrumb-item">
                    <a asp-controller="Home" asp-action="Index">Dashboard</a>
                </li>
                <li class="breadcrumb-item active">Vouchers</li>
            </ul>
        </div>

        <div class="col-auto float-end ms-auto">
            <a asp-controller="Voucher"
                   asp-action="Create"
                   asp-route-type="@ViewBag.type"
                   class="btn add-btn"
                   id="addVoucherBtn">
                <i class="fa fa-plus"></i> Add Voucher
            </a>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-12">

        <!-- Card -->
        <div class="card">
            <div class="card-body">

                <div class="table-responsive">
                    <table id="voucherTable"
                           class="table table-striped table-hover table-nowrap" style="width:100%">
                        <thead>
                            <tr>
                                <th>Voucher No</th>
                                <th>Date</th>
                                <th>Type</th>
                                <th class="text-end">Action</th>
                            </tr>
                            <tr class="filters">
                                <th><input type="text" class="form-control form-control-sm column-search" placeholder="Search Voucher No" data-column="0" /></th>
                                <th><input type="date" class="form-control form-control-sm column-search" placeholder="Search Date" data-column="1" /></th>
                                <th><input type="text" class="form-control form-control-sm column-search" placeholder="Search Type" data-column="2" /></th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                        </tbody>
                    </table>
                </div>

            </div>
        </div>
        <!-- /Card -->

    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
            const voucherType = "@(ViewBag.Type ?? "")";

            var table = $('#voucherTable').DataTable({
                "processing": true,
                "serverSide": true,
                "orderCellsTop": true,
                "ajax": {
                    "url": "@Url.Action("GetVoucherList", "Voucher")",
                    "type": "POST",
                    "data": function (d) {
                        d.type = voucherType;
                        d.__RequestVerificationToken = token;
                    }
                },
                "columns": [
                    {
                        "data": "vono",
                        "render": function (data, type, row) {
                            return `<h2 class="table-avatar"><a href="#">${data || ''}</a></h2>`;
                        }
                    },
                    { "data": "vodate" },
                    {
                        "data": "votype",
                        "render": function (data, type, row) {
                            return `<span class="badge bg-info text-dark">${data || ''}</span>`;
                        }
                    },
                    {
                        "data": "id",
                        "orderable": false,
                        "className": "text-end",
                        "render": function (data, type, row) {
                            return `
                                <div class="d-flex justify-content-end gap-2">
                                    <a href="/Voucher/Edit/${data}" class="btn btn-sm btn-primary">
                                        <i class="fa fa-pencil"></i> Edit
                                    </a>
                                    <button type="button" class="btn btn-sm btn-danger" onclick="confirmDelete(${data}, '${row.vono}')">
                                        <i class="fa fa-trash"></i> Delete
                                    </button>
                                </div>
                            `;
                        }
                    }
                ],
                "order": [[1, "desc"], [0, "desc"]],
                "paging": true,
                "lengthChange": true,
                "searching": true,
                "ordering": true,
                "info": true,
                "autoWidth": false,
                "responsive": true
            });

            // Column-wise search input events
            $('.column-search').on('keyup change clear', function () {
                var colIdx = $(this).data('column');
                if (table.column(colIdx).search() !== this.value) {
                    table.column(colIdx).search(this.value).draw();
                }
            });

            // Focus on Add Voucher button when page loads
            setTimeout(function() {
                $('#addVoucherBtn').focus();

                $('#addVoucherBtn').css({
                    'box-shadow': '0 0 0 0.2rem rgba(13, 110, 253, 0.5)',
                    'border-color': '#0d6efd',
                    'transition': 'all 0.3s ease'
                });

                setTimeout(function() {
                    $('#addVoucherBtn').css({
                        'box-shadow': '',
                        'border-color': ''
                    });
                }, 3000);
            }, 100);

        });

        function confirmDelete(id, name) {

            if (!confirm("Are you sure you want to delete Voucher " + name + "?")) {
                return;
            }

            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

            $.ajax({
                url: '/Voucher/Delete',
                type: 'POST',
                data: {
                    id: id,
                    __RequestVerificationToken: token
                },
                success: function (res) {
                    alert(res.message);
                    if (res.success) {
                        $('#voucherTable').DataTable().ajax.reload(null, false);
                    }
                },
                error: function () {
                    alert("Delete failed!");
                }
            });
        }
    </script>
}

<style>
    /* Focus styling for Add Voucher button */
    #addVoucherBtn:focus {
        box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.5) !important;
        border-color: #0d6efd !important;
        transform: scale(1.02);
        transition: all 0.3s ease;
    }

    #addVoucherBtn:hover {
        transform: scale(1.05);
        transition: all 0.3s ease;
    }

    #addVoucherBtn {
        transition: all 0.3s ease;
    }
</style>