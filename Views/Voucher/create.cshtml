 <form method="post" class="form-dense">
    <input asp-for="Head.Votype" class="form-control form-control-sm" hidden />
    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-2">

        <div>
            <h4 class="mb-0 fw-bold text-navy">
                <i class="fa fa-file-text-o text-primary me-2"></i>
                @(ViewBag.Votype ?? Model?.Head?.Votype ?? "Voucher Entry")
            </h4>
            <small class="text-muted" style="font-size: 11px;">
                <i class="fa fa-info-circle me-1"></i>
                Create and manage accounting voucher
            </small>
        </div>

        <div>
            <button type="button" id="btnAddRow" class="btn btn-outline-primary btn-sm custom-btn me-2" onclick="addRow()">
                <i class="fa fa-plus me-1"></i> Add Row
            </button>

            <button type="submit" id="btnSave" class="btn btn-success btn-sm custom-btn shadow-sm">
                <i class="fa fa-save me-1"></i> Save Voucher
            </button>
        </div>

    </div>

    <!-- MASTER -->
    <div class="card custom-card border-0 shadow-sm mb-2">
        <div class="card-header bg-white border-bottom py-1 px-3 d-flex justify-content-between align-items-center">
            <h6 class="mb-0 fw-semibold text-navy" style="font-size: 13px;">
                <i class="fa fa-sliders text-primary me-1"></i> General Details
            </h6>
        </div>
        <div class="card-body py-2 px-3">

            <div class="row g-2">

                <div class="col-md-2">
                    <label class="form-label small text-muted fw-semibold mb-0">
                        <i class="fa fa-hashtag text-primary me-1"></i> Voucher No
                    </label>
                    <input asp-for="Head.Vono" class="form-control form-control-sm" />
                </div>

                <div class="col-md-2">
                    <label class="form-label small text-muted fw-semibold mb-0">
                        <i class="fa fa-calendar text-primary me-1"></i> Trans Date
                    </label>
                    <input asp-for="Head.Vodate" type="date" class="form-control form-control-sm" />
                </div>

                <div class="col-md-2">
                    <label class="form-label small text-muted fw-semibold mb-0">
                        <i class="fa fa-clock-o text-primary me-1"></i> Entry Date
                    </label>
                    <input asp-for="Head.EntryDate" type="date" class="form-control form-control-sm" />
                </div>

                <div class="col-md-3">
                    <label class="form-label small text-muted fw-semibold mb-0">
                        <i class="fa fa-university text-primary me-1"></i> Account
                    </label>
                    <select asp-for="Head.gl3Id" class="form-select form-select-sm select2">
                        <option value="">-- Select Account --</option>
                        @if (ViewBag.HeaderAccounts != null)
                        {
                            foreach (var acc in (IEnumerable<SelectListItem>)ViewBag.HeaderAccounts)
                            {
                                bool isSelected = acc.Value == Model?.Head?.gl3Id?.ToString();
                                if (isSelected)
                                {
                                    <option value="@acc.Value" selected="selected">@acc.Text</option>
                                }
                                else
                                {
                                    <option value="@acc.Value">@acc.Text</option>
                                }
                            }
                        }
                    </select>
                </div>

                <div class="col-md-3">
                    <label class="form-label small text-muted fw-semibold mb-0">
                        <i class="fa fa-exchange text-primary me-1"></i> Pay / Receive
                    </label>
                    <select asp-for="Head.Partycode" class="form-select form-select-sm select2"
                            asp-items="@(new SelectList(ViewBag.PartyAccounts, "Value", "Text"))">
                    </select>
                </div>

                <div class="col-md-5">
                    <label class="form-label small text-muted fw-semibold mb-0">
                        <i class="fa fa-user text-primary me-1"></i> Payee / Receiver
                    </label>
                    <input asp-for="Head.PersonName" class="form-control form-control-sm" />
                </div>

                <div class="col-md-3">
                    <label class="form-label small text-muted fw-semibold mb-0">
                        <i class="fa fa-list-ol text-primary me-1"></i> Reference No
                    </label>
                    <input asp-for="Head.Invno" class="form-control form-control-sm" />
                </div>

                <div class="col-md-4">
                    <label class="form-label small text-muted fw-semibold mb-0">
                        <i class="fa fa-comment text-primary me-1"></i> Narration
                    </label>
                    <input asp-for="Head.Narration" class="form-control form-control-sm" />
                </div>

            </div>

        </div>
    </div>

    <!-- DETAILS -->
    <div class="card custom-card border-0 shadow-sm voucher-grid-card">

        <div class="card-header d-flex justify-content-between align-items-center bg-white border-bottom py-1 px-3">
            <h6 class="mb-0 fw-semibold text-navy" style="font-size: 13px;">
                <i class="fa fa-list text-primary me-1"></i>
                Voucher Details
            </h6>

            <span class="badge bg-primary fs-7 px-2 py-1 shadow-sm">
                <i class="fa fa-bolt me-1"></i>
                Live Entry Mode
            </span>
        </div>

        <div class="card-body p-0">

            <div class="table-responsive voucher-table-container">

                <table class="table table-hover table-bordered align-middle mb-0" id="tbl">

                    <thead class="table-light text-center" style="position: sticky; top: 0; z-index: 2;">
                        <tr>
                            <th style="width: 22%; min-width: 200px;">
                                <i class="fa fa-university text-primary me-1"></i>
                                Account
                            </th>

                            <th style="width: 8%; min-width: 85px;">
                                <i class="fa fa-tag text-primary me-1"></i>
                                Bilti No
                            </th>

                            <th style="width: 8%; min-width: 85px;">
                                <i class="fa fa-file-text text-primary me-1"></i>
                                Bill No
                            </th>

                            <th class="text-success" style="width: 10%; min-width: 95px;">
                                <i class="fa fa-arrow-down me-1"></i>
                                Debit
                            </th>

                            <th class="text-danger" style="width: 10%; min-width: 95px;">
                                <i class="fa fa-arrow-up me-1"></i>
                                Credit
                            </th>

                            @if (Model.Head.Votype == "CP" || Model.Head.Votype == "CR" || Model.Head.Votype == "JV")
                            {
                                <th style="width: 7%; min-width: 75px;">
                                    <i class="fa fa-percent text-primary me-1"></i>
                                    Tax
                                </th>
                            }

                            <th style="width: 37%; min-width: 350px;">
                                <i class="fa fa-comment text-primary me-1"></i>
                                Narration
                            </th>

                            <th style="width: 5%; min-width: 50px;">
                                <i class="fa fa-cog text-primary me-1"></i>
                                Action
                            </th>
                        </tr>
                    </thead>
                    <tbody id="tbody">
                        <tr id="noDataRow">
                            <td colspan="20" class="text-center text-muted py-2">
                                <i class="fa fa-inbox me-1"></i> No Data Available
                            </td>
                        </tr>
                    </tbody>

                </table>

            </div>

        </div>
    </div>

    <!-- SUMMARY / TOTALS BAR -->
    <div class="card border-0 shadow-sm voucher-totals-bar">
        <div class="card-body py-2 px-3">

            <div class="row text-center align-items-center g-2">
                <div class="col-3 border-end">
                    <span class="text-muted small me-2"><i class="fa fa-list text-secondary me-1"></i> Entries:</span>
                    <strong id="entries" class="fw-bold fs-6 text-dark">0</strong>
                </div>
                <div class="col-3 border-end">
                    <span class="text-muted small me-2"><i class="fa fa-arrow-down text-success me-1"></i> Debit:</span>
                    <strong id="dr" class="text-success fw-bold fs-6">0.00</strong>
                </div>
                <div class="col-3 border-end">
                    <span class="text-muted small me-2"><i class="fa fa-arrow-up text-danger me-1"></i> Credit:</span>
                    <strong id="cr" class="text-danger fw-bold fs-6">0.00</strong>
                </div>
                <div class="col-3">
                    <span class="text-muted small me-2"><i class="fa fa-balance-scale text-primary me-1"></i> Difference:</span>
                    <strong id="df" class="text-primary fw-bold fs-6">0.00</strong>
                </div>
            </div>

        </div>
    </div>

</form> 
@section scripts {
    <script>
        let i = 0;
        const type = '@Model.Head.Votype';

        function escapeHtml(text) {
            if (!text) return "";
            return String(text).replace(/&/g, "&amp;").replace(/"/g, "&quot;").replace(/'/g, "&#039;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
        }

        const isFullType = ["CP", "CR", "JV"].includes(type);
        const showTax    = isFullType;

        // ✅ VOUCHER RULE ENGINE (NEW)
        const VoucherRules = {
            CP: { debit: true, credit: false },  // user enters Debit only
            CR: { debit: false, credit: true },  // user enters Credit only
            BP: { debit: true, credit: false },
            BR: { debit: false, credit: true },
            JV: { debit: true, credit: true }
        };

        const rule = VoucherRules[type] || VoucherRules.JV;

        function applyRowRules(row) {
            const dr = row.querySelector("[name*='Dramt']");
            const cr = row.querySelector("[name*='Cramt']");

            if (dr) dr.disabled = !rule.debit;
            if (cr) cr.disabled = !rule.credit;

            if (!rule.debit) dr.value = "";
            if (!rule.credit) cr.value = "";
        }

        function addRow() {

            const noDataRow = document.getElementById("noDataRow");
            if (noDataRow) noDataRow.remove();

            // Default Narration from previous row, or from Master Narration
            let defaultNarration = "";
            const prevNarrationInput = document.querySelector("#tbl tbody tr:not(#noDataRow):last-child input[name*='Narration']");
            if (prevNarrationInput && prevNarrationInput.value) {
                defaultNarration = prevNarrationInput.value;
            } else {
                const headNarr = document.querySelector("input[name='Head.Narration'], #Head_Narration");
                if (headNarr && headNarr.value) {
                    defaultNarration = headNarr.value;
                }
            }

            const row = document.createElement("tr");

            row.innerHTML = `
                <td>
                    <select name="Details[${i}].gl3Id" class="form-control select2">
                        <option value="">Select Account</option>
                        @foreach (var acc in ViewBag.Accounts)
                        {
                                <option value="@acc.Value">@acc.Text</option>
                        }
                    </select>
                </td>

                <td><input name="Details[${i}].Billtino" class="form-control"/></td>
                <td><input name="Details[${i}].Bilno" class="form-control"/></td>

                <td><input name="Details[${i}].Dramt" oninput="calc()" class="form-control"/></td>
                <td><input name="Details[${i}].Cramt" oninput="calc()" class="form-control"/></td>

                ${showTax ? `<td><input name="Details[${i}].Ptax" class="form-control"/></td>` : ""}

                <td><input name="Details[${i}].Narration" value="${escapeHtml(defaultNarration)}" class="form-control"/></td>

                <td>
                    <button type="button" class="btn btn-danger btn-sm" onclick="removeRow(this)">
                        <i class="fa fa-trash"></i>
                    </button>
                </td>
            `;

            document.querySelector("#tbl tbody").appendChild(row);

            applyRowRules(row);

            i++;

            $("#tbl .select2").select2();
            calc();
        }

        function calc() {

            let dr = 0, cr = 0, entries = 0;

            document.querySelectorAll("#tbl tbody tr:not(#noDataRow)").forEach(row => {

                const drInput = row.querySelector("[name*='Dramt']");
                const crInput = row.querySelector("[name*='Cramt']");

                const d = parseFloat(drInput?.value || 0);
                const c = parseFloat(crInput?.value || 0);

                if (d > 0 && c > 0) {
                    alert("Row cannot have both Debit and Credit");
                    drInput.value = "";
                    crInput.value = "";
                    return;
                }

                if (d > 0 || c > 0) entries++;

                dr += d;
                cr += c;
            });

            const diff = dr - cr;

            document.getElementById("dr").innerText = dr.toFixed(2);
            document.getElementById("cr").innerText = cr.toFixed(2);
            document.getElementById("df").innerText = (type === "JV" ? diff : 0).toFixed(2);
            document.getElementById("entries").innerText = entries;

            const submitBtns = document.querySelectorAll("button[type='submit']");
            let isValid = false;
            if (type === "JV") {
                isValid = (entries > 0 && diff === 0 && (dr > 0 || cr > 0));
            } else if (type === "CP" || type === "BP") {
                isValid = (entries > 0 && dr > 0);
            } else if (type === "CR" || type === "BR") {
                isValid = (entries > 0 && cr > 0);
            } else {
                isValid = (entries > 0 && (dr > 0 || cr > 0));
            }

            submitBtns.forEach(btn => {
                btn.disabled = !isValid;
                if (type === "JV") {
                    btn.classList.toggle("btn-danger", !isValid && entries > 0 && diff !== 0);
                    btn.classList.toggle("btn-success", isValid);
                } else {
                    btn.classList.remove("btn-danger");
                    btn.classList.add("btn-success");
                }
            });
        }

        function removeRow(btn) {

            btn.closest("tr").remove();

            const rows = document.querySelectorAll("#tbl tbody tr");

            if (rows.length === 0) {
                document.querySelector("#tbl tbody").innerHTML = `
                    <tr id="noDataRow">
                        <td colspan="20" class="text-center text-muted py-3">
                            No Data Available
                        </td>
                    </tr>`;
            }

            calc();
        }

        // ========================================================
        // 🚀 ENTER KEY NAVIGATION FOR VOUCHER GRID (#tbl)
        // ========================================================

        // Prevent accidental form submission on Enter inside all form inputs
        $(document).on('keydown', 'form.form-dense input, form.form-dense select', function(e) {
            if (e.key === 'Enter') {
                if (!$(e.target).is('#btnSave, #btnUpdate, button[type="submit"]')) {
                    e.preventDefault();
                }
            }
        });

        // 1. Enter on Master/Header Narration -> jumps to first Detail Row Account (focus, do not open)
        $(document).on('keydown', 'input[name="Head.Narration"], #Head_Narration', function(e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                e.stopPropagation();

                var $rows = $('#tbl tbody tr:not(#noDataRow)');
                if ($rows.length === 0) {
                    if (typeof addRow === 'function') addRow();
                    $rows = $('#tbl tbody tr:not(#noDataRow)');
                }
                var $firstAcc = $rows.first().find('select[name*="gl3Id"]');
                if ($firstAcc.length) {
                    AppNav.focusElement($firstAcc);
                }
            }
        });

        // Helper: Check if account in this row is selected
        function isRowAccountSelected($tr) {
            var $acc = $tr.find('select[name*="gl3Id"]');
            var val = $acc.val();
            return (val && val !== '' && val !== '0' && val !== 'Select Account');
        }

        // Helper: Jump to Save / Update button
        function jumpToSaveButton() {
            var $saveBtn = $('#btnSave, #btnUpdate, button[type="submit"]').filter(':visible').first();
            if ($saveBtn.length) {
                $saveBtn.prop('disabled', false).removeClass('disabled');
                $saveBtn.focus();
                if (typeof highlightField === 'function') highlightField($saveBtn);
                return true;
            }
            return false;
        }

        // 2. Intercept Enter on ANY list/Select2 in CAPTURE phase so Select2 never receives Enter to open the dropdown!
        window.addEventListener('keydown', function(e) {
            if (e.key === 'Enter') {
                var $target = $(e.target);
                var $selection = $target.closest('.select2-selection');
                if ($selection.length) {
                    var $container = $selection.closest('.select2-container');
                    if ($container.hasClass('select2-container--open')) {
                        return; // Let select2 pick option if open
                    }

                    // Dropdown is closed -> Stop Select2 from opening!
                    e.preventDefault();
                    e.stopPropagation();
                    e.stopImmediatePropagation();

                    var $tr = $selection.closest('tr');
                    if ($tr.length && $tr.closest('#tbl').length) {
                        // In detail grid row -> advance to Bilti No (or next visible input)
                        var $bilti = $tr.find('input[name*="Billtino"]:visible');
                        if ($bilti.length) {
                            AppNav.focusElement($bilti);
                        } else {
                            var $nextInput = $tr.find('input:not([type=hidden]):not([disabled]):visible').first();
                            if ($nextInput.length) AppNav.focusElement($nextInput);
                        }
                        return;
                    }

                    // Header Select2 lists
                    var $select = AppNav.getSelectFromSelection($selection);
                    if ($select.is('#Head_gl3Id, select[name*="gl3Id"]')) {
                        var $party = $('#Head_Partycode');
                        if ($party.length) return AppNav.focusElement($party);
                    } else if ($select.is('#Head_Partycode, select[name*="Partycode"]')) {
                        var $person = $('#Head_PersonName, input[name*="PersonName"]');
                        if ($person.length) return AppNav.focusElement($person);
                    }

                    if (typeof AppNav !== 'undefined' && AppNav.moveToNext) {
                        AppNav.moveToNext($select.length ? $select : $selection);
                    }
                    return;
                }

                // Native select element
                if ($target.is('select:not(.select2-hidden-accessible)')) {
                    e.preventDefault();
                    e.stopPropagation();
                    e.stopImmediatePropagation();
                    if (typeof AppNav !== 'undefined' && AppNav.moveToNext) {
                        AppNav.moveToNext($target);
                    }
                }
            }
        }, true);

        // 3. When an account is selected in #tbl via Select2 dropdown
        $(document).on('select2:select', '#tbl select[name*="gl3Id"]', function(e) {
            var $tr = $(this).closest('tr');
            setTimeout(function() {
                var $bilti = $tr.find('input[name*="Billtino"]:visible');
                if ($bilti.length) {
                    AppNav.focusElement($bilti);
                } else {
                    var $nextInput = $tr.find('input:not([type=hidden]):not([disabled]):visible').first();
                    if ($nextInput.length) AppNav.focusElement($nextInput);
                }
            }, 60);
        });

        // 4. Enter on Select2 search field when empty (user didn't choose an account)
        $(document).on('keydown', '.select2-search__field', function(e) {
            if (e.key === 'Enter') {
                var $search = $(this);
                var $openSelect = $('select.select2-hidden-accessible').filter(function() {
                    return $(this).data('select2') && $(this).data('select2').$container.hasClass('select2-container--open');
                });

                if ($openSelect.length && $openSelect.closest('#tbl').length) {
                    var $tr = $openSelect.closest('tr');
                    // NEVER remove any row! Just close select2 and advance to Bilti No
                    if (!$search.val()) {
                        e.preventDefault();
                        e.stopPropagation();
                        try { $openSelect.select2('close'); } catch(err) {}
                        var $bilti = $tr.find('input[name*="Billtino"]:visible');
                        if ($bilti.length) {
                            AppNav.focusElement($bilti);
                        } else {
                            var $nextInput = $tr.find('input:not([type=hidden]):not([disabled]):visible').first();
                            if ($nextInput.length) AppNav.focusElement($nextInput);
                        }
                    }
                }
            }
        });

        // 5. Enter on detail grid inputs (Bilti No -> Bill No -> Amount -> Tax -> Narration -> New Row)
        $(document).on('keydown', '#tbl tbody tr input:not([type=hidden])', function(e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                e.stopPropagation();

                var $input = $(this);
                var $tr = $input.closest('tr');
                if (!$tr.length || $tr.attr('id') === 'noDataRow') return;

                // Case: Bilti No -> advance to Bill No
                if ($input.is('input[name*="Billtino"]')) {
                    var $bilno = $tr.find('input[name*="Bilno"]:visible');
                    if ($bilno.length) return AppNav.focusElement($bilno);
                }

                // Case: Bill No -> advance to Debit or Credit (first enabled amount)
                if ($input.is('input[name*="Bilno"]')) {
                    var $amt = $tr.find('input[name*="Dramt"]:not([disabled]):visible, input[name*="Cramt"]:not([disabled]):visible').first();
                    if ($amt.length) return AppNav.focusElement($amt);
                    var $narr = $tr.find('input[name*="Narration"]:visible');
                    if ($narr.length) return AppNav.focusElement($narr);
                }

                // Case: Debit Amount -> in JV, if Debit entered, jump past Credit to Tax/Narration; if 0, go to Credit; in CP/BP, go to Tax/Narration
                if ($input.is('input[name*="Dramt"]')) {
                    var dramtVal = parseFloat($input.val() || 0);
                    var $credit = $tr.find('input[name*="Cramt"]:not([disabled]):visible');
                    if ($credit.length && dramtVal <= 0) {
                        return AppNav.focusElement($credit);
                    }
                    var $ptax = $tr.find('input[name*="Ptax"]:visible');
                    if ($ptax.length) return AppNav.focusElement($ptax);
                    var $narr = $tr.find('input[name*="Narration"]:visible');
                    if ($narr.length) return AppNav.focusElement($narr);
                }

                // Case: Credit Amount -> advance to Tax (if visible) or Narration
                if ($input.is('input[name*="Cramt"]')) {
                    var $ptax = $tr.find('input[name*="Ptax"]:visible');
                    if ($ptax.length) return AppNav.focusElement($ptax);
                    var $narr = $tr.find('input[name*="Narration"]:visible');
                    if ($narr.length) return AppNav.focusElement($narr);
                }

                // Case: Tax -> advance to Narration
                if ($input.is('input[name*="Ptax"]')) {
                    var $narr = $tr.find('input[name*="Narration"]:visible');
                    if ($narr.length) return AppNav.focusElement($narr);
                }

                // Case: Detail Narration -> ADD NEW ROW in grid with same narration of above row!
                if ($input.is('input[name*="Narration"]')) {
                    if (typeof addRow === 'function') {
                        addRow();
                        setTimeout(function() {
                            var $lastRow = $('#tbl tbody tr:not(#noDataRow)').last();
                            var $newAcc = $lastRow.find('select[name*="gl3Id"]');
                            if ($newAcc.length) {
                                AppNav.focusElement($newAcc);
                            }
                        }, 50);
                    }
                    return;
                }

                // Fallback: move to next visible input in the row
                var $allInputs = $tr.find('input:not([type=hidden]):not([disabled]):visible');
                var idx = $allInputs.index($input);
                if (idx >= 0 && idx < $allInputs.length - 1) {
                    return AppNav.focusElement($allInputs.eq(idx + 1));
                }
            }
        });

        // ========================================================
        // 🎯 EXCEL-LIKE ARROW KEY NAVIGATION ACROSS ROWS & COLUMNS
        // ========================================================
        $(document).on('focus', '#tbl input:not([type=hidden])', function() {
            var el = this;
            setTimeout(function() {
                try { el.select(); } catch(e) {}
            }, 10);
        });

        function getRowCells($tr) {
            return $tr.find('.select2-selection, input:not([type=hidden]):not([disabled])').filter(':visible');
        }

        $(document).on('keydown', '#tbl input:not([type=hidden]), #tbl .select2-selection', function(e) {
            if (!['ArrowUp', 'ArrowDown', 'ArrowLeft', 'ArrowRight'].includes(e.key)) {
                return;
            }

            // Don't intercept arrow navigation if select2 options dropdown is open
            if ($('.select2-container--open').length > 0) {
                return;
            }

            var $current = $(this);

            // If on a list field (.select2-selection), ArrowDown or ArrowUp opens the dropdown!
            if ($current.hasClass('select2-selection') && (e.key === 'ArrowDown' || e.key === 'ArrowUp')) {
                e.preventDefault();
                var $sel = AppNav.getSelectFromSelection($current);
                AppNav.openSelect2($sel);
                return;
            }

            var $tr = $current.closest('tr');
            if (!$tr.length || $tr.attr('id') === 'noDataRow') return;

            var $cells = getRowCells($tr);
            var colIdx = $cells.index($current);
            if (colIdx === -1) colIdx = 0;

            var $allRows = $('#tbl tbody tr:not(#noDataRow)');
            var rowIdx = $allRows.index($tr);

            if (e.key === 'ArrowDown') {
                e.preventDefault();
                if (rowIdx < $allRows.length - 1) {
                    var $nextRow = $allRows.eq(rowIdx + 1);
                    var $nextCells = getRowCells($nextRow);
                    var targetIdx = Math.min(colIdx, $nextCells.length - 1);
                    if (targetIdx >= 0) {
                        var $target = $nextCells.eq(targetIdx);
                        $target.focus();
                        if ($target.is('input')) try { $target.select(); } catch(err) {}
                    }
                }
                return;
            }

            if (e.key === 'ArrowUp') {
                e.preventDefault();
                if (rowIdx > 0) {
                    var $prevRow = $allRows.eq(rowIdx - 1);
                    var $prevCells = getRowCells($prevRow);
                    var targetIdx = Math.min(colIdx, $prevCells.length - 1);
                    if (targetIdx >= 0) {
                        var $target = $prevCells.eq(targetIdx);
                        $target.focus();
                        if ($target.is('input')) try { $target.select(); } catch(err) {}
                    }
                }
                return;
            }

            if (e.key === 'ArrowRight') {
                var canRight = false;
                if ($current.hasClass('select2-selection')) {
                    canRight = true;
                } else if ($current.is('input')) {
                    var el = $current[0];
                    if (el.selectionStart !== el.selectionEnd || el.selectionEnd === el.value.length) {
                        canRight = true;
                    }
                }
                if (canRight && colIdx < $cells.length - 1) {
                    e.preventDefault();
                    var $nextCell = $cells.eq(colIdx + 1);
                    $nextCell.focus();
                    if ($nextCell.is('input')) try { $nextCell.select(); } catch(err) {}
                }
                return;
            }

            if (e.key === 'ArrowLeft') {
                var canLeft = false;
                if ($current.is('input')) {
                    var el = $current[0];
                    if (el.selectionStart !== el.selectionEnd || el.selectionStart === 0) {
                        canLeft = true;
                    }
                }
                if (canLeft && colIdx > 0) {
                    e.preventDefault();
                    var $prevCell = $cells.eq(colIdx - 1);
                    $prevCell.focus();
                    if ($prevCell.is('input')) try { $prevCell.select(); } catch(err) {}
                }
                return;
            }
        });

        $(document).ready(function () {
            $(".select2").select2();
            addRow();
            setTimeout(function() {
                AppNav.focusElement($('#Head_Vodate, #Head_Vono').first());
            }, 100);
        });

    </script>
}