 <form method="post">
    <input asp-for="Head.Votype" class="form-control form-control-sm" hidden />
    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-3">

        <div>
            <h3 class="mb-0">
                <i class="fa fa-file-text-o text-primary me-1"></i>
                @(ViewBag.Votype ?? Model?.Head?.Votype ?? "Voucher Entry")
            </h3>
            <small class="text-muted">
                <i class="fa fa-info-circle me-1"></i>
                Create and manage accounting voucher
            </small>
        </div>

        <div>
            <button type="button" class="btn btn-outline-primary btn-sm me-2" onclick="addRow()">
                <i class="fa fa-plus me-1"></i> Add Row
            </button>

            <button type="submit" class="btn btn-success btn-sm">
                <i class="fa fa-save me-1"></i> Save
            </button>
        </div>

    </div>

    <!-- MASTER -->
    <div class="card border-0 shadow-sm">
        <div class="card-body">

            <div class="row g-3">

                <div class="col-md-2">
                    <label class="form-label small text-muted">
                        <i class="fa fa-hashtag me-1"></i> Voucher No
                    </label>
                    <input asp-for="Head.Vono" class="form-control form-control-sm" />
                </div>

                <div class="col-md-2">
                    <label class="form-label small text-muted">
                        <i class="fa fa-calendar me-1"></i> Transaction Date
                    </label>
                    <input asp-for="Head.Vodate" type="date" class="form-control form-control-sm" />
                </div>

                <div class="col-md-2">
                    <label class="form-label small text-muted">
                        <i class="fa fa-clock-o me-1"></i> Entry Date
                    </label>
                    <input asp-for="Head.EntryDate" type="date" class="form-control form-control-sm" />
                </div>

                <div class="col-md-3">
                    <label class="form-label small text-muted">
                        <i class="fa fa-university me-1"></i> Account
                    </label>
                    <select asp-for="Head.gl3Id" class="form-select form-select-sm"
                            asp-items="@(new SelectList(ViewBag.HeaderAccounts, "Value", "Text"))">
                    </select>
                </div>

                <div class="col-md-3">
                    <label class="form-label small text-muted">
                        <i class="fa fa-exchange me-1"></i> Pay / Receive
                    </label>
                    <select asp-for="Head.Partycode" class="form-select form-select-sm"
                            asp-items="@(new SelectList(ViewBag.PartyAccounts, "Value", "Text"))">
                    </select>
                </div>

                <div class="col-md-5">
                    <label class="form-label small text-muted">
                        <i class="fa fa-user me-1"></i> Payee / Receiver
                    </label>
                    <input asp-for="Head.PersonName" class="form-control form-control-sm" />
                </div>

                <div class="col-md-3">
                    <label class="form-label small text-muted">
                        <i class="fa fa-list-ol me-1"></i> Reference No
                    </label>
                    <input asp-for="Head.Invno" class="form-control form-control-sm" />
                </div>

                <div class="col-md-4">
                    <label class="form-label small text-muted">
                        <i class="fa fa-comment me-1"></i> Narration
                    </label>
                    <input asp-for="Head.Narration" class="form-control form-control-sm" />
                </div>

            </div>

        </div>
    </div>

    <!-- DETAILS -->
    <!-- DETAILS -->
    <div class="card mt-3 border-0 shadow-sm">

        <div class="card-header d-flex justify-content-between align-items-center bg-white">
            <h5 class="mb-0">
                <i class="fa fa-table me-1 text-primary"></i>
                Voucher Details
            </h5>

            <span class="badge bg-light text-dark">
                <i class="fa fa-bolt me-1 text-warning"></i>
                Live Entry Mode
            </span>
        </div>

        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-hover table-bordered align-middle mb-0" id="tbl">

 
                    <thead class="table-light text-center">
                        <tr>
                            <th>
                                <i class="fa fa-university me-1"></i>
                                Account
                            </th>

                            <th>
                                <i class="fa fa-tag me-1"></i>
                                Bilti No
                            </th>

                            <th>
                                <i class="fa fa-file-text me-1"></i>
                                Bill No
                            </th>

                            <th class="text-success">
                                <i class="fa fa-arrow-down me-1"></i>
                                Debit
                            </th>

                            <th class="text-danger">
                                <i class="fa fa-arrow-up me-1"></i>
                                Credit
                            </th>

                            @if (Model.Head.Votype == "BP" || Model.Head.Votype == "BR" || Model.Head.Votype == "JV")
                            {
                                <th>
                                    <i class="fa fa-credit-card me-1"></i>
                                    Cheque No
                                </th>

                                <th>
                                    <i class="fa fa-calendar me-1"></i>
                                    Cheque Date
                                </th>
                            }

                            @if (Model.Head.Votype == "CP" || Model.Head.Votype == "CR" || Model.Head.Votype == "JV")
                            {
                                <th>
                                    <i class="fa fa-percent me-1"></i>
                                    Tax
                                </th>
                            }

                            <th>
                                <i class="fa fa-comment me-1"></i>
                                Narration
                            </th>

                            <th>
                                <i class="fa fa-cog me-1"></i>
                                Action
                            </th>
                        </tr>
                    </thead>
                    <tbody id="tbody">
                        <tr id="noDataRow">
                            <td colspan="20" class="text-center text-muted py-3">
                                <i class="fa fa-inbox me-1"></i> No Data Available
                            </td>
                        </tr>
                    </tbody>

                </table>

            </div>

        </div>
    </div>

    <!-- SUMMARY -->
    <div class="card mt-3 border-0 shadow-sm">
        <div class="card-body">

            <div class="row text-center">

                <div class="col-md-3">
                    <p class="mb-1 text-muted small"><i class="fa fa-list me-1"></i> Total Entries</p>
                    <h5 id="entries" class="fw-bold">0</h5>
                </div>

                <div class="col-md-3">
                    <p class="mb-1 text-muted small"><i class="fa fa-arrow-down text-success me-1"></i> Debit</p>
                    <h5 id="dr" class="text-success fw-bold">0</h5>
                </div>

                <div class="col-md-3">
                    <p class="mb-1 text-muted small"><i class="fa fa-arrow-up text-danger me-1"></i> Credit</p>
                    <h5 id="cr" class="text-danger fw-bold">0</h5>
                </div>

                <div class="col-md-3">
                    <p class="mb-1 text-muted small"><i class="fa fa-balance-scale me-1"></i> Difference</p>
                    <h5 id="df" class="text-primary fw-bold">0</h5>
                </div>

            </div>

           
        </div>
    </div>

</form> 
@section scripts {
    <script>
        let i = 0;
        const type = '@Model.Head.Votype';

        const isFullType = ["CP", "CR", "JV"].includes(type);
        const isChequeType = ["BP", "BR", "JV"].includes(type);

        const showTax       = isFullType;
        const showCheque    = isChequeType;

        // ✅ VOUCHER RULE ENGINE (NEW)
        const VoucherRules = {
            CP: { debit: true, credit: false },  // user enters Debit only
            CR: { debit: false, credit: true },  // user enters Credit only
            BP: { debit: true, credit: false },
            BR: { debit: false, credit: true },
            JV: { debit: true, credit: true }
        };

        const rule = VoucherRules[type] || VoucherRules.JV;

        function applyRowRules(row) {
            const dr = row.querySelector("[name*='Dramt']");
            const cr = row.querySelector("[name*='Cramt']");

            if (dr) dr.disabled = !rule.debit;
            if (cr) cr.disabled = !rule.credit;

            if (!rule.debit) dr.value = "";
            if (!rule.credit) cr.value = "";
        }

        function addRow() {

            const noDataRow = document.getElementById("noDataRow");
            if (noDataRow) noDataRow.remove();

            const row = document.createElement("tr");

            row.innerHTML = `
                <td>
                    <select name="Details[${i}].gl3Id" class="form-control select2">
                        <option>Select Account</option>
                        @foreach (var acc in ViewBag.Accounts)
                        {
                                <option value="@acc.Value">@acc.Text</option>
                        }
                    </select>
                </td>

                <td><input name="Details[${i}].Billtino" class="form-control"/></td>
                <td><input name="Details[${i}].Bilno" class="form-control"/></td>

                <td><input name="Details[${i}].Dramt" oninput="calc()" class="form-control"/></td>
                <td><input name="Details[${i}].Cramt" oninput="calc()" class="form-control"/></td>

                ${showCheque ? `
                <td><input name="Details[${i}].Chqno" class="form-control"/></td>
                <td><input name="Details[${i}].ChqDate" type="date" class="form-control"/></td>` : ""}

                ${showTax ? `<td><input name="Details[${i}].Ptax" class="form-control"/></td>` : ""}

                <td><input name="Details[${i}].Narration" class="form-control"/></td>

                <td>
                    <button type="button" class="btn btn-danger btn-sm" onclick="removeRow(this)">
                        <i class="fa fa-trash"></i>
                    </button>
                </td>
            `;

            document.querySelector("#tbl tbody").appendChild(row);

            applyRowRules(row);

            i++;

            $("#tbl .select2").select2();
            calc();
        }

        function calc() {

            let dr = 0, cr = 0, entries = 0;

            document.querySelectorAll("#tbl tbody tr:not(#noDataRow)").forEach(row => {

                const drInput = row.querySelector("[name*='Dramt']");
                const crInput = row.querySelector("[name*='Cramt']");

                const d = parseFloat(drInput?.value || 0);
                const c = parseFloat(crInput?.value || 0);

                if (d > 0 && c > 0) {
                    alert("Row cannot have both Debit and Credit");
                    drInput.value = "";
                    crInput.value = "";
                    return;
                }

                if (d > 0 || c > 0) entries++;

                dr += d;
                cr += c;
            });

            const diff = dr - cr;

            document.getElementById("dr").innerText = dr.toFixed(2);
            document.getElementById("cr").innerText = cr.toFixed(2);
            document.getElementById("df").innerText = (type === "JV" ? diff : 0).toFixed(2);
            document.getElementById("entries").innerText = entries;

            const btn = document.querySelector("button[type='submit']");
            if (btn) {
                let isValid = false;
                if (type === "JV") {
                    isValid = (entries > 0 && diff === 0 && (dr > 0 || cr > 0));
                } else if (type === "CP" || type === "BP") {
                    isValid = (entries > 0 && dr > 0);
                } else if (type === "CR" || type === "BR") {
                    isValid = (entries > 0 && cr > 0);
                } else {
                    isValid = (entries > 0 && (dr > 0 || cr > 0));
                }

                btn.disabled = !isValid;
                if (type === "JV") {
                    btn.classList.toggle("btn-danger", !isValid && entries > 0 && diff !== 0);
                    btn.classList.toggle("btn-success", isValid);
                } else {
                    btn.classList.remove("btn-danger");
                    btn.classList.add("btn-success");
                }
            }
        }

        function removeRow(btn) {

            btn.closest("tr").remove();

            const rows = document.querySelectorAll("#tbl tbody tr");

            if (rows.length === 0) {
                document.querySelector("#tbl tbody").innerHTML = `
                    <tr id="noDataRow">
                        <td colspan="20" class="text-center text-muted py-3">
                            No Data Available
                        </td>
                    </tr>`;
            }

            calc();
        }

        $(document).ready(function () {
            $(".select2").select2();
            addRow();
        });

    </script>
}