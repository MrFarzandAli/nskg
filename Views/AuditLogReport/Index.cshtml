
@{
    ViewData["Title"] = "Audit Log Report";
    var logs = ViewBag.AuditLogs as System.Data.DataTable;
    var message = ViewBag.Message as string;
    var fromDateValue = ViewBag.FromDate as string;
    var toDateValue = ViewBag.ToDate as string;
    if (string.IsNullOrEmpty(fromDateValue))
    {
        fromDateValue = DateTime.Now.ToString("yyyy-MM-dd");
    }

    if (string.IsNullOrEmpty(toDateValue))
    {
        toDateValue = DateTime.Now.ToString("yyyy-MM-dd");
    }
}

<style>
    .custom-card {
        border-radius: 10px;
    }

    .heading-glow {
        font-weight: 600;
    }

    .custom-btn {
        border-radius: 6px;
    }

    iframe {
        border-radius: 8px;
    }
</style>

<div class="container-fluid mt-4">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="fw-bold text-navy"><i class="fa fa-history me-2 text-primary"></i> Audit Log Report</h3>
    </div>

    <!-- Filter Card -->
    <div class="card custom-card mb-4 shadow-sm border-0">
        <div class="card-header card-header-brand py-3">
            <h5 class="mb-0 fw-semibold text-white">
                <i class="fa fa-filter me-2"></i> Filter Parameters
            </h5>
        </div>
        <div class="card-body report-filter-body">
            <form method="get">
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label fw-bold">From Date</label>
                        <input type="date" class="form-control" name="fromDate" value="@fromDateValue" required />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-bold">To Date</label>
                        <input type="date" class="form-control" name="toDate" value="@toDateValue" required />
                    </div>

                    <div class="col-md-4 d-flex align-items-end">
                        <div class="d-flex gap-2 w-100">
                            <button type="button"
                                    class="btn btn-primary btn-sm custom-btn flex-fill shadow-sm fw-semibold"
                                    onclick="loadOnScreenReport()">
                                <i class="fa fa-desktop me-1"></i> View Report
                            </button>

                            <button type="submit"
                                    class="btn btn-success btn-sm custom-btn flex-fill shadow-sm fw-semibold"
                                    asp-action="ExportExcel">
                                <i class="fa fa-file-excel-o me-1"></i> Excel
                            </button>

                            <button type="submit"
                                    class="btn btn-danger btn-sm custom-btn flex-fill shadow-sm fw-semibold"
                                    asp-action="GeneratePDF"
                                    formtarget="_blank">
                                <i class="fa fa-file-pdf-o me-1"></i> PDF
                            </button>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- ON SCREEN REPORT -->
    <div id="reportCard" class="card shadow border-0" style="display:none;">
        <div class="card-header card-header-brand d-flex justify-content-between align-items-center py-2 text-white">
            <h5 class="mb-0 fs-6"><i class="fa fa-file-text-o me-2"></i> Report Preview</h5>
            <div class="d-flex align-items-center gap-2">
                <button type="button" class="btn btn-sm btn-light py-0 px-2" onclick="printReportFrame()">
                    <i class="fa fa-print me-1"></i> Print
                </button>
                <button type="button" class="btn btn-sm btn-outline-light py-0 px-2" onclick="$('#reportCard').hide()">
                    <i class="fa fa-times"></i> Close
                </button>
            </div>
        </div>

        <!-- LOADER -->
        <div id="reportLoader" style="display:none; padding:40px; text-align:center;">
            <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;">
                <span class="visually-hidden">Loading...</span>
            </div>
            <div class="mt-3 fw-bold text-muted">Loading audit log report, please wait...</div>
        </div>

        <!-- REPORT -->
        <div class="card-body p-0">
            <iframe id="reportFrame" class="report-preview-frame"
                    style="width:100%; height:750px; border:none; display:none;"></iframe>
        </div>
    </div>
</div>

<script>
    function loadOnScreenReport() {
        var fromDate = $('input[name="fromDate"]').val();
        var toDate = $('input[name="toDate"]').val();

        if (!fromDate || !toDate) {
            alert("Please select From Date and To Date");
            return;
        }

        $('#reportCard').show();
        $('#reportLoader').show();
        $('#reportFrame').hide();

        $('html, body').animate({
            scrollTop: $('#reportCard').offset().top - 20
        }, 400);

        var url = '/AuditLogReport/OnScreenReport'
            + '?fromDate=' + encodeURIComponent(fromDate)
            + '&toDate=' + encodeURIComponent(toDate);

        $('#reportFrame').off('load');
        $('#reportFrame').attr('src', url);
        $('#reportFrame').on('load', function () {
            $('#reportLoader').hide();
            $('#reportFrame').show();
        });
    }

    function printReportFrame() {
        var frame = document.getElementById('reportFrame');
        if (frame && frame.contentWindow) {
            frame.contentWindow.focus();
            frame.contentWindow.print();
        }
    }
</script>
