@{
    ViewData["Title"] = "Station Ledger Report";

    var fromDateValue = ViewBag.FromDate as string;
    var toDateValue = ViewBag.ToDate as string;
    var accodeValue = ViewBag.Accode as string;
    var selectedCompanyId = ViewBag.SelectedCompanyId != null ? (int)ViewBag.SelectedCompanyId : 0;
    var companyList = ViewBag.CompanyList as IEnumerable<dynamic>;

    if (string.IsNullOrEmpty(fromDateValue))
    {
        fromDateValue = DateTime.Now.ToString("yyyy-MM-dd");
    }

    if (string.IsNullOrEmpty(toDateValue))
    {
        toDateValue = DateTime.Now.ToString("yyyy-MM-dd");
    }
}

<style>
    .custom-card { border-radius: 10px; }
    .heading-glow { font-weight: 600; }
    .custom-btn { border-radius: 6px; }
    iframe { border-radius: 8px; }
</style>

<div class="container-fluid mt-4">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="fw-bold text-navy"><i class="fa fa-map-marker me-2 text-primary"></i> Station Ledger Report</h3>
    </div>

    <!-- Filter Card -->
    <div class="card custom-card mb-4 shadow-sm border-0">
        <div class="card-header card-header-brand py-3">
            <h5 class="mb-0 fw-semibold text-white">
                <i class="fa fa-filter me-2"></i> Filter Parameters
            </h5>
        </div>
        <div class="card-body report-filter-body">
            <form method="get">
                <div class="row g-3">
                    <!-- Company Dropdown -->
                    <div class="col-md-3">
                        <label class="form-label fw-bold">Company</label>
                        <select class="form-select select2" name="companyId" id="companySelect">
                            <option value="0" selected="@(selectedCompanyId == 0 ? "selected" : null)">-- All Companies (Linked) --</option>
                            @if (companyList != null)
                            {
                                foreach (var comp in companyList)
                                {
                                    if (comp.Id == selectedCompanyId)
                                    {
                                        <option value="@comp.Id" selected="selected">@comp.Name</option>
                                    }
                                    else
                                    {
                                        <option value="@comp.Id">@comp.Name</option>
                                    }
                                }
                            }
                        </select>
                    </div>

                    <!-- Account Code Selector -->
                    <div class="col-md-3">
                        <label class="form-label fw-bold">Select Station Account</label>
                        <select class="form-control select2" id="accodeSelect" name="accode" required>
                            <option value="">-- Select Station Account --</option>
                            @if (ViewBag.AccountList != null)
                            {
                                foreach (var item in ViewBag.AccountList)
                                {
                                    <option value="@item.Code" 
                                            selected="@(item.Code == accodeValue ? "selected" : null)">
                                        @item.Name (@item.Code)
                                    </option>
                                }
                            }
                        </select>
                    </div>

                    <!-- From Date -->
                    <div class="col-md-3">
                        <label class="form-label fw-bold">From Date</label>
                        <input type="date" class="form-control" name="fromDate" value="@fromDateValue" required />
                    </div>

                    <!-- To Date -->
                    <div class="col-md-3">
                        <label class="form-label fw-bold">To Date</label>
                        <input type="date" class="form-control" name="toDate" value="@toDateValue" required />
                    </div>

                    <!-- Actions -->
                    <div class="col-md-12 d-flex justify-content-end gap-2 mt-3 pt-2 border-top">
                        <!-- VIEW ON SCREEN -->
                        <button type="button"
                                class="btn btn-primary btn-sm custom-btn px-3 shadow-sm fw-semibold"
                                onclick="loadOnScreenReport()">
                            <i class="fa fa-desktop me-1"></i> View Report
                        </button>

                        <!-- EXCEL EXPORT -->
                        <button type="submit"
                                class="btn btn-success btn-sm custom-btn px-3 shadow-sm fw-semibold"
                                asp-action="ExportExcel">
                            <i class="fa fa-file-excel-o me-1"></i> Export Excel (CSV)
                        </button>

                        <!-- PDF DOWNLOAD -->
                        <button type="submit"
                                class="btn btn-danger btn-sm custom-btn px-3 shadow-sm fw-semibold"
                                asp-action="GeneratePDF"
                                formtarget="_blank">
                            <i class="fa fa-file-pdf-o me-1"></i> Open / Print PDF
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- ON SCREEN REPORT PREVIEW -->
    <div id="reportCard" class="card shadow border-0" style="display:none;">
        <div class="card-header card-header-brand d-flex justify-content-between align-items-center py-2 text-white">
            <h5 class="mb-0 fs-6"><i class="fa fa-file-text-o me-2"></i> Report Preview</h5>
            <div class="d-flex align-items-center gap-2">
                <button type="button" class="btn btn-sm btn-light py-0 px-2" onclick="printReportFrame()">
                    <i class="fa fa-print me-1"></i> Print
                </button>
                <button type="button" class="btn btn-sm btn-outline-light py-0 px-2" onclick="$('#reportCard').hide()">
                    <i class="fa fa-times"></i> Close
                </button>
            </div>
        </div>

        <!-- LOADER -->
        <div id="reportLoader" style="display:none; padding:40px; text-align:center;">
            <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;">
                <span class="visually-hidden">Loading...</span>
            </div>
            <div class="mt-3 fw-bold text-muted">Generating station ledger report, please wait...</div>
        </div>

        <!-- REPORT IFRAME -->
        <div class="card-body p-0">
            <iframe id="reportFrame" class="report-preview-frame"
                    style="width:100%; height:750px; border:none;"></iframe>
        </div>
    </div>

</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            if ($.fn.select2) {
                $('#companySelect').select2({ theme: 'bootstrap-5', width: '100%' });

                $('#accodeSelect').select2({
                    theme: 'bootstrap-5',
                    placeholder: "-- Select Station Account --",
                    allowClear: true,
                    width: '100%'
                });
            }

            $('#companySelect').on('change', function () {
                var compId = $(this).val();
                if (compId === '' || compId === null || compId === undefined) return;

                $.getJSON('@Url.Action("GetAccountsByCompany", "StationLedgerReport")', { companyId: compId }, function (data) {
                    var $acc = $('#accodeSelect');
                    $acc.empty().append('<option value="">-- Select Station Account --</option>');
                    $.each(data, function (i, item) {
                        $acc.append('<option value="' + item.code + '">' + item.name + ' (' + item.code + ')</option>');
                    });
                    $acc.trigger('change');
                });
            });
        });

        function loadOnScreenReport() {
            var companyId = $('#companySelect').val() || '';
            var accode = $('#accodeSelect').val() || '';
            var fromDate = $('input[name="fromDate"]').val();
            var toDate = $('input[name="toDate"]').val();

            if (!accode) {
                alert("Please select a Station Account.");
                return;
            }

            if (!fromDate) {
                alert("Please select From Date.");
                return;
            }

            if (!toDate) {
                alert("Please select To Date.");
                return;
            }

            if (fromDate > toDate) {
                alert("From Date cannot be greater than To Date.");
                return;
            }

            $('#reportCard').show();
            $('#reportLoader').show();
            $('#reportFrame').show();

            // Smooth scroll down to preview
            $('html, body').animate({
                scrollTop: $("#reportCard").offset().top - 20
            }, 400);

            var url = '@Url.Action("OnScreenReport", "StationLedgerReport")'
                + '?companyId=' + encodeURIComponent(companyId)
                + '&accode=' + encodeURIComponent(accode)
                + '&fromDate=' + encodeURIComponent(fromDate)
                + '&toDate=' + encodeURIComponent(toDate);

            var frame = document.getElementById('reportFrame');
            if (frame) {
                frame.onload = function () {
                    $('#reportLoader').hide();
                };
                frame.src = url;
            }

            setTimeout(function () {
                $('#reportLoader').hide();
            }, 2500);
        }

        function printReportFrame() {
            var frame = document.getElementById('reportFrame');
            if (frame && frame.contentWindow) {
                frame.contentWindow.focus();
                frame.contentWindow.print();
            }
        }
    </script>
}
