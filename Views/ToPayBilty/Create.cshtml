@using Nskg.Models.ViewModels
@model BiltyViewModel

<form id="myForm" asp-action="Create" method="post">

    <input type="hidden" asp-for="Head.DocNo" />
    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div class="d-flex align-items-center gap-3">
            <div>
                <h3 class="mb-0 fw-bold text-navy">
                    <i class="fa fa-truck text-primary me-2"></i>
                    To Pay Bilty Entry
                </h3>
                <small class="text-muted"><i class="fa fa-info-circle me-1"></i> Create To Pay Bilty / Goods Dispatch</small>
            </div>
            <span class="badge bg-primary fs-6 px-3 py-2 shadow-sm"><i class="fa fa-file-text me-1"></i>DC No: @Model.Head.DocNo</span>
        </div>

        <div>
            <button type="button" class="btn btn-outline-primary btn-sm custom-btn me-2" onclick="addRow()">
                <i class="fa fa-plus me-1"></i> Add Item
            </button>

            <button type="submit" id="btnSave" class="btn btn-success btn-sm custom-btn shadow-sm">
                <i class="fa fa-save me-1"></i> Save To Pay Bilty
            </button>
        </div>
    </div>


    <!-- MASTER SECTION -->
    <div class="card custom-card shadow-sm border-0 mb-3">
        <div class="card-header bg-white border-bottom py-2 d-flex justify-content-between align-items-center">
            <h6 class="mb-0 fw-semibold text-navy">
                <i class="fa fa-sliders text-primary me-2"></i> General Details
            </h6>
        </div>
        <div class="card-body">
            <div class="row g-3">

                <div class="col-md-2">
                    <label class="form-label small text-muted fw-semibold mb-1"><i class="fa fa-hashtag text-primary me-1"></i> Bilty No</label>
                    <input asp-for="Head.BillTiNo" id="BiltyNo" class="form-control form-control-sm" tabindex="1" />
                </div>

                <div class="col-md-2">
                    <label class="form-label small text-muted fw-semibold mb-1"><i class="fa fa-calendar text-primary me-1"></i> Bilty Date</label>
                    <input asp-for="Head.DocDate" id="BiltyDate" type="date" value="@(Model != null && Model.Head != null && Model.Head.DocDate.HasValue ? Model.Head.DocDate.Value.ToString("yyyy-MM-dd") : DateTime.Today.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" tabindex="2" />
                </div>

                <div class="col-md-4">
                    <label class="form-label small text-muted fw-semibold mb-1"><i class="fa fa-map-marker text-primary me-1"></i> Station</label>
                    <select asp-for="Head.StationId" id="Station" class="form-select form-select-sm select2" tabindex="3"
                            asp-items="@(new SelectList(ViewBag.Stations, "Value", "Text", Model != null && Model.Head != null && Model.Head.StationId > 0 ? Model.Head.StationId.ToString() : ""))">
                    </select>
                </div>

                <div class="col-md-4">
                    <label class="form-label small text-muted fw-semibold mb-1"><i class="fa fa-user text-primary me-1"></i> Party Name</label>

                    <div class="input-group input-group-sm">
                        <select asp-for="Head.CustomerId"
                                id="CustomerId"
                                class="form-select select2" tabindex="4"
                                required
                                asp-items="@(new SelectList(ViewBag.Customers, "Value", "Text", Model != null && Model.Head != null && Model.Head.CustomerId > 0 ? Model.Head.CustomerId.ToString() : ""))">
                        </select>

                        <button type="button"
                                class="btn btn-outline-primary"
                                data-bs-toggle="modal"
                                data-bs-target="#customerModal">
                            <i class="fa fa-plus"></i>
                        </button>
                    </div>
                </div>

                <div class="col-md-3">
                    <label class="form-label small text-muted fw-semibold mb-1"><i class="fa fa-paper-plane text-primary me-1"></i> Send To</label>
                    <input asp-for="Head.SendTo" id="SendTo" class="form-control form-control-sm" tabindex="5" />
                </div>

                <div class="col-md-3">
                    <label class="form-label small text-muted fw-semibold mb-1"><i class="fa fa-file-text-o text-primary me-1"></i> Bill No</label>
                    <input asp-for="Head.BilNo" id="BillNo" class="form-control form-control-sm" tabindex="6" />
                </div>

                <div class="col-md-6">
                    <label class="form-label small text-muted fw-semibold mb-1"><i class="fa fa-comment text-primary me-1"></i> Remarks</label>
                    <input asp-for="Head.Narration" id="Remarks" class="form-control form-control-sm" tabindex="7" />
                </div>

            </div>
        </div>
    </div>


    <!-- DETAIL GRID -->
    <div class="card custom-card shadow-sm border-0 mb-3">
        <div class="card-header bg-white border-bottom py-2 d-flex justify-content-between align-items-center">
            <h6 class="mb-0 fw-semibold text-navy">
                <i class="fa fa-list text-primary me-2"></i>
                To Pay Bilty Items
            </h6>
        </div>

        <div class="card-body p-0">
            <div class="table-responsive">

                <table class="table table-bordered table-hover mb-0" id="tblItems">
                    <thead class="table-light text-center">
                        <tr>
                            <th><i class="fa fa-cube text-primary me-1"></i> Item</th>
                            <th width="120"><i class="fa fa-cubes text-primary me-1"></i> Qty</th>
                            <th width="120"><i class="fa fa-balance-scale text-primary me-1"></i> Weight</th>
                            <th width="80"><i class="fa fa-cog text-primary me-1"></i> Action</th>
                        </tr>
                    </thead>

                    <tbody id="tbodyItems">
                        <tr id="noDataRow">
                            <td colspan="4" class="text-center text-muted py-3">
                                No Items Added
                            </td>
                        </tr>
                    </tbody>
                </table>

            </div>
        </div>
    </div>


    <!-- EXPENSE SECTION -->
    <div class="card custom-card shadow-sm border-0">
        <div class="card-header bg-white border-bottom py-2 d-flex justify-content-between align-items-center">
            <h6 class="mb-0 fw-semibold text-navy">
                <i class="fa fa-calculator text-primary me-2"></i>
                Expense Details
            </h6>
        </div>

        <div class="card-body">
            <div class="row g-3">

                <div class="col-md-2">
                    <label class="form-label small text-muted fw-semibold mb-1"><i class="fa fa-money text-primary me-1"></i> Freight</label>
                    <input id="Cartage1" asp-for="Head.Cartage1" class="form-control form-control-sm calc-net" tabindex="100" />
                </div>

                <div class="col-md-2">
                    <label class="form-label small text-muted fw-semibold mb-1"><i class="fa fa-money text-primary me-1"></i> Labour</label>
                    <input id="Labour" asp-for="Head.Labour" class="form-control form-control-sm calc-net" tabindex="101" />
                </div>

                <div class="col-md-2">
                    <label class="form-label small text-muted fw-semibold mb-1"><i class="fa fa-money text-primary me-1"></i> T.T</label>
                    <input id="T_T" asp-for="Head.T_T" class="form-control form-control-sm calc-net" tabindex="102" />
                </div>

                <div class="col-md-2">
                    <label class="form-label small text-muted fw-semibold mb-1"><i class="fa fa-money text-primary me-1"></i> Lifter</label>
                    <input id="Cartage3" asp-for="Head.Cartage3" class="form-control form-control-sm calc-net" tabindex="103" />
                </div>

                <div class="col-md-2">
                    <label class="form-label small text-muted fw-semibold mb-1"><i class="fa fa-money text-primary me-1"></i> Local Freight</label>
                    <input id="Cartage2" asp-for="Head.Cartage2" class="form-control form-control-sm calc-net" tabindex="104" />
                </div>

                <div class="col-md-2">
                    <label class="form-label small text-muted fw-semibold mb-1"><i class="fa fa-money text-primary me-1"></i> Party Expense</label>
                    <input id="PartyEx" asp-for="Head.PartyEx" class="form-control form-control-sm calc-net" tabindex="105" />
                </div>

                <div class="col-md-2">
                    <label class="form-label small text-muted fw-semibold mb-1"><i class="fa fa-money text-primary me-1"></i> Lifter2</label>
                    <input id="Lifter2" asp-for="Head.Lifter2" class="form-control form-control-sm calc-net" tabindex="106" />
                </div>

                <div class="col-md-2">
                    <label class="form-label small text-muted fw-semibold mb-1"><i class="fa fa-money text-primary me-1"></i> Other</label>
                    <input id="OtherEx" asp-for="Head.OtherEx" class="form-control form-control-sm calc-net" tabindex="107" />
                </div>

                <div class="col-md-3">
                    <label class="form-label small text-navy fw-bold mb-1"><i class="fa fa-calculator text-primary me-1"></i> Net Amount</label>
                    <input asp-for="Head.NetAmt" readonly class="form-control form-control-sm bg-light fw-bold text-navy" />
                </div>

            </div>
        </div>
    </div>

</form>

<div class="modal fade" id="customerModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Add Customer</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <label>Customer Name</label>
                <input type="text" id="CustomerName" class="form-control" />
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-success" onclick="saveCustomer()">Save</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function highlightField(element) {
            $('.form-control, .form-select, .btn').removeClass('active-field');
            $(element).addClass('active-field');
        }

        $(document).ready(function() {
            // Initialize select2 on all dropdowns
            $('.select2').select2({
                theme: 'bootstrap-5',
                width: '100%'
            });

            @if (Model?.Head?.StationId > 0) {
                <text>$('#Station').val('@Model.Head.StationId').trigger('change.select2');</text>
            }
            @if (Model?.Head?.CustomerId > 0) {
                <text>$('#CustomerId').val('@Model.Head.CustomerId').trigger('change.select2');</text>
            }

            $('#BiltyNo').focus();
            highlightField('#BiltyNo');
            addRow();
            calculateNetAmount();
        });

        $(document).on('keydown', '.form-control, .form-select', function(e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                var currentElement = $(this);

                if (currentElement.hasClass('qty')) {
                    var currentRow = currentElement.closest('tr');
                    var qtyValue = currentElement.val();
                    if (!qtyValue || qtyValue.trim() === '') {
                        AppNav.focusElement($('#Cartage1')); return;
                    }
                    var weightField = currentRow.find('.qtyperpack');
                    if (weightField.length) { AppNav.focusElement(weightField); }
                    return;
                }

                if (currentElement.hasClass('qtyperpack')) {
                    var weightValue = currentElement.val();
                    if (!weightValue || weightValue.trim() === '') {
                        AppNav.focusElement($('#Cartage1')); return;
                    }
                    addRow();
                    var newRow = $('#tbodyItems tr:last-child');
                    setTimeout(function() {
                        var newQty = newRow.find('.qty');
                        AppNav.focusElement(newQty);
                    }, 50);
                    return;
                }

                // Master & Expense fields: delegate to AppNav
                AppNav.moveToNext(currentElement);
            }
        });

        $(document).on('focus', '.form-control, .form-select', function() { highlightField(this); });

        function saveCustomer() {
            let name = $("#CustomerName").val();
            if (name.trim() === "") { alert("Customer name required"); return; }
            $.ajax({
                url: '/GLChart/CreateAjax', type: 'POST', data: { name: name },
                success: function (res) {
                    if (res.success) {
                        let newOption = new Option(res.text, res.id, true, true);
                        $('#CustomerId').append(newOption).trigger('change');
                        $("#CustomerName").val(""); $("#customerModal").modal('hide');
                    } else { alert(res.message); }
                },
                error: function () { alert("Error saving customer"); }
            });
        }

        let i = 0;

        function addRow() {
            const noData = document.getElementById("noDataRow");
            if (noData) noData.remove();
            let row = `
            <tr>
                <td><input name="Details[${i}].IName" value="NOS" class="form-control form-control-sm" readonly /></td>
                <td><input name="Details[${i}].Qty" type="number" step="0.01" class="form-control form-control-sm qty" /></td>
                <td><input name="Details[${i}].QtyPerPack" type="number" step="0.01" class="form-control form-control-sm qtyperpack" /></td>
                <td class="text-center">
                    <button type="button" class="btn btn-danger btn-sm" onclick="removeRow(this)">
                        <i class="fa fa-trash"></i>
                    </button>
                </td>
            </tr>`;
            $("#tbodyItems").append(row);
            i++;
        }

        function removeRow(btn) {
            var row = $(btn).closest("tr");
            var isFirstRow = row.is(':first-child');
            row.remove();
            if (isFirstRow) {
                var newFirstQty = $('#tbodyItems .qty:first');
                if (newFirstQty.length) { newFirstQty.focus(); highlightField(newFirstQty); }
                else { $('#Cartage1').focus(); highlightField('#Cartage1'); }
            }
            if ($("#tbodyItems tr").length === 0) {
                $("#tbodyItems").html(`<tr id="noDataRow"><td colspan="4" class="text-center text-muted py-3">No Items Added</td></tr>`);
            }
        }

        function calculateNetAmount() {
            let cartage1 = parseFloat($("#Cartage1").val()) || 0;
            let cartage2 = parseFloat($("#Cartage2").val()) || 0;
            let cartage3 = parseFloat($("#Cartage3").val()) || 0;
            let labour   = parseFloat($("#Labour").val()) || 0;
            let tt       = parseFloat($("#T_T").val()) || 0;
            $("#Head_NetAmt").val((cartage1 + cartage2 + cartage3 + labour + tt).toFixed(2));
        }

        $(document).on("input", "#Cartage1, #Cartage2, #Cartage3, #Labour, #T_T", function () { calculateNetAmount(); });

        document.addEventListener('keydown', function (e) {
            if (e.ctrlKey && e.key.toLowerCase() === 's') {
                e.preventDefault();
                document.getElementById('btnSave').click();
            }
        });
    </script>
}

<style>
    .active-field {
        border: 2px solid #fd7e14 !important;
        box-shadow: 0 0 0 0.2rem rgba(253, 126, 20, 0.25) !important;
        background-color: #fff8f0 !important;
        transition: all 0.2s ease;
    }
    .btn.active-field {
        border: 2px solid #fd7e14 !important;
        box-shadow: 0 0 0 0.2rem rgba(253, 126, 20, 0.3) !important;
        transform: scale(1.02);
    }
    .form-control:focus, .form-select:focus {
        border-color: #fd7e14;
        box-shadow: 0 0 0 0.25rem rgba(253, 126, 20, 0.25);
    }
    .form-control, .form-select, .btn { transition: all 0.2s ease; }
</style>
