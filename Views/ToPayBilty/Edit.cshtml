@using Nskg.Models.ViewModels
@model BiltyViewModel

<form method="post" id="myForm">

    <input type="hidden" asp-for="Head.Id" />

    <input type="hidden" asp-for="Head.DocNo" />
    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div class="d-flex align-items-center gap-3">
            <div>
                <h3 class="mb-0">
                    <i class="fa fa-edit text-warning me-2"></i>
                    Edit To Pay Bilty
                </h3>
                <small class="text-muted">Update To Pay Bilty</small>
            </div>
            <span class="badge bg-dark fs-6 px-3 py-2"><i class="fa fa-file-text me-1"></i>DC No: @Model.Head.DocNo</span>
        </div>

        <div class="d-flex flex-wrap align-items-center gap-1">
            @if (ViewBag.PrevId != null)
            {
                <a href="@Url.Action("Edit", new { id = ViewBag.PrevId })" class="btn btn-outline-secondary btn-sm" title="Previous Entry">
                    <i class="fa fa-arrow-left me-1"></i> Prev
                </a>
            }
            else
            {
                <button type="button" class="btn btn-outline-secondary btn-sm disabled" disabled>
                    <i class="fa fa-arrow-left me-1"></i> Prev
                </button>
            }

            @if (ViewBag.NextId != null)
            {
                <a href="@Url.Action("Edit", new { id = ViewBag.NextId })" class="btn btn-outline-secondary btn-sm" title="Next Entry">
                    Next <i class="fa fa-arrow-right ms-1"></i>
                </a>
            }
            else
            {
                <button type="button" class="btn btn-outline-secondary btn-sm disabled" disabled>
                    Next <i class="fa fa-arrow-right ms-1"></i>
                </button>
            }

            <a asp-action="Create" class="btn btn-outline-primary btn-sm me-2" title="New Entry">
                <i class="fa fa-plus-circle me-1"></i> New
            </a>

            <button type="button" class="btn btn-outline-primary btn-sm me-1" onclick="addRow()">
                <i class="fa fa-plus"></i> Add Item
            </button>

            <button type="submit" id="btnUpdate" class="btn btn-warning btn-sm">
                <i class="fa fa-save"></i> Update To Pay Bilty
            </button>
        </div>
    </div>

    <!-- MASTER SECTION -->
    <div class="card shadow-sm border-0 mb-3">
        <div class="card-body">
            <div class="row g-3">

                <div class="col-md-2">
                    <label>Bilty No</label>
                    <input asp-for="Head.BillTiNo" id="BiltyNo" class="form-control form-control-sm" tabindex="1" />
                </div>

                <div class="col-md-2">
                    <label>Bilty Date</label>
                    <input asp-for="Head.DocDate" id="BiltyDate" type="date" class="form-control form-control-sm" tabindex="2" />
                </div>

                <div class="col-md-4">
                    <label>Station</label>
                    <select asp-for="Head.StationId" id="Station" class="form-select form-select-sm select2" tabindex="3"
                            asp-items="@(new SelectList(ViewBag.Stations, "Value", "Text"))">
                    </select>
                </div>

                <div class="col-md-4">
                    <label>Party Name</label>

                    <div class="input-group input-group-sm">
                        <select asp-for="Head.CustomerId"
                                id="CustomerId"
                                class="form-select select2" tabindex="4"
                                asp-items="@(new SelectList(ViewBag.Customers, "Value", "Text"))">
                        </select>

                        <button type="button"
                                class="btn btn-outline-primary"
                                data-bs-toggle="modal"
                                data-bs-target="#customerModal">
                            <i class="fa fa-plus"></i>
                        </button>
                    </div>
                </div>

                <div class="col-md-3">
                    <label>Send To</label>
                    <input asp-for="Head.SendTo" id="SendTo" class="form-control form-control-sm" tabindex="5" />
                </div>

                <div class="col-md-3">
                    <label>Bill No</label>
                    <input asp-for="Head.BilNo" id="BillNo" class="form-control form-control-sm" tabindex="6" />
                </div>

                <div class="col-md-6">
                    <label>Remarks</label>
                    <input asp-for="Head.Narration" id="Remarks" class="form-control form-control-sm" tabindex="7" />
                </div>

            </div>
        </div>
    </div>

    <!-- DETAIL GRID -->
    <div class="card shadow-sm border-0 mb-3">
        <div class="card-header bg-white">
            <h6 class="mb-0">
                <i class="fa fa-list me-1 text-warning"></i>
                To Pay Bilty Items
            </h6>
        </div>

        <div class="card-body p-0">
            <div class="table-responsive">

                <table class="table table-bordered table-hover mb-0" id="tblItems">
                    <thead class="table-light text-center">
                        <tr>
                            <th>Item</th>
                            <th width="120">Qty</th>
                            <th width="120">Weight</th>
                            <th width="80">Action</th>
                        </tr>
                    </thead>

                    <tbody id="tbodyItems">
                        <tr id="noDataRow">
                            <td colspan="4" class="text-center text-muted py-3">
                                No Items Added
                            </td>
                        </tr>
                    </tbody>
                </table>

            </div>
        </div>
    </div>

    <!-- EXPENSE SECTION -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white">
            <h6 class="mb-0">
                <i class="fa fa-money me-1 text-success"></i>
                Expense Details
            </h6>
        </div>

        <div class="card-body">
            <div class="row g-3">

                <div class="col-md-2">
                    <label>Freight</label>
                    <input id="Cartage1" asp-for="Head.Cartage1" class="form-control form-control-sm calc-net" tabindex="100" />
                </div>

                <div class="col-md-2">
                    <label>Labour</label>
                    <input id="Labour" asp-for="Head.Labour" class="form-control form-control-sm calc-net" tabindex="101" />
                </div>

                <div class="col-md-2">
                    <label>T.T</label>
                    <input id="T_T" asp-for="Head.T_T" class="form-control form-control-sm calc-net" tabindex="102" />
                </div>

                <div class="col-md-2">
                    <label>Lifter</label>
                    <input id="Cartage3" asp-for="Head.Cartage3" class="form-control form-control-sm calc-net" tabindex="103" />
                </div>

                <div class="col-md-2">
                    <label>Local Freight</label>
                    <input id="Cartage2" asp-for="Head.Cartage2" class="form-control form-control-sm calc-net" tabindex="104" />
                </div>

                <div class="col-md-2">
                    <label>Party Expense</label>
                    <input id="PartyEx" asp-for="Head.PartyEx" class="form-control form-control-sm calc-net" tabindex="105" />
                </div>

                <div class="col-md-2">
                    <label>Lifter2</label>
                    <input id="Lifter2" asp-for="Head.Lifter2" class="form-control form-control-sm calc-net" tabindex="106" />
                </div>

                <div class="col-md-2">
                    <label>Other</label>
                    <input id="OtherEx" asp-for="Head.OtherEx" class="form-control form-control-sm calc-net" tabindex="107" />
                </div>

                <div class="col-md-3">
                    <label>Net Amount</label>
                    <input asp-for="Head.NetAmt" readonly class="form-control form-control-sm bg-light" />
                </div>

            </div>
        </div>
    </div>

</form>

<div class="modal fade" id="customerModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Add Customer</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <label>Customer Name</label>
                <input type="text" id="CustomerName" class="form-control" />
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-success" onclick="saveCustomer()">Save</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function highlightField(element) {
            $('.form-control, .form-select, .btn').removeClass('active-field');
            $(element).addClass('active-field');
        }

        function saveCustomer() {
            let name = $("#CustomerName").val();
            if (name.trim() === "") { alert("Customer name required"); return; }
            $.ajax({
                url: '/GLChart/CreateAjax', type: 'POST', data: { name: name },
                success: function (res) {
                    if (res.success) {
                        let newOption = new Option(res.text, res.id, true, true);
                        $('#CustomerId').append(newOption).trigger('change');
                        $("#CustomerName").val(""); $("#customerModal").modal('hide');
                    } else { alert(res.message); }
                },
                error: function () { alert("Error saving customer"); }
            });
        }

        let i = 0;

        $(document).ready(function () {
            let data = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Details, new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }));

            $("#tbodyItems").html("");

            if (!data || data.length === 0) {
                addRow();
            } else {
                data.forEach(x => {
                    let row = `
                    <tr>
                        <td><input name="Details[${i}].IName" value="${x.iName ?? ''}" class="form-control form-control-sm" readonly /></td>
                        <td><input name="Details[${i}].Qty" value="${x.qty ?? 0}" class="form-control form-control-sm qty" /></td>
                        <td><input name="Details[${i}].QtyPerPack" value="${x.qtyPerPack ?? 0}" class="form-control form-control-sm qtyperpack" /></td>
                        <td class="text-center">
                            <button type="button" class="btn btn-danger btn-sm" onclick="removeRow(this)">
                                <i class="fa fa-trash"></i>
                            </button>
                        </td>
                    </tr>`;
                    $("#tbodyItems").append(row);
                    i++;
                });
            }

            calculateNetAmount();

            // Initialize select2 on all dropdowns
            $('.select2').select2({
                theme: 'bootstrap-5',
                width: '100%'
            });

            $('#BiltyNo').focus();
            highlightField('#BiltyNo');
        });

        $(document).on('keydown', '.form-control, .form-select', function(e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                var currentElement = $(this);
                var currentTabIndex = parseInt(currentElement.attr('tabindex')) || 0;

                if (currentElement.hasClass('qty')) {
                    var qtyValue = currentElement.val();
                    if (!qtyValue || qtyValue.trim() === '') { $('#Cartage1').focus(); highlightField('#Cartage1'); return; }
                    var weightField = currentElement.closest('tr').find('.qtyperpack');
                    if (weightField.length) { weightField.focus(); highlightField(weightField); }
                    return;
                }

                if (currentElement.hasClass('qtyperpack')) {
                    var weightValue = currentElement.val();
                    if (!weightValue || weightValue.trim() === '') { $('#Cartage1').focus(); highlightField('#Cartage1'); return; }
                    addRow();
                    setTimeout(function() {
                        var newQty = $('#tbodyItems tr:last-child').find('.qty');
                        newQty.focus(); highlightField(newQty);
                    }, 50);
                    return;
                }

                if (currentTabIndex >= 100) {
                    var nextExpense = $('[tabindex="' + (currentTabIndex + 1) + '"]');
                    if (nextExpense.length) { nextExpense.focus(); highlightField(nextExpense); }
                    else { $('#btnUpdate').focus(); highlightField('#btnUpdate'); }
                    return;
                }

                var nextField = $('[tabindex="' + (currentTabIndex + 1) + '"]');
                if (nextField.length) { nextField.focus(); highlightField(nextField); }
                else {
                    var firstQty = $('#tbodyItems .qty:first');
                    if (firstQty.length) { firstQty.focus(); highlightField(firstQty); }
                }
            }
        });

        $(document).on('focus', '.form-control, .form-select', function() { highlightField(this); });

        function addRow() {
            const noData = document.getElementById("noDataRow");
            if (noData) noData.remove();
            let row = `
            <tr>
                <td><input name="Details[${i}].IName" value="NOS" class="form-control form-control-sm" readonly /></td>
                <td><input name="Details[${i}].Qty" type="number" step="0.01" class="form-control form-control-sm qty" /></td>
                <td><input name="Details[${i}].QtyPerPack" type="number" step="0.01" class="form-control form-control-sm qtyperpack" /></td>
                <td class="text-center">
                    <button type="button" class="btn btn-danger btn-sm" onclick="removeRow(this)">
                        <i class="fa fa-trash"></i>
                    </button>
                </td>
            </tr>`;
            $("#tbodyItems").append(row);
            i++;
        }

        function removeRow(btn) {
            var row = $(btn).closest("tr");
            var isFirstRow = row.is(':first-child');
            row.remove();
            if (isFirstRow) {
                var newFirstQty = $('#tbodyItems .qty:first');
                if (newFirstQty.length) { newFirstQty.focus(); highlightField(newFirstQty); }
                else { $('#Cartage1').focus(); highlightField('#Cartage1'); }
            }
            if ($("#tbodyItems tr").length === 0) {
                $("#tbodyItems").html(`<tr id="noDataRow"><td colspan="4" class="text-center text-muted py-3">No Items Added</td></tr>`);
            }
        }

        function calculateNetAmount() {
            let c1 = parseFloat($("#Cartage1").val()) || 0;
            let c2 = parseFloat($("#Cartage2").val()) || 0;
            let c3 = parseFloat($("#Cartage3").val()) || 0;
            let labour = parseFloat($("#Labour").val()) || 0;
            let tt = parseFloat($("#T_T").val()) || 0;
            $("#Head_NetAmt").val((c1 + c2 + c3 + labour + tt).toFixed(2));
        }

        $(document).on("input", "#Cartage1, #Cartage2, #Cartage3, #Labour, #T_T", function () { calculateNetAmount(); });

        document.addEventListener('keydown', function (e) {
            if (e.ctrlKey && e.key.toLowerCase() === 's') {
                e.preventDefault();
                document.getElementById('btnUpdate').click();
            }
        });
    </script>
}

<style>
    .active-field {
        border: 2px solid #fd7e14 !important;
        box-shadow: 0 0 0 0.2rem rgba(253, 126, 20, 0.25) !important;
        background-color: #fff8f0 !important;
        transition: all 0.2s ease;
    }
    .btn.active-field {
        border: 2px solid #fd7e14 !important;
        box-shadow: 0 0 0 0.2rem rgba(253, 126, 20, 0.3) !important;
        transform: scale(1.02);
    }
    .form-control:focus, .form-select:focus {
        border-color: #fd7e14;
        box-shadow: 0 0 0 0.25rem rgba(253, 126, 20, 0.25);
    }
    .form-control, .form-select, .btn { transition: all 0.2s ease; }
</style>
