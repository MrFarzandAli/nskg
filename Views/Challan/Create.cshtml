@using Nskg.Models.ViewModels
@model ChallanViewModel

@section Styles {
    <style>
        .form-inline-label {
            min-width: 130px;
            margin-bottom: 0;
            font-weight: 600;
            white-space: nowrap;
        }
    </style>
}

<form method="post">

    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h3 class="mb-0">
                <i class="fa fa-truck text-primary me-2"></i>
                Challan Entry
            </h3>
            <small class="text-muted">Goods Dispatch / Transport Challan</small>
        </div>

        <div>
            <button type="button" class="btn btn-outline-primary btn-sm me-2" onclick="addRow()">
                <i class="fa fa-plus"></i> Add Bilty
            </button>

            <button type="submit" class="btn btn-success btn-sm">
                <i class="fa fa-save"></i> Save Challan
            </button>
        </div>
    </div>


    <!-- MASTER -->
    <div class="card shadow-sm border-0 mb-3">
        <div class="card-body">
            <div class="row g-3">

                <div class="col-md-2">
                    <label>Challan No</label>
                    <input asp-for="Head.ChalNo" class="form-control form-control-sm" />
                </div>

                <div class="col-md-2">
                    <label>Date</label>
                    <input asp-for="Head.DocDate" type="date" class="form-control form-control-sm" />
                </div>

                <div class="col-md-2">
                    <label>Doc No</label>
                    <input asp-for="Head.DocNo" readonly class="form-control form-control-sm bg-light" />
                </div>

                <div class="col-md-3">
                    <label>Station</label>
                    <select asp-for="Head.StationId" class="form-select form-select-sm"
                            asp-items="@(new SelectList(ViewBag.Stations, "Value", "Text"))">
                    </select>
                </div>

                <div class="col-md-3">
                    <label>Transporter</label>
                    <select asp-for="Head.TransId" class="form-select form-select-sm"
                            asp-items="@(new SelectList(ViewBag.Transporters, "Value", "Text"))">
                    </select>
                </div>

                <div class="col-md-3">
                    <label>Vehicle No</label>
                    <input asp-for="Head.VehicleNo" class="form-control form-control-sm" />
                </div>

                <div class="col-md-3">
                    <label>Party Name</label>
                    <input asp-for="Head.Driver" class="form-control form-control-sm" />
                </div>

                <div class="col-md-6">
                    <label>Remarks</label>
                    <input asp-for="Head.Narration" class="form-control form-control-sm" />
                </div>

            </div>
        </div>
    </div>

    <!-- DETAIL + RIGHT PANEL -->
    <div class="row">

        <!-- LEFT GRID -->
        <div class="col-md-8">
            <!-- DETAIL GRID -->
            <div class="card shadow-sm border-0 mb-3">
                <div class="card-header bg-white">
                    <h6 class="mb-0">
                        <i class="fa fa-list text-primary me-1"></i>
                        Bilty Details
                    </h6>
                </div>

                <div class="card-body p-0">
                    <div class="table-responsive">

                        <table class="table table-bordered table-hover mb-0" id="tblItems">
                            <thead class="table-light text-center">
                                <tr>
                                    <th>Bilty No</th>
                                    <th>Party Name</th>
                                    <th>Send To</th>
                                    <th width="100">Qty</th>
                                    <th width="120">Bilty Amt</th>
                                    <th width="120">Paid Amt</th>
                                    <th width="80">Action</th>
                                </tr>
                            </thead>

                            <tbody id="tbodyItems">
                                <tr id="noDataRow">
                                    <td colspan="7" class="text-center text-muted py-3">
                                        No Records Added
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                    </div>
                </div>
            </div>
        </div>

        <!-- RIGHT PANEL (IMPORTANT PART YOU MISSED) -->
        <div class="col-md-4">
            <div class="row">
                <div class="col-md-4">
                    <div class="card mb-2">
                        <div class="card-body">

                            <label>B# / Party</label>
                            <input asp-for="Head.PExpCode" class="form-control form-control-sm mb-1" />

                            <label>Amount</label>
                            <input asp-for="Head.PExpAmt" class="form-control form-control-sm mb-1 calc" />

                            <label>Bilti</label>
                            <input asp-for="Head.PExpBilti" class="form-control form-control-sm" />

                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card mb-2">
                        <div class="card-body">

                            <label>B# / Party 2</label>
                            <input asp-for="Head.PExpCode2" class="form-control form-control-sm mb-1" />

                            <label>Amount</label>
                            <input asp-for="Head.PExpAmt2" class="form-control form-control-sm mb-1 calc" />

                            <label>Bilti</label>
                            <input asp-for="Head.PExpBilti2" class="form-control form-control-sm" />

                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card">
                        <div class="card-body">

                            <label>B# / Party 3</label>
                            <input asp-for="Head.PExpCode3" class="form-control form-control-sm mb-1" />

                            <label>Amount</label>
                            <input asp-for="Head.PExpAmt3" class="form-control form-control-sm mb-1 calc" />

                            <label>Bilti</label>
                            <input asp-for="Head.PExpBilti3" class="form-control form-control-sm" />

                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>


    <div class="card shadow-sm border-0 mb-2">
        <div class="card-body py-2">
            <div class="row g-2">

                <div class="col-md-4">
                    <div class="d-flex align-items-center gap-2">
                        <label class="form-inline-label">B#/ Party</label>
                        <input asp-for="Head.PartyEx2" class="form-control form-control-sm" />
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="d-flex align-items-center gap-2">
                        <label class="form-inline-label">B#/ Local</label>
                        <input asp-for="Head.LocalAmt2" class="form-control form-control-sm" />
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="d-flex align-items-center gap-2">
                        <label class="form-inline-label">B#/ Other Expense</label>
                        <input asp-for="Head.OtherEx2" class="form-control form-control-sm" />
                    </div>
                </div>

            </div>
        </div>
    </div>


    <div class="card shadow-sm border-0 mb-2">
        <div class="card-body py-2">
            <div class="row g-2">

                <div class="col-md-4">
                    <div class="d-flex align-items-center gap-2">
                        <label class="form-inline-label">Local Amount</label>
                        <input asp-for="Head.LocalAmt" class="form-control form-control-sm" />
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="d-flex align-items-center gap-2">
                        <label class="form-inline-label">Other Expense</label>
                        <input asp-for="Head.TotOtherEx" class="form-control form-control-sm" />
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="d-flex align-items-center gap-2">
                        <label class="form-inline-label">Total Bilty</label>
                        <input asp-for="Head.TotBillTi" readonly class="form-control form-control-sm bg-light" />
                    </div>
                </div>

            </div>
        </div>
    </div>


    <div class="card shadow-sm border-0">
        <div class="card-body py-2">
            <div class="row g-2">

                <div class="col-md-2">
                    <div class="d-flex align-items-center gap-2">
                        <label class="form-inline-label" style="min-width:50px;">To Pay</label>
                        <input asp-for="Head.TotToPaid" class="form-control form-control-sm" />
                    </div>
                </div>

                <div class="col-md-2">
                    <div class="d-flex align-items-center gap-2">
                        <label class="form-inline-label" style="min-width:90px;">Delivery Amt</label>
                        <input asp-for="Head.DeliveryAmt" class="form-control form-control-sm" />
                    </div>
                </div>

                <div class="col-md-2">
                    <div class="d-flex align-items-center gap-2">
                        <label class="form-inline-label" style="min-width:70px;">Bilty Amt</label>
                        <input asp-for="Head.BillTiAmt" class="form-control form-control-sm" />
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="d-flex align-items-center gap-2">
                        <label class="form-inline-label" style="min-width:50px;">Lifter</label>
                        <input asp-for="Head.TotLifter2" class="form-control form-control-sm" />
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="d-flex align-items-center gap-2">
                        <label class="form-inline-label" style="min-width:60px;">Net Amt</label>
                        <input asp-for="Head.NetAmt" readonly class="form-control form-control-sm bg-light" />
                    </div>
                </div>

            </div>
        </div>
    </div>

</form>

@section Scripts {
    <script>

        let i = 0;

        function addRow() {

            const noData = document.getElementById("noDataRow");
            if (noData) noData.remove();

            let row = `
            <tr>
                <td>
                    <input name="Details[${i}].BillTiNo" class="form-control form-control-sm"/>
                </td>

                <td>
                    <input name="Details[${i}].CusName" class="form-control form-control-sm"/>
                </td>

                <td>
                    <input name="Details[${i}].SendTo" class="form-control form-control-sm"/>
                </td>

                <td>
                    <input name="Details[${i}].Qty" type="number"
                           class="form-control form-control-sm qty"/>
                </td>

                <td>
                    <input name="Details[${i}].BillTiAmt" type="number"
                           class="form-control form-control-sm biltyamt"/>
                </td>

                <td>
                    <input name="Details[${i}].PaidAmt" type="number"
                           class="form-control form-control-sm paidamt"/>
                </td>

                <td class="text-center">
                    <button type="button" class="btn btn-danger btn-sm"
                            onclick="removeRow(this)">
                        <i class="fa fa-trash"></i>
                    </button>
                </td>
            </tr>`;

            $("#tbodyItems").append(row);
            i++;
        }

        function removeRow(btn) {
            $(btn).closest("tr").remove();
            calculateTotals();
        }


        // 🔥 TOTAL CALCULATION (MAIN LOGIC)
        function calculateTotals() {

            let totalBilty = 0;

            $(".biltyamt").each(function () {
                totalBilty += parseFloat($(this).val()) || 0;
            });

            $("#Head_TotBillTi").val(totalBilty.toFixed(2));

            let local = parseFloat($("#LocalAmt").val()) || 0;
            let delivery = parseFloat($("#DeliveryAmt").val()) || 0;
            let other = parseFloat($("#OtherEx").val()) || 0;

            let net = totalBilty + local + delivery + other;

            $("#Head_NetAmt").val(net.toFixed(2));
        }


        // realtime
        $(document).on("input", ".biltyamt, #LocalAmt, #DeliveryAmt, #OtherEx", function () {
            calculateTotals();
        });

        $(document).ready(function () {
            addRow();
        });

    </script>
}