@using Nskg.Models.ViewModels
@model ChallanViewModel

@section Styles {
    <style>
        .form-inline-label {
            min-width: 130px;
            margin-bottom: 0;
            font-weight: 600;
            white-space: nowrap;
        }

        .card {
            border-radius: 10px;
        }

        label i {
            margin-right: 6px;
            color: #0d6efd;
        }

        /* Highlight style for form controls */
        .active-field {
            border: 2px solid #0d6efd !important;
            box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.25) !important;
            background-color: #f0f7ff !important;
            transition: all 0.2s ease;
        }

        .btn.active-field {
            border: 2px solid #0d6efd !important;
            box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.3) !important;
            transform: scale(1.02);
            transition: all 0.2s ease;
        }

        .btn-success.active-field {
            border: 2px solid #0d6efd !important;
            box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.3) !important;
            background-color: #157347 !important;
            transform: scale(1.02);
        }

        .btn-outline-primary.active-field {
            border: 2px solid #0d6efd !important;
            box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.3) !important;
            background-color: #e7f1ff !important;
            transform: scale(1.02);
        }

        .form-control:focus, .form-select:focus {
            border-color: #86b7fe;
            box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.25);
        }

        .form-control, .form-select, .btn {
            transition: all 0.2s ease;
        }
    </style>
}

<form method="post" id="challanForm">
    @Html.AntiForgeryToken()

    <input type="hidden" asp-for="Head.DocNo" />
    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div class="d-flex align-items-center gap-3">
            <div>
                <h3 class="mb-0">
                    <i class="fa fa-truck text-primary me-2"></i>
                    Challan Entry
                </h3>
                <small class="text-muted">Goods Dispatch / Transport Challan</small>
            </div>
            <span class="badge bg-primary fs-6 px-3 py-2"><i class="fa fa-file-text me-1"></i>Doc No: @Model.Head.DocNo</span>
        </div>

        <div>
            <button type="button"
                    class="btn btn-outline-primary btn-sm me-2"
                    onclick="openBiltyModal('ToPay')"
                    id="addToPayBiltyBtn"
                    tabindex="8">
                <i class="fa fa-hand-holding-usd me-1"></i> To Pay Bilty
            </button>
            <button type="button"
                    class="btn btn-outline-success btn-sm me-2"
                    onclick="openBiltyModal('Paid')"
                    id="addPaidBiltyBtn"
                    tabindex="9">
                <i class="fa fa-check-circle me-1"></i> Paid Bilty
            </button>
            <button type="button" class="btn btn-outline-secondary btn-sm me-2" onclick="addEmptyRow()" id="addEmptyRowBtn">
                <i class="fa fa-plus"></i> Add Empty Row
            </button>

            <button type="submit" class="btn btn-success btn-sm" onclick="return validateBeforeSubmit()" id="btnSave">
                <i class="fa fa-save"></i> Save Challan
            </button>
        </div>
    </div>

    <!-- MASTER -->
    <div class="card shadow-sm border-0 mb-3">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-2">
                    <label><i class="fa fa-hashtag"></i>Challan No</label>
                    <input asp-for="Head.ChalNo" id="ChalNo" class="form-control form-control-sm" tabindex="1" />
                </div>

                <div class="col-md-2">
                    <label><i class="fa fa-calendar"></i>Date</label>
                    <input asp-for="Head.DocDate" type="date" value="@(Model?.Head?.DocDate.HasValue == true ? Model.Head.DocDate.Value.ToString("yyyy-MM-dd") : DateTime.Today.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" tabindex="2" />
                </div>

                <div class="col-md-4">
                    <label><i class="fa fa-map-marker"></i>Station</label>
                    <select asp-for="Head.StationId" id="StationId" class="form-select form-select-sm select2" tabindex="3"
                            asp-items="@(new SelectList(ViewBag.Stations, "Value", "Text", Model != null && Model.Head != null && Model.Head.StationId > 0 ? Model.Head.StationId.ToString() : ""))"></select>
                </div>

                <div class="col-md-4">
                    <label><i class="fa fa-truck"></i>Transporter</label>
                    <select asp-for="Head.TransId" id="TransId" class="form-select form-select-sm select2" tabindex="4"
                            asp-items="@(new SelectList(ViewBag.Transporters, "Value", "Text", Model != null && Model.Head != null && Model.Head.TransId > 0 ? Model.Head.TransId.ToString() : ""))"></select>
                </div>

                <div class="col-md-3">
                    <label><i class="fa fa-car"></i>Vehicle No</label>
                    <input asp-for="Head.VehicleNo" class="form-control form-control-sm" tabindex="5" />
                </div>

                <div class="col-md-3">
                    <label><i class="fa fa-user"></i>Party Name</label>
                    <input asp-for="Head.Driver" class="form-control form-control-sm" tabindex="6" />
                </div>

                <div class="col-md-6">
                    <label><i class="fa fa-comment"></i>Remarks</label>
                    <input asp-for="Head.Narration" class="form-control form-control-sm" tabindex="7" />
                </div>
            </div>
        </div>
    </div>

    <!-- DETAIL -->
    <div class="card shadow-sm border-0 mb-3">
        <div class="card-header bg-white">
            <h6 class="mb-0">
                <i class="fa fa-list text-primary me-1"></i>
                Bilty Details
            </h6>
        </div>

        <div class="card-body p-1">
            <div class="table-responsive">
                <table class="table table-bordered table-hover mb-0" id="tblItems">
                    <thead class="table-light text-center">
                        <tr>
                            <th><i class="fa fa-barcode"></i> Bilty No</th>
                            <th><i class="fa fa-user"></i> Party Name</th>
                            <th><i class="fa fa-share"></i> Send To</th>
                            <th width="100"><i class="fa fa-cubes"></i> Qty</th>
                            <th width="120"><i class="fa fa-money"></i> Bilty Amt</th>
                            <th width="120"><i class="fa fa-credit-card"></i> Paid Amt</th>
                            <th width="80"><i class="fa fa-cog"></i></th>
                        </tr>
                    </thead>
                    <tbody id="tbodyItems">
                        <tr id="noDataRow">
                            <td colspan="7" class="text-center text-muted py-3">No Records Added</td>
                        </tr>
                        <!-- Rows will be added dynamically -->
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- LOWER SECTION: EXPENSES (LEFT ~70%) & PARTIES (RIGHT ~30%) -->
    <div class="row g-3 mb-3">
        <!-- LEFT COLUMN: EXPENSES & CALCULATION (~70%) -->
        <div class="col-12 col-lg-8">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white py-1 px-3">
                    <h6 class="mb-0 fw-bold text-secondary small">
                        <i class="fa fa-calculator me-1 text-primary"></i> Expenses & Calculations
                    </h6>
                </div>
                <div class="card-body p-3">
                    <!-- Hidden inputs for legacy fields -->
                    <input type="hidden" asp-for="Head.PartyEx2" />
                    <input type="hidden" asp-for="Head.LocalAmt2" />
                    <input type="hidden" asp-for="Head.OtherEx2" />

                    <div class="row g-2">
                        <div class="col-6 col-md-3">
                            <label class="form-label small fw-semibold mb-1">Local Amount</label>
                            <input asp-for="Head.LocalAmt" id="Head_LocalAmt" class="form-control form-control-sm text-end" tabindex="113" />
                        </div>

                        <div class="col-6 col-md-3">
                            <label class="form-label small fw-semibold mb-1">Other Expense</label>
                            <input asp-for="Head.TotOtherEx" id="Head_TotOtherEx" class="form-control form-control-sm text-end" tabindex="114" />
                        </div>

                        <div class="col-6 col-md-3">
                            <label class="form-label small fw-semibold mb-1">Total Bilty</label>
                            <input asp-for="Head.TotBillTi" id="Head_TotBillTi" readonly class="form-control form-control-sm bg-light text-end" />
                        </div>

                        <div class="col-6 col-md-3">
                            <label class="form-label small fw-semibold mb-1">To Pay</label>
                            <input asp-for="Head.TotToPaid" id="Head_TotToPaid" class="form-control form-control-sm text-end" tabindex="115" />
                        </div>

                        <div class="col-6 col-md-3">
                            <label class="form-label small fw-semibold mb-1">Delivery Amt</label>
                            <input asp-for="Head.DeliveryAmt" id="Head_DeliveryAmt" class="form-control form-control-sm text-end" tabindex="116" />
                        </div>

                        <div class="col-6 col-md-3">
                            <label class="form-label small fw-semibold mb-1">Bilty Amt</label>
                            <input asp-for="Head.BillTiAmt" id="Head_BillTiAmt" class="form-control form-control-sm text-end" tabindex="117" />
                        </div>

                        <div class="col-6 col-md-3">
                            <label class="form-label small fw-semibold mb-1">Lifter</label>
                            <input asp-for="Head.TotLifter2" id="Head_TotLifter2" class="form-control form-control-sm text-end" tabindex="118" />
                        </div>

                        <!-- NET / TOTAL AMOUNT -->
                        <div class="col-6 col-md-3">
                            <label class="form-label small fw-bold text-primary mb-1">Net Amount</label>
                            <input asp-for="Head.NetAmt" id="Head_NetAmt" readonly class="form-control form-control-sm fw-bold text-primary bg-light border-primary text-end" />
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- RIGHT COLUMN: PARTIES (VERTICAL STACK ~30%) -->
        <div class="col-12 col-lg-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white py-1 px-3">
                    <h6 class="mb-0 fw-bold text-secondary small">
                        <i class="fa fa-users me-1 text-primary"></i> Party Details
                    </h6>
                </div>
                <div class="card-body p-2">
                    <div class="mb-2">
                        <label class="form-label mb-1 text-muted" style="font-size:0.75rem; font-weight:600;">B#/ Party Station</label>
                        <select asp-for="Head.PartyStationCode" id="PartyStationCode" class="form-select form-select-sm select2" tabindex="100"
                                asp-items="@(new SelectList(ViewBag.PartyStations, "Value", "Text", Model?.Head?.PartyStationCode))"></select>
                    </div>

                    <!-- PARTY 1 -->
                    <div class="p-2 mb-2 border rounded bg-light">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="text-primary fw-bold" style="font-size:0.75rem;">B#/ Party 1</span>
                        </div>
                        <select asp-for="Head.PExpCode" id="PExpCode" class="form-select form-select-sm select2 mb-1" tabindex="101"
                                asp-items="@(new SelectList(ViewBag.PartyExps, "Value", "Text", Model?.Head?.PExpCode))"></select>
                        <div class="row g-1">
                            <div class="col-6">
                                <input asp-for="Head.PExpAmt" id="Head_PExpAmt" class="form-control form-control-sm calc text-end" placeholder="Amount" style="font-size:0.8rem;" tabindex="102" />
                            </div>
                            <div class="col-6">
                                <input asp-for="Head.PExpBilti" id="Head_PExpBilti" class="form-control form-control-sm text-end" placeholder="Bilti" style="font-size:0.8rem;" tabindex="103" />
                            </div>
                        </div>
                    </div>

                    <!-- PARTY 2 -->
                    <div class="p-2 mb-2 border rounded bg-light">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="text-primary fw-bold" style="font-size:0.75rem;">B#/ Party 2</span>
                        </div>
                        <select asp-for="Head.PExpCode2" id="Head_PExpCode2" class="form-select form-select-sm select2 mb-1" tabindex="104"
                                asp-items="@(new SelectList(ViewBag.PartyExps, "Value", "Text", Model?.Head?.PExpCode2))"></select>
                        <div class="row g-1">
                            <div class="col-6">
                                <input asp-for="Head.PExpAmt2" id="Head_PExpAmt2" class="form-control form-control-sm calc text-end" placeholder="Amount" style="font-size:0.8rem;" tabindex="105" />
                            </div>
                            <div class="col-6">
                                <input asp-for="Head.PExpBilti2" id="Head_PExpBilti2" class="form-control form-control-sm text-end" placeholder="Bilti" style="font-size:0.8rem;" tabindex="106" />
                            </div>
                        </div>
                    </div>

                    <!-- PARTY 3 -->
                    <div class="p-2 border rounded bg-light">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="text-primary fw-bold" style="font-size:0.75rem;">B#/ Party 3</span>
                        </div>
                        <select asp-for="Head.PExpCode3" id="Head_PExpCode3" class="form-select form-select-sm select2 mb-1" tabindex="107"
                                asp-items="@(new SelectList(ViewBag.PartyExps, "Value", "Text", Model?.Head?.PExpCode3))"></select>
                        <div class="row g-1">
                            <div class="col-6">
                                <input asp-for="Head.PExpAmt3" id="Head_PExpAmt3" class="form-control form-control-sm calc text-end" placeholder="Amount" style="font-size:0.8rem;" tabindex="108" />
                            </div>
                            <div class="col-6">
                                <input asp-for="Head.PExpBilti3" id="Head_PExpBilti3" class="form-control form-control-sm text-end" placeholder="Bilti" style="font-size:0.8rem;" tabindex="109" />
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>

</form>

<!-- Bilty Modal -->
<div class="modal fade" id="biltyModal" tabindex="-1">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Select Bilty</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <span class="fw-semibold text-muted"><i class="fa fa-filter me-1"></i> Filter Bilty Type:</span>
                    <div class="btn-group" role="group" id="biltyTypeFilterGroup">
                        <button type="button" class="btn btn-sm btn-outline-secondary active" id="filterBtnAll" onclick="setBiltyFilterType('All')">All Bilties</button>
                        <button type="button" class="btn btn-sm btn-outline-primary" id="filterBtnToPay" onclick="setBiltyFilterType('ToPay')"><i class="fa fa-hand-holding-usd me-1"></i> To Pay Bilty</button>
                        <button type="button" class="btn btn-sm btn-outline-success" id="filterBtnPaid" onclick="setBiltyFilterType('Paid')"><i class="fa fa-check-circle me-1"></i> Paid Bilty</button>
                    </div>
                </div>
                <table class="table table-bordered table-sm">
                    <thead>
                        <tr>
                            <th>Select</th>
                            <th>Doc No</th>
                            <th>Date</th>
                            <th>Bilty No</th>
                            <th>Party Name</th>
                            <th>Send To</th>
                            <th>Qty</th>
                            <th>Net Amt</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var bilty in ViewBag.BiltyList)
                        {
                            var isOld = bilty.DocDate != null && ((DateTime)bilty.DocDate).Date <= DateTime.Today.AddDays(-3);
                            var rowClass = isOld ? "table-warning fw-semibold" : "";
                            <tr class="@rowClass" data-stationid="@bilty.StationId" data-fooder="@bilty.Fooder">
                                <td>
                                    <input type="checkbox"
                                           class="bilty-check"
                                           data-id="@bilty.Id"
                                           data-stationid="@bilty.StationId"
                                           data-fooder="@bilty.Fooder"
                                           data-billtino="@bilty.BillTiNo"
                                           data-bilno="@bilty.BilNo"
                                           data-docno="@bilty.DocNo"
                                           data-docdate="@(bilty.DocDate != null ? ((DateTime)bilty.DocDate).ToString("yyyy-MM-dd") : "")"
                                           data-cusname="@bilty.CusName"
                                           data-sendto="@bilty.SendTo"
                                           data-qty="@bilty.Qty"
                                           data-ptype="@bilty.PType"
                                           data-netamt="@bilty.NetAmt"
                                           data-labour="@bilty.Labour"
                                           data-cartage2="@bilty.Cartage2"
                                           data-cartage3="@bilty.Cartage3"
                                           data-partyex="@bilty.PartyEx"
                                           data-lifter2="@bilty.Lifter2"
                                           data-otherex="@bilty.OtherEx" />
                                </td>
                                <td>
                                    @bilty.DocNo
                                    @if (isOld)
                                    {
                                        <span class="badge bg-danger ms-1" title="Older than 3 days">3+ Days</span>
                                    }
                                </td>
                                <td>@(bilty.DocDate != null ? ((DateTime)bilty.DocDate).ToString("dd/MM/yyyy") : "")</td>
                                <td>@bilty.BillTiNo</td>
                                <td>@bilty.CusName</td>
                                <td>@bilty.SendTo</td>
                                <td>@bilty.Qty</td>
                                <td>@bilty.NetAmt</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" onclick="addSelectedBilties()">
                    Add Selected
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // ============================================
        // ENTER KEY NAVIGATION - ADDED
        // ============================================

        // Flag to prevent focus from shifting back to Add Bilty button
        var isModalClosing = false;
        var focusTarget = null;

        // Highlight active field
        function highlightField(element) {
            $('.form-control, .form-select, .btn').removeClass('active-field');
            $(element).addClass('active-field');
        }

        // Focus on first field when page loads
        $(document).ready(function() {
            // Initialize select2 on all select elements
            $('.select2').select2({
                theme: 'bootstrap-5',
                width: '100%'
            });

            @if (Model?.Head?.StationId > 0) {
                <text>$('#StationId, #Head_StationId').val('@Model.Head.StationId').trigger('change.select2');</text>
            }
            @if (Model?.Head?.TransId > 0) {
                <text>$('#TransId, #Head_TransId').val('@Model.Head.TransId').trigger('change.select2');</text>
            }
            @if (!string.IsNullOrEmpty(Model?.Head?.PartyStationCode)) {
                <text>$('#PartyStationCode').val('@Model.Head.PartyStationCode').trigger('change.select2');</text>
            }
            @if (!string.IsNullOrEmpty(Model?.Head?.PExpCode)) {
                <text>$('#PExpCode').val('@Model.Head.PExpCode').trigger('change.select2');</text>
            }
            @if (!string.IsNullOrEmpty(Model?.Head?.PExpCode2)) {
                <text>$('#Head_PExpCode2').val('@Model.Head.PExpCode2').trigger('change.select2');</text>
            }
            @if (!string.IsNullOrEmpty(Model?.Head?.PExpCode3)) {
                <text>$('#Head_PExpCode3').val('@Model.Head.PExpCode3').trigger('change.select2');</text>
            }

            // Focus on Challan No
            $('#ChalNo').focus();
            highlightField('#ChalNo');
            calculateTotals();

            // Handle modal hidden event to focus on PExpCode
            $('#biltyModal').on('hidden.bs.modal', function() {
                if (focusTarget) {
                    setTimeout(function() {
                        $(focusTarget).focus();
                        highlightField(focusTarget);
                        focusTarget = null;
                        isModalClosing = false;
                    }, 150);
                }
            });

            // Prevent focus from going back to Add Bilty button and check station
            $('#biltyModal').on('show.bs.modal', function(e) {
                var stationId = $('#Head_StationId').val();
                if (!stationId || stationId === "" || stationId === "0") {
                    alert("Please select Station first.");
                    e.preventDefault();
                    $('#Head_StationId').focus();
                    highlightField('#Head_StationId');
                    return false;
                }
                filterBiltiesByStation(stationId);
            });

            $('#biltyModal').on('shown.bs.modal', function() {
                // Focus on first visible checkbox in modal
                var firstCheckbox = $('.bilty-check:visible:first');
                if (firstCheckbox.length) {
                    firstCheckbox.focus();
                }
            });
        });

        // Handle Enter key navigation
        $(document).on('keydown', '.form-control, .form-select', function(e) {
            if (e.key === 'Enter') {
                e.preventDefault();

                var currentElement = $(this);
                var currentTabIndex = parseInt(currentElement.attr('tabindex')) || 0;

                // Check if it's a detail row field
                if (currentElement.closest('tr').length > 0 && currentElement.closest('#tbodyItems').length > 0) {
                    var currentRow = currentElement.closest('tr');
                    var allFields = currentRow.find('input, select');
                    var currentFieldIndex = allFields.index(this);

                    // Move to next field in same row
                    if (currentFieldIndex < allFields.length - 1) {
                        var nextField = allFields.eq(currentFieldIndex + 1);
                        if (nextField.length) {
                            nextField.focus();
                            highlightField(nextField);
                            return;
                        }
                    } else {
                        // Last field in row, move to next row or Add Bilty button
                        var nextRow = currentRow.next('tr');
                        if (nextRow.length > 0 && !nextRow.attr('id') === 'noDataRow') {
                            var firstField = nextRow.find('input:first');
                            if (firstField.length) {
                                firstField.focus();
                                highlightField(firstField);
                                return;
                            }
                        } else {
                            // No next row, go to Add Bilty button
                            $('#addBiltyBtn').focus();
                            highlightField('#addBiltyBtn');
                            return;
                        }
                    }
                    return;
                }

                // If current element is Add Bilty button, open modal
                if (currentElement.attr('id') === 'addBiltyBtn') {
                    openBiltyModal();
                    return;
                }

                // Check if it's an expense field (tabindex 100+)
                if (currentTabIndex >= 100) {
                    var nextExpense = $('[tabindex="' + (currentTabIndex + 1) + '"]');
                    if (nextExpense.length) {
                        nextExpense.focus();
                        highlightField(nextExpense);
                    } else {
                        $('#btnSave').focus();
                        highlightField('#btnSave');
                    }
                    return;
                }

                // Navigation for master fields (tabindex 1-7)
                var nextTabIndex = currentTabIndex + 1;
                var nextField = $('[tabindex="' + nextTabIndex + '"]');

                if (nextField.length) {
                    nextField.focus();
                    highlightField(nextField);
                } else {
                    // After remarks (tabindex 7), go to Add Bilty button
                    $('#addBiltyBtn').focus();
                    highlightField('#addBiltyBtn');
                }
            }
        });

        // Also highlight on focus
        $(document).on('focus', '.form-control, .form-select, .btn', function() {
            // Don't highlight if modal is closing
            if (!isModalClosing) {
                highlightField(this);
            }
        });

        // ============================================
        // END ENTER KEY NAVIGATION
        // ============================================

        let rowCounter = 0;
        var currentBiltyFilterType = 'All';

        // Open bilty modal after verifying station is selected
        function openBiltyModal(type) {
            type = type || 'All';
            currentBiltyFilterType = type;

            var stationId = $('#Head_StationId').val();
            if (!stationId || stationId === "" || stationId === "0") {
                alert("Please select Station first.");
                $('#Head_StationId').focus();
                highlightField('#Head_StationId');
                return;
            }

            updateBiltyFilterButtons(type);
            filterBiltiesByStation(stationId, type);

            isModalClosing = true;
            focusTarget = '#PExpCode';
            var modalEl = document.getElementById('biltyModal');
            if (modalEl) {
                var modal = bootstrap.Modal.getOrCreateInstance(modalEl);
                modal.show();
            }
        }

        function setBiltyFilterType(type) {
            currentBiltyFilterType = type;
            var stationId = $('#Head_StationId').val();
            updateBiltyFilterButtons(type);
            filterBiltiesByStation(stationId, type);
        }

        function updateBiltyFilterButtons(type) {
            $('#biltyTypeFilterGroup button').removeClass('active');
            if (type === 'ToPay') $('#filterBtnToPay').addClass('active');
            else if (type === 'Paid') $('#filterBtnPaid').addClass('active');
            else $('#filterBtnAll').addClass('active');
        }

        // Filter modal bilty rows by selected station and bilty type
        function filterBiltiesByStation(stationId, biltyType) {
            biltyType = biltyType || currentBiltyFilterType || 'All';
            var selectedText = $("#Head_StationId option:selected").text().toLowerCase().trim();
            var stationName = selectedText.replace(/\s*\([^)]*\)/g, '').trim();

            var visibleCount = 0;
            $("#biltyModal tbody tr").each(function () {
                var $tr = $(this);
                if ($tr.attr('id') === 'noBiltyMatchRow') return;

                var rowStationId = $tr.data('stationid') || $tr.find('.bilty-check').data('stationid');
                var rowFooder = ($tr.data('fooder') || $tr.find('.bilty-check').data('fooder') || '').toString().toLowerCase().trim();
                var ptype = ($tr.find('.bilty-check').data('ptype') || '').toString().toLowerCase().trim();

                var stationMatches = false;
                if (rowStationId && stationId && rowStationId.toString() === stationId.toString()) {
                    stationMatches = true;
                } else if (stationName && rowFooder && (rowFooder === stationName || rowFooder.indexOf(stationName) !== -1 || stationName.indexOf(rowFooder) !== -1)) {
                    stationMatches = true;
                }

                var typeMatches = true;
                if (biltyType === 'ToPay') {
                    typeMatches = (ptype === 'topay' || ptype === 'pay');
                } else if (biltyType === 'Paid') {
                    typeMatches = (ptype === 'paid' || ptype === '' || !ptype);
                }

                if (stationMatches && typeMatches) {
                    $tr.show();
                    visibleCount++;
                } else {
                    $tr.hide();
                    $tr.find('.bilty-check').prop('checked', false);
                }
            });

            $("#noBiltyMatchRow").remove();
            if (visibleCount === 0) {
                var typeLabel = biltyType === 'ToPay' ? 'To Pay' : (biltyType === 'Paid' ? 'Paid' : '');
                $("#biltyModal tbody").append(`
                    <tr id="noBiltyMatchRow">
                        <td colspan="8" class="text-center text-muted py-3">
                            <i class="fa fa-info-circle me-1 text-warning"></i> No pending ${typeLabel} bilties found for the selected station.
                        </td>
                    </tr>
                `);
            }
        }

        // Function to get next row index and increment
        function getNextRowIndex() {
            return rowCounter++;
        }

        // Function to reindex all rows (important for after deletions)
        function reindexRows() {
            $("#tbodyItems tr").each(function(index) {
                // Update all input names with the new index
                $(this).find("input, select").each(function() {
                    const name = $(this).attr("name");
                    if (name) {
                        const newName = name.replace(/Details\[\d+\]/, `Details[${index}]`);
                        $(this).attr("name", newName);
                    }
                });
                $(this).attr("data-row-index", index);
            });
            rowCounter = $("#tbodyItems tr").length;
        }

        // Function to add empty row
        function addEmptyRow() {
            const tbody = $("#tbodyItems");

            // Remove no data row if exists
            const noDataRow = document.getElementById("noDataRow");
            if (noDataRow) noDataRow.remove();

            const currentIndex = getNextRowIndex();

            // Calculate tabindex for new row
            var rowCount = $("#tbodyItems tr").length;
            var baseTabIndex = 9 + (rowCount * 10);

            const row = `
                <tr data-row-index="${currentIndex}">
                    <td>
                        <input type="text"
                               name="Details[${currentIndex}].BillTiNo"
                               class="form-control form-control-sm billti-no"
                               tabindex="${baseTabIndex}" />
                    </td>
                    <td>
                        <input type="text"
                               name="Details[${currentIndex}].CusName"
                               class="form-control form-control-sm cus-name"
                               tabindex="${baseTabIndex + 1}" />
                    </td>
                    <td>
                        <input type="text"
                               name="Details[${currentIndex}].SendTo"
                               class="form-control form-control-sm send-to"
                               tabindex="${baseTabIndex + 2}" />
                    </td>
                    <td>
                        <input type="number"
                               name="Details[${currentIndex}].Qty"
                               class="form-control form-control-sm qty"
                               step="any"
                               tabindex="${baseTabIndex + 3}" />
                    </td>
                    <td>
                        <input type="number"
                               name="Details[${currentIndex}].BillTiAmt"
                               class="form-control form-control-sm biltyamt"
                               step="any"
                               tabindex="${baseTabIndex + 4}" />
                    </td>
                    <td>
                        <input type="number"
                               name="Details[${currentIndex}].PaidAmt"
                               class="form-control form-control-sm paidamt"
                               step="any"
                               tabindex="${baseTabIndex + 5}" />
                    </td>
                    <td class="text-center">
                        <input type="hidden" name="Details[${currentIndex}].DCNo" class="dc-no" value="" />
                        <input type="hidden" name="Details[${currentIndex}].BilNo" class="bil-no" value="" />
                        <input type="hidden" name="Details[${currentIndex}].BiltyId" class="bilty-id" value="" />
                        <div class="d-flex justify-content-center gap-1">
                            <button type="button" class="btn btn-info btn-sm text-white" title="View Bilty in Edit mode" onclick="viewBilty(this)">
                                <i class="fa fa-eye"></i>
                            </button>
                            <button type="button" class="btn btn-danger btn-sm" title="Delete Row" onclick="removeRow(this)">
                                <i class="fa fa-trash"></i>
                            </button>
                        </div>
                    </td>
                </tr>
            `;

            tbody.append(row);
            calculateTotals();
        }

        // Function to remove row
        function removeRow(btn) {
            $(btn).closest("tr").remove();
            // Reindex all rows after deletion to maintain sequential order
            reindexRows();
            calculateTotals();

            // Check if no rows exist, show message
            if ($("#tbodyItems tr").length === 0) {
                showNoDataMessage();
                rowCounter = 0;
            }
        }

        // Function to show no data message
        function showNoDataMessage() {
            const tbody = $("#tbodyItems");
            tbody.html(`
                <tr id="noDataRow">
                    <td colspan="7" class="text-center text-muted py-3">
                        No Records Added
                    </td>
                </tr>
            `);
        }

        // Function to add selected bilties from modal
        function addSelectedBilties() {
            // Remove no data row if exists
            const noDataRow = document.getElementById("noDataRow");
            if (noDataRow) noDataRow.remove();

            const tbody = $("#tbodyItems");
            let hasSelected = false;
            let selectedCount = 0;

            $(".bilty-check:checked").each(function() {
                hasSelected = true;
                const currentIndex = getNextRowIndex();
                const $checkbox = $(this);

                const ptype = ($checkbox.data("ptype") || "").trim();
                const netAmt = parseFloat($checkbox.data("netamt")) || 0;
                const paidAmt = ptype === "Paid" ? netAmt : 0;

                const billtiAmt =
                    (parseFloat($checkbox.data("labour")) || 0) +
                    (parseFloat($checkbox.data("cartage2")) || 0) +
                    (parseFloat($checkbox.data("cartage3")) || 0);

                const biltyId = $checkbox.data("id") || "";
                const billTiNoValue = $checkbox.data("billtino") || "";
                const cusName = $checkbox.data("cusname") || "";
                const sendTo = $checkbox.data("sendto") || "";
                const qty = $checkbox.data("qty") || 0;
                const docNo = $checkbox.data("docno") || "";
                const bilNo = $checkbox.data("bilno") || "";

                // Calculate tabindex for new row
                var rowCount = $("#tbodyItems tr").length;
                var baseTabIndex = 9 + (rowCount * 10);

                const row = `
                    <tr data-row-index="${currentIndex}">
                        <td>
                            <input type="text"
                                   name="Details[${currentIndex}].BillTiNo"
                                   value="${escapeHtml(billTiNoValue)}"
                                   class="form-control form-control-sm billti-no"
                                   tabindex="${baseTabIndex}" />
                        </td>
                        <td>
                            <input type="text"
                                   name="Details[${currentIndex}].CusName"
                                   value="${escapeHtml(cusName)}"
                                   class="form-control form-control-sm cus-name"
                                   tabindex="${baseTabIndex + 1}" />
                        </td>
                        <td>
                            <input type="text"
                                   name="Details[${currentIndex}].SendTo"
                                   value="${escapeHtml(sendTo)}"
                                   class="form-control form-control-sm send-to"
                                   tabindex="${baseTabIndex + 2}" />
                        </td>
                        <td>
                            <input type="number"
                                   name="Details[${currentIndex}].Qty"
                                   value="${qty}"
                                   class="form-control form-control-sm qty"
                                   tabindex="${baseTabIndex + 3}" />
                        </td>
                        <td>
                            <input type="number"
                                   name="Details[${currentIndex}].BillTiAmt"
                                   value="${billtiAmt.toFixed(2)}"
                                   class="form-control form-control-sm biltyamt"
                                   step="any"
                                   tabindex="${baseTabIndex + 4}" />
                        </td>
                        <td>
                            <input type="number"
                                   name="Details[${currentIndex}].PaidAmt"
                                   value="${paidAmt.toFixed(2)}"
                                   class="form-control form-control-sm paidamt"
                                   step="any"
                                   tabindex="${baseTabIndex + 5}" />
                        </td>
                        <td class="text-center">
                            <input type="hidden" name="Details[${currentIndex}].DCNo" class="dc-no" value="${escapeHtml(docNo)}" />
                            <input type="hidden" name="Details[${currentIndex}].BilNo" class="bil-no" value="${escapeHtml(bilNo)}" />
                            <input type="hidden" name="Details[${currentIndex}].BiltyId" class="bilty-id" value="${biltyId}" />
                            <div class="d-flex justify-content-center gap-1">
                                <button type="button" class="btn btn-info btn-sm text-white" title="View Bilty in Edit mode" onclick="viewBilty(this)">
                                    <i class="fa fa-eye"></i>
                                </button>
                                <button type="button" class="btn btn-danger btn-sm" title="Delete Row" onclick="removeRow(this)">
                                    <i class="fa fa-trash"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                `;

                tbody.append(row);
                selectedCount++;
            });

            if (!hasSelected) {
                alert("Please select at least one bilty.");
                return;
            }

            // Clear checkboxes
            $(".bilty-check").prop("checked", false);

            // Set focus target before closing modal
            focusTarget = '#PartyStationCode';

            // Close modal - this will trigger the hidden.bs.modal event
            const modal = bootstrap.Modal.getInstance(document.getElementById('biltyModal'));
            if (modal) modal.hide();

            // Reindex all rows to ensure sequential order
            reindexRows();

            // Recalculate totals
            calculateTotals();

            console.log(`Added ${selectedCount} rows. Total rows: ${$("#tbodyItems tr").length}`);
        }

        // Helper function to escape HTML
        function escapeHtml(str) {
            if (!str) return "";
            return str.toString()
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#39;');
        }

        // View Bilty function - Opens Bilty Edit in a new tab
        function viewBilty(btn) {
            var $tr = $(btn).closest('tr');
            var biltyId = $tr.find('.bilty-id').val();
            var docNo = $tr.find('.dc-no').val() || $tr.find('input[name*="DCNo"]').val();
            var billTiNo = $tr.find('.billti-no').val() || $tr.find('input[name*="BillTiNo"]').val();

            if (biltyId && parseInt(biltyId) > 0) {
                window.open('/Bilty/Edit/' + biltyId, '_blank');
                return;
            }

            if (docNo || billTiNo) {
                $.get('/Bilty/GetBiltyId', { docNo: docNo, billTiNo: billTiNo }, function(res) {
                    if (res && res.success && res.id) {
                        $tr.find('.bilty-id').val(res.id);
                        window.open('/Bilty/Edit/' + res.id, '_blank');
                    } else {
                        alert('Bilty record not found.');
                    }
                }).fail(function() {
                    alert('Error looking up bilty record.');
                });
                return;
            }

            alert('Please enter or select a valid Bilty No first.');
        }

        // Calculate totals function - COMPLETELY UNCHANGED
        function calculateTotals() {
            let detailBiltyTotal = 0;

            $(".biltyamt").each(function() {
                let val = parseFloat($(this).val());
                if (!isNaN(val)) {
                    detailBiltyTotal += val;
                }
            });

            let headBillTiAmt = parseVal("#Head_BillTiAmt");
            let totalBilty = headBillTiAmt + detailBiltyTotal;
            $("#Head_TotBillTi").val(totalBilty.toFixed(2));

            let toPay = parseVal("#Head_TotToPaid");
            let pexp1 = parseVal("#Head_PExpAmt");
            let pexp2 = parseVal("#Head_PExpAmt2");
            let pexp3 = parseVal("#Head_PExpAmt3");
            let localAmt = parseVal("#Head_LocalAmt");
            let otherExp = parseVal("#Head_TotOtherEx");
            let deliveryAmt = parseVal("#Head_DeliveryAmt");
            let lifterAmt = parseVal("#Head_TotLifter2");

            let totalExpenses = pexp1 + pexp2 + pexp3 + localAmt + otherExp + deliveryAmt + lifterAmt;
            let netAmt = toPay - totalExpenses;

            $("#Head_NetAmt").val(netAmt.toFixed(2));
        }

        function parseVal(selector) {
            let val = parseFloat($(selector).val());
            return isNaN(val) ? 0 : val;
        }

        // Validation before submit - modified: removed "at least one bilty" check
        function validateBeforeSubmit() {
            // Check if all required fields are filled
            let isValid = true;
            $("#tbodyItems tr").each(function() {
                const billtiNo = $(this).find(".billti-no").val();
                const cusName = $(this).find(".cus-name").val();

                if (!billtiNo || !cusName) {
                    isValid = false;
                    return false;
                }
            });

            return true;
        }

        // Debug: Log form data before submit - UNCHANGED
        function debugFormData() {
            console.log("=== Form Data Debug ===");
            $("#tbodyItems tr").each(function(index) {
                console.log(`Row ${index}:`, {
                    BillTiNo: $(this).find(".billti-no").val(),
                    CusName: $(this).find(".cus-name").val(),
                    SendTo: $(this).find(".send-to").val(),
                    Qty: $(this).find(".qty").val(),
                    BillTiAmt: $(this).find(".biltyamt").val(),
                    PaidAmt: $(this).find(".paidamt").val(),
                    NameAttributes: {
                        BillTiNo: $(this).find(".billti-no").attr("name"),
                        CusName: $(this).find(".cus-name").attr("name")
                    }
                });
            });
        }

        // Event listeners for real-time calculation - UNCHANGED
        $(document).on("input", ".biltyamt, #Head_BillTiAmt, #Head_TotToPaid, #Head_PExpAmt, #Head_PExpAmt2, #Head_PExpAmt3, #Head_LocalAmt, #Head_TotOtherEx, #Head_DeliveryAmt, #Head_TotLifter2", function() {
            calculateTotals();
        });

        // Initialize on document ready
        $(document).ready(function() {
            // Trigger calculation on page load
            calculateTotals();
        });

        // Attach to form submit - UNCHANGED
        $("#challanForm").on("submit", function(e) {
            debugFormData();
            return validateBeforeSubmit();
        });

        // Make functions global for onclick handlers - UNCHANGED
        window.addEmptyRow = addEmptyRow;
        window.removeRow = removeRow;
        window.addSelectedBilties = addSelectedBilties;
        window.viewBilty = viewBilty;
        window.validateBeforeSubmit = validateBeforeSubmit;
    </script>
}