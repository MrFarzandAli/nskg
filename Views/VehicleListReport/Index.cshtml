@{
    ViewData["Title"] = "Vehicle List Report (Processing Report)";

    var fromDateValue = ViewBag.FromDate as string;
    var toDateValue = ViewBag.ToDate as string;
    var accodeValue = ViewBag.Accode as string ?? "";
    var selectedCompanyId = ViewBag.SelectedCompanyId != null ? (int)ViewBag.SelectedCompanyId : 0;
    var companyList = ViewBag.CompanyList as IEnumerable<dynamic>;
    var accountList = ViewBag.AccountList as IEnumerable<dynamic>;

    if (string.IsNullOrEmpty(fromDateValue))
    {
        fromDateValue = DateTime.Now.AddDays(-30).ToString("yyyy-MM-dd");
    }

    if (string.IsNullOrEmpty(toDateValue))
    {
        toDateValue = DateTime.Now.ToString("yyyy-MM-dd");
    }
}

<style>
    .custom-card { border-radius: 10px; }
    .heading-glow { font-weight: 600; }
    .custom-btn { border-radius: 6px; }
    iframe { border-radius: 8px; }
</style>

<div class="container-fluid mt-4">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="fw-bold"><i class="fa fa-truck me-2 text-primary"></i> Vehicle List Report <small class="text-muted fs-6">(Processing Report - Account Process)</small></h3>
    </div>

    <!-- Filter Card -->
    <div class="card custom-card mb-4 shadow-sm border-0">
        <div class="card-header bg-primary text-white py-3">
            <h5 class="mb-0 fw-semibold">
                <i class="fa fa-filter me-2"></i> Filter Parameters
            </h5>
        </div>
        <div class="card-body p-4 bg-light">
            <form method="get" id="vehicleReportForm">
                <div class="row g-3">
                    <!-- Company Dropdown -->
                    <div class="col-md-3">
                        <label class="form-label fw-bold">Company Name</label>
                        <select class="form-select select2" name="companyId" id="companySelect">
                            @if (companyList != null)
                            {
                                foreach (var comp in companyList)
                                {
                                    if (comp.Id == selectedCompanyId)
                                    {
                                        <option value="@comp.Id" selected="selected">@comp.Name</option>
                                    }
                                    else
                                    {
                                        <option value="@comp.Id">@comp.Name</option>
                                    }
                                }
                            }
                        </select>
                    </div>

                    <!-- From Date -->
                    <div class="col-md-2">
                        <label class="form-label fw-bold">From Date</label>
                        <input type="date" class="form-control" name="fromDate" id="fromDate" value="@fromDateValue" required />
                    </div>

                    <!-- To Date -->
                    <div class="col-md-2">
                        <label class="form-label fw-bold">To Date</label>
                        <input type="date" class="form-control" name="toDate" id="toDate" value="@toDateValue" required />
                    </div>

                    <!-- A/c Code (Station / Godown / Adda) -->
                    <div class="col-md-5">
                        <label class="form-label fw-bold">A/c Code <small class="text-primary">(Station / Godown / Adda)</small></label>
                        <select class="form-select select2" name="accode" id="accodeSelect">
                            <option value="">-- All Accounts / Stations --</option>
                            @if (accountList != null)
                            {
                                foreach (var acc in accountList)
                                {
                                    <option value="@acc.Code" selected="@(acc.Code == accodeValue ? "selected" : null)" data-type="@acc.Type">
                                        @acc.Code - @acc.Name
                                    </option>
                                }
                            }
                        </select>
                    </div>

                    <!-- Action Buttons Toolbar -->
                    <div class="col-md-12 d-flex justify-content-end gap-2 mt-3 pt-2 border-top">
                        <!-- VIEW ON SCREEN -->
                        <button type="button" 
                                class="btn btn-primary btn-sm px-3 shadow-sm fw-semibold" 
                                onclick="loadOnScreenReport()">
                            <i class="fa fa-desktop me-1"></i> View Report
                        </button>

                        <!-- EXCEL EXPORT -->
                        <button type="submit" 
                                class="btn btn-success btn-sm px-3 shadow-sm fw-semibold" 
                                asp-action="ExportExcel">
                            <i class="fa fa-file-excel-o me-1"></i> Export Excel (CSV)
                        </button>

                        <!-- PDF DOWNLOAD -->
                        <button type="submit" 
                                class="btn btn-danger btn-sm px-3 shadow-sm fw-semibold" 
                                asp-action="GeneratePDF" 
                                formtarget="_blank">
                            <i class="fa fa-file-pdf-o me-1"></i> Open / Print PDF
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- ON SCREEN REPORT PREVIEW -->
    <div id="reportCard" class="card shadow border-0" style="display:none;">
        <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center py-2">
            <h5 class="mb-0 fs-6"><i class="fa fa-file-text-o me-2"></i> Report Preview</h5>
            <button type="button" class="btn btn-sm btn-outline-light" onclick="$('#reportCard').hide()">
                <i class="fa fa-times"></i> Close
            </button>
        </div>
        
        <!-- LOADER -->
        <div id="reportLoader" style="display:none; padding:40px; text-align:center;">
            <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;">
                <span class="visually-hidden">Loading...</span>
            </div>
            <div class="mt-3 fw-bold text-muted">Running vehicle list procedure and processing report, please wait...</div>
        </div>

        <!-- REPORT IFRAME -->
        <div class="card-body p-0">
            <iframe id="reportFrame" 
                    style="width:100%; height:750px; border:none; display:none;"></iframe>
        </div>
    </div>

</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            if ($.fn.select2) {
                $('#companySelect').select2({ theme: 'bootstrap-5', width: '100%' });
                $('#accodeSelect').select2({ theme: 'bootstrap-5', width: '100%', placeholder: '-- Select Account / Station --', allowClear: true });
            }

            $('#accodeSelect').on('change', function () {
                var selectedOption = $(this).find('option:selected');
                var accType = selectedOption.data('type');
                var accText = selectedOption.text() || '';

                if ($('#reportType').val() === 'Auto') {
                    if (accType === 'Godown' || accText.toUpperCase().indexOf('GODOWN') !== -1) {
                        // Godown selected
                    } else if (accType === 'Adda' || accText.toUpperCase().indexOf('ADDA') !== -1) {
                        // Adda selected
                    }
                }
            });

            $('#companySelect').on('change', function () {
                var compId = $(this).val();
                if (!compId) return;

                $.getJSON('@Url.Action("GetAccountsByCompany", "VehicleListReport")', { companyId: compId }, function (data) {
                    var $select = $('#accodeSelect');
                    $select.empty().append('<option value="">-- All Accounts / Stations --</option>');
                    if (data && data.length > 0) {
                        $.each(data, function (i, item) {
                            $select.append('<option value="' + item.code + '" data-type="' + item.type + '">' + item.code + ' - ' + item.name + '</option>');
                        });
                    }
                    $select.trigger('change');
                });
            });
        });

        function loadOnScreenReport() {
            var companyId = $('#companySelect').val() || '';
            var fromDate = $('#fromDate').val() || '';
            var toDate = $('#toDate').val() || '';
            var accode = $('#accodeSelect').val() || '';

            if (fromDate && toDate && fromDate > toDate) {
                alert('From Date cannot be greater than To Date.');
                return;
            }

            $('#reportCard').show();
            $('#reportLoader').show();
            $('#reportFrame').hide();

            $('html, body').animate({
                scrollTop: $('#reportCard').offset().top - 20
            }, 400);

            var url = '@Url.Action("OnScreenReport", "VehicleListReport")'
                + '?companyId=' + encodeURIComponent(companyId)
                + '&fromDate=' + encodeURIComponent(fromDate)
                + '&toDate=' + encodeURIComponent(toDate)
                + '&accode=' + encodeURIComponent(accode);

            $('#reportFrame').off('load').on('load', function () {
                $('#reportLoader').hide();
                $('#reportFrame').show();
            });

            $('#reportFrame').attr('src', url);
        }
    </script>
}

