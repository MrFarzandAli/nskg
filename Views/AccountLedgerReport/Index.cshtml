@{
    ViewData["Title"] = "Account Ledger Report (Detailed)";

    var fromDateValue = ViewBag.FromDate as string;
    var toDateValue = ViewBag.ToDate as string;
    var accodeValue = ViewBag.Accode as string;

    if (string.IsNullOrEmpty(fromDateValue))
    {
        fromDateValue = DateTime.Now.ToString("yyyy-MM-dd");
    }

    if (string.IsNullOrEmpty(toDateValue))
    {
        toDateValue = DateTime.Now.ToString("yyyy-MM-dd");
    }
}

<style>
    .custom-card { border-radius: 10px; }
    .heading-glow { font-weight: 600; }
    .custom-btn { border-radius: 6px; }
    iframe { border-radius: 8px; }
</style>

<div class="container-fluid mt-4">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h3 class="fw-bold mb-0 text-navy">
                <i class="fa fa-book me-2 text-primary"></i> Account Ledger Report (Detailed)
            </h3>
            <small class="text-muted">Comprehensive transaction ledger with opening, running balance and initials</small>
        </div>
    </div>

    <!-- Filter Card -->
    <div class="card custom-card mb-4 shadow-sm border-0">
        <div class="card-header card-header-brand py-3">
            <h5 class="mb-0 fw-semibold">
                <i class="fa fa-sliders me-2"></i> Filter Parameters
            </h5>
            <small class="text-white-50">Filter by Company, Account Code, and Date Range</small>
        </div>
        <div class="card-body report-filter-body">
            <form method="get" id="ledgerForm">
                <div class="row g-3">
                    <!-- Company Selector -->
                    <div class="col-12 col-sm-6 col-lg-3">
                        <label class="form-label fw-semibold small text-secondary">Company</label>
                        <select class="form-control select2" id="companySelect" name="companyId">
                                <option value="0" selected="@(ViewBag.SelectedCompanyId == null || ViewBag.SelectedCompanyId == 0 ? "selected" : null)">-- All Companies --</option>
                            @if (ViewBag.CompanyList != null)
                            {
                                foreach (var comp in ViewBag.CompanyList)
                                {
                                    <option value="@comp.Id" selected="@(comp.Id == ViewBag.SelectedCompanyId ? "selected" : null)">
                                        @comp.Name
                                    </option>
                                }
                            }
                        </select>
                    </div>

                    <!-- Account Code Selector -->
                    <div class="col-12 col-sm-6 col-lg-3">
                        <label class="form-label fw-semibold small text-secondary">Select Account</label>
                        <select class="form-control select2" id="accodeSelect" name="accode" required>
                            <option value="">-- Select Account --</option>
                            @if (ViewBag.AccountList != null)
                            {
                                foreach (var item in ViewBag.AccountList)
                                {
                                    <option value="@item.Code" 
                                            selected="@(item.Code == accodeValue ? "selected" : null)">
                                        @item.Code - @item.Name
                                    </option>
                                }
                            }
                        </select>
                    </div>

                    <!-- From Date -->
                    <div class="col-12 col-sm-6 col-lg-3">
                        <label class="form-label fw-semibold small text-secondary">From Date</label>
                        <input type="date" class="form-control" name="fromDate" value="@fromDateValue" required />
                    </div>

                    <!-- To Date -->
                    <div class="col-12 col-sm-6 col-lg-3">
                        <label class="form-label fw-semibold small text-secondary">To Date</label>
                        <input type="date" class="form-control" name="toDate" value="@toDateValue" required />
                    </div>

                    <div class="col-md-12 d-flex justify-content-end gap-2 mt-3 pt-2 border-top">
                        <!-- VIEW ON SCREEN -->
                        <button type="button"
                                class="btn btn-primary btn-sm custom-btn px-3 shadow-sm fw-semibold"
                                onclick="loadOnScreenReport()">
                            <i class="fa fa-desktop me-1"></i> View Report
                        </button>

                        <!-- EXCEL EXPORT -->
                        <button type="submit"
                                class="btn btn-success btn-sm custom-btn px-3 shadow-sm fw-semibold"
                                asp-action="ExportExcel">
                            <i class="fa fa-file-excel-o me-1"></i> Excel
                        </button>

                        <!-- PDF DOWNLOAD -->
                        <button type="submit"
                                class="btn btn-danger btn-sm custom-btn px-3 shadow-sm fw-semibold"
                                asp-action="GeneratePDF"
                                formtarget="_blank">
                            <i class="fa fa-file-pdf-o me-1"></i> Print / PDF
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- ON SCREEN REPORT PREVIEW -->
    <div id="reportCard" class="card shadow-sm border-0 mb-4" style="display:none;">
        <div class="card-header card-header-brand text-white d-flex justify-content-between align-items-center py-2">
            <h5 class="mb-0 fs-6 fw-semibold"><i class="fa fa-file-text-o me-2"></i> Report Preview</h5>
            <div class="d-flex gap-2">
                <button type="button" class="btn btn-light btn-sm fw-semibold" onclick="printReportFrame()">
                    <i class="fa fa-print me-1"></i> Print
                </button>
                <button type="button" class="btn btn-outline-light btn-sm" onclick="$('#reportCard').slideUp(200)">
                    <i class="fa fa-times me-1"></i> Close
                </button>
            </div>
        </div>

        <!-- LOADER -->
        <div id="reportLoader" style="display:none; padding:40px; text-align:center;">
            <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;">
                <span class="visually-hidden">Loading...</span>
            </div>
            <div class="mt-3 fw-bold text-muted">Generating ledger report via PROCESSDETAIL, please wait...</div>
        </div>

        <!-- REPORT IFRAME -->
        <div class="card-body p-0">
            <iframe id="reportFrame"
                    style="width:100%; height:750px; border:none; display:none;"></iframe>
        </div>
    </div>

</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('.select2').select2({
                theme: 'bootstrap-5',
                placeholder: "-- Select Account --",
                allowClear: true,
                width: '100%'
            });

            $('#companySelect').on('change', function () {
                var compId = $(this).val();
                if (compId === null || compId === undefined || compId === "") compId = "0";

                $.ajax({
                    url: '@Url.Action("GetAccountsByCompany", "AccountLedgerReport")',
                    type: 'GET',
                    data: { companyId: compId },
                    success: function (data) {
                        var $acc = $('#accodeSelect');
                        $acc.empty();
                        $acc.append('<option value="">-- Select Account --</option>');
                        if (data && data.length > 0) {
                            $.each(data, function (i, item) {
                                $acc.append('<option value="' + item.code + '">' + item.code + ' - ' + item.name + '</option>');
                            });
                        }
                        $acc.trigger('change');
                    }
                });
            });
        });

        function loadOnScreenReport() {
            var companyId = $('select[name="companyId"]').val();
            if (companyId === null || companyId === undefined || companyId === "") companyId = "0";
            var accode = $('select[name="accode"]').val();
            var fromDate = $('input[name="fromDate"]').val();
            var toDate = $('input[name="toDate"]').val();

            if (!accode) {
                alert("Please select an Account Code.");
                return;
            }

            if (!fromDate) {
                alert("Please select From Date.");
                return;
            }

            if (!toDate) {
                alert("Please select To Date.");
                return;
            }

            if (fromDate > toDate) {
                alert("From Date cannot be greater than To Date.");
                return;
            }

            $('#reportCard').show();
            $('#reportLoader').show();
            $('#reportFrame').hide();

            // Smooth scroll down to preview
            $('html, body').animate({
                scrollTop: $("#reportCard").offset().top - 20
            }, 400);

            var url = '@Url.Action("OnScreenReport", "AccountLedgerReport")'
                + '?accode=' + encodeURIComponent(accode)
                + '&fromDate=' + encodeURIComponent(fromDate)
                + '&toDate=' + encodeURIComponent(toDate)
                + '&companyId=' + encodeURIComponent(companyId);

            $('#reportFrame').off('load');
            $('#reportFrame').attr('src', url);

            $('#reportFrame').on('load', function () {
                $('#reportLoader').hide();
                $('#reportFrame').show();
            });
        }
    </script>
}
