@model List<GLChart3>

@foreach (var item in Model)
{
    var ac1 = (item.AC1 ?? "").Trim();
    var ac3 = (item.AC3 ?? "").Trim();
    var acc = (item.ACC ?? "").Trim();
    if (string.IsNullOrEmpty(acc)) { acc = ac1 + ac3; }
    var safeName = (item.Name ?? "").Trim().Replace("'", "\\'");

    <tr>
        <td>
            <span class="font-monospace fw-bold">@ac1 - @ac3</span>
            @if (item.LinkedGroupId != null)
            {
                <span class="badge bg-info-subtle text-info border border-info ms-1" style="font-size: 0.75rem;" title="Linked across multiple companies">
                    <i class="fa fa-link"></i> Linked
                </span>
            }
        </td>
        <td>@item.Name</td>

        <td class="text-end text-nowrap">
            <button class="btn btn-sm btn-outline-info me-1"
                    onclick="openLinkModal(@item.Id, '@safeName', '@acc')"
                    title="Link across companies">
                <i class="fa fa-link"></i> Link
            </button>

            <button class="btn btn-sm btn-primary me-1"
                    onclick="editDetail(@item.Id)">
                <i class="fa fa-pencil-square-o me-1"></i> Edit
            </button>

            <button class="btn btn-sm btn-danger"
                    onclick="return deleteDetail(event, @item.Id, '@safeName', this)">
                <i class="fa fa-trash-o me-1"></i> Delete
            </button>
        </td>
    </tr>
} 