@model List<GLChart3>

@foreach (var item in Model)
{
    <tr>
        <td>@item.AC1 - @item.AC3</td>
        <td>@item.Name</td>
        <td>
            <button class="btn btn-sm btn-warning" onclick="editDetail(@item.Id)">Edit</button>
            <button class="btn btn-sm btn-danger" onclick="deleteDetail(@item.Id)">Delete</button>
        </td>
    </tr>
}