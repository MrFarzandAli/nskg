				// If it's a select element
				if ($el.is('select')) {
					if ($el.hasClass('select2') || $el.data('select2') || $el.hasClass('select2-hidden-accessible')) {
						var $s2 = $el.data('select2') ? $el.data('select2').$container : null;
						if (!$s2 || !$s2.length) $s2 = $el.nextAll('.select2-container').first();
						if (!$s2 || !$s2.length) $s2 = $el.closest('.input-group').find('.select2-container');
						if (!$s2 || !$s2.length) $s2 = $el.parent().find('.select2-container');
						if ($s2 && $s2.length) {
							var $selection = $s2.find('.select2-selection');
							if ($selection.length) {
								$selection.focus();
								AppNav.highlightField($s2);
								return true;
							}
						}
					}
				}

				// If it's already a select2-selection
				if ($el.hasClass('select2-selection')) {
					$el.focus();
					AppNav.highlightField($el.closest('.select2-container'));
					return true;
