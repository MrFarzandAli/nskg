				});

				return $(focusable);
			},

			// Move to next field intelligently
			moveToNext: function($current) {
				if (!$current || !$current.length) return false;

				var $form = $current.closest('form');
				if (!$form.length) $form = $current.closest('.card, body');

				// Explicit navigation for Voucher Master fields (prevents any accidental jumps to Save/Update)
				if ($current.is('input[name*="Vono"], #Head_Vono')) {
					var $vodate = $form.find('input[name*="Vodate"]:visible').first();
					if ($vodate.length) return AppNav.focusElement($vodate);
				}

				if ($current.is('input[name*="Vodate"], #Head_Vodate')) {
					var $entryDate = $form.find('input[name*="EntryDate"]:not([readonly]):visible').first();
					if ($entryDate.length) return AppNav.focusElement($entryDate);
					var $acc = $form.find('select[name*="gl3Id"]').first();
					if ($acc.length) return AppNav.focusElement($acc);
				}

				if ($current.is('input[name*="EntryDate"], #Head_EntryDate')) {
					var $acc = $form.find('select[name*="gl3Id"]').first();
					if ($acc.length) return AppNav.focusElement($acc);
				}

				// Master Narration in Voucher -> First detail row Account
				if ($current.is('input[name="Head.Narration"], #Head_Narration') && $('#tbl').length) {
					var $firstDetailAcc = $('#tbl tbody tr:not(#noDataRow) select[name*="gl3Id"]').first();
					if ($firstDetailAcc.length) return AppNav.focusElement($firstDetailAcc);
				}

				// Check if inside Voucher detail table row:
				if ($current.closest('#tbl tbody tr').length) {
					// If in narration of detail row, add row and focus new row's Account
					if ($current.is('input[name*="Narration"]')) {
						if (typeof addRow === 'function') {
							addRow();
							setTimeout(function () {
								var $lastRow = $('#tbl tbody tr:not(#noDataRow)').last();
								var $newAcc = $lastRow.find('select[name*="gl3Id"]');
								if ($newAcc.length) {
									AppNav.focusElement($newAcc);
								}
							}, 50);
							return true;
						}
					}
				}

				// 1. Check if $current has positive tabindex or if its underlying select has tabindex
				var tabIndex = 0;
				if ($current.hasClass('select2-selection')) {
					var $sel = AppNav.getSelectFromSelection($current);
					tabIndex = parseInt($sel.attr('data-orig-tabindex')) || parseInt($sel.data('tabindex')) || parseInt($sel.attr('tabindex')) || 0;
				} else {
					tabIndex = parseInt($current.attr('data-orig-tabindex')) || parseInt($current.data('tabindex')) || parseInt($current.attr('tabindex')) || 0;
				}

				// If tabindex-based navigation is used on this form:
				if (tabIndex > 0) {
					// Master fields (tabindex 1-99)
					if (tabIndex < 100) {
						var nextIdx = tabIndex + 1;
						var $next = $('[data-orig-tabindex="' + nextIdx + '"]:visible, [tabindex="' + nextIdx + '"]:visible, select[data-orig-tabindex="' + nextIdx + '"], select[tabindex="' + nextIdx + '"]').first();
						if ($next.length) {
							return AppNav.focusElement($next);
						}

						// Check common next targets after master fields:
						var $firstItem = $('#tbodyItems .qty:first:visible');
						if (!$firstItem.length) $firstItem = $('#tbodyItems input:not([readonly]):visible').first();
						if (!$firstItem.length) $firstItem = $('#tbodyItems input:first:visible');
						if ($firstItem.length) return AppNav.focusElement($firstItem);

						var $addBilty = $('#addBiltyBtn:visible, #btnAddChallan:visible');
						if ($addBilty.length) return AppNav.focusElement($addBilty);
					}
					// Expense fields (tabindex >= 100)
					else {
						var nextExpIdx = tabIndex + 1;
						var $nextExp = $('[data-orig-tabindex="' + nextExpIdx + '"]:visible, [tabindex="' + nextExpIdx + '"]:visible, select[data-orig-tabindex="' + nextExpIdx + '"], select[tabindex="' + nextExpIdx + '"]').first();
						if ($nextExp.length) {
							return AppNav.focusElement($nextExp);
						}
						var $save = $('#btnSave:visible, #btnSaveBottom:visible, #btnSaveComm:visible, #btnUpdate:visible, #btnUpdateBottom:visible, button[type=submit]:visible').first();
						if ($save.length) return AppNav.focusElement($save);
					}
				}

				// 2. DOM-based navigation using DOM tree order (compareDocumentPosition)
				var $focusable = AppNav.getFocusableElements($form);
				
				// Identify current container element so we compare from its end and NEVER refocus itself
				var $compareFrom = $current;
				if ($current.hasClass('select2-selection')) {
					$compareFrom = $current.closest('.select2-container');
				} else if ($current.is('select')) {
					var $s2 = $current.data('select2') ? $current.data('select2').$container : $current.nextAll('.select2-container').first();
					if (!$s2 || !$s2.length) $s2 = $current.closest('.input-group').find('.select2-container');
					if ($s2 && $s2.length) $compareFrom = $s2;
				}
				var compareDomEl = $compareFrom[0];

				// Identify all elements that belong to current field so we never refocus current field
				var $selfElements = $current;
				if ($current.hasClass('select2-selection')) {
					var $underlying = AppNav.getSelectFromSelection($current);
					$selfElements = $current.add($current.closest('.select2-container')).add($underlying);
				} else if ($current.is('select')) {
					var $s2Cont = $current.data('select2') ? $current.data('select2').$container : $current.nextAll('.select2-container').first();
					$selfElements = $current.add($s2Cont);
					if ($s2Cont && $s2Cont.length) $selfElements = $selfElements.add($s2Cont.find('*'));
				}

				// Find the first focusable element that appears AFTER compareDomEl in document order
				for (var i = 0; i < $focusable.length; i++) {
					var el = $focusable[i];
					if ($selfElements.is(el) || $.contains(compareDomEl, el)) continue;
					if (compareDomEl.compareDocumentPosition(el) & Node.DOCUMENT_POSITION_FOLLOWING) {
						return AppNav.focusElement(el);
					}
				}

				return false;
			}
		};

		$(document).ready(function () {
			// Backward compatibility for views that call highlightField directly
			window.highlightField = AppNav.highlightField;

			// Cache original tabindexes before Select2 alters them
			function cacheTabindexes() {
				$('[tabindex]').each(function () {
					var t = $(this).attr('tabindex');
					if (t && parseInt(t) > 0 && !$(this).attr('data-orig-tabindex')) {
						$(this).attr('data-orig-tabindex', t).data('tabindex', parseInt(t));
					}
				});
			}
			cacheTabindexes();
			$(document).ajaxComplete(function () { cacheTabindexes(); });

			// 1. ArrowDown / ArrowUp opens the dropdown list on any Select2 field or native select
			$(document).on('keydown', '.select2-selection', function (e) {
				var $container = $(this).closest('.select2-container');
				if ($container.hasClass('select2-container--open')) return;

				if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
					e.preventDefault();
					var $select = AppNav.getSelectFromSelection($(this));
					AppNav.openSelect2($select);
					return;
				}

				// Space key: open dropdown cleanly
				if (e.key === ' ') {
					e.preventDefault();
					var $select = AppNav.getSelectFromSelection($(this));
					AppNav.openSelect2($select);
					return;
				}

				// 🚀 Type to search while closed:
				// If any printable single character is typed without opening first, open and immediately search!
				if (e.key && e.key.length === 1 && !e.ctrlKey && !e.altKey && !e.metaKey && e.key !== 'Enter') {
					var $select = AppNav.getSelectFromSelection($(this));
					if ($select.length) {
						var typedChar = e.key;
						e.preventDefault();
						e.stopPropagation();

						var triggerSearchWithChar = function () {
							var $search = $('.select2-container--open .select2-search__field, .select2-dropdown .select2-search__field');
							if ($search.length) {
								$search.focus().val(typedChar).trigger('input').trigger('keyup');
								var len = $search.val().length;
								if ($search[0].setSelectionRange) {
									$search[0].setSelectionRange(len, len);
								}
							}
						};

						$select.one('select2:open', function () {
							setTimeout(triggerSearchWithChar, 10);
						});

						AppNav.openSelect2($select);
						setTimeout(triggerSearchWithChar, 40);
					}
				}
			});

			$(document).on('keydown', 'select:not(.select2-hidden-accessible)', function (e) {
				if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
					if ($(this).data('select2') && !$(this).data('select2').isOpen()) {
						e.preventDefault();
						AppNav.openSelect2($(this));
					}
				}
			});

			// Auto-focus search field whenever any Select2 opens
			$(document).on('select2:open', function () {
				setTimeout(function () {
					var $search = $('.select2-container--open .select2-search__field');
					if ($search.length && !$search.is(':focus')) {
						$search.focus();
					}
				}, 10);
			});

			// 2. Select2: When an item is selected from dropdown, advance immediately to next field!
			$(document).on('select2:select', 'select', function (e) {
				var $sel = $(this);
				$sel.data('nav-advancing', true);
				setTimeout(function () {
					AppNav.moveToNext($sel);
					setTimeout(function () {
						$sel.removeData('nav-advancing');
					}, 200);
				}, 60);
			});

			$(document).on('select2:close', 'select', function (e) {
				var $sel = $(this);
				if ($sel.data('nav-advancing')) {
					setTimeout(function () {
						var $s2 = $sel.data('select2') ? $sel.data('select2').$container : null;
						if ($s2 && $s2.find('.select2-selection').is(':focus')) {
							AppNav.moveToNext($sel);
						}
					}, 20);
				}
			});

			// 3. Enter key handling:
			// - On Select2 selection container:
			//   Enter directly advances to the NEXT field!
			$(document).on('keydown', '.select2-selection', function (e) {
				if (e.key === 'Enter') {
					var $container = $(this).closest('.select2-container');
					// If dropdown is currently OPEN, let Select2 pick the item
					if ($container.hasClass('select2-container--open')) {
						return;
					}

					e.preventDefault();
					var $select = AppNav.getSelectFromSelection($(this));
					var val = $select.val();

					// SPECIAL CASE: Inside Voucher detail table (#tbl)
					var $tblRow = $select.closest('#tbl tbody tr');
					if ($tblRow.length) {
						var hasAcc = (val && val !== '' && val !== '0' && val !== 'Select Account');
						if (!hasAcc) {
							// Account is NOT selected in this detail row
							var $allRows = $('#tbl tbody tr').not('#noDataRow');
							if ($allRows.length > 1) {
								// Remove this trailing empty row and go to Update / Create button
								$tblRow.remove();
								if (typeof calc === 'function') calc();
								var $saveBtn = $('#btnSave, #btnSaveBottom, #btnUpdate, #btnUpdateBottom, button[type="submit"]').filter(':visible').first();
								if ($saveBtn.length) {
									$saveBtn.prop('disabled', false).removeClass('disabled');
									return AppNav.focusElement($saveBtn);
								}
							}
						}
					}

					// Advance directly to NEXT field!
					AppNav.moveToNext($select.length ? $select : $(this));
				}
			});

			// Also handle when inside Select2 search field and Enter pressed without selecting account
			$(document).on('keydown', '.select2-search__field', function (e) {
				if (e.key === 'Enter') {
					var $search = $(this);
					var $select = $('select.select2-hidden-accessible').filter(function() {
						return $(this).data('select2') && $(this).data('select2').$container.hasClass('select2-container--open');
					});
					if ($select.length) {
						var $highlighted = $('.select2-results__option--highlighted');
						if ((!$highlighted.length || $highlighted.hasClass('select2-results__message')) && !$search.val()) {
							var $tblRow = $select.closest('#tbl tbody tr');
							if ($tblRow.length) {
								var $allRows = $('#tbl tbody tr').not('#noDataRow');
								if ($allRows.length > 1) {
									e.preventDefault();
									$select.select2('close');
									$tblRow.remove();
									if (typeof calc === 'function') calc();
									var $saveBtn = $('#btnSave, #btnSaveBottom, #btnUpdate, #btnUpdateBottom, button[type="submit"]').filter(':visible').first();
									if ($saveBtn.length) {
										$saveBtn.prop('disabled', false).removeClass('disabled');
										return AppNav.focusElement($saveBtn);
									}
								}
							} else {
								// In standard form dropdown: close and move to next
								e.preventDefault();
								$select.select2('close');
								AppNav.moveToNext($select);
							}
						}
					}
				}
			});

			// ============================================================
			// BILTY ITEMS & TO PAY BILTY ITEMS GRID KEYBOARD NAVIGATION
			// (Arrow keys navigate cells/rows/cols; Enter moves Qty -> Weight -> New row)
			// ============================================================
			$(document).on('keydown', '#tblItems tbody input', function (e) {
				var $input = $(this);
				var $tr = $input.closest('tr');
				var $allRows = $('#tblItems tbody tr').not('#noDataRow');
				var rowIndex = $allRows.index($tr);

				// 1. Enter Key Navigation inside grid
				if (e.key === 'Enter') {
					e.preventDefault();
					e.stopImmediatePropagation();

					if ($input.hasClass('qty')) {
						var val = $input.val();
						// If Qty is empty, move to Freight / Expense section
						if (!val || $.trim(val) === '') {
							return AppNav.focusElement($('#Cartage1'));
						}
						// Move to Weight (qtyperpack) in same row
						var $weight = $tr.find('.qtyperpack');
						if ($weight.length) {
							return AppNav.focusElement($weight);
						}
						return;
					}

					if ($input.hasClass('qtyperpack')) {
						var wVal = $input.val();
						var qVal = $tr.find('.qty').val();
						// If both Weight and Qty are empty or user presses Enter without value, go to Freight
						if ((!wVal || $.trim(wVal) === '') && (!qVal || $.trim(qVal) === '')) {
							return AppNav.focusElement($('#Cartage1'));
						}
						// If on the last row, add new row and focus its Qty
						if (rowIndex === $allRows.length - 1) {
							if (typeof addRow === 'function') {
								addRow();
								setTimeout(function () {
									var $newQty = $('#tblItems tbody tr:last-child .qty');
									AppNav.focusElement($newQty);
								}, 30);
							}
						} else {
							// Move to next row's Qty
							var $nextQty = $allRows.eq(rowIndex + 1).find('.qty');
							AppNav.focusElement($nextQty);
						}
						return;
					}
					return;
				}

				// 2. Arrow Left & Right Navigation
				if (e.key === 'ArrowRight') {
					if ($input.hasClass('iname')) {
						e.preventDefault();
						return AppNav.focusElement($tr.find('.qty'));
					}
					if ($input.hasClass('qty')) {
						e.preventDefault();
						return AppNav.focusElement($tr.find('.qtyperpack'));
					}
				}

				if (e.key === 'ArrowLeft') {
					if ($input.hasClass('qtyperpack')) {
						e.preventDefault();
						return AppNav.focusElement($tr.find('.qty'));
					}
					if ($input.hasClass('qty')) {
						var $iname = $tr.find('.iname, input[name*="IName"]');
						if ($iname.length && !$iname.is('[readonly]')) {
							e.preventDefault();
							return AppNav.focusElement($iname);
						}
					}
				}

				// 3. Arrow Down Navigation (navigate down rows or add new row)
				if (e.key === 'ArrowDown') {
					e.preventDefault();
					var isQty = $input.hasClass('qty');
					if (rowIndex < $allRows.length - 1) {
						var $targetRow = $allRows.eq(rowIndex + 1);
						var $target = isQty ? $targetRow.find('.qty') : $targetRow.find('.qtyperpack');
						return AppNav.focusElement($target);
					} else {
						// On the last row:
						var qVal = $tr.find('.qty').val();
						var wVal = $tr.find('.qtyperpack').val();
						if ((qVal && $.trim(qVal) !== '') || (wVal && $.trim(wVal) !== '')) {
							if (typeof addRow === 'function') {
								addRow();
								setTimeout(function () {
									var $targetRow = $('#tblItems tbody tr:last-child');
									var $target = isQty ? $targetRow.find('.qty') : $targetRow.find('.qtyperpack');
									AppNav.focusElement($target);
								}, 30);
							}
						} else {
							// Last row is empty, navigate to Expense section
							return AppNav.focusElement($('#Cartage1'));
						}
					}
				}

				// 4. Arrow Up Navigation (navigate up rows or back to Remarks)
				if (e.key === 'ArrowUp') {
					e.preventDefault();
					var isQty = $input.hasClass('qty');
					if (rowIndex > 0) {
						var $targetRow = $allRows.eq(rowIndex - 1);
						var $target = isQty ? $targetRow.find('.qty') : $targetRow.find('.qtyperpack');
						return AppNav.focusElement($target);
					} else {
						// On first row: move back up to Remarks field!
						return AppNav.focusElement($('#Remarks'));
					}
				}
			});

			// Master Remarks to Bilty Items grid connector
			$(document).on('keydown', '#Remarks', function (e) {
				if (e.key === 'ArrowDown') {
					e.preventDefault();
					var $firstQty = $('#tblItems tbody tr:first .qty');
					if ($firstQty.length) return AppNav.focusElement($firstQty);
				}
			});

			// Expense section to Bilty Items grid connector
			$(document).on('keydown', '#Cartage1', function (e) {
				if (e.key === 'ArrowUp') {
					e.preventDefault();
					var $lastQty = $('#tblItems tbody tr:last-child .qty');
					if ($lastQty.length) return AppNav.focusElement($lastQty);
				}
			});

			// - On normal inputs, standard selects, and textareas:
			$(document).on('keydown', 'input:not([type=submit]):not([type=button]):not([type=checkbox]):not([type=radio]), select:not(.select2-hidden-accessible), textarea', function (e) {
				if (e.key === 'Enter') {
					// Ignore if dropdown popup search field or dropdown is open
					if ($(this).hasClass('select2-search__field') || $('.select2-container--open').length > 0) {
						return;
					}

					// Ignore grid inputs which are already handled specifically
					if ($(this).closest('#tblItems, #tbl').length > 0) {
						return;
					}

					if ($(this).is('textarea') && e.shiftKey) {
						return;
					}

					e.preventDefault();
					AppNav.moveToNext($(this));
				}
			});

			// Ensure active focus highlighting on focus
			$(document).on('focus', 'input, select, textarea, .select2-selection, button', function () {
				AppNav.highlightField(this);
			});
		});
		</script>

		@await RenderSectionAsync("Scripts", required: false)
		
	</body>
</html>
