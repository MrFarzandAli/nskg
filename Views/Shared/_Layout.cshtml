@using System.Linq
@inject Nskg.Repositories.Interfaces.IUnitOfWork UnitOfWork
<!DOCTYPE html>
	<html lang="en" data-layout="vertical" data-topbar="light" data-sidebar="dark" data-sidebar-size="lg" data-sidebar-image="none">
	<head>
		<meta charset="utf-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<meta name="description" content="Smarthr - Bootstrap Admin Template">
		<meta name="keywords" content="admin, estimates, bootstrap, business, corporate, creative, management, minimal, modern, accounts, invoice, html5, responsive, CRM, Projects">
		<meta name="author" content="Dreamguys - Bootstrap Admin Template">
		<title> @ViewData["Title"] </title>
		<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
		<!-- Favicon -->
		<link rel="shortcut icon" type="image/x-icon" href="~/assets/img/favicon.png">
		
		<!-- Bootstrap CSS -->
		<link rel="stylesheet" href="~/assets/css/bootstrap.min.css">
        
		<!-- Fontawesome CSS -->
		<link rel="stylesheet" href="~/assets/plugins/fontawesome/css/fontawesome.min.css">
		<link rel="stylesheet" href="~/assets/plugins/fontawesome/css/all.min.css">

		<!-- Lineawesome CSS -->
		<link rel="stylesheet" href="~/assets/css/line-awesome.min.css">
		<link rel="stylesheet" href="~/assets/css/material.css">
		
		<!-- Chart CSS -->
		<link rel="stylesheet" href="~/assets/plugins/morris/morris.css">
		
		<!-- Main CSS -->
		<link rel="stylesheet" href="~/assets/css/style.css">


		<link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css">
										
		<!-- SweetAlert2 CSS & JS -->
		<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
									
		<!-- Toastr CSS & JS (Notifications ke liye) -->
		<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css">
	    
		<!-- Select2 CSS -->
		<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" />
		<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" />
		<style>
			/* Match Select2 perfectly with .form-control-sm / .form-select-sm */
			.select2-container .select2-selection--single,
			.select2-container--bootstrap-5 .select2-selection--single {
				height: 31px !important;
				min-height: 31px !important;
				padding: 0.2rem 0.5rem !important;
				font-size: 0.875rem !important;
				line-height: 1.5 !important;
				border-radius: 0.25rem !important;
				display: flex !important;
				align-items: center !important;
				border-color: #ced4da !important;
			}
			.select2-container--bootstrap-5 .select2-selection--single .select2-selection__rendered {
				font-size: 0.875rem !important;
				line-height: 1.5 !important;
				padding-left: 0 !important;
				padding-right: 1.25rem !important;
				color: #212529 !important;
			}
			.select2-container--bootstrap-5 .select2-selection--single .select2-selection__arrow {
				top: 50% !important;
				transform: translateY(-50%) !important;
				right: 6px !important;
				width: 16px !important;
				height: 16px !important;
			}
			.select2-container {
				width: 100% !important;
			}

			/* Select2 Dropdown Popup List Items Compactness */
			.select2-dropdown {
				font-size: 12px !important;
			}
			.select2-results__option {
				padding: 4px 8px !important;
				font-size: 12px !important;
				line-height: 1.4 !important;
			}
			.select2-container--bootstrap-5 .select2-dropdown .select2-search .select2-search__field {
				font-size: 12px !important;
				padding: 4px 6px !important;
				height: 28px !important;
			}
			.select2-container--default .select2-results__option--highlighted[aria-selected],
			.select2-container--bootstrap-5 .select2-results__option--highlighted {
				font-size: 12px !important;
			}

			/* Ensure Bootstrap 5 form-check-input / checkboxes display checkmark icon when checked */
			.form-check-input:checked,
			.form-check-input[type="checkbox"]:checked,
			input[type="checkbox"].form-check-input:checked,
			.bilty-check:checked {
				background-color: #0d6efd !important;
				border-color: #0d6efd !important;
				background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 20 20'%3e%3cpath fill='none' stroke='%23ffffff' stroke-linecap='round' stroke-linejoin='round' stroke-width='3' d='m6 10 3 3 6-6'/%3e%3c/svg%3e") !important;
				background-position: center !important;
				background-repeat: no-repeat !important;
				background-size: contain !important;
			}

			/* Responsive Header & Company Title */
			.header {
				display: flex;
				align-items: center;
				justify-content: space-between;
			}
			.header .page-title-box {
				display: flex !important;
				align-items: center;
				flex: 1 1 auto;
				min-width: 0;
				max-width: calc(100vw - 320px);
				padding: 0 15px !important;
				height: 60px;
			}
			.header .page-title-box h3 {
				white-space: nowrap;
				overflow: hidden;
				text-overflow: ellipsis;
				font-size: 16px !important;
				font-weight: 600;
				margin: 0;
				color: #fff;
			}
			.header .user-menu {
				flex-shrink: 0;
				margin-left: auto;
				position: static !important;
			}

			/* Tablet and Small Screen Navbar Adjustments */
			@@media (max-width: 1199px) {
				.header .page-title-box {
					max-width: calc(100vw - 280px);
				}
				.header .page-title-box h3 {
					font-size: 14px !important;
				}
			}
			@@media (max-width: 991px) {
				.header .page-title-box {
					display: flex !important;
					max-width: calc(100vw - 200px);
					padding: 0 10px !important;
				}
				.header .page-title-box h3 {
					font-size: 13px !important;
				}
				.header .page-title-box .badge {
					font-size: 11px !important;
				}
				.header .header-left {
					width: auto !important;
					min-width: 60px;
					padding: 0 10px !important;
				}
			}
			@@media (max-width: 767px) {
				.header .page-title-box {
					max-width: calc(100vw - 140px);
				}
				.header .page-title-box .btn-switch-comp span {
					display: none;
				}
			}

			/* Sidebar Compact Typography for Small / Laptop Screens */
			.sidebar .sidebar-menu ul li a {
				font-size: 13.5px !important;
				padding: 7px 12px !important;
			}
			.sidebar .sidebar-menu ul ul a {
				font-size: 12.5px !important;
				padding: 6px 10px 6px 36px !important;
			}
			.sidebar .sidebar-menu ul li a span {
				margin-left: 10px !important;
			}
			.sidebar .sidebar-menu ul li a i {
				font-size: 16px !important;
			}

			/* Global Form and Button Compactness for Laptops (<= 1366px) */
			@@media (max-width: 1366px) {
				body {
					font-size: 13px;
				}
				.sidebar .sidebar-menu ul li a {
					font-size: 13px !important;
					padding: 6px 10px !important;
				}
				.sidebar .sidebar-menu ul ul a {
					font-size: 12px !important;
					padding: 5px 8px 5px 32px !important;
				}
				.form-label, label {
					font-size: 12px !important;
					margin-bottom: 3px !important;
				}
				.form-control, .form-select, .select2-container {
					font-size: 12.5px !important;
				}
				.btn {
					font-size: 12.5px !important;
				}
				.card-header h5, .card-header h6 {
					font-size: 14px !important;
				}
				.table th, .table td {
					font-size: 12px !important;
					padding: 0.35rem 0.5rem !important;
				}
			}

			/* Global Table & Report Responsive Wrapper */
			.table-responsive {
				overflow-x: auto !important;
				-webkit-overflow-scrolling: touch;
			}

			/* ================================================================
			   NSKG ENTERPRISE BRANDING & UNIFIED DESIGN SYSTEM
			   Theme synchronized with SmartHR Warm Sunset Palette (#ff9b44 -> #fc6075)
			   ================================================================ */
			:root {
				--brand-primary: #ff9b44;       /* SmartHR Warm Amber / Coral Orange */
				--brand-secondary: #fc6075;     /* Warm Sunset Crimson / Rose */
				--brand-gradient: linear-gradient(135deg, #ff9b44 0%, #fc6075 100%);
				--brand-dark: #1e293b;          /* Professional Slate 800 */
				--brand-light: #fffaf5;         /* Subtle Warm Tint */
				--brand-border: #f1dfd3;        /* Soft Warm Border */
			}

			.bg-brand, .bg-brand-gradient, .card-header-brand {
				background: linear-gradient(135deg, #ff9b44 0%, #fc6075 100%) !important;
				color: #ffffff !important;
				border-bottom: none !important;
			}
			.card-header-brand h5, .card-header-brand h6 {
				color: #ffffff !important;
			}
			.card-header-brand small, .card-header-brand .text-white-50, .card-header-brand .text-muted {
				color: rgba(255, 255, 255, 0.88) !important;
			}

			.text-brand, .text-navy {
				color: #e65100 !important;      /* Elegant Deep Warm Amber */
			}

			.btn-brand {
				background: linear-gradient(135deg, #ff9b44 0%, #fc6075 100%) !important;
				border: none !important;
				color: #ffffff !important;
				box-shadow: 0 2px 6px rgba(255, 155, 68, 0.35);
			}
			.btn-brand:hover {
				background: linear-gradient(135deg, #f78523 0%, #e84a60 100%) !important;
				color: #ffffff !important;
				box-shadow: 0 4px 10px rgba(255, 155, 68, 0.45);
			}

			.card.custom-card, .card.report-card {
				border-radius: 8px !important;
				border: 1px solid #f1e5dc !important;
				box-shadow: 0 4px 14px rgba(255, 155, 68, 0.08) !important;
				overflow: hidden;
			}

			.custom-btn {
				border-radius: 5px !important;
				font-weight: 500 !important;
				transition: all 0.2s ease-in-out;
			}
			.custom-btn:hover {
				transform: translateY(-1px);
				box-shadow: 0 3px 8px rgba(0,0,0,0.12);
			}

			.report-filter-body {
				background-color: #fdfdfd !important;
				padding: 1.25rem !important;
			}

			.report-page-header h3 {
				color: #e65100 !important;
				font-weight: 700 !important;
			}

			/* Unified Form Label & Icon Standard */
			.form-label, label {
				font-weight: 500;
				color: #334155;
			}
			.form-label i, label i {
				color: #ff9b44 !important;
			}

			/* Master and Detail Card Header Standard */
			.card-header-subtle {
				background: #ffffff !important;
				border-bottom: 1px solid #f1dfd3 !important;
				padding: 0.6rem 1rem !important;
			}
			.card-header-subtle h6 {
				color: #e65100 !important;
				font-weight: 600 !important;
				margin-bottom: 0;
			}

			/* Table header icons and card header icons unified warm theme */
			.table-light th i, table thead th i {
				color: #ff9b44 !important;
			}
			h3 i.text-primary, h4 i.text-primary, h5 i.text-primary, h6 i.text-primary {
				color: #ff9b44 !important;
			}
			.badge.bg-primary {
				background: linear-gradient(135deg, #ff9b44 0%, #fc6075 100%) !important;
			}

			/* Buttons aesthetic harmony */
			.btn-primary {
				background: linear-gradient(135deg, #ff9b44 0%, #fc6075 100%) !important;
				border: none !important;
				color: #ffffff !important;
				box-shadow: 0 2px 5px rgba(255, 155, 68, 0.28) !important;
			}
			.btn-primary:hover, .btn-primary:focus {
				background: linear-gradient(135deg, #f78523 0%, #e84a60 100%) !important;
				color: #ffffff !important;
				box-shadow: 0 4px 10px rgba(255, 155, 68, 0.4) !important;
			}
			.btn-outline-primary {
				color: #ff9b44 !important;
				border-color: #ff9b44 !important;
			}
			.btn-outline-primary:hover {
				background: linear-gradient(135deg, #ff9b44 0%, #fc6075 100%) !important;
				color: #ffffff !important;
				border-color: transparent !important;
			}

			/* Spinner & Focus highlight */
			.spinner-border.text-primary {
				color: #ff9b44 !important;
			}
			.form-control:focus, .form-select:focus, .select2-container--default.select2-container--focus .select2-selection--single {
				border-color: #ff9b44 !important;
				box-shadow: 0 0 0 0.2rem rgba(255, 155, 68, 0.2) !important;
			}

			/* ================================================================
			   COMPACT TRANSACTION & OPERATION DATA ENTRY LAYOUT STANDARD
			   Zero full-page scroll: Master + Grid + Totals fit in single screen
			   ================================================================ */
			.page-wrapper .content.compact-content-layout {
				padding: 8px 16px 8px 16px !important;
				min-height: calc(100vh - 60px);
				display: flex;
				flex-direction: column;
			}
			.compact-content-layout .page-header {
				margin-bottom: 6px !important;
			}
			.compact-content-layout form.form-dense {
				display: flex;
				flex-direction: column;
				flex: 1 1 auto;
				min-height: 0;
			}
			.form-dense .card {
				margin-bottom: 6px !important;
			}
			.form-dense .card-header {
				padding: 4px 10px !important;
			}
			.form-dense .card-body {
				padding: 8px 12px !important;
			}
			.form-dense .form-label {
				font-size: 11px !important;
				margin-bottom: 2px !important;
				font-weight: 600 !important;
				color: #475569 !important;
			}
			.form-dense .form-control-sm,
			.form-dense .form-select-sm {
				font-size: 12px !important;
				height: 28px !important;
				padding: 2px 6px !important;
			}
			.form-dense .select2-container .select2-selection--single {
				height: 28px !important;
				min-height: 28px !important;
				font-size: 12px !important;
				padding: 1px 6px !important;
			}
			.form-dense .select2-container--bootstrap-5 .select2-selection--single .select2-selection__rendered {
				font-size: 12px !important;
				line-height: 24px !important;
			}

			/* Voucher Grid & Bottom Totals Bar Layout */
			.voucher-grid-card {
				flex: 1 1 auto;
				display: flex;
				flex-direction: column;
				min-height: 320px;
				margin-bottom: 6px !important;
			}
			.voucher-grid-card .card-body {
				flex: 1 1 auto;
				display: flex;
				flex-direction: column;
				min-height: 0;
				padding: 0 !important;
			}
			.voucher-table-container {
				flex: 1 1 auto;
				min-height: 300px;
				max-height: calc(100vh - 350px) !important;
				overflow-y: auto;
			}
			#tbl th, #tbl td {
				padding: 4px 6px !important;
				font-size: 12px !important;
			}
			#tbl .form-control {
				height: 28px !important;
				font-size: 12px !important;
				padding: 2px 6px !important;
			}
			#tbl .select2-container .select2-selection--single {
				height: 28px !important;
				min-height: 28px !important;
				font-size: 12px !important;
			}
			#tbl .select2-container--bootstrap-5 .select2-selection--single .select2-selection__rendered {
				font-size: 12px !important;
				line-height: 24px !important;
			}
			.voucher-totals-bar {
				position: sticky;
				bottom: 0;
				z-index: 99;
				margin-top: auto;
				margin-bottom: 2px !important;
				background: #ffffff !important;
				border: 1px solid #e2e8f0 !important;
				border-top: 2px solid #ff9b44 !important;
				box-shadow: 0 -3px 12px rgba(0, 0, 0, 0.08) !important;
				border-radius: 6px;
			}

			/* Special Small Laptop & Scaled Display Adaptive Rules (Height <= 768px, e.g. 1366x768 or 1080p  125%/150%) */
			@@media (max-height: 768px) {
				.page-wrapper .content.compact-content-layout {
					padding: 6px 12px 4px 12px !important;
					min-height: calc(100vh - 60px);
				}
				.compact-content-layout .page-header {
					margin-bottom: 4px !important;
				}
				.form-dense .card {
					margin-bottom: 4px !important;
				}
				.form-dense .card-header {
					padding: 3px 8px !important;
				}
				.form-dense .card-body {
					padding: 5px 8px !important;
				}
				.voucher-grid-card {
					min-height: 260px;
					margin-bottom: 4px !important;
				}
				.voucher-table-container {
					min-height: 240px;
					max-height: calc(100vh - 330px) !important;
				}
				.form-dense .form-label {
					font-size: 10.5px !important;
					margin-bottom: 1px !important;
				}
				.form-dense .form-control-sm,
				.form-dense .form-select-sm,
				.form-dense .select2-container .select2-selection--single {
					height: 26px !important;
					min-height: 26px !important;
					font-size: 11.5px !important;
					padding: 1px 4px !important;
				}
				.form-dense .select2-container--bootstrap-5 .select2-selection--single .select2-selection__rendered {
					font-size: 11.5px !important;
					line-height: 23px !important;
				}
			}
		</style>

		@await RenderSectionAsync("Styles", required: false)
	</head>
	
	<body>
		<!-- Main Wrapper -->
		<div class="main-wrapper">
		
			<!-- Header -->
			<div class="header">
			
				<!-- Logo -->
				<div class="header-left">
					<a asp-controller="Home" asp-action="Index" class="logo">
						<img src="~/assets/img/logo.png" width="40" height="40" alt="Logo">
					</a>
														<a asp-controller="Home" asp-action="Index" class="logo2">
						<img src="~/assets/img/logo2.png" width="40" height="40" alt="Logo">
					</a>
				</div>
				<!-- /Logo -->
				
				<a id="toggle_btn" href="javascript:void(0);">
					<span class="bar-icon">
						<span></span>
						<span></span>
						<span></span>
					</span>
				</a>
				
		<!-- Header Title -->
		@{
			var companyName = "NSKG";
			var companyCode = "";
			try
			{
				var claimName = User.FindFirst("CompanyName")?.Value;
				var claimCode = User.FindFirst("CompanyCode")?.Value;
				if (!string.IsNullOrWhiteSpace(claimCode)) companyCode = claimCode;

				if (!string.IsNullOrWhiteSpace(claimName))
				{
					companyName = claimName;
				}
				else
				{
					var compIdClaim = User.FindFirst("CompanyId")?.Value;
					if (int.TryParse(compIdClaim, out int loggedCompId) && loggedCompId > 0)
					{
						var company = await UnitOfWork.Companies.GetByIdAsync(loggedCompId);
						if (company != null && !string.IsNullOrWhiteSpace(company.Name))
						{
							companyName = company.Name;
							companyCode = company.Cocode ?? "";
						}
					}
				}
			}
			catch
			{
				// ignore and fallback to default
			}
		}
		<div class="page-title-box d-flex align-items-center">
			<h3 class="mb-0 text-white"><i class="fa fa-building me-1"></i> @companyName</h3>
			@if (!string.IsNullOrEmpty(companyCode) && companyCode != "0")
			{
				<span class="badge bg-light text-dark ms-2 font-weight-bold" style="font-size: 13px;">Branch: @companyCode</span>
			}
			<a asp-controller="AccountSetup" asp-action="SwitchCompany" class="btn btn-sm btn-outline-light ms-3 btn-switch-comp text-nowrap" title="Switch Company in this browser" style="font-size: 11px; padding: 3px 10px; border-radius: 4px; border: 1px solid rgba(255,255,255,0.4); background: rgba(255,255,255,0.15); color: #fff;">
				<i class="fa fa-exchange-alt me-1"></i><span> Switch Company</span>
			</a>
		</div>
				<!-- /Header Title -->
				
				<a id="mobile_btn" class="mobile_btn" href="#sidebar"><i class="fa-solid fa-bars"></i></a>
				
				<!-- Header Menu -->
				<ul class="nav user-menu">
				
							
					<!-- Notifications -->
@* 					<li class="nav-item dropdown">
						<a href="#" class="dropdown-toggle nav-link" data-bs-toggle="dropdown">
							<i class="fa-regular fa-bell"></i> <span class="badge rounded-pill">3</span>
						</a>
						<div class="dropdown-menu notifications">
							<div class="topnav-dropdown-header">
								<span class="notification-title">Notifications</span>
								<a href="javascript:void(0)" class="clear-noti"> Clear All </a>
							</div>
							<div class="noti-content">
