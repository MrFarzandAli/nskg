@{
    ViewData["Title"] = "Advance Report";

    var fromDateValue = ViewBag.FromDate as string;
    var toDateValue = ViewBag.ToDate as string;
    var docNoValue = ViewBag.DocNo != null ? ViewBag.DocNo.ToString() : "";
    var chalNoValue = ViewBag.ChalNo != null ? ViewBag.ChalNo.ToString() : "";
    var vehicleNoValue = ViewBag.VehicleNo as string ?? "";
    var transporterValue = ViewBag.Transporter as string ?? "";
    var selectedCompanyId = ViewBag.SelectedCompanyId != null ? (int)ViewBag.SelectedCompanyId : 0;
    var companyList = ViewBag.CompanyList as IEnumerable<dynamic>;

    if (string.IsNullOrEmpty(fromDateValue))
        fromDateValue = DateTime.Now.ToString("yyyy-MM-dd");

    if (string.IsNullOrEmpty(toDateValue))
        toDateValue = DateTime.Now.ToString("yyyy-MM-dd");
}

<style>
    .custom-card { border-radius: 10px; }
    .heading-glow { font-weight: 600; }
    .custom-btn { border-radius: 6px; }
    iframe { border-radius: 8px; }
</style>

<div class="container-fluid mt-4">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="fw-bold"><i class="fa fa-file-text-o me-2 text-primary"></i> Advance Report</h3>
    </div>

    <!-- Filter Card -->
    <div class="card custom-card mb-4 shadow-sm border-0">
        <div class="card-header bg-primary text-white py-3">
            <h5 class="mb-0 fw-semibold">
                <i class="fa fa-filter me-2"></i> Filter Parameters
            </h5>
        </div>
        <div class="card-body p-4 bg-light">
            <form method="get" id="filterForm">
                <div class="row g-3">
                    <!-- Company Dropdown -->
                    <div class="col-md-4">
                        <label class="form-label fw-bold">Company</label>
                        <select class="form-select select2" name="companyId" id="companySelect">
                                <option value="0" selected="@(selectedCompanyId == 0 ? "selected" : null)">-- All Companies --</option>
                            @if (companyList != null)
                            {
                                foreach (var comp in companyList)
                                {
                                    if (comp.Id == selectedCompanyId)
                                    {
                                        <option value="@comp.Id" selected="selected">@comp.Name</option>
                                    }
                                    else
                                    {
                                        <option value="@comp.Id">@comp.Name</option>
                                    }
                                }
                            }
                        </select>
                    </div>

                    <!-- From Date -->
                    <div class="col-md-2">
                        <label class="form-label fw-bold">From Date</label>
                        <input type="date" class="form-control" name="fromDate" id="fromDate" value="@fromDateValue" />
                    </div>

                    <!-- To Date -->
                    <div class="col-md-2">
                        <label class="form-label fw-bold">To Date</label>
                        <input type="date" class="form-control" name="toDate" id="toDate" value="@toDateValue" />
                    </div>

                    <!-- Chal No -->
                    <div class="col-md-2">
                        <label class="form-label fw-bold">Chal No</label>
                        <input type="number" class="form-control" name="chalNo" id="chalNo" placeholder="Challan No" value="@chalNoValue" min="0" />
                    </div>

                    <!-- Doc No -->
                    <div class="col-md-2">
                        <label class="form-label fw-bold">Doc No</label>
                        <input type="number" class="form-control" name="docNo" id="docNo" placeholder="Doc No" value="@docNoValue" min="0" />
                    </div>

                    <!-- Vehicle No -->
                    <div class="col-md-3">
                        <label class="form-label fw-bold">Vehicle No</label>
                        <input type="text" class="form-control" name="vehicleNo" id="vehicleNo" placeholder="e.g. TLA-123" value="@vehicleNoValue" />
                    </div>

                    <!-- Transporter -->
                    <div class="col-md-3">
                        <label class="form-label fw-bold">Transporter</label>
                        <input type="text" class="form-control" name="transporter" id="transporter" placeholder="Transporter name" value="@transporterValue" />
                    </div>

                    <div class="col-md-12 d-flex justify-content-end gap-2 mt-3 pt-2 border-top">
                        <!-- VIEW ON SCREEN -->
                        <button type="button"
                                class="btn btn-primary btn-sm px-3 shadow-sm fw-semibold"
                                onclick="loadOnScreenReport()">
                            <i class="fa fa-desktop me-1"></i> View Report
                        </button>

                        <!-- EXCEL EXPORT -->
                        <button type="submit"
                                class="btn btn-success btn-sm px-3 shadow-sm fw-semibold"
                                asp-action="ExportExcel">
                            <i class="fa fa-file-excel-o me-1"></i> Export Excel (CSV)
                        </button>

                        <!-- PDF DOWNLOAD / PRINT -->
                        <button type="submit"
                                class="btn btn-danger btn-sm px-3 shadow-sm fw-semibold"
                                asp-action="GeneratePDF"
                                formtarget="_blank">
                            <i class="fa fa-file-pdf-o me-1"></i> Open / Print PDF
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- ON SCREEN REPORT PREVIEW -->
    <div id="reportCard" class="card shadow border-0" style="display:none;">
        <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center py-2">
            <h5 class="mb-0 fs-6"><i class="fa fa-file-text-o me-2"></i> Report Preview</h5>
            <button type="button" class="btn btn-sm btn-outline-light" onclick="$('#reportCard').hide()">
                <i class="fa fa-times"></i> Close
            </button>
        </div>

        <!-- LOADER -->
        <div id="reportLoader" style="display:none; padding:40px; text-align:center;">
            <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;">
                <span class="visually-hidden">Loading...</span>
            </div>
            <div class="mt-3 fw-bold text-muted">Generating advance report, please wait...</div>
        </div>

        <!-- REPORT IFRAME -->
        <div class="card-body p-0">
            <iframe id="reportFrame"
                    style="width:100%; height:750px; border:none; display:none;"></iframe>
        </div>
    </div>

</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            if ($.fn.select2) {
                $('#companySelect').select2({ theme: 'bootstrap-5', width: '100%' });
            }
        });

        function loadOnScreenReport() {
            var companyId = $('#companySelect').val() || '';
            var fromDate = $('input[name="fromDate"]').val() || '';
            var toDate = $('input[name="toDate"]').val() || '';
            var docNo = $('input[name="docNo"]').val() || '';
            var chalNo = $('input[name="chalNo"]').val() || '';
            var vehicleNo = $('input[name="vehicleNo"]').val() || '';
            var transporter = $('input[name="transporter"]').val() || '';

            if (fromDate && toDate && fromDate > toDate && !docNo && !chalNo && !vehicleNo && !transporter) {
                alert("From Date cannot be greater than To Date.");
                return;
            }

            $('#reportCard').show();
            $('#reportLoader').show();
            $('#reportFrame').hide();

            $('html, body').animate({
                scrollTop: $("#reportCard").offset().top - 20
            }, 400);

            var url = '@Url.Action("OnScreenReport", "AdvanceReport")'
                + '?companyId=' + encodeURIComponent(companyId)
                + '&fromDate=' + encodeURIComponent(fromDate)
                + '&toDate=' + encodeURIComponent(toDate)
                + '&docNo=' + encodeURIComponent(docNo)
                + '&chalNo=' + encodeURIComponent(chalNo)
                + '&vehicleNo=' + encodeURIComponent(vehicleNo)
                + '&transporter=' + encodeURIComponent(transporter);

            $('#reportFrame').off('load');
            $('#reportFrame').attr('src', url);

            $('#reportFrame').on('load', function () {
                $('#reportLoader').hide();
                $('#reportFrame').show();
            });
        }
    </script>
}
