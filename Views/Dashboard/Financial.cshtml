@using Nskg.Models.ViewModels
@model FinancialDashboardViewModel

@{
    ViewData["Title"] = "Financial Dashboard";
}

<div class="container-fluid my-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2><i class="fa fa-chart-line text-primary me-2"></i> Financial Dashboard</h2>
        <small class="text-muted">Real-time financial snapshot</small>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-md-3">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <h6 class="text-muted">Total Revenue</h6>
                    <h3 class="mt-2">@Model.TotalRevenue.ToString("C")</h3>
                    <small class="text-success">Month over month +3.5%</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <h6 class="text-muted">Total Expenses</h6>
                    <h3 class="mt-2">@Model.TotalExpenses.ToString("C")</h3>
                    <small class="text-danger">Stable</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <h6 class="text-muted">Receivables</h6>
                    <h3 class="mt-2">@Model.TotalReceivables.ToString("C")</h3>
                    <small class="text-warning">Due 30 days</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <h6 class="text-muted">Cash Balance</h6>
                    <h3 class="mt-2">@Model.CashBalance.ToString("C")</h3>
                    <small class="text-muted">Updated now</small>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-8">
            <div class="card mb-3">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <strong>Revenue (last 6 months)</strong>
                    <small class="text-muted">Trend</small>
                </div>
                <div class="card-body">
                    <canvas id="revenueChart" height="120"></canvas>
                </div>
            </div>

            <div class="card mb-3">
                <div class="card-header">
                    <strong>Quick Insights</strong>
                </div>
                <div class="card-body">
                    <ul>
                        <li>Top performing account: Sales</li>
                        <li>Largest expense category: Transport</li>
                        <li>Average invoice cycle: 18 days</li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card mb-3">
                <div class="card-header">
                    <strong>Recent Transactions</strong>
                </div>
                <div class="card-body p-0">
                    <table class="table table-sm mb-0">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Account</th>
                                <th class="text-end">Debit</th>
                                <th class="text-end">Credit</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach(var t in Model.RecentTransactions)
                            {
                                <tr>
                                    <td>@t.Date.ToString("dd-MMM")</td>
                                    <td>@t.Account</td>
                                    <td class="text-end">@t.Debit.ToString("N2")</td>
                                    <td class="text-end">@t.Credit.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const labels = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.MonthlyLabels));
        const data = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.MonthlyRevenue));

        const ctx = document.getElementById('revenueChart').getContext('2d');
        new Chart(ctx, {
            type: 'line',
            data: {
                labels: labels,
                datasets: [{
                    label: 'Revenue',
                    data: data,
                    borderColor: '#0d6efd',
                    backgroundColor: 'rgba(13,110,253,0.12)',
                    fill: true,
                    tension: 0.3,
                    pointRadius: 4
                }]
            },
            options: {
                responsive: true,
                plugins: {
                    legend: { display: false }
                },
                scales: {
                    y: { beginAtZero: true }
                }
            }
        });
    </script>
}
