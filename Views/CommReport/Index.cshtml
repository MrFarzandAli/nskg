@{
    var mode = ViewBag.Mode as string ?? "List";
    var isChallanList = string.Equals(mode, "List", StringComparison.OrdinalIgnoreCase);
    var pageHeading = isChallanList ? "Challan List" : "Challan Report";
    ViewData["Title"] = pageHeading;

    var pchalnoValue = ViewBag.Pchalno as string ?? "";
    var pcocodeValue = ViewBag.Pcocode as string ?? "";
    var fromDateValue = ViewBag.FromDate as string;
    var toDateValue = ViewBag.ToDate as string;
    var reportTypeValue = ViewBag.ReportType as string ?? (isChallanList ? "Godown" : "Adda");
    var partyCodeValue = ViewBag.PartyCode as string ?? "";
    var biltyNoValue = ViewBag.BiltyNo != null ? ViewBag.BiltyNo.ToString() : "";
    var vehicleNoValue = ViewBag.VehicleNo as string ?? "";
    var stationValue = ViewBag.Station as string ?? "";
    var selectedCompanyId = ViewBag.SelectedCompanyId != null ? (int)ViewBag.SelectedCompanyId : 0;
    var companyList = ViewBag.CompanyList as IEnumerable<dynamic>;

    if (string.IsNullOrEmpty(fromDateValue))
    {
        fromDateValue = DateTime.Now.AddDays(-30).ToString("yyyy-MM-dd");
    }

    if (string.IsNullOrEmpty(toDateValue))
    {
        toDateValue = DateTime.Now.ToString("yyyy-MM-dd");
    }
}

<style>
    .custom-card { border-radius: 10px; }
    .heading-glow { font-weight: 600; }
    .custom-btn { border-radius: 6px; }
    iframe { border-radius: 8px; }
</style>

<div class="container-fluid mt-4">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h3 class="fw-bold mb-0 text-navy">
                <i class="fa fa-file-text-o me-2 text-primary"></i> @pageHeading 
            </h3>
            <small class="text-muted">Challan and commission delivery report</small>
        </div>
        <div class="btn-group">
            <a asp-controller="CommReport" asp-action="ChallanList" class="btn btn-sm @(isChallanList ? "btn-primary" : "btn-outline-primary") fw-semibold custom-btn">
                <i class="fa fa-list me-1"></i> Challan List (Pchalno / Pcocode)
            </a>
            <a asp-controller="CommReport" asp-action="ChallanReport" class="btn btn-sm @(!isChallanList ? "btn-primary" : "btn-outline-primary") fw-semibold custom-btn">
                <i class="fa fa-calendar me-1"></i> Challan Report (Fdate / Tdate)
            </a>
        </div>
    </div>

    <!-- Filter Card -->
    <div class="card custom-card mb-4 shadow-sm border-0">
        <div class="card-header card-header-brand py-3">
            <h5 class="mb-0 fw-semibold">
                <i class="fa fa-sliders me-2"></i> Report Parameters
            </h5>
            <small class="text-white-50">Filter by Challan No, Company, and Date Range</small>
        </div>
        <div class="card-body report-filter-body">
            <form method="get" id="filterForm">
                <input type="hidden" name="mode" value="@mode" />
                <input type="hidden" name="reportType" id="reportType" value="@reportTypeValue" />

                <div class="row g-3">
                    @if (isChallanList)
                    {
                        <!-- Challan List Parameters (Pchalno, Pcocode) -->
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Pchalno <small class="text-primary">(Challan No)</small></label>
                            <input type="text" class="form-control form-control-lg fw-bold" name="pchalno" id="pchalno" placeholder="Enter Challan No (e.g. 503)" value="@pchalnoValue" autofocus />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold">Pcocode <small class="text-primary">(Company)</small></label>
                            <select class="form-select form-select-lg select2" name="companyId" id="companySelect">
                                <option value="0" selected="@(selectedCompanyId == 0 ? "selected" : null)">-- All Companies --</option>
                                @if (companyList != null)
                                {
                                    foreach (var comp in companyList)
                                    {
                                        if (comp.Id == selectedCompanyId || (!string.IsNullOrEmpty(pcocodeValue) && comp.Code == pcocodeValue))
                                        {
                                            <option value="@comp.Id" data-cocode="@comp.Code" selected="selected">@comp.Name</option>
                                        }
                                        else
                                        {
                                            <option value="@comp.Id" data-cocode="@comp.Code">@comp.Name</option>
                                        }
                                    }
                                }
                            </select>
                        </div>
                    }
                    else
                    {
                        <!-- Challan Report Parameters (Fdate, Tdate, Pcocode) -->
                        <div class="col-md-4">
                            <label class="form-label fw-bold">Fdate <small class="text-primary">(From Date)</small></label>
                            <input type="date" class="form-control form-control-lg" name="fromDate" id="fromDate" value="@fromDateValue" required />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label fw-bold">Tdate <small class="text-primary">(To Date)</small></label>
                            <input type="date" class="form-control form-control-lg" name="toDate" id="toDate" value="@toDateValue" required />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label fw-bold">Pcocode <small class="text-primary">(Company)</small></label>
                            <select class="form-select form-select-lg select2" name="companyId" id="companySelect">
                                <option value="0" selected="@(selectedCompanyId == 0 ? "selected" : null)">-- All Companies --</option>
                                @if (companyList != null)
                                {
                                    foreach (var comp in companyList)
                                    {
                                        if (comp.Id == selectedCompanyId || (!string.IsNullOrEmpty(pcocodeValue) && comp.Code == pcocodeValue))
                                        {
                                            <option value="@comp.Id" data-cocode="@comp.Code" selected="selected">@comp.Name</option>
                                        }
                                        else
                                        {
                                            <option value="@comp.Id" data-cocode="@comp.Code">@comp.Name</option>
                                        }
                                    }
                                }
                            </select>
                        </div>


                    }

                    <div class="col-md-12 d-flex justify-content-end gap-2 mt-3 pt-2 border-top">
                        <!-- VIEW ON SCREEN -->
                        <button type="button"
                                class="btn btn-primary btn-sm px-3 shadow-sm fw-semibold"
                                onclick="loadOnScreenReport()">
                            <i class="fa fa-desktop me-1"></i> View Report
                        </button>

                        <!-- EXCEL EXPORT -->
                        <button type="submit"
                                class="btn btn-success btn-sm px-3 shadow-sm fw-semibold"
                                asp-action="ExportExcel">
                            <i class="fa fa-file-excel-o me-1"></i> Export Excel (CSV)
                        </button>

                        <!-- PDF DOWNLOAD -->
                        <button type="submit"
                                class="btn btn-danger btn-sm px-3 shadow-sm fw-semibold"
                                asp-action="GeneratePDF"
                                formtarget="_blank">
                            <i class="fa fa-file-pdf-o me-1"></i> Open / Print PDF
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- ON SCREEN REPORT PREVIEW -->
    <div id="reportCard" class="card shadow-sm border-0 mb-4" style="display:none;">
        <div class="card-header card-header-brand text-white d-flex justify-content-between align-items-center py-2">
            <h5 class="mb-0 fs-6 fw-semibold"><i class="fa fa-file-text-o me-2"></i> Report Preview</h5>
            <div class="d-flex gap-2">
                <button type="button" class="btn btn-light btn-sm fw-semibold" onclick="printReportFrame()">
                    <i class="fa fa-print me-1"></i> Print
                </button>
                <button type="button" class="btn btn-outline-light btn-sm" onclick="$('#reportCard').slideUp(200)">
                    <i class="fa fa-times me-1"></i> Close
                </button>
            </div>
        </div>

        <!-- LOADER -->
        <div id="reportLoader" style="display:none; padding:40px; text-align:center;">
            <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;">
                <span class="visually-hidden">Loading...</span>
            </div>
            <div class="mt-3 fw-bold text-muted">Generating @pageHeading, please wait...</div>
        </div>

        <!-- REPORT IFRAME -->
        <div class="card-body p-0">
            <iframe id="reportFrame"
                    style="width:100%; height:750px; border:none; display:none;"></iframe>
        </div>
    </div>

</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            if ($.fn.select2) {
                $('#companySelect').select2({ theme: 'bootstrap-5', width: '100%' });
            }
        });

        function loadOnScreenReport() {
            var companyId = $('#companySelect').val() || '';
            var pchalno = $('#pchalno').val() || '';
            var fromDate = $('#fromDate').val() || '';
            var toDate = $('#toDate').val() || '';
            var reportType = $('#reportType').val() || 'Godown';
            var biltyNo = $('#biltyNo').val() || '';
            var vehicleNo = $('#vehicleNo').val() || '';
            var station = $('#station').val() || '';
            var partyCode = $('#partyCode').val() || '';

            if (fromDate && toDate && fromDate > toDate && !pchalno && !biltyNo && !vehicleNo) {
                alert("From Date cannot be greater than To Date.");
                return;
            }

            $('#reportCard').show();
            $('#reportLoader').show();
            $('#reportFrame').hide();

            // Smooth scroll down to preview
            $('html, body').animate({
                scrollTop: $("#reportCard").offset().top - 20
            }, 400);

            var url = '@Url.Action("OnScreenReport", "CommReport")'
                + '?companyId=' + encodeURIComponent(companyId)
                + '&pchalno=' + encodeURIComponent(pchalno)
                + '&fromDate=' + encodeURIComponent(fromDate)
                + '&toDate=' + encodeURIComponent(toDate)
                + '&reportType=' + encodeURIComponent(reportType)
                + '&biltyNo=' + encodeURIComponent(biltyNo)
                + '&vehicleNo=' + encodeURIComponent(vehicleNo)
                + '&station=' + encodeURIComponent(station)
                + '&partyCode=' + encodeURIComponent(partyCode)
                + '&mode=' + encodeURIComponent('@mode');

            $('#reportFrame').off('load');
            $('#reportFrame').attr('src', url);

            $('#reportFrame').on('load', function () {
                $('#reportLoader').hide();
                $('#reportFrame').show();
            });
        }
    </script>
}


