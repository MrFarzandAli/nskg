@{
    ViewData["Title"] = "Commission Report";

    var fromDateValue = ViewBag.FromDate as string;
    var toDateValue = ViewBag.ToDate as string;
    var partyCodeValue = ViewBag.PartyCode as string;
    var reportTypeValue = ViewBag.ReportType as string ?? "Godown";

    if (string.IsNullOrEmpty(fromDateValue))
    {
        fromDateValue = DateTime.Now.AddDays(-30).ToString("yyyy-MM-dd");
    }

    if (string.IsNullOrEmpty(toDateValue))
    {
        toDateValue = DateTime.Now.ToString("yyyy-MM-dd");
    }
}

<style>
    .custom-card { border-radius: 10px; }
    .heading-glow { font-weight: 600; }
    .custom-btn { border-radius: 6px; }
    iframe { border-radius: 8px; }
</style>

<div class="container-fluid mt-4">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="fw-bold"><i class="fa fa-file-text-o me-2 text-warning"></i> Commission Report</h3>
    </div>

    <!-- Filter Card -->
    <div class="card custom-card mb-4 shadow-sm border-0">
        <div class="card-header bg-warning text-dark py-3">
            <h5 class="mb-0 fw-semibold">
                <i class="fa fa-filter me-2"></i> Filter Parameters
            </h5>
        </div>
        <div class="card-body p-4 bg-light">
            <form method="get" id="filterForm">
                <div class="row g-3">
                    <!-- Report / Location Type (Godown vs Adda) -->
                    <div class="col-md-3">
                        <label class="form-label fw-bold">Report Type / Location</label>
                        <select class="form-select fw-bold border-warning" name="reportType" id="reportType">
                            <!option value="Godown" @(reportTypeValue == "Godown" ? "selected" : "")>Godown (commreport_all1)</!option>
                            <!option value="Adda" @(reportTypeValue == "Adda" ? "selected" : "")>Adda (commreport_all12)</!option>
                        </select>
                    </div>

                    <!-- From Date -->
                    <div class="col-md-2">
                        <label class="form-label fw-bold">From Date</label>
                        <input type="date" class="form-control" name="fromDate" id="fromDate" value="@fromDateValue" />
                    </div>

                    <!-- To Date -->
                    <div class="col-md-2">
                        <label class="form-label fw-bold">To Date</label>
                        <input type="date" class="form-control" name="toDate" id="toDate" value="@toDateValue" />
                    </div>

                    <!-- Party Code (Optional) -->
                    <div class="col-md-3">
                        <label class="form-label fw-bold">Party Code <small class="text-muted">(Optional)</small></label>
                        <input type="text" class="form-control" name="partyCode" id="partyCode" placeholder="e.g. 001001" value="@partyCodeValue" />
                    </div>

                    <!-- View on Screen Button -->
                    <div class="col-md-2 d-flex align-items-end">
                        <button type="button"
                                class="btn btn-warning btn-md w-100 text-dark shadow-sm fw-bold"
                                onclick="loadOnScreenReport()">
                            <i class="fa fa-desktop me-1"></i> View
                        </button>
                    </div>

                    <div class="col-md-12 d-flex justify-content-end gap-2 mt-3 pt-2 border-top">
                        <!-- EXCEL EXPORT -->
                        <button type="submit"
                                class="btn btn-success btn-sm px-3 shadow-sm"
                                asp-action="ExportExcel">
                            <i class="fa fa-file-excel-o me-1"></i> Export Excel (CSV)
                        </button>

                        <!-- PDF DOWNLOAD -->
                        <button type="submit"
                                class="btn btn-danger btn-sm px-3 shadow-sm"
                                asp-action="GeneratePDF"
                                formtarget="_blank">
                            <i class="fa fa-file-pdf-o me-1"></i> Open / Print PDF
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- ON SCREEN REPORT PREVIEW -->
    <div id="reportCard" class="card shadow border-0" style="display:none;">
        <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center py-2">
            <h5 class="mb-0 fs-6"><i class="fa fa-file-text-o me-2"></i> Report Preview</h5>
            <button type="button" class="btn btn-sm btn-outline-light" onclick="$('#reportCard').hide()">
                <i class="fa fa-times"></i> Close
            </button>
        </div>

        <!-- LOADER -->
        <div id="reportLoader" style="display:none; padding:40px; text-align:center;">
            <div class="spinner-border text-warning" role="status" style="width: 3rem; height: 3rem;">
                <span class="visually-hidden">Loading...</span>
            </div>
            <div class="mt-3 fw-bold text-muted">Generating commission report, please wait...</div>
        </div>

        <!-- REPORT IFRAME -->
        <div class="card-body p-0">
            <iframe id="reportFrame"
                    style="width:100%; height:750px; border:none; display:none;"></iframe>
        </div>
    </div>

</div>

@section Scripts {
    <script>
        function loadOnScreenReport() {
            var fromDate = $('input[name="fromDate"]').val();
            var toDate = $('input[name="toDate"]').val();
            var partyCode = $('input[name="partyCode"]').val() || '';
            var reportType = $('#reportType').val() || 'Godown';

            if (fromDate && toDate && fromDate > toDate) {
                alert("From Date cannot be greater than To Date.");
                return;
            }

            $('#reportCard').show();
            $('#reportLoader').show();
            $('#reportFrame').hide();

            // Smooth scroll down to preview
            $('html, body').animate({
                scrollTop: $("#reportCard").offset().top - 20
            }, 400);

            var url = '@Url.Action("OnScreenReport", "CommReport")'
                + '?fromDate=' + encodeURIComponent(fromDate)
                + '&toDate=' + encodeURIComponent(toDate)
                + '&partyCode=' + encodeURIComponent(partyCode)
                + '&reportType=' + encodeURIComponent(reportType);

            $('#reportFrame').off('load');
            $('#reportFrame').attr('src', url);

            $('#reportFrame').on('load', function () {
                $('#reportLoader').hide();
                $('#reportFrame').show();
            });
        }
    </script>
}
