<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2008/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <Body>
    <ReportItems>
      <!-- 1. Report Title -->
      <Textbox Name="TxtTitle">
        <CanGrow>true</CanGrow>
        <KeepTogether>true</KeepTogether>
        <Paragraphs>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>Adda Commission Report (commreport_all12)</Value>
                <Style>
                  <FontSize>18pt</FontSize>
                  <FontWeight>Bold</FontWeight>
                </Style>
              </TextRun>
            </TextRuns>
            <Style>
              <TextAlign>Center</TextAlign>
            </Style>
          </Paragraph>
        </Paragraphs>
        <rd:DefaultName>TxtTitle</rd:DefaultName>
        <Top>0.1in</Top>
        <Left>0.6in</Left>
        <Height>0.35in</Height>
        <Width>11.8in</Width>
        <Style>
          <Border>
            <Style>None</Style>
          </Border>
          <PaddingLeft>2pt</PaddingLeft>
          <PaddingRight>2pt</PaddingRight>
          <PaddingTop>2pt</PaddingTop>
          <PaddingBottom>2pt</PaddingBottom>
        </Style>
      </Textbox>

      <!-- 2. Company Name -->
      <Textbox Name="TxtCompanyName">
        <CanGrow>true</CanGrow>
        <KeepTogether>true</KeepTogether>
        <Paragraphs>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>=First(Fields!CompanyName.Value)</Value>
                <Style>
                  <FontSize>12pt</FontSize>
                  <FontWeight>Bold</FontWeight>
                </Style>
              </TextRun>
            </TextRuns>
            <Style>
              <TextAlign>Center</TextAlign>
            </Style>
          </Paragraph>
        </Paragraphs>
        <rd:DefaultName>TxtCompanyName</rd:DefaultName>
        <Top>0.45in</Top>
        <Left>0.6in</Left>
        <Height>0.25in</Height>
        <Width>11.8in</Width>
        <ZIndex>1</ZIndex>
        <Style>
          <Border>
            <Style>None</Style>
          </Border>
          <PaddingLeft>2pt</PaddingLeft>
          <PaddingRight>2pt</PaddingRight>
          <PaddingTop>2pt</PaddingTop>
          <PaddingBottom>2pt</PaddingBottom>
        </Style>
      </Textbox>

      <!-- 3. Date Range -->
      <Textbox Name="TxtDateRange">
        <CanGrow>true</CanGrow>
        <KeepTogether>true</KeepTogether>
        <Paragraphs>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>="From: " &amp; IIf(IsNothing(First(Fields!FromDate.Value)), "", Format(First(Fields!FromDate.Value), "dd-MM-yyyy")) &amp; "    To: " &amp; IIf(IsNothing(First(Fields!ToDate.Value)), "", Format(First(Fields!ToDate.Value), "dd-MM-yyyy"))</Value>
                <Style>
                  <FontSize>9.5pt</FontSize>
                  <FontWeight>Bold</FontWeight>
                </Style>
              </TextRun>
            </TextRuns>
            <Style>
              <TextAlign>Center</TextAlign>
            </Style>
          </Paragraph>
        </Paragraphs>
        <rd:DefaultName>TxtDateRange</rd:DefaultName>
        <Top>0.72in</Top>
        <Left>0.6in</Left>
        <Height>0.25in</Height>
        <Width>11.8in</Width>
        <ZIndex>2</ZIndex>
        <Style>
          <Border>
            <Style>None</Style>
          </Border>
          <PaddingLeft>2pt</PaddingLeft>
          <PaddingRight>2pt</PaddingRight>
          <PaddingTop>2pt</PaddingTop>
          <PaddingBottom>2pt</PaddingBottom>
        </Style>
      </Textbox>

      <!-- 4. Data Tablix -->
      <Tablix Name="TablixCommReport">
        <TablixBody>
          <TablixColumns>
