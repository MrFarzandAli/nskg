            <!-- 5. Amount -->
            <TablixColumn>
              <Width>0.85in</Width>
            </TablixColumn>
            <!-- 6. VehicleNo -->
            <TablixColumn>
              <Width>0.8in</Width>
            </TablixColumn>
            <!-- 7. DrAmt -->
            <TablixColumn>
              <Width>0.8in</Width>
            </TablixColumn>
            <!-- 8. CrAmt -->
            <TablixColumn>
              <Width>0.8in</Width>
            </TablixColumn>
            <!-- 9. DeliveryAmt -->
            <TablixColumn>
              <Width>0.7in</Width>
