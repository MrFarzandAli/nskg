            </TablixColumn>
            <!-- 14. PartyCode -->
            <TablixColumn>
              <Width>0.7in</Width>
            </TablixColumn>
            <!-- 15. Pay -->
            <TablixColumn>
              <Width>0.6in</Width>
            </TablixColumn>
            <!-- 16. Qty -->
            <TablixColumn>
              <Width>0.5in</Width>
            </TablixColumn>
          </TablixColumns>
          <TablixRows>
            <!-- Header Row (Height: 0.25in) -->
            <TablixRow>
              <Height>0.25in</Height>
              <TablixCells>
                <!-- 1. VoDate Header -->
