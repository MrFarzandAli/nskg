<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2008/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <Body>
    <ReportItems>
      <!-- Main Data Table / Grid -->
      <Tablix Name="TablixStationLedger">
        <TablixBody>
          <TablixColumns>
            <!-- 1. Doc.Date -->
            <TablixColumn>
              <Width>0.65in</Width>
            </TablixColumn>
            <!-- 2. Doc. # -->
            <TablixColumn>
              <Width>0.50in</Width>
            </TablixColumn>
            <!-- 3. Typ -->
            <TablixColumn>
              <Width>0.35in</Width>
            </TablixColumn>
            <!-- 4. Comm -->
            <TablixColumn>
              <Width>0.45in</Width>
            </TablixColumn>
            <!-- 5. Vehicle No -->
            <TablixColumn>
              <Width>0.95in</Width>
            </TablixColumn>
            <!-- 6. Station -->
            <TablixColumn>
              <Width>1.05in</Width>
            </TablixColumn>
            <!-- 7. Narration -->
            <TablixColumn>
              <Width>1.40in</Width>
            </TablixColumn>
            <!-- 8. Comapny -->
            <TablixColumn>
              <Width>0.60in</Width>
            </TablixColumn>
            <!-- 9. Delivery AMT -->
            <TablixColumn>
              <Width>0.85in</Width>
            </TablixColumn>
            <!-- 10. 6% Delivery -->
            <TablixColumn>
              <Width>0.85in</Width>
            </TablixColumn>
            <!-- 11. DEBIT -->
            <TablixColumn>
              <Width>0.95in</Width>
            </TablixColumn>
            <!-- 12. CREDIT -->
            <TablixColumn>
              <Width>0.95in</Width>
            </TablixColumn>
            <!-- 13. BALANCE -->
            <TablixColumn>
              <Width>1.05in</Width>
            </TablixColumn>
          </TablixColumns>

          <TablixRows>
            <!-- Header Row -->
            <TablixRow>
              <Height>0.24in</Height>
              <TablixCells>
                <!-- 1. Doc.Date -->
                <TablixCell>
                  <CellContents>
                    <Textbox Name="HdrDocDate">
                      <Paragraphs>
                        <Paragraph>
                          <TextRuns><TextRun><Value>Doc.Date</Value><Style><FontFamily>Arial</FontFamily><FontSize>7.5pt</FontSize><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns>
                          <Style><TextAlign>Center</TextAlign></Style>
                        </Paragraph>
                      </Paragraphs>
                      <Style>
                        <Border><Color>Black</Color><Style>Solid</Style><Width>0.5pt</Width></Border>
                        <PaddingLeft>1pt</PaddingLeft><PaddingRight>1pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom>
                      </Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>

                <!-- 2. Doc. # -->
                <TablixCell>
                  <CellContents>
                    <Textbox Name="HdrDocNo">
                      <Paragraphs>
                        <Paragraph>
                          <TextRuns><TextRun><Value>Doc. #</Value><Style><FontFamily>Arial</FontFamily><FontSize>7.5pt</FontSize><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns>
                          <Style><TextAlign>Center</TextAlign></Style>
                        </Paragraph>
                      </Paragraphs>
                      <Style>
                        <Border><Color>Black</Color><Style>Solid</Style><Width>0.5pt</Width></Border>
                        <PaddingLeft>1pt</PaddingLeft><PaddingRight>1pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom>
                      </Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>

                <!-- 3. Typ -->
                <TablixCell>
                  <CellContents>
                    <Textbox Name="HdrTyp">
                      <Paragraphs>
                        <Paragraph>
                          <TextRuns><TextRun><Value>Typ</Value><Style><FontFamily>Arial</FontFamily><FontSize>7.5pt</FontSize><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns>
                          <Style><TextAlign>Center</TextAlign></Style>
                        </Paragraph>
                      </Paragraphs>
                      <Style>
                        <Border><Color>Black</Color><Style>Solid</Style><Width>0.5pt</Width></Border>
                        <PaddingLeft>1pt</PaddingLeft><PaddingRight>1pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom>
                      </Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>

                <!-- 4. Comm -->
                <TablixCell>
                  <CellContents>
                    <Textbox Name="HdrComm">
                      <Paragraphs>
                        <Paragraph>
                          <TextRuns><TextRun><Value>Comm</Value><Style><FontFamily>Arial</FontFamily><FontSize>7.5pt</FontSize><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns>
                          <Style><TextAlign>Center</TextAlign></Style>
                        </Paragraph>
                      </Paragraphs>
                      <Style>
                        <Border><Color>Black</Color><Style>Solid</Style><Width>0.5pt</Width></Border>
                        <PaddingLeft>1pt</PaddingLeft><PaddingRight>1pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom>
                      </Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>

                <!-- 5. Vehicle No -->
                <TablixCell>
                  <CellContents>
                    <Textbox Name="HdrVehicleNo">
                      <Paragraphs>
                        <Paragraph>
                          <TextRuns><TextRun><Value>Vehicle No</Value><Style><FontFamily>Arial</FontFamily><FontSize>7.5pt</FontSize><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns>
                          <Style><TextAlign>Center</TextAlign></Style>
                        </Paragraph>
                      </Paragraphs>
                      <Style>
                        <Border><Color>Black</Color><Style>Solid</Style><Width>0.5pt</Width></Border>
                        <PaddingLeft>1pt</PaddingLeft><PaddingRight>1pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom>
                      </Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>

                <!-- 6. Station -->
                <TablixCell>
                  <CellContents>
                    <Textbox Name="HdrStation">
                      <Paragraphs>
                        <Paragraph>
                          <TextRuns><TextRun><Value>Station</Value><Style><FontFamily>Arial</FontFamily><FontSize>7.5pt</FontSize><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns>
                          <Style><TextAlign>Center</TextAlign></Style>
                        </Paragraph>
                      </Paragraphs>
                      <Style>
                        <Border><Color>Black</Color><Style>Solid</Style><Width>0.5pt</Width></Border>
                        <PaddingLeft>1pt</PaddingLeft><PaddingRight>1pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom>
                      </Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>

                <!-- 7. Narration -->
                <TablixCell>
                  <CellContents>
                    <Textbox Name="HdrNarration">
                      <Paragraphs>
                        <Paragraph>
                          <TextRuns><TextRun><Value>Narration</Value><Style><FontFamily>Arial</FontFamily><FontSize>7.5pt</FontSize><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns>
                          <Style><TextAlign>Center</TextAlign></Style>
                        </Paragraph>
                      </Paragraphs>
                      <Style>
                        <Border><Color>Black</Color><Style>Solid</Style><Width>0.5pt</Width></Border>
                        <PaddingLeft>1pt</PaddingLeft><PaddingRight>1pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom>
                      </Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>

                <!-- 8. Comapny -->
                <TablixCell>
                  <CellContents>
                    <Textbox Name="HdrCompany">
                      <Paragraphs>
                        <Paragraph>
                          <TextRuns><TextRun><Value>Comapny</Value><Style><FontFamily>Arial</FontFamily><FontSize>7.5pt</FontSize><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns>
                          <Style><TextAlign>Center</TextAlign></Style>
                        </Paragraph>
                      </Paragraphs>
                      <Style>
                        <Border><Color>Black</Color><Style>Solid</Style><Width>0.5pt</Width></Border>
                        <PaddingLeft>1pt</PaddingLeft><PaddingRight>1pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom>
                      </Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>

                <!-- 9. Delivery AMT -->
                <TablixCell>
                  <CellContents>
                    <Textbox Name="HdrDeliveryAmt">
                      <Paragraphs>
                        <Paragraph>
                          <TextRuns><TextRun><Value>Delivery AMT</Value><Style><FontFamily>Arial</FontFamily><FontSize>7.5pt</FontSize><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns>
                          <Style><TextAlign>Center</TextAlign></Style>
                        </Paragraph>
                      </Paragraphs>
                      <Style>
                        <Border><Color>Black</Color><Style>Solid</Style><Width>0.5pt</Width></Border>
                        <PaddingLeft>1pt</PaddingLeft><PaddingRight>1pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom>
                      </Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>

                <!-- 10. 6% Delivery -->
                <TablixCell>
                  <CellContents>
                    <Textbox Name="HdrDeliveryAmt2">
                      <Paragraphs>
                        <Paragraph>
                          <TextRuns><TextRun><Value>6% Delivery</Value><Style><FontFamily>Arial</FontFamily><FontSize>7.5pt</FontSize><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns>
                          <Style><TextAlign>Center</TextAlign></Style>
                        </Paragraph>
                      </Paragraphs>
                      <Style>
                        <Border><Color>Black</Color><Style>Solid</Style><Width>0.5pt</Width></Border>
                        <PaddingLeft>1pt</PaddingLeft><PaddingRight>1pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom>
                      </Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>

                <!-- 11. DEBIT -->
                <TablixCell>
                  <CellContents>
                    <Textbox Name="HdrDebit">
                      <Paragraphs>
                        <Paragraph>
                          <TextRuns><TextRun><Value>D E B I T</Value><Style><FontFamily>Arial</FontFamily><FontSize>7.5pt</FontSize><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns>
                          <Style><TextAlign>Center</TextAlign></Style>
                        </Paragraph>
                      </Paragraphs>
                      <Style>
                        <Border><Color>Black</Color><Style>Solid</Style><Width>0.5pt</Width></Border>
                        <PaddingLeft>1pt</PaddingLeft><PaddingRight>1pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom>
                      </Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>

                <!-- 12. CREDIT -->
                <TablixCell>
                  <CellContents>
                    <Textbox Name="HdrCredit">
                      <Paragraphs>
                        <Paragraph>
                          <TextRuns><TextRun><Value>C R E D I T</Value><Style><FontFamily>Arial</FontFamily><FontSize>7.5pt</FontSize><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns>
                          <Style><TextAlign>Center</TextAlign></Style>
                        </Paragraph>
                      </Paragraphs>
                      <Style>
                        <Border><Color>Black</Color><Style>Solid</Style><Width>0.5pt</Width></Border>
                        <PaddingLeft>1pt</PaddingLeft><PaddingRight>1pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom>
                      </Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>

                <!-- 13. BALANCE -->
                <TablixCell>
                  <CellContents>
                    <Textbox Name="HdrBalance">
                      <Paragraphs>
                        <Paragraph>
                          <TextRuns><TextRun><Value>B A L A N C E</Value><Style><FontFamily>Arial</FontFamily><FontSize>7.5pt</FontSize><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns>
                          <Style><TextAlign>Center</TextAlign></Style>
                        </Paragraph>
                      </Paragraphs>
                      <Style>
                        <Border><Color>Black</Color><Style>Solid</Style><Width>0.5pt</Width></Border>
                        <PaddingLeft>1pt</PaddingLeft><PaddingRight>1pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom>
                      </Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>
              </TablixCells>
            </TablixRow>

            <!-- Data Detail Row -->
            <TablixRow>
              <Height>0.20in</Height>
              <TablixCells>
                <!-- 1. Doc.Date -->
                <TablixCell>
                  <CellContents>
                    <Textbox Name="ValDocDate">
                      <Paragraphs>
                        <Paragraph>
                          <TextRuns><TextRun><Value>=IIf(Fields!SortOrder.Value = 0, "", IIf(IsNothing(Fields!DocDate.Value), "", Format(Fields!DocDate.Value, "dd-MM-yy")))</Value><Style><FontFamily>Arial</FontFamily><FontSize>7.5pt</FontSize></Style></TextRun></TextRuns>
                          <Style><TextAlign>Center</TextAlign></Style>
                        </Paragraph>
                      </Paragraphs>
                      <Style>
                        <Border><Color>Black</Color><Style>Solid</Style><Width>0.5pt</Width></Border>
                        <PaddingLeft>1pt</PaddingLeft><PaddingRight>1pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom>
                      </Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>

                <!-- 2. Doc. # -->
                <TablixCell>
                  <CellContents>
                    <Textbox Name="ValDocNo">
                      <Paragraphs>
                        <Paragraph>
                          <TextRuns><TextRun><Value>=IIf(Fields!SortOrder.Value = 0, "", Fields!DocNo.Value)</Value><Style><FontFamily>Arial</FontFamily><FontSize>7.5pt</FontSize></Style></TextRun></TextRuns>
                          <Style><TextAlign>Center</TextAlign></Style>
                        </Paragraph>
                      </Paragraphs>
                      <Style>
                        <Border><Color>Black</Color><Style>Solid</Style><Width>0.5pt</Width></Border>
                        <PaddingLeft>1pt</PaddingLeft><PaddingRight>1pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom>
                      </Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>

                <!-- 3. Typ -->
                <TablixCell>
                  <CellContents>
                    <Textbox Name="ValVotype">
                      <Paragraphs>
                        <Paragraph>
                          <TextRuns><TextRun><Value>=IIf(Fields!SortOrder.Value = 0, "", Fields!Votype.Value)</Value><Style><FontFamily>Arial</FontFamily><FontSize>7.5pt</FontSize></Style></TextRun></TextRuns>
                          <Style><TextAlign>Center</TextAlign></Style>
                        </Paragraph>
                      </Paragraphs>
                      <Style>
                        <Border><Color>Black</Color><Style>Solid</Style><Width>0.5pt</Width></Border>
                        <PaddingLeft>1pt</PaddingLeft><PaddingRight>1pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom>
                      </Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>

                <!-- 4. Comm -->
                <TablixCell>
                  <CellContents>
                    <Textbox Name="ValComm">
                      <Paragraphs>
                        <Paragraph>
                          <TextRuns><TextRun><Value>=IIf(Fields!SortOrder.Value = 0, "", Fields!Comm.Value)</Value><Style><FontFamily>Arial</FontFamily><FontSize>7.5pt</FontSize></Style></TextRun></TextRuns>
                          <Style><TextAlign>Center</TextAlign></Style>
                        </Paragraph>
                      </Paragraphs>
                      <Style>
                        <Border><Color>Black</Color><Style>Solid</Style><Width>0.5pt</Width></Border>
                        <PaddingLeft>1pt</PaddingLeft><PaddingRight>1pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom>
                      </Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>

                <!-- 5. Vehicle No / Opening Balance text -->
                <TablixCell>
                  <CellContents>
                    <Textbox Name="ValVehicleNo">
                      <Paragraphs>
                        <Paragraph>
                          <TextRuns><TextRun><Value>=IIf(Fields!SortOrder.Value = 0, "Balance Brought Farword", Fields!VehicleNo.Value)</Value><Style><FontFamily>Arial</FontFamily><FontSize>7.5pt</FontSize><FontWeight>=IIf(Fields!SortOrder.Value = 0, "Bold", "Normal")</FontWeight></Style></TextRun></TextRuns>
                          <Style><TextAlign>=IIf(Fields!SortOrder.Value = 0, "Left", "Left")</TextAlign></Style>
                        </Paragraph>
                      </Paragraphs>
                      <Style>
                        <Border><Color>Black</Color><Style>Solid</Style><Width>0.5pt</Width></Border>
                        <PaddingLeft>2pt</PaddingLeft><PaddingRight>1pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom>
                      </Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>

                <!-- 6. Station -->
                <TablixCell>
                  <CellContents>
                    <Textbox Name="ValStation">
                      <Paragraphs>
                        <Paragraph>
                          <TextRuns><TextRun><Value>=IIf(Fields!SortOrder.Value = 0, "", Fields!Station.Value)</Value><Style><FontFamily>Arial</FontFamily><FontSize>7.5pt</FontSize></Style></TextRun></TextRuns>
                          <Style><TextAlign>Left</TextAlign></Style>
                        </Paragraph>
                      </Paragraphs>
                      <Style>
                        <Border><Color>Black</Color><Style>Solid</Style><Width>0.5pt</Width></Border>
                        <PaddingLeft>2pt</PaddingLeft><PaddingRight>1pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom>
                      </Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>

                <!-- 7. Narration -->
                <TablixCell>
                  <CellContents>
                    <Textbox Name="ValNarration">
                      <Paragraphs>
                        <Paragraph>
                          <TextRuns><TextRun><Value>=IIf(Fields!SortOrder.Value = 0, "", Fields!Narration.Value)</Value><Style><FontFamily>Arial</FontFamily><FontSize>7.5pt</FontSize></Style></TextRun></TextRuns>
                          <Style><TextAlign>Left</TextAlign></Style>
                        </Paragraph>
                      </Paragraphs>
                      <Style>
                        <Border><Color>Black</Color><Style>Solid</Style><Width>0.5pt</Width></Border>
                        <PaddingLeft>2pt</PaddingLeft><PaddingRight>1pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom>
                      </Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>

                <!-- 8. Comapny -->
                <TablixCell>
                  <CellContents>
                    <Textbox Name="ValCompany">
                      <Paragraphs>
                        <Paragraph>
                          <TextRuns><TextRun><Value>=IIf(Fields!SortOrder.Value = 0, "", Fields!CompanyCode.Value)</Value><Style><FontFamily>Arial</FontFamily><FontSize>7.5pt</FontSize></Style></TextRun></TextRuns>
                          <Style><TextAlign>Center</TextAlign></Style>
                        </Paragraph>
                      </Paragraphs>
                      <Style>
                        <Border><Color>Black</Color><Style>Solid</Style><Width>0.5pt</Width></Border>
                        <PaddingLeft>1pt</PaddingLeft><PaddingRight>1pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom>
                      </Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>

                <!-- 9. Delivery AMT -->
                <TablixCell>
                  <CellContents>
                    <Textbox Name="ValDeliveryAmt">
                      <Paragraphs>
                        <Paragraph>
                          <TextRuns><TextRun><Value>=IIf(Fields!SortOrder.Value = 0 Or IsNothing(Fields!DeliveryAmt.Value) Or Fields!DeliveryAmt.Value = 0, "", Format(Fields!DeliveryAmt.Value, "#,##0"))</Value><Style><FontFamily>Arial</FontFamily><FontSize>7.5pt</FontSize></Style></TextRun></TextRuns>
                          <Style><TextAlign>Right</TextAlign></Style>
                        </Paragraph>
                      </Paragraphs>
                      <Style>
                        <Border><Color>Black</Color><Style>Solid</Style><Width>0.5pt</Width></Border>
                        <PaddingLeft>1pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom>
                      </Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>

                <!-- 10. 6% Delivery -->
                <TablixCell>
                  <CellContents>
                    <Textbox Name="ValDeliveryAmt2">
                      <Paragraphs>
                        <Paragraph>
                          <TextRuns><TextRun><Value>=IIf(Fields!SortOrder.Value = 0 Or IsNothing(Fields!DeliveryAmt2.Value) Or Fields!DeliveryAmt2.Value = 0, "", Format(Fields!DeliveryAmt2.Value, "#,##0"))</Value><Style><FontFamily>Arial</FontFamily><FontSize>7.5pt</FontSize></Style></TextRun></TextRuns>
                          <Style><TextAlign>Right</TextAlign></Style>
                        </Paragraph>
                      </Paragraphs>
                      <Style>
                        <Border><Color>Black</Color><Style>Solid</Style><Width>0.5pt</Width></Border>
                        <PaddingLeft>1pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom>
                      </Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>

                <!-- 11. DEBIT -->
                <TablixCell>
                  <CellContents>
                    <Textbox Name="ValDebit">
                      <Paragraphs>
                        <Paragraph>
                          <TextRuns><TextRun><Value>=IIf(Fields!SortOrder.Value = 0 Or IsNothing(Fields!Debit.Value) Or Fields!Debit.Value = 0, "", Format(Fields!Debit.Value, "#,##0"))</Value><Style><FontFamily>Arial</FontFamily><FontSize>7.5pt</FontSize></Style></TextRun></TextRuns>
                          <Style><TextAlign>Right</TextAlign></Style>
                        </Paragraph>
                      </Paragraphs>
                      <Style>
                        <Border><Color>Black</Color><Style>Solid</Style><Width>0.5pt</Width></Border>
                        <PaddingLeft>1pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom>
                      </Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>

                <!-- 12. CREDIT -->
                <TablixCell>
                  <CellContents>
                    <Textbox Name="ValCredit">
                      <Paragraphs>
                        <Paragraph>
                          <TextRuns><TextRun><Value>=IIf(Fields!SortOrder.Value = 0 Or IsNothing(Fields!Credit.Value) Or Fields!Credit.Value = 0, "", Format(Fields!Credit.Value, "#,##0"))</Value><Style><FontFamily>Arial</FontFamily><FontSize>7.5pt</FontSize></Style></TextRun></TextRuns>
                          <Style><TextAlign>Right</TextAlign></Style>
                        </Paragraph>
                      </Paragraphs>
                      <Style>
                        <Border><Color>Black</Color><Style>Solid</Style><Width>0.5pt</Width></Border>
                        <PaddingLeft>1pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom>
                      </Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>

                <!-- 13. BALANCE -->
                <TablixCell>
                  <CellContents>
                    <Textbox Name="ValBalance">
                      <Paragraphs>
                        <Paragraph>
                          <TextRuns><TextRun><Value>=Format(Fields!Balance.Value, "#,##0")</Value><Style><FontFamily>Arial</FontFamily><FontSize>7.5pt</FontSize><FontWeight>=IIf(Fields!SortOrder.Value = 0, "Bold", "Normal")</FontWeight></Style></TextRun></TextRuns>
                          <Style><TextAlign>Right</TextAlign></Style>
                        </Paragraph>
                      </Paragraphs>
                      <Style>
                        <Border><Color>Black</Color><Style>Solid</Style><Width>0.5pt</Width></Border>
                        <PaddingLeft>1pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom>
                      </Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>
              </TablixCells>
            </TablixRow>

            <!-- Table Footer Row: GRAND TOTAL -->
            <TablixRow>
              <Height>0.24in</Height>
              <TablixCells>
                <!-- 1. DocDate -->
                <TablixCell>
                  <CellContents>
                    <Textbox Name="TotDocDate">
                      <Paragraphs><Paragraph><TextRuns><TextRun><Value /></TextRun></TextRuns></Paragraph></Paragraphs>
                      <Style><Border><Color>Black</Color><Style>Solid</Style><Width>0.5pt</Width></Border></Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>

                <!-- 2. DocNo -->
                <TablixCell>
                  <CellContents>
                    <Textbox Name="TotDocNo">
                      <Paragraphs><Paragraph><TextRuns><TextRun><Value /></TextRun></TextRuns></Paragraph></Paragraphs>
                      <Style><Border><Color>Black</Color><Style>Solid</Style><Width>0.5pt</Width></Border></Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>

                <!-- 3. Typ -->
                <TablixCell>
                  <CellContents>
                    <Textbox Name="TotTyp">
                      <Paragraphs><Paragraph><TextRuns><TextRun><Value /></TextRun></TextRuns></Paragraph></Paragraphs>
                      <Style><Border><Color>Black</Color><Style>Solid</Style><Width>0.5pt</Width></Border></Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>

                <!-- 4. Comm -->
                <TablixCell>
                  <CellContents>
                    <Textbox Name="TotComm">
                      <Paragraphs><Paragraph><TextRuns><TextRun><Value /></TextRun></TextRuns></Paragraph></Paragraphs>
                      <Style><Border><Color>Black</Color><Style>Solid</Style><Width>0.5pt</Width></Border></Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>

                <!-- 5. VehicleNo -->
                <TablixCell>
                  <CellContents>
                    <Textbox Name="TotVehicleNo">
                      <Paragraphs><Paragraph><TextRuns><TextRun><Value /></TextRun></TextRuns></Paragraph></Paragraphs>
                      <Style><Border><Color>Black</Color><Style>Solid</Style><Width>0.5pt</Width></Border></Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>

                <!-- 6. Station -->
                <TablixCell>
                  <CellContents>
                    <Textbox Name="TotStation">
                      <Paragraphs><Paragraph><TextRuns><TextRun><Value /></TextRun></TextRuns></Paragraph></Paragraphs>
                      <Style><Border><Color>Black</Color><Style>Solid</Style><Width>0.5pt</Width></Border></Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>

                <!-- 7. Narration / Grand Total Label -->
                <TablixCell>
                  <CellContents>
                    <Textbox Name="TotGrandLabel">
                      <Paragraphs>
                        <Paragraph>
                          <TextRuns><TextRun><Value>GRAND TOTAL...........</Value><Style><FontFamily>Arial</FontFamily><FontSize>8pt</FontSize><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns>
                          <Style><TextAlign>Right</TextAlign></Style>
                        </Paragraph>
                      </Paragraphs>
                      <Style>
                        <Border><Color>Black</Color><Style>Solid</Style><Width>0.5pt</Width></Border>
                        <PaddingLeft>1pt</PaddingLeft><PaddingRight>1pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom>
                      </Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>

                <!-- 8. Company -->
                <TablixCell>
                  <CellContents>
                    <Textbox Name="TotCompany">
                      <Paragraphs><Paragraph><TextRuns><TextRun><Value /></TextRun></TextRuns></Paragraph></Paragraphs>
                      <Style><Border><Color>Black</Color><Style>Solid</Style><Width>0.5pt</Width></Border></Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>

                <!-- 9. Delivery AMT -->
                <TablixCell>
                  <CellContents>
                    <Textbox Name="TotDeliveryAmt">
                      <Paragraphs><Paragraph><TextRuns><TextRun><Value /></TextRun></TextRuns></Paragraph></Paragraphs>
                      <Style><Border><Color>Black</Color><Style>Solid</Style><Width>0.5pt</Width></Border></Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>

                <!-- 10. 6% Delivery -->
                <TablixCell>
                  <CellContents>
                    <Textbox Name="TotDeliveryAmt2">
                      <Paragraphs><Paragraph><TextRuns><TextRun><Value /></TextRun></TextRuns></Paragraph></Paragraphs>
                      <Style><Border><Color>Black</Color><Style>Solid</Style><Width>0.5pt</Width></Border></Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>

                <!-- 11. Total Debit -->
                <TablixCell>
                  <CellContents>
                    <Textbox Name="TotalDebit">
                      <Paragraphs>
                        <Paragraph>
                          <TextRuns><TextRun><Value>=Format(Sum(Fields!Debit.Value), "#,##0")</Value><Style><FontFamily>Arial</FontFamily><FontSize>8pt</FontSize><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns>
                          <Style><TextAlign>Right</TextAlign></Style>
                        </Paragraph>
                      </Paragraphs>
                      <Style>
                        <Border><Color>Black</Color><Style>Solid</Style><Width>0.5pt</Width></Border>
                        <PaddingLeft>1pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom>
                      </Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>

                <!-- 12. Total Credit -->
                <TablixCell>
                  <CellContents>
                    <Textbox Name="TotalCredit">
                      <Paragraphs>
                        <Paragraph>
                          <TextRuns><TextRun><Value>=Format(Sum(Fields!Credit.Value), "#,##0")</Value><Style><FontFamily>Arial</FontFamily><FontSize>8pt</FontSize><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns>
                          <Style><TextAlign>Right</TextAlign></Style>
                        </Paragraph>
                      </Paragraphs>
                      <Style>
                        <Border><Color>Black</Color><Style>Solid</Style><Width>0.5pt</Width></Border>
                        <PaddingLeft>1pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom>
                      </Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>

                <!-- 13. Final Balance -->
                <TablixCell>
                  <CellContents>
                    <Textbox Name="TotalBalance">
                      <Paragraphs>
                        <Paragraph>
                          <TextRuns><TextRun><Value>=Format(Last(Fields!Balance.Value), "#,##0")</Value><Style><FontFamily>Arial</FontFamily><FontSize>8pt</FontSize><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns>
                          <Style><TextAlign>Right</TextAlign></Style>
                        </Paragraph>
                      </Paragraphs>
                      <Style>
                        <Border><Color>Black</Color><Style>Solid</Style><Width>0.5pt</Width></Border>
                        <PaddingLeft>1pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom>
                      </Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>
              </TablixCells>
            </TablixRow>
          </TablixRows>
