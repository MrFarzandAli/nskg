<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2008/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <Body>
    <ReportItems>
      <!-- Main Data Table / Grid -->
      <Tablix Name="TablixLedger">
        <TablixBody>
          <TablixColumns>
            <!-- 1. Doc.Date -->
            <TablixColumn>
              <Width>0.70in</Width>
            </TablixColumn>
            <!-- 2. Doc. # -->
            <TablixColumn>
              <Width>0.60in</Width>
            </TablixColumn>
            <!-- 3. Typ -->
            <TablixColumn>
              <Width>0.40in</Width>
            </TablixColumn>
            <!-- 4. BilltiNo -->
            <TablixColumn>
              <Width>0.60in</Width>
            </TablixColumn>
            <!-- 5. Bill. No -->
            <TablixColumn>
              <Width>0.55in</Width>
            </TablixColumn>
            <!-- 6. Vehicle No -->
            <TablixColumn>
              <Width>1.25in</Width>
            </TablixColumn>
            <!-- 7. Station -->
            <TablixColumn>
              <Width>1.25in</Width>
            </TablixColumn>
            <!-- 8. Party name / Item -->
            <TablixColumn>
              <Width>1.45in</Width>
            </TablixColumn>
            <!-- 9. Qty -->
            <TablixColumn>
              <Width>0.45in</Width>
            </TablixColumn>
            <!-- 9.5 Initials -->
            <TablixColumn>
              <Width>0.55in</Width>
            </TablixColumn>
            <!-- 10. DEBIT -->
            <TablixColumn>
              <Width>1.05in</Width>
            </TablixColumn>
            <!-- 11. CREDIT -->
            <TablixColumn>
              <Width>1.05in</Width>
            </TablixColumn>
            <!-- 12. BALANCE -->
            <TablixColumn>
              <Width>1.15in</Width>
            </TablixColumn>
          </TablixColumns>

          <TablixRows>
            <!-- Header Row -->
            <TablixRow>
              <Height>0.25in</Height>
              <TablixCells>
                <TablixCell>
                  <CellContents>
                    <Textbox Name="HdrDocDate">
                      <Paragraphs>
                        <Paragraph>
                          <TextRuns><TextRun><Value>Doc.Date</Value><Style><FontFamily>Arial</FontFamily><FontSize>8pt</FontSize><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns>
                          <Style><TextAlign>Center</TextAlign></Style>
                        </Paragraph>
                      </Paragraphs>
                      <Style>
                        <Border><Color>Black</Color><Style>Solid</Style><Width>0.5pt</Width></Border>
                        <PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom>
                      </Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>

                <TablixCell>
                  <CellContents>
                    <Textbox Name="HdrDocNo">
                      <Paragraphs>
                        <Paragraph>
                          <TextRuns><TextRun><Value>Doc. #</Value><Style><FontFamily>Arial</FontFamily><FontSize>8pt</FontSize><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns>
                          <Style><TextAlign>Center</TextAlign></Style>
                        </Paragraph>
                      </Paragraphs>
                      <Style>
                        <Border><Color>Black</Color><Style>Solid</Style><Width>0.5pt</Width></Border>
                        <PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom>
                      </Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>

                <TablixCell>
                  <CellContents>
                    <Textbox Name="HdrTyp">
                      <Paragraphs>
                        <Paragraph>
                          <TextRuns><TextRun><Value>Typ</Value><Style><FontFamily>Arial</FontFamily><FontSize>8pt</FontSize><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns>
                          <Style><TextAlign>Center</TextAlign></Style>
                        </Paragraph>
                      </Paragraphs>
                      <Style>
                        <Border><Color>Black</Color><Style>Solid</Style><Width>0.5pt</Width></Border>
                        <PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom>
                      </Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>

                <TablixCell>
                  <CellContents>
                    <Textbox Name="HdrBilltiNo">
                      <Paragraphs>
                        <Paragraph>
                          <TextRuns><TextRun><Value>BilltiNo</Value><Style><FontFamily>Arial</FontFamily><FontSize>8pt</FontSize><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns>
                          <Style><TextAlign>Center</TextAlign></Style>
                        </Paragraph>
                      </Paragraphs>
                      <Style>
                        <Border><Color>Black</Color><Style>Solid</Style><Width>0.5pt</Width></Border>
                        <PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom>
                      </Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>

                <TablixCell>
                  <CellContents>
                    <Textbox Name="HdrBillNo">
                      <Paragraphs>
                        <Paragraph>
                          <TextRuns><TextRun><Value>Bill. No</Value><Style><FontFamily>Arial</FontFamily><FontSize>8pt</FontSize><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns>
                          <Style><TextAlign>Center</TextAlign></Style>
                        </Paragraph>
                      </Paragraphs>
                      <Style>
                        <Border><Color>Black</Color><Style>Solid</Style><Width>0.5pt</Width></Border>
                        <PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom>
                      </Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>

                <TablixCell>
                  <CellContents>
                    <Textbox Name="HdrVehicleNo">
                      <Paragraphs>
                        <Paragraph>
                          <TextRuns><TextRun><Value>Vehicle No</Value><Style><FontFamily>Arial</FontFamily><FontSize>8pt</FontSize><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns>
                          <Style><TextAlign>Center</TextAlign></Style>
                        </Paragraph>
                      </Paragraphs>
                      <Style>
                        <Border><Color>Black</Color><Style>Solid</Style><Width>0.5pt</Width></Border>
                        <PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom>
                      </Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>

                <TablixCell>
                  <CellContents>
                    <Textbox Name="HdrStation">
                      <Paragraphs>
                        <Paragraph>
                          <TextRuns><TextRun><Value>Station</Value><Style><FontFamily>Arial</FontFamily><FontSize>8pt</FontSize><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns>
                          <Style><TextAlign>Center</TextAlign></Style>
                        </Paragraph>
                      </Paragraphs>
                      <Style>
                        <Border><Color>Black</Color><Style>Solid</Style><Width>0.5pt</Width></Border>
                        <PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom>
                      </Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>

                <TablixCell>
                  <CellContents>
                    <Textbox Name="HdrPartyItem">
                      <Paragraphs>
                        <Paragraph>
                          <TextRuns><TextRun><Value>Party name / Item</Value><Style><FontFamily>Arial</FontFamily><FontSize>8pt</FontSize><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns>
                          <Style><TextAlign>Center</TextAlign></Style>
                        </Paragraph>
                      </Paragraphs>
                      <Style>
                        <Border><Color>Black</Color><Style>Solid</Style><Width>0.5pt</Width></Border>
                        <PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom>
                      </Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>

                <TablixCell>
                  <CellContents>
                    <Textbox Name="HdrQty">
                      <Paragraphs>
                        <Paragraph>
                          <TextRuns><TextRun><Value>Qty</Value><Style><FontFamily>Arial</FontFamily><FontSize>8pt</FontSize><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns>
                          <Style><TextAlign>Center</TextAlign></Style>
                        </Paragraph>
                      </Paragraphs>
                      <Style>
                        <Border><Color>Black</Color><Style>Solid</Style><Width>0.5pt</Width></Border>
                        <PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom>
                      </Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>

                <TablixCell>
                  <CellContents>
                    <Textbox Name="HdrInitials">
                      <Paragraphs>
                        <Paragraph>
                          <TextRuns><TextRun><Value>Initials</Value><Style><FontFamily>Arial</FontFamily><FontSize>8pt</FontSize><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns>
                          <Style><TextAlign>Center</TextAlign></Style>
                        </Paragraph>
                      </Paragraphs>
                      <Style>
                        <Border><Color>Black</Color><Style>Solid</Style><Width>0.5pt</Width></Border>
                        <PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom>
                      </Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>

                <TablixCell>
                  <CellContents>
                    <Textbox Name="HdrDebit">
                      <Paragraphs>
                        <Paragraph>
                          <TextRuns><TextRun><Value>DEBIT</Value><Style><FontFamily>Arial</FontFamily><FontSize>8pt</FontSize><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns>
                          <Style><TextAlign>Center</TextAlign></Style>
                        </Paragraph>
                      </Paragraphs>
                      <Style>
                        <Border><Color>Black</Color><Style>Solid</Style><Width>0.5pt</Width></Border>
                        <PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom>
                      </Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>

                <TablixCell>
                  <CellContents>
                    <Textbox Name="HdrCredit">
                      <Paragraphs>
                        <Paragraph>
                          <TextRuns><TextRun><Value>CREDIT</Value><Style><FontFamily>Arial</FontFamily><FontSize>8pt</FontSize><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns>
                          <Style><TextAlign>Center</TextAlign></Style>
                        </Paragraph>
                      </Paragraphs>
                      <Style>
                        <Border><Color>Black</Color><Style>Solid</Style><Width>0.5pt</Width></Border>
                        <PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom>
                      </Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>

                <TablixCell>
                  <CellContents>
                    <Textbox Name="HdrBalance">
                      <Paragraphs>
                        <Paragraph>
                          <TextRuns><TextRun><Value>BALANCE</Value><Style><FontFamily>Arial</FontFamily><FontSize>8pt</FontSize><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns>
                          <Style><TextAlign>Center</TextAlign></Style>
                        </Paragraph>
                      </Paragraphs>
                      <Style>
                        <Border><Color>Black</Color><Style>Solid</Style><Width>0.5pt</Width></Border>
                        <PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom>
                      </Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>
              </TablixCells>
            </TablixRow>

            <!-- Data Detail Row -->
            <TablixRow>
              <Height>0.22in</Height>
              <TablixCells>
                <!-- Doc.Date -->
                <TablixCell>
                  <CellContents>
                    <Textbox Name="ValDocDate">
                      <Paragraphs>
                        <Paragraph>
                          <TextRuns><TextRun><Value>=IIf(IsNothing(Fields!DocDate.Value), "", Format(Fields!DocDate.Value, "dd-MM-yy"))</Value><Style><FontFamily>Arial</FontFamily><FontSize>8pt</FontSize></Style></TextRun></TextRuns>
                          <Style><TextAlign>Center</TextAlign></Style>
                        </Paragraph>
                      </Paragraphs>
                      <Style>
                        <Border><Color>Black</Color><Style>Solid</Style><Width>0.5pt</Width></Border>
                        <PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom>
                      </Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>

                <!-- Doc. # -->
                <TablixCell>
                  <CellContents>
                    <Textbox Name="ValDocNo">
                      <Paragraphs>
                        <Paragraph>
                          <TextRuns><TextRun><Value>=Fields!DocNo.Value</Value><Style><FontFamily>Arial</FontFamily><FontSize>8pt</FontSize></Style></TextRun></TextRuns>
                          <Style><TextAlign>Center</TextAlign></Style>
                        </Paragraph>
                      </Paragraphs>
                      <Style>
                        <Border><Color>Black</Color><Style>Solid</Style><Width>0.5pt</Width></Border>
                        <PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom>
                      </Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>

                <!-- Typ -->
                <TablixCell>
                  <CellContents>
                    <Textbox Name="ValVotype">
                      <Paragraphs>
                        <Paragraph>
                          <TextRuns><TextRun><Value>=Fields!Votype.Value</Value><Style><FontFamily>Arial</FontFamily><FontSize>8pt</FontSize></Style></TextRun></TextRuns>
                          <Style><TextAlign>Center</TextAlign></Style>
                        </Paragraph>
                      </Paragraphs>
                      <Style>
                        <Border><Color>Black</Color><Style>Solid</Style><Width>0.5pt</Width></Border>
                        <PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom>
                      </Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>

                <!-- BilltiNo -->
                <TablixCell>
                  <CellContents>
                    <Textbox Name="ValBilltiNo">
                      <Paragraphs>
                        <Paragraph>
                          <TextRuns><TextRun><Value>=Fields!BillTiNo.Value</Value><Style><FontFamily>Arial</FontFamily><FontSize>8pt</FontSize></Style></TextRun></TextRuns>
                          <Style><TextAlign>Center</TextAlign></Style>
                        </Paragraph>
                      </Paragraphs>
                      <Style>
                        <Border><Color>Black</Color><Style>Solid</Style><Width>0.5pt</Width></Border>
                        <PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom>
                      </Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>

                <!-- Bill. No -->
                <TablixCell>
                  <CellContents>
                    <Textbox Name="ValBilNo">
                      <Paragraphs>
                        <Paragraph>
                          <TextRuns><TextRun><Value>=Fields!BilNo.Value</Value><Style><FontFamily>Arial</FontFamily><FontSize>8pt</FontSize></Style></TextRun></TextRuns>
                          <Style><TextAlign>Center</TextAlign></Style>
                        </Paragraph>
                      </Paragraphs>
                      <Style>
                        <Border><Color>Black</Color><Style>Solid</Style><Width>0.5pt</Width></Border>
                        <PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom>
                      </Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>

                <!-- Vehicle No -->
                <TablixCell>
                  <CellContents>
                    <Textbox Name="ValVehicleNo">
                      <Paragraphs>
                        <Paragraph>
                          <TextRuns><TextRun><Value>=Fields!VehicleNo.Value</Value><Style><FontFamily>Arial</FontFamily><FontSize>8pt</FontSize><FontWeight>=IIf(Fields!SortOrder.Value = 0, "Bold", "Normal")</FontWeight></Style></TextRun></TextRuns>
                          <Style><TextAlign>Left</TextAlign></Style>
                        </Paragraph>
                      </Paragraphs>
                      <Style>
                        <Border><Color>Black</Color><Style>Solid</Style><Width>0.5pt</Width></Border>
                        <PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom>
                      </Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>

                <!-- Station -->
                <TablixCell>
                  <CellContents>
                    <Textbox Name="ValStation">
                      <Paragraphs>
                        <Paragraph>
                          <TextRuns><TextRun><Value>=Fields!Station.Value</Value><Style><FontFamily>Arial</FontFamily><FontSize>8pt</FontSize></Style></TextRun></TextRuns>
                          <Style><TextAlign>Left</TextAlign></Style>
                        </Paragraph>
                      </Paragraphs>
                      <Style>
                        <Border><Color>Black</Color><Style>Solid</Style><Width>0.5pt</Width></Border>
                        <PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom>
                      </Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>

                <!-- Party name / Item -->
                <TablixCell>
                  <CellContents>
                    <Textbox Name="ValPartyItem">
                      <Paragraphs>
                        <Paragraph>
                          <TextRuns><TextRun><Value>=Fields!IName.Value</Value><Style><FontFamily>Arial</FontFamily><FontSize>8pt</FontSize></Style></TextRun></TextRuns>
                          <Style><TextAlign>Left</TextAlign></Style>
                        </Paragraph>
                      </Paragraphs>
                      <Style>
                        <Border><Color>Black</Color><Style>Solid</Style><Width>0.5pt</Width></Border>
                        <PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom>
                      </Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>

                <!-- Qty -->
                <TablixCell>
                  <CellContents>
                    <Textbox Name="ValQty">
                      <Paragraphs>
                        <Paragraph>
                          <TextRuns><TextRun><Value>=IIf(IsNothing(Fields!Qty.Value) Or Fields!Qty.Value = 0, "", Format(Fields!Qty.Value, "#,##0"))</Value><Style><FontFamily>Arial</FontFamily><FontSize>8pt</FontSize></Style></TextRun></TextRuns>
                          <Style><TextAlign>Center</TextAlign></Style>
                        </Paragraph>
                      </Paragraphs>
                      <Style>
                        <Border><Color>Black</Color><Style>Solid</Style><Width>0.5pt</Width></Border>
                        <PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom>
                      </Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>

                <!-- Initials -->
                <TablixCell>
                  <CellContents>
                    <Textbox Name="ValInitials">
                      <Paragraphs>
                        <Paragraph>
                          <TextRuns><TextRun><Value>=Fields!Initials.Value</Value><Style><FontFamily>Arial</FontFamily><FontSize>8pt</FontSize></Style></TextRun></TextRuns>
                          <Style><TextAlign>Center</TextAlign></Style>
                        </Paragraph>
                      </Paragraphs>
                      <Style>
                        <Border><Color>Black</Color><Style>Solid</Style><Width>0.5pt</Width></Border>
                        <PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom>
                      </Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>

                <!-- DEBIT -->
                <TablixCell>
                  <CellContents>
                    <Textbox Name="ValDebit">
                      <Paragraphs>
                        <Paragraph>
                          <TextRuns><TextRun><Value>=IIf(IsNothing(Fields!Debit.Value) Or Fields!Debit.Value = 0, "", Format(Fields!Debit.Value, "#,##0.00"))</Value><Style><FontFamily>Arial</FontFamily><FontSize>8pt</FontSize></Style></TextRun></TextRuns>
                          <Style><TextAlign>Right</TextAlign></Style>
                        </Paragraph>
                      </Paragraphs>
                      <Style>
                        <Border><Color>Black</Color><Style>Solid</Style><Width>0.5pt</Width></Border>
                        <PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom>
                      </Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>

                <!-- CREDIT -->
                <TablixCell>
                  <CellContents>
                    <Textbox Name="ValCredit">
                      <Paragraphs>
                        <Paragraph>
                          <TextRuns><TextRun><Value>=IIf(IsNothing(Fields!Credit.Value) Or Fields!Credit.Value = 0, "", Format(Fields!Credit.Value, "#,##0.00"))</Value><Style><FontFamily>Arial</FontFamily><FontSize>8pt</FontSize></Style></TextRun></TextRuns>
                          <Style><TextAlign>Right</TextAlign></Style>
                        </Paragraph>
                      </Paragraphs>
                      <Style>
                        <Border><Color>Black</Color><Style>Solid</Style><Width>0.5pt</Width></Border>
                        <PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom>
                      </Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>

                <!-- BALANCE -->
                <TablixCell>
                  <CellContents>
                    <Textbox Name="ValBalance">
                      <Paragraphs>
                        <Paragraph>
                          <TextRuns><TextRun><Value>=Format(Fields!Balance.Value, "#,##0.00")</Value><Style><FontFamily>Arial</FontFamily><FontSize>8pt</FontSize><FontWeight>=IIf(Fields!SortOrder.Value = 0, "Bold", "Normal")</FontWeight></Style></TextRun></TextRuns>
                          <Style><TextAlign>Right</TextAlign></Style>
                        </Paragraph>
                      </Paragraphs>
                      <Style>
                        <Border><Color>Black</Color><Style>Solid</Style><Width>0.5pt</Width></Border>
                        <PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom>
                      </Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>
              </TablixCells>
            </TablixRow>

            <!-- Table Footer / PAGE TOTAL Row -->
            <TablixRow>
              <Height>0.25in</Height>
              <TablixCells>
                <!-- 1. DocDate -->
                <TablixCell>
                  <CellContents>
                    <Textbox Name="TotDocDate">
                      <Paragraphs>
                        <Paragraph>
                          <TextRuns><TextRun><Value>PAGE TOTAL</Value><Style><FontFamily>Arial</FontFamily><FontSize>8.5pt</FontSize><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns>
                          <Style><TextAlign>Left</TextAlign></Style>
                        </Paragraph>
                      </Paragraphs>
                      <Style>
                        <Border><Color>Black</Color><Style>Solid</Style><Width>0.5pt</Width></Border>
                        <PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom>
                      </Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>

                <!-- 2. DocNo -->
                <TablixCell>
                  <CellContents>
                    <Textbox Name="TotDocNo">
                      <Paragraphs><Paragraph><TextRuns><TextRun><Value /></TextRun></TextRuns></Paragraph></Paragraphs>
                      <Style><Border><Color>Black</Color><Style>Solid</Style><Width>0.5pt</Width></Border></Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>

                <!-- 3. Typ -->
                <TablixCell>
                  <CellContents>
                    <Textbox Name="TotTyp">
                      <Paragraphs><Paragraph><TextRuns><TextRun><Value /></TextRun></TextRuns></Paragraph></Paragraphs>
                      <Style><Border><Color>Black</Color><Style>Solid</Style><Width>0.5pt</Width></Border></Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>

                <!-- 4. BilltiNo -->
                <TablixCell>
                  <CellContents>
                    <Textbox Name="TotBilltiNo">
                      <Paragraphs><Paragraph><TextRuns><TextRun><Value /></TextRun></TextRuns></Paragraph></Paragraphs>
                      <Style><Border><Color>Black</Color><Style>Solid</Style><Width>0.5pt</Width></Border></Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>

                <!-- 5. BilNo -->
                <TablixCell>
                  <CellContents>
                    <Textbox Name="TotBilNo">
                      <Paragraphs><Paragraph><TextRuns><TextRun><Value /></TextRun></TextRuns></Paragraph></Paragraphs>
                      <Style><Border><Color>Black</Color><Style>Solid</Style><Width>0.5pt</Width></Border></Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>

                <!-- 6. VehicleNo -->
                <TablixCell>
                  <CellContents>
                    <Textbox Name="TotVehicleNo">
                      <Paragraphs><Paragraph><TextRuns><TextRun><Value /></TextRun></TextRuns></Paragraph></Paragraphs>
                      <Style><Border><Color>Black</Color><Style>Solid</Style><Width>0.5pt</Width></Border></Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>

                <!-- 7. Station -->
                <TablixCell>
                  <CellContents>
                    <Textbox Name="TotStation">
                      <Paragraphs><Paragraph><TextRuns><TextRun><Value /></TextRun></TextRuns></Paragraph></Paragraphs>
                      <Style><Border><Color>Black</Color><Style>Solid</Style><Width>0.5pt</Width></Border></Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>

                <!-- 8. IName -->
                <TablixCell>
                  <CellContents>
                    <Textbox Name="TotIName">
                      <Paragraphs><Paragraph><TextRuns><TextRun><Value /></TextRun></TextRuns></Paragraph></Paragraphs>
                      <Style><Border><Color>Black</Color><Style>Solid</Style><Width>0.5pt</Width></Border></Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>

                <!-- 9. Qty -->
                <TablixCell>
                  <CellContents>
                    <Textbox Name="TotQty">
                      <Paragraphs><Paragraph><TextRuns><TextRun><Value /></TextRun></TextRuns></Paragraph></Paragraphs>
                      <Style><Border><Color>Black</Color><Style>Solid</Style><Width>0.5pt</Width></Border></Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>

                <!-- 9.5 Initials -->
                <TablixCell>
                  <CellContents>
                    <Textbox Name="TotInitials">
                      <Paragraphs><Paragraph><TextRuns><TextRun><Value /></TextRun></TextRuns></Paragraph></Paragraphs>
                      <Style><Border><Color>Black</Color><Style>Solid</Style><Width>0.5pt</Width></Border></Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>

                <!-- 10. Total Debit -->
                <TablixCell>
                  <CellContents>
                    <Textbox Name="TotalDebit">
                      <Paragraphs>
                        <Paragraph>
                          <TextRuns><TextRun><Value>=Format(Sum(Fields!Debit.Value), "#,##0.00")</Value><Style><FontFamily>Arial</FontFamily><FontSize>8.5pt</FontSize><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns>
                          <Style><TextAlign>Right</TextAlign></Style>
                        </Paragraph>
                      </Paragraphs>
                      <Style>
                        <Border><Color>Black</Color><Style>Solid</Style><Width>0.5pt</Width></Border>
                        <PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom>
                      </Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>

                <!-- 11. Total Credit -->
                <TablixCell>
                  <CellContents>
                    <Textbox Name="TotalCredit">
                      <Paragraphs>
                        <Paragraph>
                          <TextRuns><TextRun><Value>=Format(Sum(Fields!Credit.Value), "#,##0.00")</Value><Style><FontFamily>Arial</FontFamily><FontSize>8.5pt</FontSize><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns>
                          <Style><TextAlign>Right</TextAlign></Style>
                        </Paragraph>
                      </Paragraphs>
                      <Style>
                        <Border><Color>Black</Color><Style>Solid</Style><Width>0.5pt</Width></Border>
                        <PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom>
                      </Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>

                <!-- 12. Final Balance -->
                <TablixCell>
                  <CellContents>
                    <Textbox Name="TotalBalance">
                      <Paragraphs>
                        <Paragraph>
                          <TextRuns><TextRun><Value>=Format(Last(Fields!Balance.Value), "#,##0.00")</Value><Style><FontFamily>Arial</FontFamily><FontSize>8.5pt</FontSize><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns>
                          <Style><TextAlign>Right</TextAlign></Style>
                        </Paragraph>
                      </Paragraphs>
                      <Style>
                        <Border><Color>Black</Color><Style>Solid</Style><Width>0.5pt</Width></Border>
                        <PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom>
                      </Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>
              </TablixCells>
            </TablixRow>
          </TablixRows>
        </TablixBody>

